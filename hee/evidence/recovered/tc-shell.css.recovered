/* SYNCED-FROM: tcos-www/css/site.css -- nav + toggle chrome, extracted
   for other repos/surfaces to pull in alongside tc-tokens.css. Expects
   the CSS custom properties tc-tokens.css defines. */
.site-nav {
  display: flex; align-items: center; justify-content: space-between;
  padding: 14px 0; gap: 16px; flex-wrap: wrap;
}
.site-nav .brand {
  font-family: ui-monospace, monospace; font-weight: 700; font-size: 14px;
  color: var(--ink); text-decoration: none;
}
.site-nav .links { display: flex; gap: 22px; }
.site-nav .links a {
  color: var(--ink-dim); text-decoration: none; font-size: 13.5px;
}
.site-nav .links a:hover, .site-nav .links a.active { color: var(--accent-ink); }

/* Font-size toggle (S/M/L/XL) -- zoom-based, Chrome/Edge/Safari only;
   Firefox lacks `zoom` support, a known real gap, not silently ignored. */
body[data-fontsize="s"] { zoom: 0.875; }
body[data-fontsize="m"] { zoom: 1; }
body[data-fontsize="l"] { zoom: 1.125; }
body[data-fontsize="xl"] { zoom: 1.25; }
.fontsize-toggle { display: flex; align-items: center; gap: 4px; margin-left: 12px; }
.fontsize-toggle span { font-family: ui-monospace, monospace; font-size: 10px; color: var(--ink-faint); margin-right: 2px; }
.fontsize-btn {
  background: var(--surface-2); border: 1px solid var(--line); color: var(--ink-faint);
  font-family: ui-monospace, monospace; font-size: 10.5px; font-weight: 700;
  width: 22px; height: 22px; border-radius: 5px; cursor: pointer; line-height: 1;
}
.fontsize-btn.active { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-ink); }

/* Theme toggle -- same shape as the fontsize toggle above. */
.theme-toggle { display: flex; align-items: center; gap: 4px; margin-left: 12px; }
.theme-btn {
  background: var(--surface-2); border: 1px solid var(--line); color: var(--ink-faint);
  font-family: ui-monospace, monospace; font-size: 10.5px; font-weight: 600;
  padding: 0 8px; height: 22px; border-radius: 5px; cursor: pointer; line-height: 1;
}
.theme-btn.active { background: var(--accent-soft); border-color: var(--accent); color: var(--accent-ink); }

/* Freshness header (tc-freshness.js) -- extracted verbatim from the
   Roadmap Coverage dashboard. "A common theme for any page that
   would benefit from that header component" (Spencer, 2026-08-25). */
.freshness {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  margin-top: 18px; padding: 10px 14px;
  background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px;
}
.fr-left {
  display: flex; align-items: center; gap: 8px;
  font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 12.5px; color: var(--ink-dim);
}
.fr-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok, #21815c); flex: none; }
.freshness[data-stale="true"] .fr-dot { background: #b8790a; }
.freshness[data-sync-state="error"] .fr-dot { background: #d03b3b; }
.sync-btn {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 12px; color: var(--ink-dim);
  background: var(--surface); border: 1px solid var(--line); border-radius: 6px;
  padding: 5px 11px; cursor: pointer; transition: border-color 0.15s, color 0.15s;
}
.sync-btn:hover { border-color: var(--accent); color: var(--accent-ink); }
.sync-btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.sync-btn svg { flex: none; }
.sync-btn.spinning svg { animation: tc-spin 0.9s linear infinite; }
.sync-btn.err { color: #d03b3b; border-color: rgba(208, 59, 59, 0.4); }
@keyframes tc-spin { to { transform: rotate(360deg); } }
.sync-note { font-size: 12px; color: var(--ink-faint); margin: 8px 2px 0; }
.sync-note.err { color: #d03b3b; }
