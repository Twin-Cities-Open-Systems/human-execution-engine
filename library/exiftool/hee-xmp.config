# exiftool config: the TCOS/HEE XMP namespace. Loaded by hee-exif with
# -config; without it the tags still READ (exiftool shows unknown XMP
# tags with -u), they just cannot be written by name.
#
#   XMP-hee:LabSignature  armored detached GPG signature over the file's
#                         metadata-stripped form (see SignedForm)
#   XMP-hee:LabSigner     fingerprint of the key that made it
#   XMP-hee:SignedDigest  sha256 of the stripped form that was signed
#   XMP-hee:SignedForm    how to reproduce that form: "exiftool -all="
#
# Why a stripped form: a signature over a file's bytes cannot live inside
# those bytes. Signing the file with all metadata removed lets the
# signature travel IN the metadata and stay valid through every later
# metadata write -- measured 2026-09-05 on JPEG, PNG and GIF: the
# stripped form is byte-identical before and after further stamps.
%Image::ExifTool::UserDefined::hee = (
  GROUPS => { 0 => 'XMP', 1 => 'XMP-hee', 2 => 'Image' },
  NAMESPACE => { 'hee' => 'https://tcos.us/ns/hee/1.0/' },
  WRITABLE => 'string',
  LabSignature => { },
  LabSigner    => { },
  SignedDigest => { },
  SignedForm   => { },
);
%Image::ExifTool::UserDefined = (
  'Image::ExifTool::XMP::Main' => { hee => { SubDirectory => { TagTable => 'Image::ExifTool::UserDefined::hee' } } },
);
1;
