#!/bin/sh
# Spencer Butler <dev@tcos.us>
# walk
# Serve HEE-MIB from a throwaway container and walk it, so the MIB is tested
# against net-snmp's own parser rather than only against smilint. Needs no
# snmpd on this host and touches no fleet infrastructure -- this tests a
# document, not a deployment.
set -eu
HERE="$(cd "$(dirname "$0")" && pwd)"
IMAGE="${IMAGE:-alpine:3}"
exec docker run --rm -v "$HERE":/mibs:ro "$IMAGE" sh -c '
  apk add -q --no-cache net-snmp net-snmp-tools >/dev/null 2>&1
  snmpd -C -c /mibs/snmpd.test.conf -Lf /dev/null &
  sleep 3
  export MIBDIRS=/usr/share/snmp/mibs:/mibs MIBS=+HEE-MIB
  echo "--- tree ---"
  snmptranslate -Tp HEE-MIB::heeMIB
  echo "--- walk ---"
  snmpwalk -v2c -c public 127.0.0.1:1161 HEE-MIB::heeObjects
'
