#!/sbin/openrc-run
# gopher-gateway -- real gopher-to-HTML render for man.lab.tcos.us
# (human-execution-engine/pve/services/gopher-gateway.yaml)

name="gopher-gateway"
command="/usr/bin/python3"
command_args="/opt/gopher-gateway/gopher_gateway.py"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

depend() {
    need net
}
