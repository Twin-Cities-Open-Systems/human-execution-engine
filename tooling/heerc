# heerc -- minimal, identity-agnostic shell environment for HEE.
#
# Real trigger (2026-08-26): hee's PATH resolution depended entirely on
# spencer's personal dotfiles happening to add ~/.local/bin to PATH --
# broke for a fresh homedir before dotfiles got reinstalled, and would
# break the same way for any identity (touchy-claude, a future oper)
# that doesn't run spencer's exact personal dotfiles. This decouples
# "can bare `hee` resolve" from "did this identity install full
# personal dotfiles."
#
# Sourced by dotfiles' .bashrc when this repo happens to be cloned
# (guarded -- an oper using dotfiles without hee cloned is unaffected,
# per Spencer directly: "oper can still use dotfiles without hee").
# Deliberately minimal: PATH only, no aliases/prompt/other opinion --
# those stay in personal dotfiles, not here.

case ":${PATH}:" in
  *":${HOME}/.local/bin:"*) ;;
  *) PATH="${HOME}/.local/bin:${PATH}" ;;
esac

# Status output style for every HEE tool (library/bash/vis.status.shfn.bash).
# Per-oper preference, so it belongs in an rc file rather than hardcoded.
#
#   icon   ✅ OK   ⚠️ WARNING   ❌ CRITICAL   ❓ UNKNOWN     (default)
#   ascii  [OK]    [WARN]       [CRIT]        [UNKN]         (pipes, logs, no-emoji terminals)
#   plain  OK      WARNING      CRITICAL      UNKNOWN        (label only)
#
# See yours:  hee_status_demo
: "${HEE_STATUS_STYLE:=icon}"
export HEE_STATUS_STYLE

# Guarded source so `hee_status_demo` and `hee_status` are available in any
# shell that has this repo cloned -- absent repo, absent function, no error.
if [ -r "${HOME}/git/human-execution-engine/library/bash/vis.status.shfn.bash" ]; then
  . "${HOME}/git/human-execution-engine/library/bash/vis.status.shfn.bash"
fi

# Real footgun, 2026-08-28: an agent session ran raw mutating git across
# three repos before ever reading PROMPTING_RULES.md's rule #1 (all
# git/gh mutation goes through scripts/hee_git_ops.sh, not raw git).
# One-line-per-shell reminder, not the full file -- this file stays
# minimal by design (PATH only, no other opinion); the real content
# lives in bootstrap.mk's print-governance-reminder and the file itself.
if [ -f "${HOME}/git/human-execution-engine/prompts/PROMPTING_RULES.md" ]; then
  echo "heerc: read prompts/PROMPTING_RULES.md -- git/gh mutations go through scripts/hee_git_ops.sh, never raw git." >&2
fi
