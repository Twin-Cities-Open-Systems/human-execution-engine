#!/bin/sh
# section: 1
# hee-tools-check -- report presence and version of every external tool
# named in the toolchain manifest.
#
# Status output uses the canonical HEE vocabulary
# (library/bash/vis.status.shfn.bash): OK / WARNING / CRITICAL / UNKNOWN.
# Style honours HEE_STATUS_STYLE.
set -eu

# Resolve manifest relative to this script, so it works from any CWD.
# Resolve through symlinks first -- tools are symlinked onto PATH from
# ~/.local/bin, where a bare `dirname "$0"` finds no library/, so both the
# help contract and the status vocabulary silently fail to load.
HEE_SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  HEE_SELF="$(realpath "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
elif command -v readlink >/dev/null 2>&1; then
  HEE_SELF="$(readlink -f -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
fi
# shellcheck disable=SC1007
# `CDPATH= cd` is a deliberate one-command environment assignment, not a
# missing value: it stops a user CDPATH from making `cd` print or land
# somewhere else. SC1007 reads it as a typo.
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$HEE_SELF")" && pwd)"
DEFAULT_MANIFEST="$SCRIPT_DIR/../tools.manifest.txt"

# Where the TOOL lives -- used only to find its own library.
# shellcheck disable=SC1007
TOOL_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
# The library may not be present (it is still landing on its own branch --
# pr:461@human-execution-engine). Fall back to the same LABEL + message
# shape HEE_STATUS_STYLE=plain produces, so the label -- the part machines
# parse -- is never lost, only the icon.
# shellcheck source=/dev/null
if [ -r "$TOOL_ROOT/library/bash/vis.status.shfn.bash" ]; then
  . "$TOOL_ROOT/library/bash/vis.status.shfn.bash"
  # shellcheck source=/dev/null
  [ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"
else
  hee_status() { _lvl="$1"; shift; printf '%s %s\n' "$_lvl" "$*"; }
fi

# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/tools.manifest.shfn.bash" ] && . "$TOOL_ROOT/library/bash/tools.manifest.shfn.bash"

usage() {
  cat <<'EOF'
hee-tools-check -- is every external tool this org expects actually here

SYNOPSIS
  hee-tools-check [MANIFEST]
  hee-tools-check help

DESCRIPTION
  Reads a whitespace-separated manifest of external tools and reports,
  one line each, whether the tool is on PATH and what version it claims.

  MANIFEST defaults to tooling/tools.manifest.txt resolved relative to
  this script, not to the current directory, so it works from anywhere.
  Blank lines and lines starting with # are skipped. The NAME field (first)
  and the DESIRED-version field (third) are both used.

  Presence is `command -v`. The version string is the first line of
  `<tool> --version`, falling back to `<tool> -V`; if neither works the
  line reads (version-flag-unknown). Nothing is installed, downloaded,
  or modified -- this tool is strictly read-only.

  VERSION ENFORCEMENT. When the DESIRED field is a version (not `any`) and
  the reported version string does not contain it, the line is CRITICAL:
  "wrong version (have X, want Y)". This is why hee-print silently ran the
  distro's Python yq 3.x for days -- the manifest pins `yq 4.50.1`, the tool
  was present at 3.4.3, and presence-only reported OK. A version-flag-unknown
  tool cannot be compared, so it is reported present without enforcement.

  The exit code is the worst status reported, so a script can gate on it;
  each line's LABEL (per vis.status.shfn.bash) says which tool.

EXIT STATUS
  Nagios plugin convention; the worst line wins.
  0 OK        every manifest tool present at the version it pins
  1 WARNING   an optional tool is missing
  2 CRITICAL  a required tool is missing, or present at the wrong version
  3 UNKNOWN   the MANIFEST cannot be read

  Until 2026-09-11 this tool exited 0 even with a required tool missing, and
  an unreadable MANIFEST exited 2 from the shell. Until 2026-09-26 it checked
  presence only and passed a tool pinned to a version it did not have.

EXAMPLES
  $ hee tools-check tests/fixtures/tools-manifest/present.txt   # ci

ENVIRONMENT
  HEE_STATUS_STYLE   icon (default), ascii, or plain. See heerc.
  PATH               searched for each manifest tool

SEE ALSO
  hee-tools, hee-tools-update, tooling/tools.manifest.txt
EOF
}

# Contextual help, via the shared contract. Replaces a positional check that
# saw only one argument position, and announces what it discarded.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  usage
  exit 0
fi

MANIFEST="${1:-$DEFAULT_MANIFEST}"

# vline NAME [REQ]
#
# REQ is "required" (default) or "optional". A missing OPTIONAL tool is a
# WARNING, never CRITICAL -- rule 16: never leave a check red on day one,
# because a permanently-red check trains people to ignore red. Two tools were
# reporting CRITICAL for absences nothing actually depends on:
#
#   bat  -- library/sh/hee-print already guards it with `command -v bat` and
#           falls back to cat. Optional by construction.
#   go   -- nothing builds it. cmd/hee/main.go is a stub, and per rule 13 Go is
#           the rung this toolchain has not reached yet.
# Alternate resolution lives in library/bash/tools.manifest.shfn.bash, so
# this half and hee-tools-update read the manifest the same way. They did
# not: this tool understood `bat|batcat` and the updater did not, so the
# updater silently skipped the manifest's only `required` entry (issue 507).
resolve_tool() { hee_manifest_resolve_tool "$@"; }

vline() {
  spec="$1"
  req="${2:-required}"
  desired="${3:-any}"
  n="$(resolve_tool "$spec")" || n=""
  if [ -n "$n" ]; then
    if "$n" --version >/dev/null 2>&1; then
      ver=$("$n" --version | head -n 1)
    elif "$n" -V >/dev/null 2>&1; then
      ver=$("$n" -V | head -n 1)
    else
      ver="(version-flag-unknown)"
    fi
    as=""
    [ "$n" != "$spec" ] && as="  [as $n]"
    # Version enforcement. Only when the manifest pins a version AND we could
    # read one -- a version-flag-unknown tool cannot be compared, so it is
    # reported present, never failed for something unmeasurable. The match is
    # a substring test: a version STRING like "yq (...) version v4.50.1"
    # contains the pinned "4.50.1", while the Python yq's "yq 3.4.3" does not.
    if [ "$desired" != "any" ] && [ -n "$desired" ] && [ "$ver" != "(version-flag-unknown)" ]; then
      case "$ver" in
        *"$desired"*)
          hee_status OK "$(printf '%-8s %s' "$spec" "$ver$as")" ;;
        *)
          hee_status CRITICAL "$(printf '%-8s %s' "$spec" "wrong version (have '$ver', want $desired) -- run hee tools-update$as")"
          WORST=2 ;;
      esac
      return
    fi
    if [ "$n" != "$spec" ]; then
      hee_status OK "$(printf '%-8s %s' "$spec" "$ver  [as $n]")"
    else
      hee_status OK "$(printf '%-8s %s' "$spec" "$ver")"
    fi
  else
    if [ "$req" = "optional" ]; then
      hee_status WARNING "$(printf '%-8s %s' "$spec" "missing (optional)")"
      [ "$WORST" -ge 1 ] || WORST=1
    else
      hee_status CRITICAL "$(printf '%-8s %s' "$spec" "missing")"
      WORST=2
    fi
  fi
}

if [ ! -r "$MANIFEST" ]; then
  hee_status UNKNOWN "hee-tools-check: cannot read manifest: $MANIFEST"
  exit 3
fi
WORST=0

echo "### hee-tools-check"
echo "manifest: $MANIFEST"
echo ""

# name kind desired (ignore kind/desired for now; check presence+version string)
while IFS= read -r line; do
  case "$line" in
    ""|\#*) continue ;;
  esac
  set -- $line
  name="$1"
  # 3rd column is the desired version (or `any`); 5th, optional for
  # back-compat, is requiredness -- a line without it is required.
  desired="${3:-any}"
  req="${5:-required}"
  vline "$name" "$req" "$desired"
done < "$MANIFEST"

exit "$WORST"
