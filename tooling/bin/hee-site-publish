#!/bin/sh
# section: 1
# hee-site-publish -- publish real files to the resume Cloudflare Pages
# project (spencer.blog.tcos.us, touchy.blog.tcos.us, blog.tcos.us,
# media.tcos.us -- one real deployed tree, personalized client-side by
# index.html reading window.location.hostname, no server-side routing).
#
# Real, important fact this tool exists because of: `wrangler pages
# deploy` is a full-tree ATOMIC REPLACE, not incremental -- deploying a
# directory containing only new files would delete everything else
# already live across all four real domains. This tool only ADDS files
# into a real, current copy of resume/dist/ before deploying the whole
# tree, never deploys a partial directory.
#
# The add-into-the-tree dance is required ONLY because that one tree is
# shared by four domains. `--site NAME` targets a DEDICATED project (one
# project, one domain, nothing else in it), where the atomic replace is
# the correct semantic rather than a footgun: the files named on the
# command line are the whole site.
#
# Usage:
#   hee-site-publish --add <file> [--add <file> ...] [--dry-run]
#   hee-site-publish --site NAME --index <file> [--add <file> ...] [--dry-run]
#
# Requires: real sealed Cloudflare API token at
# <tcos-www-repo>/.hee/secrets/cloudflare-tcos-www.gpg (hee-cred -pass,
# path resolved relative to THAT repo since hee-cred's storage dir is
# CWD-relative -- the token is named for tcos-www, not for the deploy
# target).
# Resolve through symlinks before deriving TOOL_ROOT -- tools are symlinked
# onto PATH from ~/.local/bin, where a bare `dirname "$0"` finds no library/.
SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  SELF="$(realpath "$SELF" 2>/dev/null || echo "$SELF")"
elif command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f -- "$SELF" 2>/dev/null || echo "$SELF")"
fi
TOOL_ROOT="$(cd "$(dirname "$SELF")/../.." && pwd)"

# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"

usage() {
  cat <<'USAGE'
hee-site-publish -- publish files to a Cloudflare Pages site and deploy it

SYNOPSIS
  hee-site-publish --add FILE [--add FILE ...] [--dry-run]
  hee-site-publish --post FILE.md [--oper SLUG] [--no-pr] [--dry-run]
  hee-site-publish --site NAME --index FILE [--add FILE ...] [--dry-run]
  hee-site-publish --site list
  hee-site-publish help

DESCRIPTION
  With no --site, publishes to the resume Cloudflare Pages project, which
  serves four domains from one deployed tree -- spencer.blog.tcos.us,
  touchy.blog.tcos.us, blog.tcos.us and media.tcos.us -- personalized
  client-side by index.html reading window.location.hostname. There is no
  server-side routing.

  Why the --add dance exists: `wrangler pages deploy` is a full-tree
  ATOMIC REPLACE, not an incremental upload. Deploying a directory holding
  only new files would delete everything else already live across all four
  domains. So this tool only ADDS files into a current copy of
  resume/dist/ and then deploys the whole tree -- it never deploys a
  partial directory.

    --add       a file to add to the tree; repeatable
    --post      publish one blog post: copy FILE.md into the resume repo at
                profiles/<oper>/blog/, rebuild the site (./convert.sh renders
                every post to a Gold page through .github's render-review.py
                and fails on a non-Gold page), deploy the whole tree, then
                open a PR carrying the post so git catches up. Live first,
                reviewed second -- the deploy is from the working tree, the
                PR is the record. Repeat --post for several posts.
    --oper      which person's blog; default: your login ($USER) if it is a
                roster slug, else required
    --no-pr     skip the PR (leaves the post uncommitted on a branch)
    --dry-run   show what would deploy, deploy nothing

DEDICATED SITES (--site)
  A dedicated site is one Cloudflare Pages project serving one domain and
  nothing else. There is no shared tree to preserve, so the atomic replace
  is the correct semantic rather than a footgun: **the files you name are
  the whole site**, and anything previously deployed and not named again is
  gone. That is the difference from the resume path above, and it is why
  --index is required rather than inferred.

    --site NAME  which dedicated site (`--site list` names them)
    --dir DIR    publish DIR as the site: every file in it, top level only.
                 Skips README.md, dotfiles, editor leftovers (*.bak, *~,
                 *.orig, *.swp) -- a backup beside the page is a backup,
                 not a page. DIR needs an index.html unless --index names
                 one.
    --index FILE the file served at the site's root, as index.html. With
                 --dir, FILE is usually a file inside DIR whose name is not
                 index.html.
    --add FILE   another file, published under its own basename; repeatable

  Known sites:

    beer    beer.tcos.us    project `beer`    TCLUG meetup material

  A site's PERMANENT assets -- its og:image, its favicon -- live in
  `fleet-ops/sites/<name>/` ($FLEET_OPS_DIR honoured) and are shipped on
  every publish, before --dir, --index and --add, each of which may
  override one by name. README.md there is never deployed. This exists so
  those assets cannot be forgotten on the command line and therefore
  deleted by the replace; it is also what makes what is live reviewable in
  a repo. A site kept entirely in one directory does not need it -- use
  --dir and the directory is the whole answer.

  Order, last wins: repo assets, then --dir, then --add, then --index.

  To add a site, add a line to the `site_project` case in this script,
  attach the domain to the project (tcos-www/CLOUDFLARE_SETUP.md has the
  API calls and the three token permissions it takes), add the CNAME to the
  zone -- Cloudflare does not create it for you -- and put its assets in
  fleet-ops/sites/<name>/.

  Requires a sealed Cloudflare API token at
  <tcos-www-repo>/.hee/secrets/cloudflare-tcos-www.gpg, read via `hee-cred
  -pass`. The path is relative to the tcos-www repo -- hee-cred's storage
  directory is CWD-relative and the token is named for that repo, not for
  whatever this deploys.

EXIT STATUS
  0 deployed (or dry-run completed)   1 usage or credential error
  2 build failed, nothing deployed
USAGE
}

# Contextual help, via the shared contract -- never a positional check.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  usage
  exit 0
fi

set -eu

RESUME_DIR="$HOME/git/resume"
DRY_RUN=0
FILES=""
POSTS=""
OPER=""
MAKE_PR=1
SITE=""
SITE_DIR=""
INDEX=""

# Files that live beside a page without being part of the site. A backup
# next to index.html is a backup; publishing it would put an older copy of
# the page on the public internet at a guessable name.
skip_file() {
  case "$1" in
    README.md|.*) return 0 ;;
    *.bak|*~|*.orig|*.rej|*.swp) return 0 ;;
    *) return 1 ;;
  esac
}

# The dedicated sites. One line per site; the domain is here only so a
# refusal and the success line can name the real URL.
site_project() {
  case "$1" in
    beer) echo "beer beer.tcos.us" ;;
    *)    return 1 ;;
  esac
}
SITE_NAMES="beer"

# wrangler 4 requires Node >= 22. Debian 13 ships Node 20, where an
# unpinned `npx wrangler` resolves to 4 and refuses to start with
# "Wrangler requires at least Node.js v22.0.0" -- measured on flippy
# 2026-09-21, which broke every deploy path in this tool. Pick the newest
# major this node can actually run rather than pinning one forever.
node_major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
if [ "${node_major:-0}" -ge 22 ] 2>/dev/null; then WRANGLER="wrangler"; else WRANGLER="wrangler@3"; fi

# With CLOUDFLARE_ACCOUNT_ID unset, wrangler enumerates accounts through
# /memberships -- which this token has no permission for, so every deploy
# dies with "A request to the Cloudflare API (/memberships) failed.
# Authentication error [code: 10000]" (measured on flippy 2026-09-21).
# /accounts DOES work with it, so the id is resolved here and handed over,
# and wrangler never makes the call. Run inside the hee-cred -exec shell,
# where $HEE_CRED_PASS is the token; the id is not a secret.
#
# shellcheck disable=SC2016  # deliberate: a fragment for the -exec shell.
# $HEE_CRED_PASS must NOT expand in THIS process -- expanding it here is
# precisely what would put the token on a command line.
CF_ACCOUNT_SNIPPET='
  acct="${CLOUDFLARE_ACCOUNT_ID:-}"
  [ -n "$acct" ] || acct=$(curl -fsS -H "Authorization: Bearer $HEE_CRED_PASS" \
      https://api.cloudflare.com/client/v4/accounts 2>/dev/null \
    | grep -o "\"id\":\"[0-9a-f]\{32\}\"" | head -1 | cut -d\" -f4)
  [ -n "$acct" ] || { echo "hee-site-publish: could not resolve the Cloudflare account id (token lacks /accounts, or the API is unreachable)" >&2; exit 2; }
'

while [ $# -gt 0 ]; do
  case "$1" in
    --add) shift; FILES="$FILES $1" ;;
    --post) shift; POSTS="$POSTS $1" ;;
    --oper) shift; OPER="$1" ;;
    --site) shift; SITE="$1" ;;
    --dir) shift; SITE_DIR="$1" ;;
    --index) shift; INDEX="$1" ;;
    --no-pr) MAKE_PR=0 ;;
    --dry-run) DRY_RUN=1 ;;
    *) echo "hee-site-publish: unknown arg: $1" >&2; exit 1 ;;
  esac
  shift
done

if [ "$SITE" = list ]; then
  for s in $SITE_NAMES; do
    sp=$(site_project "$s")
    printf '%-8s %-16s project %s\n' "$s" "${sp##* }" "${sp%% *}"
  done
  exit 0
fi

if [ -n "$SITE" ]; then
  site_project "$SITE" >/dev/null 2>&1 || {
    echo "hee-site-publish: unknown --site '$SITE' -- known: $SITE_NAMES (see '--site list')" >&2; exit 1; }
  [ -z "$POSTS" ] || { echo "hee-site-publish: --post is the resume blog; it cannot be combined with --site" >&2; exit 1; }
  if [ -n "$SITE_DIR" ]; then
    [ -d "$SITE_DIR" ] || { echo "hee-site-publish: --dir is not a directory: $SITE_DIR" >&2; exit 1; }
    # A site served with no index.html answers the bare domain with
    # nothing, so say so here rather than after a successful-looking
    # deploy.
    if [ -z "$INDEX" ] && [ ! -f "$SITE_DIR/index.html" ]; then
      echo "hee-site-publish: $SITE_DIR has no index.html -- name the front page with --index <file>" >&2; exit 1
    fi
  else
    # Required, never inferred: on a dedicated site the named files ARE the
    # whole site, so "which one is the front page" is not something to guess.
    [ -n "$INDEX" ] || { echo "hee-site-publish: --site needs --dir <directory> or --index <file>" >&2; exit 1; }
  fi
else
  [ -z "$INDEX" ] || { echo "hee-site-publish: --index is only meaningful with --site" >&2; exit 1; }
  [ -z "$SITE_DIR" ] || { echo "hee-site-publish: --dir is only meaningful with --site" >&2; exit 1; }
  [ -n "$FILES$POSTS" ] || { echo "hee-site-publish: need at least one --add <file> or --post <file.md>" >&2; exit 1; }
fi

# ---- --site: a dedicated project, one domain, nothing else in the tree.
# The named files are assembled into a fresh directory and that directory
# IS the deploy -- no copy of a live tree to preserve, because nothing
# else lives here.
if [ -n "$SITE" ]; then
  sp=$(site_project "$SITE")
  PROJECT="${sp%% *}"; DOMAIN="${sp##* }"
  [ -z "$INDEX" ] || [ -f "$INDEX" ] || { echo "hee-site-publish: not a real file: $INDEX" >&2; exit 1; }
  for f in $FILES; do
    [ -f "$f" ] || { echo "hee-site-publish: not a real file: $f" >&2; exit 1; }
  done

  # The site's PERMANENT assets -- its og card, its favicon -- live in
  # fleet-ops/sites/<name>/ and are shipped on every publish, before the
  # page. Without this they would have to be named on the command line
  # every time, and the one time they were not, the atomic replace would
  # silently delete them: exactly how fleet-ops#734 lost the store's
  # photographs. An asset a publish can forget is an asset a publish
  # eventually deletes.
  SITE_ASSETS="${FLEET_OPS_DIR:-$HOME/git/fleet-ops}/sites/$SITE"

  echo "site: $SITE -> https://$DOMAIN (Cloudflare Pages project '$PROJECT')"
  if [ -d "$SITE_ASSETS" ]; then
    for f in "$SITE_ASSETS"/*; do
      [ -f "$f" ] || continue
      skip_file "$(basename "$f")" && continue
      echo "  asset: $SITE_ASSETS/$(basename "$f")"
    done
  else
    echo "  asset: none ($SITE_ASSETS does not exist)"
  fi
  if [ -n "$SITE_DIR" ]; then
    for f in "$SITE_DIR"/*; do
      [ -f "$f" ] || continue
      if skip_file "$(basename "$f")"; then echo "  skip:  $(basename "$f")"; continue; fi
      echo "  dir:   $f -> $(basename "$f")"
    done
  fi
  for f in $FILES; do echo "  add:   $f -> $(basename "$f")"; done
  [ -z "$INDEX" ] || echo "  index: $INDEX -> index.html"
  echo "  NOTE: a dedicated site is replaced wholesale -- anything previously"
  echo "        deployed and not listed above will be gone."

  if [ "$DRY_RUN" -eq 1 ]; then
    echo "dry-run: not deploying."
    exit 0
  fi

  TREE=$(mktemp -d) || { echo "hee-site-publish: mktemp failed" >&2; exit 1; }
  trap 'rm -rf "$TREE"' EXIT INT TERM
  # Order, last wins: repo assets, then --dir, then --add, then --index.
  # A page may deliberately override an asset of the same name; an asset
  # never silently overwrites the page.
  if [ -d "$SITE_ASSETS" ]; then
    for f in "$SITE_ASSETS"/*; do
      [ -f "$f" ] || continue
      skip_file "$(basename "$f")" && continue
      cp "$f" "$TREE/$(basename "$f")" || exit 1
    done
  fi
  if [ -n "$SITE_DIR" ]; then
    for f in "$SITE_DIR"/*; do
      [ -f "$f" ] || continue
      skip_file "$(basename "$f")" && continue
      cp "$f" "$TREE/$(basename "$f")" || exit 1
    done
  fi
  for f in $FILES; do cp "$f" "$TREE/$(basename "$f")" || exit 1; done
  [ -z "$INDEX" ] || cp "$INDEX" "$TREE/index.html" || exit 1

  # --branch is the project's real production branch, for the same reason
  # the resume deploy below hardcodes it: without it wrangler infers a
  # branch from the local checkout and can silently deploy to a PREVIEW
  # environment while the custom domain keeps serving the old production.
  cd "$HOME/git/tcos-www"
  "$HOME/git/human-execution-engine/tooling/bin/hee-cred" -pass cloudflare-tcos-www -exec sh -c "
    $CF_ACCOUNT_SNIPPET
    CLOUDFLARE_ACCOUNT_ID=\"\$acct\" CLOUDFLARE_API_TOKEN=\"\$HEE_CRED_PASS\" \
      npx --yes $WRANGLER pages deploy '$TREE' --project-name '$PROJECT' --branch main
  " || { echo "hee-site-publish: deploy failed -- https://$DOMAIN still serves what it served before" >&2; exit 2; }
  echo "✅ OK $SITE deployed -- https://$DOMAIN"
  exit 0
fi

# ---- --post: the drop-an-md-and-publish path (Spencer, 2026-09-05: "I'd
# like a place I can just drop an md file and a script will publish").
# The place IS profiles/<oper>/blog/ in the resume repo -- the source
# every build already reads -- this just does the copy, build, deploy
# and PR in one command so nothing else has to be remembered.
if [ -n "$POSTS" ]; then
  [ -d "$RESUME_DIR/.git" ] || { echo "hee-site-publish: no resume checkout at $RESUME_DIR" >&2; exit 1; }
  if [ -z "$OPER" ]; then
    if [ -d "$RESUME_DIR/profiles/${USER:-}" ]; then OPER="$USER"; else
      echo "hee-site-publish: --oper SLUG required (no profile for '${USER:-}' under $RESUME_DIR/profiles/)" >&2; exit 1; fi
  fi
  BLOG_DIR="$RESUME_DIR/profiles/$OPER/blog"
  [ -d "$BLOG_DIR" ] || { echo "hee-site-publish: $BLOG_DIR does not exist -- no such person, or no blog yet" >&2; exit 1; }
  for f in $POSTS; do
    [ -f "$f" ] || { echo "hee-site-publish: not a real file: $f" >&2; exit 1; }
    case "$f" in *.md) ;; *) echo "hee-site-publish: --post wants a .md file, got: $f" >&2; exit 1 ;; esac
    head -1 "$f" | grep -q '^#' || echo "hee-site-publish: WARNING $f does not start with a '# Title' line -- the manifest title will be empty" >&2
    echo "post: $f -> $BLOG_DIR/$(basename "$f")"
    [ "$DRY_RUN" -eq 1 ] || cp "$f" "$BLOG_DIR/$(basename "$f")"
  done
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "dry-run: would run ./convert.sh in $RESUME_DIR, deploy, and open a PR on a branch named blog/$OPER-<date>"
  else
    # Build. convert.sh renders every post through .github's
    # render-review.py and runs Gold compliance on each page -- a failing
    # build here means the site is NOT deployed, which is the point.
    (cd "$RESUME_DIR" && ./convert.sh >/dev/null) || { echo "hee-site-publish: build failed -- nothing deployed" >&2; exit 2; }
    echo "built: $RESUME_DIR/dist ($(ls "$RESUME_DIR"/dist/profiles/"$OPER"/blog/*.html 2>/dev/null | wc -l) rendered post(s) for $OPER)"
  fi
fi


for f in $FILES; do
  [ -f "$f" ] || { echo "hee-site-publish: not a real file: $f" >&2; exit 1; }
  echo "adding: $f -> $RESUME_DIR/dist/$(basename "$f")"
  [ "$DRY_RUN" -eq 1 ] || cp "$f" "$RESUME_DIR/dist/$(basename "$f")"
done

if [ "$DRY_RUN" -eq 1 ]; then
  echo "dry-run: not deploying. Real dist/ tree would now contain the above additions"
  echo "alongside everything already there."
  exit 0
fi

# Real, non-obvious: the sealed token lives in tcos-www's own
# .hee/secrets/ (named for that repo), not resume's -- hee-cred's
# storage path is CWD-relative, so it must be invoked from there even
# though the actual deploy target is the resume repo/directory.
#
# Real, serious bug found and fixed 2026-08-30: without an explicit
# --branch, `wrangler pages deploy` infers the deployment's real branch
# from whatever LOCAL git branch happens to be checked out in
# $RESUME_DIR -- if that's not the project's real production branch,
# Cloudflare silently deploys to a PREVIEW environment (its own
# separate, Access-gated URL) instead of production, and the real
# custom domain keeps serving whatever the last real production deploy
# was. Confirmed live: a deploy from a stray feature branch went out as
# environment=preview and never reached spencer.blog.tcos.us at all,
# despite `wrangler` printing a clean, confident-looking success message.
# --branch is hardcoded to the project's real production branch so this
# always deploys for real, regardless of whatever branch is checked out.
cd "$HOME/git/tcos-www"
"$HOME/git/human-execution-engine/tooling/bin/hee-cred" -pass cloudflare-tcos-www -exec sh -c "
  $CF_ACCOUNT_SNIPPET
  cd '$RESUME_DIR' && CLOUDFLARE_ACCOUNT_ID=\"\$acct\" CLOUDFLARE_API_TOKEN=\"\$HEE_CRED_PASS\" \
    npx --yes $WRANGLER pages deploy dist --project-name resume --branch main
"

# ---- --post: git catches up. Never a direct commit to main (rule 1) --
# a branch and a PR, opened by the same command so it cannot be
# forgotten. The deploy above already happened from the working tree.
if [ -n "$POSTS" ] && [ "$MAKE_PR" -eq 1 ]; then
  BR="blog/$OPER-$(date -u +%Y%m%d-%H%M%S)"
  (
    cd "$RESUME_DIR"
    git switch -q -c "$BR"
    for f in $POSTS; do git add "profiles/$OPER/blog/$(basename "$f")"; done
    git add dist/blog_manifest.json 2>/dev/null || true
    TITLES=""
    for f in $POSTS; do TITLES="$TITLES
- $(sed -n '1s/^#*[[:space:]]*//p' "$f")"; done
    git commit -q -m "blog($OPER): publish $(echo $POSTS | wc -w) post(s)

Published live by hee-site-publish --post before this PR existed; this
PR is the record.
$TITLES"
    git push -q -u origin "$BR"
    gh pr create --base main --head "$BR" --assignee @me \
      --title "blog($OPER): $(for f in $POSTS; do sed -n '1s/^#*[[:space:]]*//p' "$f"; done | head -1)" \
      --body "Published live by \`hee-site-publish --post\` at $(date -Is); this PR is the git record.
$TITLES" | tail -1
    git switch -q main
  )
fi

