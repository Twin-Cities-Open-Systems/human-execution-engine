#!/usr/bin/env python3
# section: 1
"""hee-pwgen -- real, cryptographically secure password generator.

Real trigger: "./hee -pwgen 8" -- not baked into any hee-* tool yet;
hee-cred's -seal step deliberately relies on the human typing their own
password, this is the separate, real "just generate one" case (used
tonight for the soju bouncer user, written straight to a private file,
never printed to a shared/logged surface if you pipe it there
yourself).

Uses Python's `secrets` module -- real CSPRNG, not `random` (which is
not cryptographically secure and shouldn't generate anything
credential-shaped).

Usage:
  hee-pwgen [LENGTH]   # default 20 if omitted -- 8 works but is short
                        # for anything beyond a quick local test
"""
import secrets
import string
import sys

DEFAULT_LENGTH = 20
ALPHABET = string.ascii_letters + string.digits

# `help` as the LAST argument, plus --help/-h as synonyms -- the org's
# tool-help contract (issue:462@human-execution-engine). This tool has no
# subcommands, so there is only one page to print.
HELP = """hee-pwgen -- cryptographically secure password generator

SYNOPSIS
  hee-pwgen [LENGTH]
  hee-pwgen help

DESCRIPTION
  Prints one password to stdout and nothing else, so it pipes cleanly
  into a file or a password manager.

  LENGTH is the character count, default 20. It must be a positive
  integer; there is no maximum. A LENGTH under 12 still generates, but
  prints a warning to stderr first -- stdout stays exactly one line
  either way.

  Characters are drawn from ASCII letters and digits only (62 symbols,
  no punctuation), using secrets.choice -- Python's CSPRNG, not the
  `random` module. The alphabet is deliberately punctuation-free so the
  output survives shell quoting, config files, and web forms that reject
  symbols; that costs about 0.7 bits per character against a full
  printable set, so add characters rather than reaching for punctuation.

  Nothing is stored, logged, or echoed anywhere else -- if the password
  ends up on a shared surface, it is because the caller piped it there.

EXIT STATUS
  Nagios plugin convention.
  0 OK        a password was printed
  1 WARNING   LENGTH was not an integer, or was less than 1 -- message on
              stderr, nothing on stdout. Note: this is a usage error, which
              the org vocabulary would put at 2 CRITICAL; the tool really
              exits 1 today and is documented as-is, not changed here.

EXAMPLES
  hee-pwgen                  20 characters
  hee-pwgen 32               32 characters
  hee-pwgen > ~/.secret      straight to a private file, never to a log

SEE ALSO
  hee-cred -- which deliberately does NOT generate for you; its -seal
  step relies on a human typing their own password.
"""


def main():
    argv = sys.argv[1:]
    if argv and argv[-1] in ("help", "--help", "-h"):
        print(HELP, end="")
        return

    length = DEFAULT_LENGTH
    if len(sys.argv) > 1:
        try:
            length = int(sys.argv[1])
        except ValueError:
            sys.exit(f"hee-pwgen: '{sys.argv[1]}' is not a real integer length")
        if length < 1:
            sys.exit("hee-pwgen: length must be at least 1")

    if length < 12:
        print(f"hee-pwgen: warning: {length} chars is short for anything beyond a quick local test", file=sys.stderr)

    print("".join(secrets.choice(ALPHABET) for _ in range(length)))


if __name__ == "__main__":
    main()
