#!/usr/bin/env python3
# section: 1
"""hee-name: allocate unique, human-readable names from a pool, for
anything that needs one -- tmux-agent session names, bastion containers
(fleet-ops#76), or whatever comes next.

Real trigger (2026-08-24, Spencer, fleet-ops#253): "let's get the naming
sorted, that will avoid having to ever have that convo again... supa-
extendable... an oper can choose from a list what char set they want to
use or any other cult ref." Real, stated design constraints, not
invented: (1) an OPER picks the pool, not a hardcoded one; (2) adding a
new pool must not require touching this file; (3) it has to actually
last -- exhaustion-resistant, not a one-shot list.

## Pools

Each pool is a flat YAML file under tooling/name-pools/<pool>.yaml:

  pool: south-park
  names: [stan, kyle, cartman, ...]

Adding a new pool -- any "cult ref" -- means dropping in one new file.
No code change, no registry to update. `hee-name -list-pools` discovers
whatever's actually in that directory at runtime.

## Allocation and exhaustion

Allocations are scoped (e.g. "tmux-agent", "bastion") so two different
systems drawing from the same pool don't collide, tracked in
`.hee/name-allocations/<scope>.yaml` -- same real, disk-based,
git-trackable pattern as hee-ticket's `.hee/tickets/`.

That path anchors to THIS TOOL's repo, not the caller's cwd. It used to
resolve `git rev-parse --show-toplevel`, which meant the ledger followed
whoever ran the command: two callers in two directories drew from the same
pool, wrote two different ledgers, and neither could see the collision.
Override with `--allocations-dir` or `$HEE_NAME_ALLOCATIONS` (heerc) when
a scope genuinely belongs somewhere else -- see #525.

## Roles

Some scopes require the name to declare what it is. `bastion` does: every
name ends in `-oper` or `-agent`, with no bare form, so `--role` is
mandatory there. The role is applied when the name is reserved rather than
appended afterward, because the ledger is what the next allocation checks.

Once every name in a pool is taken within a scope, allocation doesn't
fail or wrap silently -- it appends a numeric suffix (`kyle-2`, `kyle-3`,
...), cycling back through the pool. A 20-name pool with this scheme
comfortably outlasts any realistic churn; there's no hardcoded ceiling.

Usage:
  hee-name -list-pools
  hee-name -allocate --pool south-park --scope tmux-agent [--prefix bast-]
  hee-name -list --scope tmux-agent
  hee-name -release <name> --scope tmux-agent
"""
import argparse
import os
import sys
from datetime import datetime, timezone
from pathlib import Path

# library/py lives in this tool's own repo -- derive it from this script's
# own location, resolved through symlinks, never from the repo the tool
# happens to be invoked against.
from pathlib import Path as _Path  # noqa: E402
sys.path.insert(0, str(_Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored  # noqa: E402

try:
    import yaml
except ImportError:
    sys.exit("Requires pyyaml: pip install pyyaml")


def default_allocations_root() -> Path:
    """The canonical ledger location: THIS TOOL's own repo.

    Deliberately not the cwd's repo. `git rev-parse --show-toplevel` answers
    "where am I standing", and standing somewhere is not a decision about
    where a fleet-wide ledger lives -- but it silently behaved like one.
    Two callers in two directories drew from one pool, wrote two ledgers,
    and neither saw the collision; the tool's own docstring promise of
    unique names did not hold. Observed 2026-09-02, when a pve-storage
    allocation landed in the thesis-engine repo purely because that was
    the cwd. See human-execution-engine#525.

    tooling/bin/hee-name -> <repo>/.hee/name-allocations
    """
    return Path(__file__).resolve().parent.parent.parent / ".hee" / "name-allocations"


def pools_dir() -> Path:
    # tooling/bin/hee-name -> tooling/name-pools
    return Path(__file__).resolve().parent.parent / "name-pools"


# Set by main() from --allocations-dir. Module-level so the accessors below
# keep their existing signatures.
_ALLOCATIONS_OVERRIDE: "Path | None" = None


def allocations_dir() -> Path:
    """Resolve the ledger location, most explicit source winning.

    Operator, 2026-09-02: "fix this so names anchor exactly where we tell
    them to." So there is a way to tell it, and the fallback is a fixed
    location rather than an ambient one.

      1. --allocations-dir PATH     explicit, per invocation
      2. $HEE_NAME_ALLOCATIONS      per-oper, set in heerc
      3. this tool's own repo       canonical default, never the cwd
    """
    if _ALLOCATIONS_OVERRIDE is not None:
        d = _ALLOCATIONS_OVERRIDE
    else:
        env = os.environ.get("HEE_NAME_ALLOCATIONS")
        d = Path(env).expanduser() if env else default_allocations_root()
    d.mkdir(parents=True, exist_ok=True)
    return d


def list_pools() -> list[str]:
    d = pools_dir()
    if not d.is_dir():
        return []
    return sorted(p.stem for p in d.glob("*.yaml"))


def load_pool(name: str) -> list[str]:
    path = pools_dir() / f"{name}.yaml"
    if not path.exists():
        available = ", ".join(list_pools()) or "(none found)"
        sys.exit(f"hee-name: no such pool '{name}'. Available: {available}")
    doc = yaml.safe_load(path.read_text())
    names = doc.get("names") or []
    if not names:
        sys.exit(f"hee-name: pool '{name}' has no names defined")
    return names


def load_allocations(scope: str) -> dict:
    path = allocations_dir() / f"{scope}.yaml"
    if not path.exists():
        return {}
    return yaml.safe_load(path.read_text()) or {}


def save_allocations(scope: str, records: dict) -> None:
    path = allocations_dir() / f"{scope}.yaml"
    path.write_text(yaml.safe_dump(records, sort_keys=True))


# Scopes whose names must declare a role, and the roles they accept.
# Operator, 2026-09-02: "never just bast-homer, must always ending in
# oper|agent name" -- and, asked whether that was ever conditional,
# "always". A convention only a reader enforces is not a convention:
# .hee/name-allocations/bastion.yaml held exactly one entry, the bare
# `bast-homer`, because nothing rejected it.
ROLE_REQUIRED_SCOPES = {
    "bastion": ("oper", "agent"),
}


def cmd_allocate(pool: str, scope: str, prefix: str, role: "str | None") -> None:
    roles = ROLE_REQUIRED_SCOPES.get(scope)
    if roles and role is None:
        sys.exit(
            f"hee-name: scope '{scope}' requires --role ({'|'.join(roles)}).\n"
            f"  A bastion name always ends in its role, so the role is part of\n"
            f"  allocating the name, not something appended afterward -- the\n"
            f"  ledger is what the next allocation checks for collisions."
        )
    if role is not None:
        if not roles:
            sys.exit(f"hee-name: scope '{scope}' does not take a --role")
        if role not in roles:
            sys.exit(f"hee-name: invalid role '{role}' for scope '{scope}'. Valid: {', '.join(roles)}")

    # The role is terminal, always. A numeric exhaustion suffix goes on the
    # POOL NAME (bast-homer-2-oper), never after the role, so that reading
    # the last segment always answers "what is this".
    sfx = f"-{role}" if role else ""

    names = load_pool(pool)
    records = load_allocations(scope)
    used = set(records.keys())

    chosen = None
    # first pass: any bare name from the pool not yet used in this scope
    for n in names:
        candidate = f"{prefix}{n}{sfx}"
        if candidate not in used:
            chosen = candidate
            break
    # exhausted: cycle the pool again with an incrementing numeric suffix
    if chosen is None:
        suffix = 2
        while chosen is None:
            for n in names:
                candidate = f"{prefix}{n}-{suffix}{sfx}"
                if candidate not in used:
                    chosen = candidate
                    break
            suffix += 1

    records[chosen] = {
        "pool": pool,
        "scope": scope,
        **({"role": role} if role else {}),
        "allocated_at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
    }
    save_allocations(scope, records)
    print(chosen)


def cmd_release(name: str, scope: str) -> None:
    records = load_allocations(scope)
    if name not in records:
        sys.exit(f"hee-name: '{name}' is not currently allocated in scope '{scope}'")
    del records[name]
    save_allocations(scope, records)
    print(f"hee-name: released '{name}' from scope '{scope}'")


def cmd_list(scope: str) -> None:
    records = load_allocations(scope)
    if not records:
        print(f"(no allocations in scope '{scope}')")
        return
    for name, rec in sorted(records.items()):
        print(f"{name}\t{rec['pool']}\t{rec['allocated_at']}")


def main():
    ap = argparse.ArgumentParser(prog="hee-name")
    ap.add_argument("-list-pools", action="store_true")
    ap.add_argument("-allocate", action="store_true")
    ap.add_argument("-release", metavar="NAME")
    ap.add_argument("-list", action="store_true")
    ap.add_argument("--pool", default=None)
    ap.add_argument("--scope", default="default")
    ap.add_argument("--prefix", default="")
    ap.add_argument("--role", default=None,
                    help="role suffix; required for scopes in ROLE_REQUIRED_SCOPES")
    ap.add_argument("--allocations-dir", default=None, metavar="PATH",
                    help="anchor the ledger here (else $HEE_NAME_ALLOCATIONS, else this tool's repo)")
    # Contextual help BEFORE argparse parses anything. argparse owns -h and
    # --help but not the bare `help` verb, and resolves either only after
    # parsing -- so an unrelated argument errors first and the help never
    # prints. Measured: 8 tools exited non-zero for --help for exactly this
    # reason. See library/py/hee_cli.
    if help_wanted(sys.argv[1:]):
        note_ignored(sys.argv[1:])
        ap.print_help()
        return 0

    args = ap.parse_args()

    global _ALLOCATIONS_OVERRIDE

    if args.allocations_dir:

        _ALLOCATIONS_OVERRIDE = Path(args.allocations_dir).expanduser()

    if args.list_pools:
        pools = list_pools()
        if not pools:
            print("(no pools found under tooling/name-pools/)")
        for p in pools:
            print(f"{p}\t({len(load_pool(p))} names)")
        return

    if args.allocate:
        if not args.pool:
            sys.exit("hee-name -allocate requires --pool (see -list-pools)")
        cmd_allocate(args.pool, args.scope, args.prefix, args.role)
        return

    if args.release:
        cmd_release(args.release, args.scope)
        return

    if args.list:
        cmd_list(args.scope)
        return

    print(__doc__)


if __name__ == "__main__":
    main()
