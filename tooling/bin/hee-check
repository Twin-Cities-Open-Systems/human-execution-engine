#!/usr/bin/env bash
# section: 1
# hee-check -- repo boundary and integrity checks.
#
# Subcommands (default: boundary, so existing callers are unaffected):
#   hee-check [boundary] [ROOT]   derived dirs are not committed to git
#   hee-check refs [ROOT]         file references in docs point at real files
#   hee-check refs --fix [ROOT]   repair refs with exactly one real candidate
#   hee-check regex               shared regex patterns agree across engines
#   hee-check systemd [PATH]      systemd unit files are valid
#   hee-check locale [ROOT]       text matches the declared locale
#   hee-check cli [TOOLDIR]       every tool's help obeys the CLI contract
#   hee-check all [ROOT]          boundary + refs + style
#
# Status output uses the canonical HEE vocabulary
# (library/bash/vis.status.shfn.bash): OK / WARNING / CRITICAL / UNKNOWN with
# Nagios exit codes 0/1/2/3. Style honours HEE_STATUS_STYLE.
set -uo pipefail

# Resolve through symlinks first -- tools are symlinked onto PATH from
# ~/.local/bin, where a bare `dirname "$0"` finds no library/, so both the
# help contract and the status vocabulary would silently fail to load. Same
# realpath idiom the `hee` dispatcher already uses.
HEE_SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  HEE_SELF="$(realpath -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
elif command -v readlink >/dev/null 2>&1; then
  HEE_SELF="$(readlink -f -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
fi
SELF_DIR="$(cd "$(dirname "$HEE_SELF")" && pwd)"
# Where the TOOL lives -- used only to find its own library. Never the
# default target: the tool must check wherever it is invoked, not the repo
# it happens to be installed in.
TOOL_ROOT="$(cd "$SELF_DIR/../.." && pwd)"

# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"

if [ -r "$TOOL_ROOT/library/bash/vis.status.shfn.bash" ]; then
  . "$TOOL_ROOT/library/bash/vis.status.shfn.bash"
else
  hee_status() { shift; printf '%s\n' "$*"; }
  hee_status_code() { return 3; }
fi

# Help is contextual: `help` as the LAST argument prints help for wherever
# you are in the command, not always the top-level page.
#   hee-check help            -> the tool
#   hee-check refs help       -> the refs subcommand
#   hee-check boundary help   -> the boundary subcommand
# `--help` and `-h` are accepted as synonyms so hee-gen-manpages, which
# runs `<tool> --help`, keeps working.
usage_refs() {
  cat <<'EOF'
hee-check refs -- every file reference in a doc must point at a real file

SYNOPSIS
  hee-check refs [--fix] [PATH]

DESCRIPTION
  Reads .md, .yaml, .yml and .json and checks every path-like reference
  written in them -- backticked and quoted paths, not only markdown links.
  This is the gap that let a contract reference a file that did not exist.

  PATH defaults to the current directory. If PATH holds repositories
  rather than being one (for example ~/git), each is checked and totalled.

  Excluded by design: docs/history/** and hee/evidence/**. Those are
  point-in-time snapshots, so a reference to a since-deleted file is
  correct history rather than rot.

OPTIONS
  --fix   Repair a reference when exactly one real file has that basename.
          Ambiguous references are left for a human, never guessed.

EXIT STATUS
  0 OK   2 CRITICAL broken refs found   3 UNKNOWN target unusable

EXAMPLES
  hee-check refs
  hee-check refs ~/git
  hee-check refs --fix ~/git/fleet-ops

DELIBERATE ABSENCE
  A path can be missing on purpose. Two ways to say so:

    hee-check:refs-ok                 exempts the line it appears on
    hee-check:refs-off ... refs-on    exempts everything between them

  Either takes an optional reason after it. In Markdown wrap it in an
  HTML comment so it renders as nothing.

  Shell existence tests need no marker: `[ -f X ]`, `[ ! -e X ]` and
  `test -d X` ASK whether a path is there, so reporting the absence back
  would be answering the question and calling it a defect.

  Why this exists: on 2026-09-01 every one of the six findings carrying a
  `did you mean` suggestion was a false positive, so --fix would have
  written six wrong paths -- four into governance, two into generated man
  pages. One of them would have repointed rule 17's own example of
  documentation going stale, making the rule describe a file that never
  had the problem. See issue:504@human-execution-engine.

EOF
}

usage_boundary() {
  cat <<'EOF'
hee-check boundary -- generated state must not be committed to git

SYNOPSIS
  hee-check [boundary] [PATH]

DESCRIPTION
  Editor and tool generated state committed to a repo puts machine output
  in the history and leaks one operator's local tooling into a shared
  repo. Which editor an operator uses is their own business: a derived
  directory present on disk but untracked is fine and is never reported.

  The rule is "not committed", never "not present".

ENVIRONMENT
  HEE_DERIVED_DIRS   space-separated directories treated as generated
                     state. Default: .cursor

EXIT STATUS
  0 OK   2 CRITICAL generated state is tracked   3 UNKNOWN target unusable

EXAMPLES
  hee-check
  hee-check boundary ~/git/fleet-ops
  HEE_DERIVED_DIRS=".cursor .idea .vscode" hee-check
EOF
}

usage() {
  cat <<'EOF'
hee-check -- repo boundary and integrity checks

SYNOPSIS
  hee-check [boundary] [PATH]
  hee-check refs [--fix] [PATH]
  hee-check systemd [PATH]
  hee-check locale [PATH]
  hee-check cli [TOOLDIR] [--json] [--quiet]
  hee-check regex
  hee-check signatures [PATH] [--re-sign --key GPG-KEY-ID]
  hee-check all [PATH]
  hee-check [SUBCOMMAND] help

DESCRIPTION
  Checks a repository for integrity problems. PATH defaults to the current
  directory, so the tool checks where it is invoked, never the repo it
  happens to be installed in.

  If PATH holds repositories rather than being one (for example ~/git),
  every repository directly inside is checked and the results totalled.
  One level deep by design -- deeper would crawl vendored checkouts.

SUBCOMMANDS
  boundary   generated state is not committed (default)
  refs       every file reference resolves
  systemd    systemd unit files are valid
  locale     authored text matches the locale this repo declares
  cli        every hee tool's own help obeys the CLI contract
  regex      shared regex patterns behave identically in every engine
  roster     roster.json's claims match real accounts and org membership
  gitignore  secret paths excluded, no negation re-including one, no duplicates
  signatures every detached .asc verifies against the file it signs,
             and can re-sign the ones that drifted
  all        boundary + refs + locale + signatures

  Add `help` after any subcommand for its own page:
      hee-check refs help

EXIT STATUS
  Nagios plugin convention.
  0 OK   1 WARNING (reserved)   2 CRITICAL   3 UNKNOWN

ENVIRONMENT
  HEE_STATUS_STYLE   icon (default), ascii, or plain. See heerc.
  HEE_DERIVED_DIRS   directories treated as generated state. Default: .cursor

EXAMPLES
  hee-check                     boundary check of the current repo
  hee-check refs                every reference in the current repo
  hee-check refs ~/git          every repo under ~/git
  hee-check refs --fix          repair unambiguous references
  hee-check all ~/git/fleet-ops both checks on one repo
  hee-check signatures          verify every detached signature
  hee-check signatures --re-sign --key inspector@tcos.us
                                re-sign only the drifted signatures that
                                this key already made

SEE ALSO
  hee-lint, hee-index, hee-print
EOF
}

# Directories holding editor/tool-generated state. Committing these puts
# machine output in the history and leaks one operator's local tooling
# choices into a shared repo. Which editor any operator uses is their own
# business -- this list is about generated state, not about editors.
# Extend via HEE_DERIVED_DIRS (space-separated) rather than editing here.
DERIVED_DIRS="${HEE_DERIVED_DIRS:-.cursor}"

# A target that does not exist, is not a directory, or is unreadable is
# UNKNOWN (exit 3) -- never OK. Issue 440: hee-check printed "OK" for a
# directory it never searched, because `find` failed inside an `if`, so
# `set -e` never tripped and grep reported "no match". Silence is not a
# negative result -- PROMPTING_RULES rule 2.
validate_target() {
  t="${1:-}"
  if [ -z "$t" ]; then hee_status UNKNOWN "no target given"; return 3; fi
  if [ ! -e "$t" ]; then hee_status UNKNOWN "target does not exist: $t"; return 3; fi
  if [ ! -d "$t" ]; then hee_status UNKNOWN "target is not a directory: $t"; return 3; fi
  if [ ! -r "$t" ]; then hee_status UNKNOWN "target is not readable: $t"; return 3; fi
  return 0
}

check_boundary() {
  root="${1:-.}"
  validate_target "$root" || return 3
  rc=0
  # The rule is "not COMMITTED", never "not present". A derived directory
  # existing on disk is the operator's own business and is not reported.
  # The previous version tested `-d`, so it failed CRITICAL on an untracked
  # local directory that harms nothing. Corrected 2026-08-31, operator:
  # "they are not forbidden".
  # A hardcoded workspace or home path in a committed file breaks for any
  # operator whose checkouts are not in the same place. PROMPTING_RULES
  # rule 10 already bans hardcoding a real user's home in a shared script;
  # this is the same rule one level up -- not the user, the workspace.
  # Real trigger 2026-08-31: an operator asked for this to be parameterised
  # org-wide "I do not want to run into an oper that uses ~/projects/".
  # Skips history/evidence snapshots, which record what was true then.
  # library/regex/patterns.yaml is excluded because it necessarily CONTAINS
  # an example of everything this checker detects -- its own match/reject
  # test fixtures. Flagging a detector's test data is a false positive that
  # would fire on every run forever. Caught during pre-merge reconciliation.
  # SCOPED BY WHAT THE PATH ACTUALLY BREAKS, not by whether it matches.
  #
  # Triage of all 36 findings across 6 repos, 2026-08-31, showed the check was
  # treating three unrelated things as one failure:
  #
  #   real breakage   a runnable script or unit file with someone's home in it
  #                   genuinely fails for the next operator -- CRITICAL
  #   a mention       prose, a historical note, a blog post, an -example config.
  #                   Misleading at worst, and rewriting a note that accurately
  #                   records what was run would falsify the record -- WARNING
  #   not authored    build output and generated state. Nobody wrote it, so
  #                   nobody can fix it -- not scanned at all
  #
  # It was reporting all three as CRITICAL, which turned 6 repos red and put a
  # published blog post on the same footing as a broken systemd unit. Operator
  # chose this split.
  _HP_SKIP="':!docs/history' ':!*/evidence/*' ':!*.log' ':!library/regex/patterns.yaml'"
  _HP_SKIP="$_HP_SKIP ':!dist/*' ':!*/dist/*' ':!build/*' ':!*/build/*'"
  _HP_SKIP="$_HP_SKIP ':!*/node_modules/*' ':!node_modules/*' ':!*.netrwhist'"

  # A path on the RIGHT of a docker -v/--volume is inside the image, not on
  # this host, so it cannot break for anyone. Real false positive:
  # devops/bin/get-coder.sh does the right thing with $HOME and was still
  # flagged for "-v $CODER_DATA:/home/coder/.config".
  _hp_filter() { grep -v -E -- '(-v|--volume)[[:space:]=][^[:space:]]*:/home/'; }

  _hp_code="$(eval git -C '"$root"' grep -n -I -E "'/home/[a-z][a-z0-9_-]*/'" -- \
              "'*.sh'" "'*.bash'" "'*.mjs'" "'*.js'" "'*.py'" "'*.service'" \
              "'*.timer'" "'*.pl'" "'*.rb'" "'bin/*'" $_HP_SKIP 2>/dev/null | _hp_filter)"
  _hp_prose="$(eval git -C '"$root"' grep -n -I -E "'/home/[a-z][a-z0-9_-]*/'" -- \
               "'*.md'" "'*.yaml'" "'*.yml'" "'*.json'" "'*.txt'" $_HP_SKIP 2>/dev/null | _hp_filter)"

  if [ -n "$_hp_code" ]; then
    _n="$(printf '%s\n' "$_hp_code" | wc -l)"
    printf '%s\n' "$_hp_code" | head -20 | while IFS= read -r l; do
      hee_status CRITICAL "hardcoded home path in executable code: $l"
    done
    # Report the true total, never the truncated one -- a capped count that
    # looks like a real count is the same failure as a false OK.
    [ "$_n" -gt 20 ] && hee_status CRITICAL "hardcoded home path: $((_n - 20)) more not shown ($_n total)"
    rc=2
  fi

  if [ -n "$_hp_prose" ]; then
    _n="$(printf '%s\n' "$_hp_prose" | wc -l)"
    printf '%s\n' "$_hp_prose" | head -10 | while IFS= read -r l; do
      hee_status WARNING "hardcoded home path in prose (not blocking): $l"
    done
    [ "$_n" -gt 10 ] && hee_status WARNING "hardcoded home path in prose: $((_n - 10)) more not shown ($_n total)"
  fi

  for d in $DERIVED_DIRS; do
    tracked="$(git -C "$root" ls-files -- "$d/*" "*/$d/*" 2>/dev/null | head -20)"
    if [ -n "$tracked" ]; then
      printf '%s\n' "$tracked" | while IFS= read -r f; do
        hee_status CRITICAL "derived state committed to git: $f"
      done
      rc=2
    fi
  done
  [ "$rc" -eq 0 ] && hee_status OK "no derived state committed in $root ($DERIVED_DIRS)"

  # Git conflict markers in a tracked text file. Incident tcos-www#59
  # (2026-09-06): a rebase committed <<<<<<< / ======= / >>>>>>> lines
  # into every generated page, CI was green, and tcos.us served them for
  # 16 minutes. Nothing that ships is allowed to carry these.
  _markers=$(git -C "$root" ls-files -z 2>/dev/null | xargs -0 -r grep -I -l -n -E '^(<<<<<<< |=======$|>>>>>>> )' -- 2>/dev/null | head -20)
  if [ -n "$_markers" ]; then
    for f in $_markers; do
      hee_status CRITICAL "git conflict markers in tracked file: $f ($(git -C "$root" grep -c -E '^(<<<<<<< |=======$|>>>>>>> )' -- "$f" 2>/dev/null | cut -d: -f2) line(s))"
    done
    rc=2
  else
    hee_status OK "no git conflict markers in tracked files"
  fi
  return "$rc"
}

check_regex() {
  reg="$TOOL_ROOT/library/regex/patterns.yaml"
  [ -r "$reg" ] || { hee_status UNKNOWN "no pattern registry at $reg"; return 3; }
  command -v python3 >/dev/null 2>&1 || { hee_status UNKNOWN "python3 unavailable"; return 3; }
  REG="$reg" python3 <<'PYEOF'
import os, re, subprocess, sys, yaml
reg = yaml.safe_load(open(os.environ["REG"]))
style = os.environ.get("HEE_STATUS_STYLE","icon")
ICON={"OK":"\u2705","WARNING":"\u26a0\ufe0f","CRITICAL":"\u274c","UNKNOWN":"\u2753"}
def line(l,m):
    if style=="plain": print(f"{l} {m}")
    elif style=="ascii": print(f"[{ {'OK':'OK','WARNING':'WARN','CRITICAL':'CRIT','UNKNOWN':'UNKN'}[l] }]".ljust(7)+m)
    else: print(f"{ICON[l]} {l} {m}")

def have(t):
    return subprocess.run(["command","-v",t],capture_output=True,shell=False).returncode==0 if False else bool(__import__("shutil").which(t))

def eng_grep(pat,s):
    return subprocess.run(["grep","-Eq",pat],input=s,text=True,capture_output=True).returncode==0
def eng_bash(pat,s):
    r=subprocess.run(["bash","-c",'[[ "$1" =~ $2 ]]',"_",s,pat],capture_output=True)
    return r.returncode==0
def eng_awk(pat,s):
    # Pattern passed as a VARIABLE, never interpolated into a /.../ literal:
    # an awk regex literal is slash-delimited, so a pattern containing "/"
    # (every path pattern) silently breaks. Caught by this validator on its
    # first run against the hardcoded_home pattern.
    r=subprocess.run(["awk","-v","p="+pat,'$0 ~ p { print "Y" }'],input=s,text=True,capture_output=True)
    return "Y" in r.stdout
def eng_sed(pat,s):
    # A sed address is delimited; the default "/" breaks on any pattern
    # containing a slash. \%...% picks an alternative delimiter. Same class
    # of harness bug as the awk one -- the pattern was never at fault.
    if "%" in pat: return True   # would need a third delimiter; skip rather than lie
    r=subprocess.run(["sed","-nE",f"\\%{pat}%p"],input=s,text=True,capture_output=True)
    return bool(r.stdout.strip())
def eng_rg(pat,s):
    # rg uses the Rust regex crate: linear-time, NO lookaround, NO
    # backreferences -- the same family as RE2. That makes rg the sharpest
    # portability canary we have, and it is the org's strongly preferred
    # search tool, so a pattern that fails here is not fit for use.
    r=subprocess.run(["rg","-q","--no-config","-e",pat],input=s,text=True,capture_output=True)
    return r.returncode==0
def eng_perl(pat,s):
    # The pattern must be a VARIABLE, taken off @ARGV before reading stdin.
    # Interpolating $ARGV[0] inside // does not do what it looks like.
    r=subprocess.run(["perl","-e",
                      'my $p = shift @ARGV; while (my $l = <STDIN>) { exit 0 if $l =~ /$p/ } exit 1',
                      "--", pat],
                     input=s, text=True, capture_output=True)
    return r.returncode==0

import shutil
_ALL=[("grep -E",eng_grep),("bash =~",eng_bash),("awk",eng_awk),
      ("sed -E",eng_sed),("rg",eng_rg),("perl",eng_perl)]
LANES = reg["spec"].get("lanes", {})
DEFAULT_LANE = reg["spec"].get("default_lane","portable")
_BIN={"grep -E":"grep","bash =~":"bash","awk":"awk","sed -E":"sed","rg":"rg","perl":"perl"}
ENGINES=[(n,f) for n,f in _ALL if shutil.which(_BIN[n])]
missing=[n for n,_ in _ALL if not shutil.which(_BIN[n])]
if missing: line("WARNING", "engine not installed, not checked: "+", ".join(missing))
if not any(n=="rg" for n,_ in ENGINES):
    line("WARNING", "rg absent -- it is the org's preferred tool AND the strictest portability canary (Rust regex: no lookaround, no backrefs)")

# python's re has no POSIX bracket classes, so [[:space:]] compiles to a class
# of the literal characters [ : s p a c e ] -- silently wrong -- or fails
# outright. Every shell engine here wants the POSIX form, so the registry is
# written in it and python is the one that needs translating.
#
# Found 2026-09-01: a pattern using [[:space:]] passed in grep, bash, awk,
# sed, rg and perl, and reported "python cannot compile". The harness was
# calling the one engine that cannot read its own registry's dialect.
POSIX_CLASSES = {
    "alpha": "a-zA-Z", "digit": "0-9", "alnum": "a-zA-Z0-9",
    "space": " \\t\\n\\r\\f\\v", "blank": " \\t",
    "upper": "A-Z", "lower": "a-z",
    "punct": "!-/:-@\\[-`{-~", "xdigit": "0-9A-Fa-f",
}

def posix_to_py(pat):
    """Rewrite POSIX bracket classes into their python equivalents.

    Only the [:name:] wrapper is replaced; it always appears inside an outer
    bracket expression, so inlining the character set is exactly right.
    """
    out = pat
    for name, chars in POSIX_CLASSES.items():
        out = out.replace("[:%s:]" % name, chars)
    return out

fails=0; checked=0
for p in reg["spec"]["patterns"]:
    name=p["name"]; pat=p["ere"]; cap=p.get("capture",0)
    lane=p.get("lane",DEFAULT_LANE)
    allowed=set(LANES.get(lane,[]))
    if not allowed:
        line("CRITICAL", f"{name}: declares unknown lane {lane!r}"); fails+=1; continue
    lane_engines=[(n,f) for n,f in ENGINES if n in allowed]
    try: rx=re.compile(posix_to_py(pat))
    except re.error as e:
        line("CRITICAL", f"{name}: python cannot compile: {e}"); fails+=1; continue
    for t in p.get("tests",{}).get("match",[]):
        checked+=1
        m=rx.search(t["input"]); got=m.group(cap) if m else None
        if got!=t["expect"]:
            line("CRITICAL", f"{name}: python expected {t['expect']!r} got {got!r} for {t['input'][:40]!r}"); fails+=1
        for eng,fn in lane_engines:
            if not fn(pat,t["input"]):
                line("CRITICAL", f"{name}: {eng} did not match {t['input'][:40]!r} -- engines disagree"); fails+=1
    for s in p.get("tests",{}).get("reject",[]):
        checked+=1
        if rx.search(s):
            line("CRITICAL", f"{name}: python wrongly matched {s[:40]!r}"); fails+=1
        for eng,fn in lane_engines:
            if fn(pat,s):
                line("CRITICAL", f"{name}: {eng} wrongly matched {s[:40]!r}"); fails+=1
    if lane=="portable" and re.search(r"\(\?[=!<]", pat):
        line("CRITICAL", f"{name}: lane=portable but uses lookaround -- rg, awk, sed and Go cannot compile it"); fails+=1
    line("OK", f"{name}: lane={lane}, verified in {', '.join(n for n,_ in lane_engines) or 'python only'}")

if fails: line("CRITICAL", f"{fails} regex failure(s) across {checked} cases"); sys.exit(2)
line("OK", f"all {len(reg['spec']['patterns'])} patterns agree across python + {', '.join(n for n,_ in ENGINES)} ({checked} cases)")
PYEOF
}

usage_cli() {
  cat <<'EOF'
hee-check cli -- does every hee tool's own help behave

SYNOPSIS
  hee-check cli [TOOLDIR] [--json] [--quiet]

DESCRIPTION
  Runs every `hee-*` tool in TOOLDIR (default: this repo's tooling/bin) and
  checks its help against the org's CLI contract.

  Probes run FROM A TEMP DIRECTORY, never from inside a checkout. That is
  deliberate: `hee lint help` prints fine inside a repo and fails outside
  one, so a checker that runs in-repo cannot see the bug.

  Checked, in order of what it costs when broken:

    help executes something   arguments to the RIGHT of a help token must
                              never be parsed. `hee foo help --force` must
                              not run --force. CRITICAL.
    errored but exited 0      silently passes CI. CRITICAL.
    help errors or hangs      CRITICAL.
    help is not uniform       `-h` works but `help` does not, or vice
                              versa. WARNING.
    silent discard            ignores args after help but never says so.
                              WARNING -- use hee_help_note_ignored().
    bare color                a color glyph with no status word, rule 11.
    no SYNOPSIS / EXIT        WARNING.

  Tools adopt the contract by sourcing library/bash/cli.help.shfn.bash.

EXIT STATUS
  0 OK   1 WARNING   2 CRITICAL   3 UNKNOWN no such tool directory
EOF
}

usage_locale() {
  cat <<'EOF'
hee-check locale -- does authored text match the locale this repo declares

SYNOPSIS
  hee-check locale [PATH]

DESCRIPTION
  Reports words that do not match the declared locale, and what that locale
  spells them instead. PATH defaults to the current directory.

  THIS IS NOT A LIST OF MISTAKES. Neither English locale is wrong. Declare
  en_GB and `color` is what gets flagged; the machinery is identical in
  both directions. TCOS declares en_US because its operator is in the US
  and its public content is US-facing -- a fact about TCOS, not English.

  Operator, 2026-09-01: "make the tool more of a locale verification tool,
  not a 'we hate the brits' tool."

PROSE, NOT TOKENS
  A word is reported only where it stands alone as English -- bounded by
  whitespace, a quote or an open paren, and followed by whitespace, end of
  line, or sentence punctuation that is itself followed by whitespace.

  A sigil, operator, digit, underscore, dot or brace means it is a token:
  $colour, --colour=always, colour: red, theme.colour.fg, colour_scheme
  and colour${num} are all references, not prose.

CONFIGURATION VOCABULARY
  Some tools spell their own options in another locale. tmux uses colour39,
  display-panes-colour, fg=colour232 -- API tokens, not prose, and
  rewriting them breaks the config.

  That is read from the primitives repo's external.yaml, where a tool's
  provenance already lives, rather than hardcoded here. If the registry is
  not found the check still runs and SAYS SO: a silently skipped exemption
  is how a false positive comes back.

DELIBERATE USE
  hee-check:locale-ok   exempts the line it appears on
  hee-check:style-ok    accepted as a synonym

ENVIRONMENT
  HEE_LOCALE       what this repo writes. Default en_US. Set it in heerc.
  HEE_PRIMITIVES   path to the primitives checkout. Default
                   $HEE_GIT_ROOT/primitives, else ~/git/primitives.

EXIT STATUS
  0 OK   1 WARNING findings   3 UNKNOWN unknown locale, or python3 missing
EOF
}

usage_systemd() {
  cat <<'EOF'
hee-check systemd -- validate systemd unit files

SYNOPSIS
  hee-check systemd [PATH]

DESCRIPTION
  Runs `systemd-analyze verify` over every unit under PATH (default: the
  repo's systemd/ directory, else the current directory).

  TWO REAL TRAPS THIS HANDLES, both measured 2026-08-31:

  1. Exit code alone is not a gate. `Type=notarealtype` produces a warning
     and exits 0 -- a broken unit sails through green. So warning TEXT is
     matched, not just $?.

  2. verify resolves ExecStart paths and fails when the binary is absent.
     A unit correct for its target host is therefore "broken" on any CI
     runner with a different $HOME or checkout path. That is a false
     negative on good code -- the same class of permanent-red noise that
     fleet-ops#350 was about. Those lines are filtered by default.

     --strict turns them back on, for when you ARE checking on the target
     host and want to know the binary is really there.

OPTIONS
  --strict   also fail when an ExecStart path does not resolve

EXIT STATUS
  0 OK   2 CRITICAL a unit is invalid   3 UNKNOWN systemd-analyze absent
EOF
}

check_systemd() {
  strict=0
  if [ "${1:-}" = "--strict" ]; then strict=1; shift; fi
  root="${1:-}"
  if [ -z "$root" ]; then
    if [ -d systemd ]; then root=systemd; else root=.; fi
  fi
  validate_target "$root" || return 3
  command -v systemd-analyze >/dev/null 2>&1 || {
    hee_status UNKNOWN "systemd-analyze not installed -- cannot verify units"; return 3; }

  units=$(find "$root" -type f \( -name '*.service' -o -name '*.timer' -o -name '*.socket' \
          -o -name '*.mount' -o -name '*.path' -o -name '*.target' \) 2>/dev/null | sort)
  [ -n "$units" ] || { hee_status OK "no systemd units under $root"; return 0; }

  rc=0; n=0
  for u in $units; do
    n=$((n + 1))
    out=$(systemd-analyze verify "$u" 2>&1)
    code=$?
    # Drop the not-executable line unless --strict: an ExecStart correct for
    # the TARGET host is absent on a CI runner, and failing on that is a
    # false negative on a good unit.
    if [ "$strict" -eq 0 ]; then
      filtered=$(printf '%s\n' "$out" | grep -v 'is not executable' | grep -v '^$')
      if [ "$code" -ne 0 ] && [ -z "$filtered" ]; then code=0; fi
    else
      filtered="$out"
    fi
    # A warning with exit 0 is still a defect -- Type=notarealtype proves it.
    if printf '%s' "$filtered" | grep -qE 'Failed to parse|Invalid|Assignment outside|Unknown (lvalue|section)|no ExecStart'; then
      code=2
    fi
    if [ "$code" -ne 0 ]; then
      hee_status CRITICAL "$u"
      printf '%s\n' "$filtered" | sed 's/^/      /'
      rc=2
    fi
  done
  [ "$rc" -eq 0 ] && hee_status OK "$n systemd unit(s) valid under $root"
  return "$rc"
}

check_refs() {
  fix=0
  if [ "${1:-}" = "--fix" ]; then fix=1; shift; fi
  root="${1:-.}"
  validate_target "$root" || return 3
  command -v python3 >/dev/null 2>&1 || { hee_status UNKNOWN "python3 unavailable -- cannot check refs"; return 3; }
  HEE_REFS_FIX="$fix" PYTHONPATH="$TOOL_ROOT/library/py:${PYTHONPATH:-}" python3 - "$root" <<'PY'
import os, sys
sys.path.insert(0, os.path.join(os.environ.get("PYTHONPATH","").split(":")[0]))
from hee_refs import scan, repair, discover_repos, repo_root

target = sys.argv[1]
repos = discover_repos(target) or [repo_root(target)]
repos = [r for r in repos if os.path.isdir(r)]
style = os.environ.get("HEE_STATUS_STYLE", "icon")
ICON = {"OK": "✅", "WARNING": "⚠️", "CRITICAL": "❌", "UNKNOWN": "❓"}
def line(level, msg):
    if style == "plain": print(f"{level} {msg}")
    elif style == "ascii":
        print(f"[{ {'OK':'OK','WARNING':'WARN','CRITICAL':'CRIT','UNKNOWN':'UNKN'}[level] }]".ljust(7) + msg)
    else: print(f"{ICON[level]} {level} {msg}")

fix = os.environ.get("HEE_REFS_FIX") == "1"
total_checked = total_broken = total_fixed = 0
for root in repos:
    checked, broken = scan(root)
    fixed = 0
    if fix:
        changed = repair(root, broken)
        for src, old, new in changed:
            line("OK", f"{os.path.basename(root)}: fixed {src}  {old} -> {new}")
        fixed = len(changed)
        checked, broken = scan(root)

    label = os.path.basename(root)
    for b in broken:
        hint = f"  (did you mean {b.suggestion}?)" if b.suggestion else ""
        line("CRITICAL", f"{label}/{b.source}:{b.line} -> {b.ref}{hint}")
    if not broken and checked:
        line("OK", f"{label}: all {checked} file references resolve")
    elif not checked:
        line("OK", f"{label}: no doc file references found")
    total_checked += checked; total_broken += len(broken); total_fixed += fixed

if not repos:
    line("UNKNOWN", f"no git repository found at or under {target}")
    sys.exit(3)

if len(repos) > 1:
    line("OK" if not total_broken else "CRITICAL",
         f"{len(repos)} repos: {total_broken} broken of {total_checked} checked"
         + (f", {total_fixed} repaired" if total_fixed else ""))
sys.exit(2 if total_broken else 0)
PY
}

# Contextual help: `help` (or --help/-h) as the LAST argument.
# Help dispatch goes through the shared contract, not the old `_last`
# idiom. `_last` only looked at the FINAL argument, so `hee-check refs help
# --fix` was not recognized as help at all and ran the real --fix. Asking
# for help must never be able to do anything -- see cli.help.shfn.bash.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  case "$(hee_help_topic "$@")" in
      refs)     usage_refs ;;
      boundary) usage_boundary ;;
      all)      usage_boundary; echo; usage_refs ;;
      systemd)  usage_systemd ;;
      cli)      usage_cli ;;
      locale|style) usage_locale ;;
      roster)   printf '%s\n' "hee-check roster -- the roster's claims match measured reality" "" "Reads roster.json in the given path, takes the org from the file's own org field, and for every person with a GitHub login measures whether that account exists and whether it is a member of that org. An entry claiming an active status (verified, ratified, peer) that reality does not support is CRITICAL. An entry marked departed or inactive that is still an org member is a warning: both mean no access, so membership contradicts the claim. An account that cannot be measured is UNKNOWN, never CRITICAL -- a rate limit is not a departure." "" "EXIT: 0 agree  2 a claim reality does not support  3 no roster, or gh/python3 missing" ;;
      regex)    printf '%s\n' "hee-check regex -- verify shared regex patterns behave identically in every engine" "" "Runs library/regex/patterns.yaml's own match/reject tests through python, grep -E, bash =~ and awk, and fails if any engine disagrees with any other. Also rejects PCRE-only constructs, which RE2 and POSIX ERE cannot express." "" "EXIT: 0 agree  2 disagree  3 registry or python3 missing" ;;
      *)        usage ;;
  esac
  exit 0
fi

# check_signatures ROOT -- every detached signature verifies against the
# file it signs.
#
# Real trigger 2026-09-02. hee/skills/ratify-contract-v1.skill.yaml records
# a bug caught twice across four PRs (signing content, then editing it) and
# names its own gap: "no automated CI check runs this skill's verification
# step -- it's still a manually-invoked discipline, not enforced". Operator:
# "ensure we are not just having a theatre party, we design is solid, let's
# not leave a hole in implementation".
#
# On its first run this found FOUR BAD signatures out of six. The bug had
# fired four more times AFTER the skill was written to prevent it, silently,
# because a stale signature still parses as valid armor.
#
# BAD SIGNATURE and NO PUBLIC KEY are reported differently, deliberately.
# The first means content changed after signing: CRITICAL. The second means
# this machine cannot check: UNKNOWN. Reporting an unverifiable signature as
# broken would train people to ignore the check, which is how a real BAD one
# gets missed.
#
# --re-sign --key KEYID repairs what this same loop just found. Deliberately
# one function: a separate re-signing tool would need its own idea of which
# signatures are BAD, and the two would drift. The finder is the fixer.
#
# Three real constraints, each of them a safety property rather than a
# nicety:
#
#   1. Only a signature that is ALREADY BAD is touched. A good signature is
#      never re-made, so running this cannot quietly re-attest content that
#      nobody looked at.
#   2. Only a signature that KEYID itself made is re-signed. The signing key
#      is read back out of gpg's own verify output, not guessed from the
#      filename. Run it with your key and you fix your own signatures and
#      nobody else's -- the operator fixes the three that are his, the agent
#      fixes the one that is its own.
#   3. A file with no existing signature is never signed. Creating a first
#      signature is ratification, a different act with its own ceremony
#      (hee/skills/ratify-contract-v1.skill.yaml). This only ever replaces.
#
# Why it exists: `hee check signatures` could find drifted signatures and
# nothing on the hee surface could repair them. hee-contract-review
# --action sign only handles status:proposed contracts, and
# tools/sign-card.sh only fills a pending attestor slot -- neither re-signs
# content that changed after it was already signed. That gap is what sent
# an agent back to hand-assembled `gpg --detach-sign` command blocks, which
# is exactly what rule 15 exists to stop.
check_signatures() {
  root="${1:-.}"
  _resign="${2:-0}"
  _resign_key="${3:-}"

  git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    hee_status UNKNOWN "not a git repository: $root"; return 3; }
  command -v gpg >/dev/null 2>&1 || {
    hee_status UNKNOWN "gpg unavailable -- cannot verify signatures"; return 3; }

  if [ "$_resign" -eq 1 ]; then
    [ -n "$_resign_key" ] || {
      hee_status UNKNOWN "--re-sign needs --key GPG-KEY-ID"; return 3; }
    gpg --list-secret-keys "$_resign_key" >/dev/null 2>&1 || {
      hee_status UNKNOWN "no secret key for '$_resign_key' in the keyring on $(hostname) -- run this where that key actually lives"
      return 3; }
    # Normalize to a fingerprint so it can be compared against what gpg
    # reports for each existing signature. An email or short id is accepted
    # on the command line; only the fingerprint is compared.
    _resign_fpr="$(gpg --with-colons --list-secret-keys "$_resign_key" 2>/dev/null \
                   | awk -F: '/^fpr/{print $10; exit}')"
    [ -n "$_resign_fpr" ] || {
      hee_status UNKNOWN "could not resolve a fingerprint for '$_resign_key'"; return 3; }
  fi

  _sig_ok=0; _sig_bad=0; _sig_unk=0; _sig_orphan=0
  _sig_fixed=0; _sig_notmine=0
  # Tracked files only -- an untracked .asc is somebody's scratch work.
  for _a in $(git -C "$root" ls-files '*.asc' 2>/dev/null); do
    # Two real conventions here: <file>.asc and <file>.<signer>.asc.
    _base="${_a%.asc}"
    [ -f "$root/$_base" ] || _base="${_base%.*}"
    if [ ! -f "$root/$_base" ]; then
      hee_status WARNING "orphan signature, signs nothing: $_a"
      _sig_orphan=$((_sig_orphan + 1)); continue
    fi
    _out="$(gpg --verify "$root/$_a" "$root/$_base" 2>&1)"
    case "$_out" in
      *"Good signature"*) _sig_ok=$((_sig_ok + 1)) ;;
      *"BAD signature"*)
        # Whose key made this signature? Read it back from gpg's own
        # output rather than inferring it from the .<signer>.asc filename,
        # which is a naming convention and not evidence.
        _made_by="$(printf '%s\n' "$_out" \
                    | sed -n 's/.*using [A-Za-z0-9]\{1,\} key \([0-9A-Fa-f]\{16,\}\).*/\1/p' \
                    | head -1)"
        if [ "$_resign" -eq 1 ] && [ -n "$_made_by" ] && [ "$_made_by" = "$_resign_fpr" ]; then
          if gpg --yes --local-user "$_resign_fpr" --detach-sign --armor \
                 --output "$root/$_a" "$root/$_base" 2>/dev/null \
             && gpg --verify "$root/$_a" "$root/$_base" 2>&1 | grep -q "Good signature"; then
            hee_status OK "re-signed, now verifies: $_a"
            _sig_fixed=$((_sig_fixed + 1))
            _sig_ok=$((_sig_ok + 1))
          else
            hee_status CRITICAL "re-sign FAILED, signature left BAD: $_a"
            _sig_bad=$((_sig_bad + 1))
          fi
        elif [ "$_resign" -eq 1 ]; then
          hee_status CRITICAL "BAD signature, made by another key ($_made_by) -- that holder must re-sign: $_a"
          _sig_bad=$((_sig_bad + 1))
          _sig_notmine=$((_sig_notmine + 1))
        else
          hee_status CRITICAL "BAD signature, content changed after signing: $_a"
          _sig_bad=$((_sig_bad + 1))
        fi ;;
      *"No public key"*|*"Can't check signature"*)
        hee_status UNKNOWN "cannot verify here, no public key: $_a"
        _sig_unk=$((_sig_unk + 1)) ;;
      *)
        hee_status UNKNOWN "unrecognized gpg result: $_a"
        _sig_unk=$((_sig_unk + 1)) ;;
    esac
  done

  if [ "$_resign" -eq 1 ]; then
    hee_status OK "re-sign: $_sig_fixed repaired with $_resign_key, $_sig_notmine left for another key holder"
  fi

  _sig_total=$((_sig_ok + _sig_bad + _sig_unk + _sig_orphan))
  [ "$_sig_total" -eq 0 ] && { hee_status OK "no signatures to verify"; return 0; }
  if [ "$_sig_bad" -gt 0 ]; then
    hee_status CRITICAL "signatures: $_sig_ok good, $_sig_bad BAD, $_sig_unk unverifiable, $_sig_orphan orphan"
    return 2
  fi
  if [ "$_sig_unk" -gt 0 ] || [ "$_sig_orphan" -gt 0 ]; then
    hee_status WARNING "signatures: $_sig_ok good, $_sig_unk unverifiable, $_sig_orphan orphan"
    return 1
  fi
  hee_status OK "all $_sig_ok signatures verify against the files they sign"
  return 0
}

# check_locale ROOT -- authored text matches the locale this repo declares.
#
# Thin, deliberately. Deciding whether a word is prose or a token, mapping it
# to the declared locale's spelling, and reading which external tools spell
# their own config vocabulary in another locale is real parsing over two
# registries -- rule 13 says that graduates out of sh. It lives in
# library/py/hee_locale, where it is testable.
check_locale() {
  root="${1:-.}"
  command -v python3 >/dev/null 2>&1 || { hee_status UNKNOWN "python3 unavailable"; return 3; }
  HEE_TOOL_ROOT="$TOOL_ROOT" python3 "$TOOL_ROOT/library/py/hee_locale/_cli.py" "$root"
}

cmd="${1:-boundary}"

# check_roster ROOT -- the roster's claims match measured reality.
#
# A roster is a claim about who is present. Nothing was checking it, so it
# drifts silently and then gets cited as authority. Measured 2026-09-06 in
# fleet-ops: of 7 entries, 5 claimed an active status while the account was
# either gone from GitHub entirely or no longer an org member -- including
# one departure the operator had confirmed weeks earlier.
#
# Deliberately generic: the org is read from the roster's own `org` field,
# never from a constant here, so this works for any org that keeps a roster
# in the same shape rather than only for the one that wrote it.
#
# An account that cannot be measured is UNKNOWN, not CRITICAL. Reporting a
# rate limit or a network failure as "this person is gone" is how a check
# earns the right to be ignored.
check_roster() {
  root="${1:-.}"
  _rf="$root/roster.json"
  [ -f "$_rf" ] || { hee_status UNKNOWN "no roster.json in $root -- nothing to reconcile"; return 3; }
  command -v gh >/dev/null 2>&1 || { hee_status UNKNOWN "gh unavailable -- cannot measure accounts"; return 3; }
  command -v python3 >/dev/null 2>&1 || { hee_status UNKNOWN "python3 unavailable -- cannot read roster.json"; return 3; }

  _org="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("org",""))' "$_rf" 2>/dev/null)"
  [ -n "$_org" ] || { hee_status UNKNOWN "roster.json declares no org"; return 3; }

  # tier US name US github US status, one person per line. Unit separator,
  # not tab: tab is IFS whitespace, so `read` collapses a run of them and an
  # empty field silently shifts every later field left. Measured -- a person
  # with no github login reported the wrong status before this was fixed.
  _rows="$(python3 -c '
import json,sys
d=json.load(open(sys.argv[1]))
for t in d.get("tiers",[]):
    for p in t.get("people",[]):
        print("\x1f".join([t.get("name",""), p.get("name",""), p.get("github") or "", p.get("status") or ""]))
' "$_rf" 2>/dev/null)"

  _bad=0; _unk=0; _ok=0
  printf '%s\n' "$_rows" | while IFS="$(printf '\037')" read -r _tier _name _gh _st; do
    [ -n "$_name" ] || continue
    if [ -z "$_gh" ]; then
      printf '  🟢 %-12s %-18s %-10s no github login recorded\n' "$_tier" "$_name" "$_st"
      continue
    fi
    if gh api "users/$_gh" --silent >/dev/null 2>&1; then _acct=exists; else _acct=missing; fi
    if gh api "orgs/$_org/members/$_gh" --silent >/dev/null 2>&1; then _mem=member; else _mem=not-member; fi

    # An active status asserts presence. departed/proposed do not.
    case "$_st" in
      verified|ratified|peer) _active=1 ;;
      *) _active=0 ;;
    esac

    if [ "$_active" -eq 1 ] && [ "$_acct" = missing ]; then
      printf '  🔴 %-12s %-18s claims %-9s but the GitHub account does not exist\n' "$_tier" "$_name" "$_st"
    elif [ "$_active" -eq 1 ] && [ "$_mem" = not-member ]; then
      printf '  🔴 %-12s %-18s claims %-9s but is not a member of %s\n' "$_tier" "$_name" "$_st" "$_org"
    elif { [ "$_st" = departed ] || [ "$_st" = inactive ]; } && [ "$_mem" = member ]; then
      printf '  🟡 %-12s %-18s marked %s but still a member of %s\n' "$_tier" "$_name" "$_st" "$_org"
    else
      printf '  🟢 %-12s %-18s %-10s account=%s org=%s\n' "$_tier" "$_name" "$_st" "$_acct" "$_mem"
    fi
  done

  # The subshell above cannot carry counts back out of the pipe, so recount
  # from the same measured facts rather than trusting a variable that the
  # pipeline already discarded.
  _crit="$(printf '%s\n' "$_rows" | while IFS="$(printf '\037')" read -r _tier _name _gh _st; do
    [ -n "$_gh" ] || continue
    case "$_st" in verified|ratified|peer) ;; *) continue ;; esac
    gh api "users/$_gh" --silent >/dev/null 2>&1 || { echo x; continue; }
    gh api "orgs/$_org/members/$_gh" --silent >/dev/null 2>&1 || echo x
  done | wc -l)"

  if [ "${_crit:-0}" -gt 0 ]; then
    hee_status CRITICAL "roster: $_crit entry(ies) claim an active status that reality does not support"
    return 2
  fi
  hee_status OK "roster: every active claim matches a real account and org membership"
  return 0
}


# check_gitignore ROOT [--fix] -- the repo excludes the secret paths every
# TCOS repo excludes, carries no negation that re-includes one, and has no
# duplicate cruft.
#
# Real trigger 2026-09-06: a sealed pve credential was committed to this
# PUBLIC repo inside a documentation typo PR. Nothing stopped it, because
# .gitignore carried `!.hee/secrets/*.gpg`, copied from fleet-ops where it is
# correct -- that repo is private and really tracks 7 sealed files. Here it
# had protected zero files. The force-push did not undo it either: the
# orphaned commit and the blob are still served by SHA.
#
# Visibility decides severity, and an unknown visibility is treated as public.
# Guessing "probably private" is how this check would learn to be ignored.
check_gitignore() {
  root="${1:-.}"
  _fix="${2:-0}"
  # The org's base lives in its .github repo, which is where org-wide GitHub
  # administration belongs. GitHub does NOT inherit .gitignore from .github
  # the way it inherits community health files, so this is synced by this
  # tool rather than by the platform -- worth knowing before anyone expects
  # it to happen on its own.
  #
  # Resolution order keeps the tool generic (issue:603@human-execution-engine):
  # an explicit env var, then a sibling .github checkout, then the copy
  # bundled here so it still works with no org checkout at all.
  _base=""
  _workspace="$(cd "$root/.." 2>/dev/null && pwd)"
  for _cand in "${HEE_GITIGNORE_BASE:-}" "$_workspace/.github/gitignore/base.gitignore" "$TOOL_ROOT/library/gitignore/secrets.baseline"; do
    [ -n "$_cand" ] && [ -r "$_cand" ] && { _base="$_cand"; break; }
  done
  _dang="$TOOL_ROOT/library/gitignore/negation-danger.txt"
  [ -r "$_base" ] || { hee_status UNKNOWN "no baseline at $_base"; return 3; }
  git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1 || {
    hee_status UNKNOWN "not a git repository: $root"; return 3; }

  _gi="$root/.gitignore"
  _name="$(basename "$(cd "$root" && pwd)")"

  # visibility: gh when it can answer, else public
  _vis="public"
  if command -v gh >/dev/null 2>&1; then
    _slug="$(git -C "$root" remote get-url origin 2>/dev/null | sed -E 's#(git@github.com:|https://github.com/)##; s#\.git$##')"
    if [ -n "$_slug" ]; then
      _v="$(gh repo view "$_slug" --json visibility --jq .visibility 2>/dev/null)"
      [ -n "$_v" ] && _vis="$(printf '%s' "$_v" | tr '[:upper:]' '[:lower:]')"
    fi
  fi

  _crit=0; _warn=0
  if [ ! -f "$_gi" ]; then
    [ "$_fix" -eq 1 ] && : > "$_gi"
    [ "$_fix" -eq 1 ] || { printf '  🟡 %-24s %-8s no .gitignore at all\n' "$_name" "$_vis"; return 1; }
  fi

  # 1. dangerous negations -- CRITICAL in a public repo, noted in a private one
  _bad=""
  while IFS= read -r _line; do
    case "$_line" in
      "!"*) ;;
      *) continue ;;
    esac
    while IFS= read -r _pat; do
      case "$_pat" in ""|\#*) continue ;; esac
      case "$_line" in
        *"$_pat"*) _bad="$_bad$_line
" ; break ;;
      esac
    done < "$_dang"
  done < "$_gi"

  if [ -n "$_bad" ]; then
    printf '%s' "$_bad" | while IFS= read -r _b; do
      [ -n "$_b" ] || continue
      if [ "$_vis" = "public" ]; then
        printf '  🔴 %-24s %-8s negation re-includes a secret path: %s\n' "$_name" "$_vis" "$_b"
      else
        printf '  🟡 %-24s %-8s negation re-includes a secret path (private, may be deliberate): %s\n' "$_name" "$_vis" "$_b"
      fi
    done
    [ "$_vis" = "public" ] && _crit=1 || _warn=1
    if [ "$_fix" -eq 1 ] && [ "$_vis" = "public" ]; then
      _tmp="$_gi.hee.$$"
      while IFS= read -r _line; do
        _hit=0
        case "$_line" in "!"*)
          while IFS= read -r _pat; do
            case "$_pat" in ""|\#*) continue ;; esac
            case "$_line" in *"$_pat"*) _hit=1; break ;; esac
          done < "$_dang" ;;
        esac
        if [ "$_hit" -eq 1 ]; then
          echo "# removed by hee check gitignore --fix: a negation re-including a"
          echo "# secret path in a public repo. See pr:609@human-execution-engine."
          echo "# was: $_line"
        else
          printf '%s\n' "$_line"
        fi
      done < "$_gi" > "$_tmp" && mv "$_tmp" "$_gi"
    fi
  fi

  # 2. missing baseline entries
  _missing=""
  while IFS= read -r _pat; do
    case "$_pat" in ""|\#*) continue ;; esac
    grep -qxF "$_pat" "$_gi" 2>/dev/null || _missing="$_missing$_pat
"
  done < "$_base"
  if [ -n "$_missing" ]; then
    _n="$(printf '%s' "$_missing" | grep -c .)"
    printf '  🟡 %-24s %-8s %s baseline secret path(s) not excluded\n' "$_name" "$_vis" "$_n"
    _warn=1
    if [ "$_fix" -eq 1 ]; then
      # A managed block between markers, so a second run replaces rather than
      # appends and an updated base propagates. Everything outside the markers
      # is the repo's own and is never touched.
      _tmp="$_gi.hee.$$"
      awk 'BEGIN{skip=0} /^# >>> hee gitignore base >>>$/{skip=1;next} /^# <<< hee gitignore base <<<$/{skip=0;next} !skip{print}' "$_gi" > "$_tmp"
      {
        echo ""
        echo "# >>> hee gitignore base >>>"
        echo "# Managed by: hee check gitignore --fix. Edit the base, not this block."
        echo "# Base: $_base"
        echo "# Never negate one of these back in: in a public repo it publishes"
        echo "# the file permanently -- see pr:609@human-execution-engine."
        grep -vE '^\s*#' "$_base" | grep -vE '^\s*$'
        echo "# <<< hee gitignore base <<<"
      } >> "$_tmp"
      mv "$_tmp" "$_gi"
    fi
  fi

  # 3. cruft: exact duplicate patterns
  _dups="$(grep -vE '^\s*(#|$)' "$_gi" 2>/dev/null | sort | uniq -d)"
  if [ -n "$_dups" ]; then
    _dn="$(printf '%s' "$_dups" | grep -c .)"
    printf '  🟡 %-24s %-8s %s duplicate pattern(s)\n' "$_name" "$_vis" "$_dn"
    _warn=1
    if [ "$_fix" -eq 1 ]; then
      _tmp="$_gi.hee.$$"
      awk '/^[[:space:]]*(#|$)/ { print; next } !seen[$0]++ { print }' "$_gi" > "$_tmp" && mv "$_tmp" "$_gi"
    fi
  fi

  if [ "$_crit" -eq 1 ]; then return 2; fi
  if [ "$_warn" -eq 1 ]; then return 1; fi
  printf '  🟢 %-24s %-8s baseline covered, no unsafe negation, no duplicates\n' "$_name" "$_vis"
  return 0
}

case "$cmd" in
  boundary) shift 2>/dev/null || true; check_boundary "${1:-.}" ;;
  refs)     shift 2>/dev/null || true; check_refs "${1:-.}" ;;
  cli)      shift 2>/dev/null || true
            command -v python3 >/dev/null 2>&1 || { hee_status UNKNOWN "python3 unavailable"; exit 3; }
            HEE_CLICHECK_ARGS="$*" python3 "$TOOL_ROOT/library/py/hee_clicheck/_cli.py" ;;
  locale)   shift 2>/dev/null || true; check_locale "${1:-.}" ;;
  # `style` was this check's name for one day, 2026-09-01, before the
  # operator reframed it. Kept as an alias rather than broken: the cost is
  # one line, and a subcommand that vanishes is worse than one that redirects.
  style)    shift 2>/dev/null || true; check_locale "${1:-.}" ;;
  regex)    check_regex ;;
  gitignore)
            shift 2>/dev/null || true
            _gfix=0; _groot="."
            while [ $# -gt 0 ]; do
              case "$1" in --fix) _gfix=1; shift ;; *) _groot="$1"; shift ;; esac
            done
            check_gitignore "$_groot" "$_gfix" ;;
  roster)   shift 2>/dev/null || true; check_roster "${1:-.}" ;;
  signatures|sig)
    shift 2>/dev/null || true
    _s_root="."; _s_resign=0; _s_key=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --re-sign) _s_resign=1; shift ;;
        --key) _s_key="${2:-}"; shift 2 ;;
        --key=*) _s_key="${1#--key=}"; shift ;;
        -*) hee_status UNKNOWN "hee-check signatures: unknown option: $1"; exit 3 ;;
        *) _s_root="$1"; shift ;;
      esac
    done
    check_signatures "$_s_root" "$_s_resign" "$_s_key" ;;
  systemd)  shift 2>/dev/null || true; check_systemd "$@" ;;
  all)      shift 2>/dev/null || true
            # The CI gate. CRITICAL fails it; WARNING and UNKNOWN are
            # reported and do not. Rule 16: a check that is red for a
            # spelling in a comment or a signature it has no key for trains
            # people to ignore red -- measured 2026-09-06: dotfiles and
            # resume CI red on exactly those, with nothing broken. --strict
            # restores "worst status wins" for an operator checking by hand.
            _strict=0
            if [ "${1:-}" = "--strict" ]; then _strict=1; shift; fi
            check_boundary "${1:-.}"; a=$?
            check_refs "${1:-.}"; b=$?
            check_locale "${1:-.}"; c=$?
            check_signatures "${1:-.}" 0 ""; d=$?
            _worst=$a
            [ "$b" -gt "$_worst" ] && _worst=$b
            [ "$c" -gt "$_worst" ] && _worst=$c
            [ "$d" -gt "$_worst" ] && _worst=$d
            _crit=0
            for _r in "$a" "$b" "$c" "$d"; do [ "$_r" -eq 2 ] && _crit=1; done
            if [ "$_crit" -eq 1 ]; then
              echo "❌ CRITICAL hee-check all: at least one check is CRITICAL"; exit 2
            fi
            if [ "$_worst" -ne 0 ]; then
              if [ "$_strict" -eq 1 ]; then
                echo "⚠️ WARNING hee-check all: no CRITICAL; warnings above (--strict: failing on them)"; exit "$_worst"
              fi
              echo "⚠️ WARNING hee-check all: no CRITICAL; warnings above are advisory (--strict fails on them)"; exit 0
            fi
            echo "🟢 OK hee-check all: every check passed"; exit 0 ;;
  *)
    # Back-compat: hee-check took a bare ROOT before it had subcommands.
    # Decide by asking the filesystem, not by guessing at path shapes -- a
    # pattern list missed a bare "." and broke the most common invocation.
    # A path-shaped argument is a TARGET: validate it, so a missing one is
    # UNKNOWN/3 ("could not determine") rather than being mistaken for a
    # typo'd subcommand. A bare word is a subcommand: a typo is CRITICAL/2.
    # Issue 440 turned on exactly this distinction -- `hee-check og` was a
    # typo, `hee-check /nope` was a bad target, and both silently said OK.
    case "$cmd" in
      */*|.|..|~*) check_boundary "$cmd" ;;
      *)
        if [ -d "$cmd" ]; then
          check_boundary "$cmd"
        else
          hee_status UNKNOWN "unknown subcommand: $cmd" >&2
          usage >&2
          exit 2
        fi
        ;;
    esac
    ;;
esac
