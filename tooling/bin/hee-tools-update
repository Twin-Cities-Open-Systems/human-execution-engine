#!/bin/sh
# section: 1
# hee-tools-update -- install/refresh the external tools the toolchain
# manifest pins a version for.
#
# Status output uses the canonical HEE vocabulary
# (library/bash/vis.status.shfn.bash): OK / WARNING / CRITICAL / UNKNOWN.
set -eu

# Resolve through symlinks first -- tools are symlinked onto PATH from
# ~/.local/bin, where a bare `dirname "$0"` finds no library/. Same realpath
# idiom the `hee` dispatcher uses, per the GNU Tools Preference Policy.
SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  SELF="$(realpath "$SELF" 2>/dev/null || echo "$SELF")"
elif command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f -- "$SELF" 2>/dev/null || echo "$SELF")"
fi
# shellcheck disable=SC1007
# `CDPATH= cd` is a deliberate one-command environment assignment, not a
# missing value: it stops a user CDPATH from making `cd` print or land
# somewhere else. SC1007 reads it as a typo.
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)"
DEFAULT_MANIFEST="$SCRIPT_DIR/../tools.manifest.txt"

# Where the TOOL lives -- used only to find its own library. The library
# may not be present (still landing on its own branch --
# pr:461@human-execution-engine); fall back to the same LABEL + message
# shape HEE_STATUS_STYLE=plain produces so the label is never lost.
# shellcheck disable=SC1007
TOOL_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"
# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/tools.manifest.shfn.bash" ] && . "$TOOL_ROOT/library/bash/tools.manifest.shfn.bash"

# shellcheck source=/dev/null
if [ -r "$TOOL_ROOT/library/bash/vis.status.shfn.bash" ]; then
  . "$TOOL_ROOT/library/bash/vis.status.shfn.bash"
else
  hee_status() { _lvl="$1"; shift; printf '%s %s\n' "$_lvl" "$*"; }
fi

usage() {
  cat <<'EOF'
hee-tools-update -- install or refresh the pinned external toolchain

SYNOPSIS
  hee-tools-update [--force|--reinstall] [MANIFEST] [LOG_DIR]
  hee-tools-update help

OPTIONS
  --force, --reinstall   Reinstall every downloading kind (go, yq) even when it
                         is already at the pinned version, bypassing the version
                         short-circuit. The escape hatch for a corrupt install
                         whose version string still matches. Must be the FIRST
                         argument (a leading-flag test keeps spaces in MANIFEST/
                         LOG_DIR intact).

DESCRIPTION
  Walks the toolchain manifest and acts on each entry according to its
  `kind` column. This tool WRITES to the filesystem and DOWNLOADS from
  the network -- it is the mutating half of the pair; hee-tools-check is
  the read-only half.

  MANIFEST defaults to tooling/tools.manifest.txt resolved relative to
  this script, so it works from any directory.

  LOG_DIR defaults to $XDG_STATE_HOME/hee/tools (that is
  ~/.local/state/hee/tools unless XDG_STATE_HOME is set). A run log
  records what got installed on THIS machine at one moment -- host
  state, not repo content -- and XDG_STATE_HOME is the directory the
  spec reserves for exactly that.

  It used to default to the RELATIVE path hee/evidence/tools, which
  landed the log wherever you happened to be standing. Run from a repo
  root -- the documented way -- that dirtied the worktree, and
  ci/git/hee-preflight.sh is a hard gate that refuses a dirty worktree.
  So a SUCCESSFUL toolchain update blocked the next session's entry
  until someone cleaned up after it. Real, and it happened
  (issue:501@human-execution-engine).

  Pass LOG_DIR explicitly if you do want the log inside a repo.

  Manifest lines are `name kind desired`. Blank lines and # comments are
  skipped. Handled kinds, and only these:

    go tar <version>    compares `go version` against <version> and, only if
                        they differ (or go is absent, or --force), downloads
                        https://go.dev/dl/go<version>.linux-amd64.tar.gz, records
                        its sha256 in the log, wipes and re-extracts
                        $HOME/.local/go/<version>, then symlinks go and gofmt
                        into $HOME/.local/bin. The short-circuit was added
                        because the unconditional reinstall re-downloaded ~150MB
                        every run and re-triggered a `curl (23)` write failure on
                        disk-constrained hosts (issue:826@human-execution-engine).
    yq bin <version>    compares `yq --version` against <version> and, only if
                        they differ (or yq is absent, or --force), downloads the
                        mikefarah/yq linux_amd64 release binary and moves it
                        into $HOME/.local/bin/yq (via a temp file, so a failed
                        download never leaves a truncated yq on PATH ahead of
                        the distro's Python yq).
    <name> pkg <any>    reports presence only and prints an apt hint. NEVER
                        installs anything. Recognized for jq, bat, glow, rg
                        and tmux by name; any other name:kind pair is logged
                        as an unknown manifest entry and skipped.

  A FAILED download does not abort the run. Each downloading kind guards its
  own download and returns cleanly on failure; the loop records the severity
  from the line's requiredness (`req`, the 5th manifest column -- absent means
  required) and moves on to the next line. So a broken OPTIONAL entry -- the go
  tarball is optional -- can no longer block a REQUIRED one that follows it,
  such as yq. Before this, a `curl (23)` write error on the go download aborted
  the whole run under `set -e` and yq was never reached.

  Architecture is hardcoded linux/amd64 for both downloading kinds. On
  any other OS or architecture this tool will fetch the wrong artifact
  rather than refuse -- a real limitation, not a documented option.

  Real footgun: every line of output goes to the log file only. `log()`
  pipes through `tee -a "$OUT" >/dev/null`, and the downloads are quiet
  (curl -fsSL), so a successful run prints NOTHING to the terminal. Read
  LOG_DIR/tools-update.<UTC-timestamp>.log to see what happened. The
  resolved path is printed when the run starts.

EXAMPLES
  hee tools-update

  hee tools-update --force

  Neither is marked "# ci": both download and install the pinned toolchain (go,
  yq) into ~/.local, a mutation of the host, so there is no read-only run to
  prove. --force reinstalls even when the version already matches. hee
  tools-check is the read-only half and IS proven in CI.

EXIT STATUS
  Nagios plugin convention; the worst line wins, matching hee-tools-check.
  0 OK        every manifest line was processed and every install succeeded
  1 WARNING   an OPTIONAL line's install failed (bad download/extract). Other
              lines still ran.
  2 CRITICAL  a REQUIRED line's install failed, or a line names a kind this
              tool cannot act on (that line was skipped, so a pin is unapplied).

  A failed download no longer aborts the run or leaks curl's own exit code:
  the download is guarded, the failure is mapped to WARNING/CRITICAL by the
  line's requiredness, and the remaining lines are still processed.

ENVIRONMENT
  HOME               install prefix -- $HOME/.local/bin and $HOME/.local/go
  TMPDIR             download scratch space for the go tarball (default /tmp)
  PATH               must contain $HOME/.local/bin for the installed
                     binaries to be reachable; the log says so if it is not
  HEE_STATUS_STYLE   icon (default), ascii, or plain. See heerc.

FILES
  tooling/tools.manifest.txt              default manifest
  $XDG_STATE_HOME/hee/tools/tools-update.*.log   per-run log

SEE ALSO
  hee-tools, hee-tools-check
EOF
}

# Contextual help, via the shared contract. Checked before anything else --
# this tool's first real act is `mkdir -p`, and asking for help must never
# create directories or touch $HOME.
#
# The `_last` idiom this replaces only looked at the FINAL argument, so
# `hee tools-update help /some/manifest` was not recognized as help at all
# and ran for real. That is not hypothetical: it wrote seven junk evidence
# logs into hee/evidence/tools/ across 2026-08-30/31, each recording only
# `manifest: --help`, and those logs dirtied the worktree until they broke
# ci/git/hee-preflight.sh for the next session.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  usage
  exit 0
fi

# --force / --reinstall, as the FIRST argument only. Kept deliberately simple:
# a leading-flag test preserves any spaces in the positional MANIFEST/LOG_DIR
# args (rebuilding a positional list in POSIX sh cannot, without arrays). When
# set, a downloading kind reinstalls even if it is already at the pinned
# version -- the escape hatch for a corrupt-but-version-matching install, which
# the version short-circuit below would otherwise skip.
FORCE=0
if [ "${1:-}" = "--force" ] || [ "${1:-}" = "--reinstall" ]; then
  FORCE=1
  shift
fi

MANIFEST="${1:-$DEFAULT_MANIFEST}"
EVD_DIR="${2:-${XDG_STATE_HOME:-$HOME/.local/state}/hee/tools}"
TS="$(date -u +%Y%m%dT%H%M%SZ)"
OUT="$EVD_DIR/tools-update.$TS.log"

mkdir -p "$EVD_DIR" "$HOME/.local/bin" "$HOME/.local/go"

# Say where the log is BEFORE the run, not after. Every line of real output
# goes to the file and nothing to the terminal, so without this a successful
# run is completely silent and the operator has no path to look at.
printf 'log: %s\n' "$OUT"

log() { printf "%s\n" "$*" | tee -a "$OUT" >/dev/null; }
have() { command -v "$1" >/dev/null 2>&1; }

install_go_tar() {
  gov="$1"
  arch="amd64"
  os="linux"
  t="go${gov}.${os}-${arch}.tar.gz"
  url="https://go.dev/dl/${t}"
  tmp="${TMPDIR:-/tmp}/${t}"
  dest="$HOME/.local/go/${gov}"

  log "== go install ${gov} =="
  log "curl $url"
  # Guard the download EXPLICITLY rather than leaning on `set -e`. The caller
  # invokes this in an `if`, which disables errexit for the whole function, so
  # an unchecked failure here would fall through to `tar` on a bad file. Check
  # the download itself, and return before touching $dest -- a failed download
  # must never wipe a working install. Real trigger: a `curl (23)` write error
  # aborted the whole run before yq was reached (issue:501@human-execution-engine
  # gave the log-path fix; this gives the keep-going fix).
  if ! curl -fsSL -o "$tmp" "$url"; then
    log "go ${gov} download failed (curl) -- existing install left untouched"
    return 1
  fi
  log "sha256:"
  sha256sum "$tmp" | tee -a "$OUT" >/dev/null || true

  rm -rf "$dest"
  mkdir -p "$dest"
  if ! tar -C "$dest" -xzf "$tmp"; then
    log "go ${gov} extract failed (tar)"
    return 1
  fi

  ln -sf "$dest/go/bin/go" "$HOME/.local/bin/go"
  ln -sf "$dest/go/bin/gofmt" "$HOME/.local/bin/gofmt"

  if have go; then
    log "go version: $(go version)"
  else
    log "$(hee_status CRITICAL 'go not on PATH; add ~/.local/bin to PATH')"
  fi
}

install_yq_bin() {
  yqv="$1"
  arch="amd64"
  os="linux"
  url="https://github.com/mikefarah/yq/releases/download/v${yqv}/yq_${os}_${arch}"
  out="$HOME/.local/bin/yq"
  tmp="$out.tmp.$$"

  log "== yq install v${yqv} =="
  log "curl $url -> $out"
  # Download to a temp path and mv into place. A direct write to $out that
  # fails partway (a `curl (23)` write error) would leave a truncated,
  # executable `yq` on PATH -- worse than the missing one it replaced. mv is
  # atomic on the same filesystem, so PATH only ever sees a complete binary.
  # Guard the download explicitly: the caller runs this under `if`, so errexit
  # is off inside here.
  if ! curl -fsSL -o "$tmp" "$url"; then
    rm -f "$tmp"
    log "yq v${yqv} download failed (curl) -- existing yq (if any) left untouched"
    return 1
  fi
  chmod +x "$tmp"
  mv -f "$tmp" "$out"
  # "$out", not a bare `yq`. A bare name resolves through the shell's command
  # hash, which still points at the PRE-install binary -- so a real run on
  # 2026-09-01 installed v4.50.1 and then logged v4.53.3. The install had
  # worked; the verification was reading a different file. A log that cannot
  # tell a successful install from a failed one is worse than no log.
  log "yq version: $("$out" --version || true)"
}

log "### hee-tools-update"
log "manifest: $MANIFEST"
log "out: $OUT"
log ""

# Worst status seen across the manifest, Nagios convention (0 OK / 1 WARNING /
# 2 CRITICAL), the same mapping hee-tools-check uses. A failed install no
# longer aborts the run: the download guards in install_* return non-zero, the
# loop records the severity per the manifest's `req` column and keeps going, so
# a broken OPTIONAL line (e.g. the go tarball) can never block a REQUIRED one
# (e.g. yq) that comes after it.
rc=0

# record_fail REQ MESSAGE -- a required install failure is CRITICAL (rc 2), an
# optional one is WARNING (rc 1). Never downgrades an existing CRITICAL.
record_fail() {
  _rf_req="$1"; shift
  if [ "$_rf_req" = "optional" ]; then
    log "$(hee_status WARNING "$*")"
    [ "$rc" -ge 1 ] || rc=1
  else
    log "$(hee_status CRITICAL "$*")"
    rc=2
  fi
}

while IFS= read -r line; do
  case "$line" in
    ""|\#*) continue ;;
  esac
  set -- $line
  # Fields: name kind desired [vflag] [req]. Field 4 is the version flag and
  # field 5 the requiredness -- absent means required, the same read as
  # hee-tools-check, so the two halves agree on which lines are optional.
  name="$1"; kind="$2"; desired="$3"; req="${5:-required}"

  # Dispatch on KIND, then on name -- never on the literal "$name:$kind"
  # pair. The manifest's name field can carry alternates (`bat|batcat`), so
  # a literal match silently skipped 2 of 8 entries, one of them the only
  # `required` line (issue 507).
  case "$kind:$name" in
    tar:go)
      # Version short-circuit, matching bin:yq below. go used to reinstall on
      # EVERY run -- re-downloading the ~150MB tarball and wiping+re-extracting
      # $HOME/.local/go/<version> even when go was already at the pinned
      # version. On a disk-constrained host that guaranteed a `curl (23)` write
      # failure every run, and needlessly re-paid the download otherwise
      # (issue:826@human-execution-engine). Skip the download when `go version`
      # already reports the pin; `--force` overrides to force a clean re-extract.
      if [ "$FORCE" != 1 ] && have go; then
        cur="$(go version | sed -n 's/.*go version go\([0-9.]\+\).*/\1/p' | head -n 1)"
        log "go current: ${cur:-unknown} desired: $desired"
        if [ "${cur:-}" = "$desired" ]; then
          log "go ok"
        elif ! install_go_tar "$desired"; then
          record_fail "$req" "go $desired could not be installed -- see $OUT"
        fi
      elif ! install_go_tar "$desired"; then
        record_fail "$req" "go $desired could not be installed -- see $OUT"
      fi
      ;;
    bin:yq)
      # `--force` reinstalls even when the version already matches -- the escape
      # hatch for a corrupt-but-version-matching binary.
      if [ "$FORCE" != 1 ] && have yq; then
        cur="$(yq --version | sed -n 's/.*version v\{0,1\}\([0-9.]\+\).*/\1/p' | head -n 1)"
        log "yq current: ${cur:-unknown} desired: $desired"
        if [ "${cur:-}" = "$desired" ]; then
          log "yq ok"
        elif ! install_yq_bin "$desired"; then
          record_fail "$req" "yq $desired could not be installed -- see $OUT"
        fi
      elif ! install_yq_bin "$desired"; then
        record_fail "$req" "yq $desired could not be installed -- see $OUT"
      fi
      ;;
    pkg:*)
      # Generic, with no per-name list to forget to extend. That list is
      # exactly what dropped smilint, and what would have dropped every
      # future pkg entry -- #517 had just extended it again, by hand, to
      # add two more tools. This removes the reason to.
      #
      # Their names are deliberately not spelled out in this comment: a
      # comment line that BEGINS with the linter's own name is parsed as a
      # directive (SC1072/SC1073). Four attempts at writing this block hit
      # that, and the blocking lint job caught every one before it merged.
      if _resolved="$(hee_manifest_resolve_tool "$name")"; then
        if [ "$_resolved" != "$name" ]; then
          log "== $name ok (present as $_resolved) =="
        else
          log "== $name ok (present) =="
        fi
      else
        log "== $name missing =="
        log "hint (debian/ubuntu): sudo apt install $(hee_manifest_primary "$name")"
      fi
      ;;
    *)
      # CRITICAL, not WARNING. The tool cannot tell "this line is malformed"
      # from "this tool is missing", and the whole point of a manifest is
      # that every line is acted on. A skipped line that reads as a warning
      # is a pin nobody is applying. #517 left a comment here saying this
      # was tracked in issue 507 and not fixed there; this is that fix.
      log "$(hee_status CRITICAL "unhandled manifest entry: $name $kind $desired")"
      rc=2
      ;;
  esac
done < "$MANIFEST"

log ""
log "done"

# The loop runs in this shell, not a subshell, so rc survives -- `done <
# "$MANIFEST"` redirects input rather than piping into the loop, which is
# what would have put it in a subshell and discarded rc.
case "$rc" in
  1) hee_status WARNING "an optional toolchain entry could not be installed -- see $OUT" ;;
  2) hee_status CRITICAL "a required toolchain entry could not be installed or acted on -- see $OUT" ;;
esac
exit "$rc"
