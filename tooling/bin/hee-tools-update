#!/bin/sh
# section: 1
# hee-tools-update -- install/refresh the external tools the toolchain
# manifest pins a version for.
#
# Status output uses the canonical HEE vocabulary
# (library/bash/vis.status.shfn.bash): OK / WARNING / CRITICAL / UNKNOWN.
set -eu

# Resolve through symlinks first -- tools are symlinked onto PATH from
# ~/.local/bin, where a bare `dirname "$0"` finds no library/. Same realpath
# idiom the `hee` dispatcher uses, per the GNU Tools Preference Policy.
SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  SELF="$(realpath -- "$SELF" 2>/dev/null || echo "$SELF")"
elif command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f -- "$SELF" 2>/dev/null || echo "$SELF")"
fi
# shellcheck disable=SC1007
# `CDPATH= cd` is a deliberate one-command environment assignment, not a
# missing value: it stops a user CDPATH from making `cd` print or land
# somewhere else. SC1007 reads it as a typo.
SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$SELF")" && pwd)"
DEFAULT_MANIFEST="$SCRIPT_DIR/../tools.manifest.txt"

# Where the TOOL lives -- used only to find its own library. The library
# may not be present (still landing on its own branch --
# pr:461@human-execution-engine); fall back to the same LABEL + message
# shape HEE_STATUS_STYLE=plain produces so the label is never lost.
# shellcheck disable=SC1007
TOOL_ROOT="$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)"
# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"

# shellcheck source=/dev/null
if [ -r "$TOOL_ROOT/library/bash/vis.status.shfn.bash" ]; then
  . "$TOOL_ROOT/library/bash/vis.status.shfn.bash"
else
  hee_status() { _lvl="$1"; shift; printf '%s %s\n' "$_lvl" "$*"; }
fi

usage() {
  cat <<'EOF'
hee-tools-update -- install or refresh the pinned external toolchain

SYNOPSIS
  hee-tools-update [MANIFEST] [LOG_DIR]
  hee-tools-update help

DESCRIPTION
  Walks the toolchain manifest and acts on each entry according to its
  `kind` column. This tool WRITES to the filesystem and DOWNLOADS from
  the network -- it is the mutating half of the pair; hee-tools-check is
  the read-only half.

  MANIFEST defaults to tooling/tools.manifest.txt resolved relative to
  this script, so it works from any directory.

  LOG_DIR defaults to $XDG_STATE_HOME/hee/tools (that is
  ~/.local/state/hee/tools unless XDG_STATE_HOME is set). A run log
  records what got installed on THIS machine at one moment -- host
  state, not repo content -- and XDG_STATE_HOME is the directory the
  spec reserves for exactly that.

  It used to default to the RELATIVE path hee/evidence/tools, which
  landed the log wherever you happened to be standing. Run from a repo
  root -- the documented way -- that dirtied the worktree, and
  ci/git/hee-preflight.sh is a hard gate that refuses a dirty worktree.
  So a SUCCESSFUL toolchain update blocked the next session's entry
  until someone cleaned up after it. Real, and it happened
  (issue:501@human-execution-engine).

  Pass LOG_DIR explicitly if you do want the log inside a repo.

  Manifest lines are `name kind desired`. Blank lines and # comments are
  skipped. Handled kinds, and only these:

    go tar <version>    downloads https://go.dev/dl/go<version>.linux-amd64.tar.gz,
                        records its sha256 in the log, wipes and re-extracts
                        $HOME/.local/go/<version>, then symlinks go and gofmt
                        into $HOME/.local/bin. Always reinstalls -- there is no
                        "already at this version" short-circuit for go.
    yq bin <version>    compares `yq --version` against <version> and, only if
                        they differ (or yq is absent), downloads the
                        mikefarah/yq linux_amd64 release binary to
                        $HOME/.local/bin/yq and chmod +x's it.
    <name> pkg <any>    reports presence only and prints an apt hint. NEVER
                        installs anything. Recognized for jq, bat, glow, rg
                        and tmux by name; any other name:kind pair is logged
                        as an unknown manifest entry and skipped.

  Architecture is hardcoded linux/amd64 for both downloading kinds. On
  any other OS or architecture this tool will fetch the wrong artifact
  rather than refuse -- a real limitation, not a documented option.

  Real footgun: every line of output goes to the log file only. `log()`
  pipes through `tee -a "$OUT" >/dev/null`, and the downloads are quiet
  (curl -fsSL), so a successful run prints NOTHING to the terminal. Read
  LOG_DIR/tools-update.<UTC-timestamp>.log to see what happened. The
  resolved path is printed when the run starts.

EXIT STATUS
  Nagios plugin convention.
  0 OK   every manifest line was processed
  Any other status is the exit code of whichever command failed under
  `set -e` (curl, tar, sha256sum, mkdir), passed through unmapped -- a
  failed download exits with curl's own code, not 2 CRITICAL. Documented
  as-is, not changed here.

ENVIRONMENT
  HOME               install prefix -- $HOME/.local/bin and $HOME/.local/go
  TMPDIR             download scratch space for the go tarball (default /tmp)
  PATH               must contain $HOME/.local/bin for the installed
                     binaries to be reachable; the log says so if it is not
  HEE_STATUS_STYLE   icon (default), ascii, or plain. See heerc.

FILES
  tooling/tools.manifest.txt              default manifest
  $XDG_STATE_HOME/hee/tools/tools-update.*.log   per-run log

SEE ALSO
  hee-tools, hee-tools-check
EOF
}

# Contextual help, via the shared contract. Checked before anything else --
# this tool's first real act is `mkdir -p`, and asking for help must never
# create directories or touch $HOME.
#
# The `_last` idiom this replaces only looked at the FINAL argument, so
# `hee tools-update help /some/manifest` was not recognized as help at all
# and ran for real. That is not hypothetical: it wrote seven junk evidence
# logs into hee/evidence/tools/ across 2026-08-30/31, each recording only
# `manifest: --help`, and those logs dirtied the worktree until they broke
# ci/git/hee-preflight.sh for the next session.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  usage
  exit 0
fi

MANIFEST="${1:-$DEFAULT_MANIFEST}"
EVD_DIR="${2:-${XDG_STATE_HOME:-$HOME/.local/state}/hee/tools}"
TS="$(date -u +%Y%m%dT%H%M%SZ)"
OUT="$EVD_DIR/tools-update.$TS.log"

mkdir -p "$EVD_DIR" "$HOME/.local/bin" "$HOME/.local/go"

# Say where the log is BEFORE the run, not after. Every line of real output
# goes to the file and nothing to the terminal, so without this a successful
# run is completely silent and the operator has no path to look at.
printf 'log: %s\n' "$OUT"

log() { printf "%s\n" "$*" | tee -a "$OUT" >/dev/null; }
have() { command -v "$1" >/dev/null 2>&1; }

install_go_tar() {
  gov="$1"
  arch="amd64"
  os="linux"
  t="go${gov}.${os}-${arch}.tar.gz"
  url="https://go.dev/dl/${t}"
  tmp="${TMPDIR:-/tmp}/${t}"
  dest="$HOME/.local/go/${gov}"

  log "== go install ${gov} =="
  log "curl $url"
  curl -fsSL -o "$tmp" "$url"
  log "sha256:"
  sha256sum "$tmp" | tee -a "$OUT" >/dev/null

  rm -rf "$dest"
  mkdir -p "$dest"
  tar -C "$dest" -xzf "$tmp"

  ln -sf "$dest/go/bin/go" "$HOME/.local/bin/go"
  ln -sf "$dest/go/bin/gofmt" "$HOME/.local/bin/gofmt"

  if have go; then
    log "go version: $(go version)"
  else
    log "$(hee_status CRITICAL 'go not on PATH; add ~/.local/bin to PATH')"
  fi
}

install_yq_bin() {
  yqv="$1"
  arch="amd64"
  os="linux"
  url="https://github.com/mikefarah/yq/releases/download/v${yqv}/yq_${os}_${arch}"
  out="$HOME/.local/bin/yq"

  log "== yq install v${yqv} =="
  log "curl $url -> $out"
  curl -fsSL -o "$out" "$url"
  chmod +x "$out"
  log "yq version: $(yq --version || true)"
}

log "### hee-tools-update"
log "manifest: $MANIFEST"
log "out: $OUT"
log ""

while IFS= read -r line; do
  case "$line" in
    ""|\#*) continue ;;
  esac
  set -- $line
  name="$1"; kind="$2"; desired="$3"

  case "$name:$kind" in
    go:tar)
      install_go_tar "$desired"
      ;;
    yq:bin)
      if have yq; then
        cur="$(yq --version | sed -n 's/.*version v\{0,1\}\([0-9.]\+\).*/\1/p' | head -n 1)"
        log "yq current: ${cur:-unknown} desired: $desired"
        if [ "${cur:-}" != "$desired" ]; then
          install_yq_bin "$desired"
        else
          log "yq ok"
        fi
      else
        install_yq_bin "$desired"
      fi
      ;;
    jq:pkg|bat:pkg|glow:pkg|rg:pkg|tmux:pkg|shellcheck:pkg|ruff:pkg)
      if have "$name"; then
        log "== $name ok (present) =="
      else
        log "== $name missing =="
        log "hint (debian/ubuntu): sudo apt install $name"
      fi
      ;;
    *)
      # Still WARNING, and still wrong -- `bat|batcat` and `smilint` land here
      # because this dispatch matches literal names and the manifest's name
      # field can carry alternates. hee-tools-check's resolve_tool already
      # handles that; this half never learned. An unhandled entry should also
      # be CRITICAL, not WARNING: the tool cannot tell "this line is
      # malformed" from "this tool is missing". Both tracked in issue 507 --
      # not fixed here, because fixing it properly means both halves sharing
      # one resolver rather than each keeping its own.
      log "$(hee_status WARNING "unknown manifest entry: $name $kind $desired")"
      ;;
  esac
done < "$MANIFEST"

log ""
log "done"
