#!/usr/bin/env python3
# section: 8
"""hee-trust -- the fleet's trust anchors: who signs, and who believes whom.

Named for the noun rather than the category. `hee sec` was considered and
rejected: security covers nearly everything, so a tool called that accretes
whatever has no other home. `trust` names one question -- do I believe this
thing, and on whose word.

Deliberately NOT the place for hee-cred. A credential is a secret you HOLD;
a trust anchor is something you BELIEVE. They share GPG and recipient
handling, but shared implementation belongs in library/, not a merged
command. hee-cred also has 31 callers across five repos, and moving a
working, well-scoped tool to satisfy a taxonomy is not an improvement.

SYNOPSIS
  hee-trust anchor [--home PATH] [--repo PATH] [--write] [--force]
  hee-trust anchor verify [--home PATH]
  hee-trust ca show [--host HOST] [--vmid N]
  hee-trust [SUBCOMMAND] help

SUBCOMMANDS
  anchor    the SOA capsule at ~/.hee/index/_.yaml
  ca        the fleet X.509 CA

EXIT STATUS
  Nagios plugin convention.
  0 OK   1 WARNING   2 CRITICAL   3 UNKNOWN

SEE ALSO
  hee-cred (a secret you HOLD, deliberately separate), hee-ssh-trust-ca,
  hee-ver, docs/specs/HEE_SOA_CAPSULE.md

WHY `anchor` EXISTS

library/py/hee_hash/soa.py could only ever VERIFY. There was no generator
anywhere in the org -- docs/specs/HEE_SOA_CAPSULE.md describes the creation
process as six manual steps, "dogfooded live 2026-08-24", and that is
literally how both existing capsules were made.

The consequence, measured 2026-09-03: kiosk's claude and spencer accounts
have capsules; owner-dogfood, container-factory and the golden template
have none. contracts/fleet-identity-v1.contract.yaml makes
owner@dogfood:~/.hee/index/_.yaml the ROOT of the identity chain, and the
fleet CA generated into that same container is described as attesting
through it. It could not, because nothing could write one.

A hash you have to produce by hand is a hash nobody produces.
"""
import argparse
import os
import pwd
import socket
import subprocess
import sys
from pathlib import Path

from pathlib import Path as _Path  # noqa: E402
sys.path.insert(0, str(_Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored  # noqa: E402
from hee_hash.soa import SoaHasher, verify_current_host, HASH_SPEC_ID  # noqa: E402

HELP_ANCHOR = """hee-trust anchor -- the SOA capsule at ~/.hee/index/_.yaml

SYNOPSIS
  hee-trust anchor [--home PATH] [--write]
  hee-trust anchor verify [--home PATH]

DESCRIPTION
  Creates the per-identity capsule docs/specs/HEE_SOA_CAPSULE.md specifies,
  computing the hash chain with library/py/hee_hash/soa.py rather than
  reproducing it -- the same code that verifies is the code that writes,
  so the two cannot drift.

  Three legs are read from the account's real state: the PARTUUID backing
  its home, the PARTUUID backing its repo checkout, and its username, uid
  and fully-qualified host. Three legs pair into three duoples; the duoples
  concatenate into one stool root hash. Legs and a stool make a stool.

  Nothing here is asserted. The hash is a function of facts anyone on the
  host can re-derive, which is the whole reason the algorithm exists
  instead of a random token.

  DRY RUN by default, matching hee-gen-manpages and hee-gen-skills. --write
  is required to touch the filesystem.

  Writes, all owner-only:
    ~/.hee/current/soa/<hostshort>.legs.kv      the real legs
    ~/.hee/current/soa/<hostshort>.hashes.txt   intermediate values, audit
    ~/.hee/index/_.yaml                         the capsule, mode 600

  `verify` re-reads both files and recomputes independently. It reports OK
  only when the written stool matches a fresh computation.

EXIT STATUS
  0 OK   1 WARNING   2 CRITICAL   3 UNKNOWN
"""

HELP_CA = """hee-trust ca -- the fleet X.509 CA

SYNOPSIS
  hee-trust ca show [--host HOST] [--vmid N]

DESCRIPTION
  Reports the fleet CA as it actually exists: subjects, validity,
  SHA-256 fingerprints, key permissions, and whether the chain verifies.

  The dogfood CA lives in owner-dogfood (lxc 102) and its private keys
  have never left that container. `show` reads it over the same path
  everything else uses and never copies key material.

  Creation is deliberately NOT here yet. The dogfood CA was generated
  2026-09-03 by a script run once, with no air gap, no SLIP-39 split and
  no witnesses -- recorded in that container's ca-provenance.txt. Folding
  that script in without also deciding what a REAL ceremony looks like
  would quietly make the informal path the official one.

EXIT STATUS
  0 OK   2 CRITICAL chain does not verify   3 UNKNOWN cannot reach it
"""


def _run(cmd):
    return subprocess.run(cmd, capture_output=True, text=True)


def _partuuid(path: Path) -> str:
    """PARTUUID of the filesystem backing `path`, or the literal 'null'.

    'null' is a real value here, not an error: soa.py canonicalizes missing
    keys to the literal string rather than omitting them, so a host with no
    PARTUUID (a container on a dataset, say) still produces a stable hash
    instead of a differently-shaped one.
    """
    r = _run(["findmnt", "-no", "PARTUUID", "--target", str(path)])
    v = (r.stdout or "").strip() if r.returncode == 0 else ""
    return v or "null"


def build_legs(home: Path, repo: Path, hostf: str) -> str:
    pw = pwd.getpwuid(os.getuid())
    return (
        f"[leg.home_fs]\npartuuid={_partuuid(home)}\n\n"
        f"[leg.repo_fs]\npartuuid={_partuuid(repo)}\n\n"
        f"[leg.user]\nusername={pw.pw_name}\nuid={pw.pw_uid}\nhost={hostf}\n"
    )


def cmd_anchor(args) -> int:
    home = Path(args.home).expanduser() if args.home else Path.home()
    hostf = socket.getfqdn()
    hs = hostf.split(".")[0]
    soa_dir = home / ".hee" / "current" / "soa"
    idx_dir = home / ".hee" / "index"

    # The repo leg. On a single-partition host this is the same filesystem
    # as home, and the spec says so plainly -- two accounts on one host
    # SHOULD share leg_home_fs and leg_repo_fs. Only leg.user differs.
    repo = Path(args.repo).expanduser() if args.repo else home

    legs_text = build_legs(home, repo, hostf)
    h_home, h_repo, h_user, d_hr, d_hu, d_ru, stool = \
        SoaHasher().compute_from_legs_text(legs_text)
    show = f"{stool[:8]}..{stool[-8:]}"

    hashes_text = (
        f"# hee-soa.v1 intermediate hashes -- {hostf}, generated by hee-trust\n"
        f"# spec: {HASH_SPEC_ID}\n"
        f"leg_home_fs={h_home}\nleg_repo_fs={h_repo}\nleg_user={h_user}\n"
        f"duople_home_repo={d_hr}\nduople_home_user={d_hu}\nduople_repo_user={d_ru}\n"
        f"stool_hash_full={stool}\n"
    )
    pw = pwd.getpwuid(os.getuid())
    yaml_text = (
        "yaml.v0:\n"
        '  id: "hee://_/index/_.yaml"\n'
        '  status: active\n\n'
        "  hee_soa:\n"
        '    scheme: "hee-soa.v1"\n'
        f'    host: "{hostf}"\n'
        f'    user: "{pw.pw_name}"\n'
        f'    stool_hash_full: "{stool}"\n'
        f'    stool_hash_show: "{show}"\n\n'
        "  refs:\n"
        f'    legs_kv: "{soa_dir}/{hs}.legs.kv"\n'
        f'    hashes_txt: "{soa_dir}/{hs}.hashes.txt"\n\n'
        "  invariants:\n"
        '    - "short_token_never_authoritative"\n'
        '    - "verify_identity_before_writes"\n'
        '    - "disk_over_memory"\n\n'
        "  notes:\n"
        f'    - "generated by hee-trust anchor --write on {hostf}"\n'
        '    - "the hash is a function of real, re-derivable facts -- not asserted"\n'
    )

    targets = [(soa_dir / f"{hs}.legs.kv", legs_text, 0o600),
               (soa_dir / f"{hs}.hashes.txt", hashes_text, 0o600),
               (idx_dir / "_.yaml", yaml_text, 0o600)]

    print(f"host      {hostf}")
    print(f"user      {pw.pw_name} (uid {pw.pw_uid})")
    print(f"stool     {show}")
    for p, _, _ in targets:
        state = "EXISTS, would be replaced" if p.exists() else "new"
        print(f"  {'would write' if not args.write else 'writing'}  {p}  [{state}]")

    if not args.write:
        print("\nDry run. Nothing written. Re-run with --write to apply.")
        return 0

    # Refusing rather than clobbering: an anchor IS the identity, per
    # fleet-identity-v1's ssot_is_the_bastion. Overwriting one silently
    # would replace an identity, not update a file.
    existing = idx_dir / "_.yaml"
    if existing.exists() and not args.force:
        print(f"\nCRITICAL {existing} already exists.", file=sys.stderr)
        print("  An anchor is the identity, not a file about it. Refusing to\n"
              "  replace one. Pass --force only if you mean to REPLACE this\n"
              "  identity, and know what already chains through it.", file=sys.stderr)
        return 2

    for p, text, mode in targets:
        p.parent.mkdir(parents=True, exist_ok=True)
        os.chmod(p.parent, 0o700)
        p.write_text(text)
        os.chmod(p, mode)
    print("\nwritten. verifying independently...")
    return cmd_anchor_verify(args)


def cmd_anchor_verify(args) -> int:
    home = Path(args.home).expanduser() if args.home else Path.home()
    try:
        res = verify_current_host(home=home)
    except Exception as e:
        print(f"UNKNOWN cannot verify: {e}", file=sys.stderr)
        return 3
    print(f"  host   {res.host}")
    print(f"  stool  {res.stool_show}")
    if res.expected_stool_full is None:
        print("  CRITICAL capsule carries no stool_hash_full to check against",
              file=sys.stderr)
        return 2
    if res.ok:
        print("  OK recomputed stool matches the capsule")
        return 0
    print("  CRITICAL recomputed stool does NOT match the capsule", file=sys.stderr)
    print(f"    capsule     {res.expected_stool_full}", file=sys.stderr)
    print(f"    recomputed  {res.stool_full}", file=sys.stderr)
    return 2


def cmd_ca_show(args) -> int:
    vm = str(args.vmid)
    script = (
        'cd /root/ca 2>/dev/null || { echo NO_CA; exit 0; }; '
        'for f in root/root.crt.pem intermediate/int.crt.pem; do '
        '  echo "--- $f"; '
        '  openssl x509 -in "$f" -noout -subject -enddate -fingerprint -sha256 2>/dev/null; '
        'done; '
        'echo "--- verify"; '
        'openssl verify -CAfile root/root.crt.pem intermediate/int.crt.pem 2>&1; '
        'echo "--- key modes"; stat -c "%a %n" root/root.key.pem intermediate/int.key.pem'
    )
    r = _run(["ssh", "-o", "BatchMode=yes", f"root@{args.host}",
              f"pct exec {vm} -- sh -c {script!r}"])
    out = (r.stdout or "").strip()
    if r.returncode != 0 or not out:
        print(f"UNKNOWN cannot reach lxc {vm} on {args.host}: "
              f"{(r.stderr or '').strip().splitlines()[-1] if r.stderr else 'no output'}",
              file=sys.stderr)
        return 3
    if "NO_CA" in out:
        print(f"UNKNOWN no CA at /root/ca in lxc {vm}", file=sys.stderr)
        return 3
    print(out)
    return 0 if ": OK" in out else 2


def main() -> int:
    ap = argparse.ArgumentParser(prog="hee-trust", add_help=False)
    sub = ap.add_subparsers(dest="cmd")

    a = sub.add_parser("anchor", add_help=False)
    a.add_argument("verb", nargs="?", default="create")
    a.add_argument("--home", default=None)
    a.add_argument("--repo", default=None)
    a.add_argument("--write", action="store_true")
    a.add_argument("--force", action="store_true")

    c = sub.add_parser("ca", add_help=False)
    c.add_argument("verb", nargs="?", default="show")
    c.add_argument("--host", default="10.0.0.153")
    c.add_argument("--vmid", default="102")

    argv = sys.argv[1:]
    if help_wanted(argv):
        note_ignored(argv)
        if argv and argv[0] == "anchor":
            print(HELP_ANCHOR)
        elif argv and argv[0] == "ca":
            print(HELP_CA)
        else:
            print(__doc__)
            print("Add `help` after any subcommand for its own page.")
        return 0

    args = ap.parse_args(argv)
    if args.cmd == "anchor":
        return cmd_anchor_verify(args) if args.verb == "verify" else cmd_anchor(args)
    if args.cmd == "ca":
        if args.verb != "show":
            print(f"hee-trust ca: unknown verb '{args.verb}' (only `show` today)",
                  file=sys.stderr)
            return 3
        return cmd_ca_show(args)
    print(__doc__)
    return 0


if __name__ == "__main__":
    sys.exit(main())
