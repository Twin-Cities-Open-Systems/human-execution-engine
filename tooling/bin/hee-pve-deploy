#!/usr/bin/env python3
# section: 8
# System administration -- creates and configures Proxmox containers. man-pages(7) puts commands that
# administer the system in 8, not 1.
"""hee-pve-deploy -- deploy and provision a Proxmox LXC from one declarative manifest.

One YAML file per service; this tool creates the container via the real
Proxmox API (pvesh over SSH to the node), idempotent by hostname, then
applies the manifest's add-ons, files and provision scripts inside it.

Real trigger (2026-08-24, Spencer): "build extensible deploy via api to
pve strat" -- tiny, bare-minimum LXC per core service (bastion, qmail
MTA, snmpd), matching docs/guides/PVE_CAPACITY_PLANNING_METHODOLOGY.md's
step 5 ("a new service is a new manifest entry, not new deploy code").

Never installs anything on the pve host itself -- pvesh is Proxmox's
own real API-wrapper CLI, already there on any real Proxmox node; this
tool just calls it over SSH from wherever hee runs.

Manifest format (pve/services/<name>.yaml):
  hostname: bastion
  template: alpine-3.23-default_20260116_amd64.tar.xz
  cores: 1
  memory_mb: 256
  disk_gb: 4
  storage: ssd1
  bridge: vmbr0
  unprivileged: true
  addons: [agent-tooling]           # named apk sets from the org's registry (--addons)
  agent: ci-triage                  # agent roster role, only for a container that runs an agent
  files:                            # committed files pushed INTO the container
    - {src: pve/lab-dhcp/dnsmasq.conf, dst: /etc/dnsmasq.conf, mode: "0644"}
    - {generate: agent-roster-model, dst: /etc/claude-code/managed-settings.d/50-model.json, mode: "0644"}
  provision:                        # committed POSIX sh scripts run inside it
    - pve/lab-dhcp/provision.sh
  resolver:                         # the container's /etc/resolv.conf, and nothing overwrites it
    nameservers: [10.0.0.194, 10.0.0.72]
    search: [lab.tcos.us, tcos.us]
    ndots: 2

`files:` and `provision:` paths are relative to the root of the repo the
manifest lives in (git rev-parse --show-toplevel), never to the current
directory and never absolute: a manifest names what it ships, and what it
ships is under review beside it. Real trigger (2026-09-10): the only
precedent for configuring what runs INSIDE a container was a README of
`pct exec N -- sh -c "cat > /etc/..."` one-liners (fleet-ops
pve/snmp-joe/README.md) -- the same imperative shape pve/network.yaml was
written to remove for bridges. Order: create -> addons -> files ->
provision. The manifest is fully resolved BEFORE the container is created,
so a missing file fails closed rather than leaving a half-provisioned
container behind. Every step is previewed under --dry-run, including
addons, which the dry run used to skip.

A `files:` entry names either `src` (a committed file) or `generate` (a
file rendered at deploy time, never committed). The one generator today is
`agent-roster-model`: it reads the org's agent roster (--agent-roster), refuses unless
the agent roster is `status: ratified` AND its detached signature verifies with a
key the agent roster's own ratification_evidence names, then renders the
Claude Code managed-settings drop-in that pins the manifest's `agent:` to
the model the agent roster assigns. Real trigger (2026-09-10): the first agent
manifests shipped five hand-kept managed-settings.json copies, each
restating a model the signed agent roster already names -- a second source that
would leave every container on the old model after an agent roster change, with
nothing to say so. Operator: "generate from roster at deploy is correct,
footgun". The model is named in exactly one place, and the dry run prints
the rendered file.

Every command run inside the container gets
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin. `pct exec`
otherwise passes PVE's own /sbin:/bin:/usr/sbin:/usr/bin, which has no
/usr/local/bin, so a provision script calling a tool it just linked there
exited 127 (measured 2026-09-10).

`resolver:` declares the container's DNS: up to three IPv4 nameservers, in
order; an optional search list; and ndots (default 1). The tool writes
/etc/resolv.conf from it right after the network is up, before add-ons, and
makes it stick. Nothing else does, measured 2026-09-10: the golden template
sets no resolver, pve rewrites /etc/resolv.conf from the HOST's file at every
container start, and Alpine's udhcpc rewrites it from DHCP on every lease --
ct113 was resolving through 10.0.0.72 and 1.1.1.1 handed out by the
household router, and a public resolver answers NXDOMAIN for lab names. So
it also writes /etc/.pve-ignore.resolv.conf (pve skips the file), and for a
DHCP container /etc/udhcpc/udhcpc.conf with RESOLV_CONF="no". ndots matters
on musl: the search list is used only when a name has FEWER dots than
ndots, so `view.lab` (one dot) resolves as view.lab.tcos.us only with
ndots 2. Operator: "proper search and ndot settings too (view.lab/foo should
work)".

Usage:
  hee-pve-deploy MANIFEST.yaml [--node pve] [--host 10.0.0.153] [--dry-run]
                 [--anchors FILE] [--addons FILE] [--agent-roster FILE]
"""
import os
import argparse
import ipaddress
import json
import re
import shlex
import subprocess
import sys
import textwrap
import time

# library/py lives in this tool's own repo -- derive it from this script's
# own location, resolved through symlinks, never from the repo the tool
# happens to be invoked against.
from pathlib import Path as _Path  # noqa: E402
sys.path.insert(0, str(_Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored  # noqa: E402

try:
    import yaml
except ImportError:
    sys.exit("Requires pyyaml: pip install pyyaml")


def pvesh(host, args, capture=True):
    cmd = ["ssh", "-o", "BatchMode=yes", f"root@{host}", "pvesh", *args]
    proc = subprocess.run(cmd, capture_output=capture, text=True)
    if proc.returncode != 0:
        # With capture=False pvesh wrote straight to the terminal, so there is
        # no stderr to show -- say so rather than printing "None".
        detail = proc.stderr if capture else "(pvesh's own output is above; it was not captured)"
        sys.exit(f"hee-pve-deploy: pvesh {' '.join(args)} failed (exit {proc.returncode}):\n{detail}")
    return proc.stdout if capture else None


def existing_hostnames(host, node):
    import json
    out = pvesh(host, ["get", f"/nodes/{node}/lxc", "--output-format", "json"])
    return {c["name"]: c["vmid"] for c in json.loads(out)}


def ensure_template(host, template_storage, template):
    # Real, live-found gap: some storages (the lvmthin local-lvm/vmdata this
    # fleet used before the 2026-09-02 ZFS migration, and zfspool alike) only
    # support content type images/rootdir, not vztmpl -- templates must
    # live on a dir-type storage (real "local" on this node). Separate
    # from where the LXC's actual rootfs disk lands.
    local = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", f"root@{host}", "pveam", "list", template_storage],
        capture_output=True, text=True,
    ).stdout
    if template not in local:
        print(f"hee-pve-deploy: downloading template {template} to {template_storage}...")
        pvesh_download = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", f"root@{host}", "pveam", "download", template_storage, template],
            capture_output=True, text=True,
        )
        if pvesh_download.returncode != 0:
            sys.exit(f"hee-pve-deploy: template download failed:\n{pvesh_download.stderr}")


def _anchor_ok(spec, anchors_path):
    """Refuse a pinned address unless the role is an enumerated anchor.

    Identity in this fleet is the ROLE. The address is allocated and invisible
    -- operator, 2026-09-08: "we really only care what the role is... we design
    it now to not even care, and give it strict rules that we can bend if we
    need to." The anchors registry IS that bend, and this is what makes it a
    mechanism instead of a preference.

    This org has repeatedly written rules that nothing enforced: the kind
    registry calls itself authoritative while hee-lint passes an unregistered
    kind, and rule 16 mandated a checkout without naming a ref. A strict rule
    with no check is a preference.

    FAILS CLOSED. An unreadable registry refuses the pin rather than allowing
    it -- "I could not check" must never resolve to "go ahead", which is the
    exact failure namespace-audit shipped (issue:423@fleet-ops).
    """
    role = spec.get("role")
    if not role:
        sys.exit(
            "hee-pve-deploy: this manifest pins an address or hwaddr but declares no "
            "'role'.\n"
            "  Only an enumerated anchor may be pinned, and an anchor is identified by "
            "its role.\n"
            "  Either add 'role:' naming an anchor, or drop the pin and let the address "
            "be allocated."
        )
    if not os.path.isfile(anchors_path):
        sys.exit(
            f"hee-pve-deploy: cannot read the anchors registry at {anchors_path}, so "
            f"'{role}' cannot be confirmed as an anchor.\n"
            "  Refusing the pin rather than allowing it: could-not-check is not "
            "permission.\n"
            "  Point --anchors at the registry, or drop the pin."
        )
    try:
        import yaml
    except ImportError:
        sys.exit("hee-pve-deploy: pyyaml unavailable, so the anchors registry cannot be "
                 "read and the pin cannot be confirmed. Refusing.")
    with open(anchors_path, encoding="utf-8") as fh:
        doc = yaml.safe_load(fh) or {}
    anchors = ((doc.get("spec") or {}).get("anchors") or {})
    if role not in anchors:
        sys.exit(
            f"hee-pve-deploy: role '{role}' is not an anchor, so its address must not be "
            f"pinned.\n"
            f"  Anchors are: {', '.join(sorted(anchors)) or '(none declared)'}\n"
            f"  An anchor is a role something must reach BEFORE name resolution works --\n"
            f"  not merely an important one. Drop the pin and let the address be "
            f"allocated,\n"
            f"  or add '{role}' to {os.path.basename(anchors_path)} with a stated reason."
        )
    return True


def _net0(spec, anchors_path=None):
    """The net0 string, with a static address when the manifest declares one.

    The address used to be the literal `ip=dhcp`. The bridge was configurable
    and the address was not, so EVERY container this tool created came up on
    DHCP and any static had to be set by hand afterward -- which is why ct111,
    ct112 and ct113 are all `ip=dhcp` today while ct100-110, which predate the
    tool, hold statics. It is also why two of them appear in no zone file:
    nobody did the hand step. golden-tiny.yaml already recorded this as a
    known gap, in a `not_expressible:` block.

    That matters more than it looks. pve/network-172.16-migration.md assigns
    fourteen static addresses, and a provisioner that cannot express one turns
    every single assignment into a manual step -- the exact shape that
    produced the config drift this repo spent 2026-09-08 removing.

    `address` is a CIDR, because pve wants one. A bare address silently
    produces a container with no usable netmask, so it is refused here rather
    than accepted and puzzled over later.
    """
    net = f"name=eth0,bridge={spec.get('bridge', 'vmbr0')}"
    addr = spec.get("address")
    gw = spec.get("gateway")
    # Declared so it survives destroy-and-recreate. A container's MAC is
    # generated by pve at create time, so a DHCP reservation keyed on it breaks
    # silently on a rebuild -- declaring it makes the MAC durable by
    # declaration rather than by accident. Only anchors need this.
    hwaddr = spec.get("hwaddr")

    if (addr or hwaddr) and anchors_path is not None:
        _anchor_ok(spec, anchors_path)

    if hwaddr:
        net += f",hwaddr={hwaddr}"

    if not addr:
        if gw:
            sys.exit("hee-pve-deploy: 'gateway' set without 'address' -- a gateway "
                     "means nothing on a DHCP interface, and DHCP supplies its own.")
        return net + ",ip=dhcp"

    if "/" not in str(addr):
        sys.exit(f"hee-pve-deploy: address '{addr}' has no prefix length. pve needs "
                 f"CIDR -- write '{addr}/24', not '{addr}'. A bare address yields an "
                 f"interface with no usable netmask.")
    net += f",ip={addr}"
    if gw:
        net += f",gw={gw}"
    return net


def main():
    def require(key):
        """Fail loudly rather than invent a storage name.

        This used to default to 'local-lvm'. That storage stopped existing
        when this fleet migrated to ZFS on 2026-09-02, and a wrong default is
        worse than none: pvesh would either fail with a message about a
        storage the manifest never mentioned, or -- if a storage by that name
        did exist -- silently put the container somewhere nobody chose.

        Every manifest in fleet-ops/pve/services/ sets this explicitly, so
        requiring it costs nothing and removes a way to be quietly wrong.
        """
        v = spec.get(key)
        if v in (None, ""):
            sys.exit(f"hee-pve-deploy: manifest is missing required key '{key}'.\n"
                     f"  Storage is not guessed -- name it, e.g. `storage: ssd1`.\n"
                     f"  List what exists: ssh root@{args.host} pvesm status")
        return v

    # description=__doc__: the tool's --help IS its man page (rule 17), and
    # until 2026-09-10 this parser carried no description at all, so the
    # published page documented four flags and not one manifest key.
    ap = argparse.ArgumentParser(
        prog="hee-pve-deploy", description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("manifest", help="pve/services/<name>.yaml -- see the manifest format above")
    ap.add_argument("--node", default="pve")
    ap.add_argument("--host", default="10.0.0.153")
    ap.add_argument("--dry-run", action="store_true",
                    help="resolve the manifest and print every command that would run "
                         "-- create, add-ons, files, provision -- creating and changing "
                         "nothing. Without it the deploy is applied.")
    ap.add_argument("--anchors",
                    default=os.path.expanduser(
                        "~/git/fleet-ops/hee/registries/network-anchors.registry.v1.yaml"),
                    help="registry of roles whose address may be pinned. A manifest that "
                         "declares address or hwaddr must name a role listed there; "
                         "anything else has its address allocated.")
    ap.add_argument("--addons", default=DEFAULT_ADDONS,
                    help="the org's container-addons registry, the only place an "
                         "'addons:' name resolves. Unreadable means every add-on is "
                         "refused, never silently skipped.")
    ap.add_argument("--agent-roster", default=DEFAULT_AGENT_ROSTER,
                    help="the org's signed agent roster, the only place a model is named. "
                         "Read only by 'generate: agent-roster-model' files entries; it must be "
                         "ratified and its .asc must verify, or nothing is rendered.")
    # Contextual help BEFORE argparse parses anything. argparse owns -h and
    # --help but not the bare `help` verb, and resolves either only after
    # parsing -- so an unrelated argument errors first and the help never
    # prints. Measured: 8 tools exited non-zero for --help for exactly this
    # reason. See library/py/hee_cli.
    if help_wanted(sys.argv[1:]):
        note_ignored(sys.argv[1:])
        ap.print_help()
        return 0

    args = ap.parse_args()

    with open(args.manifest, encoding="utf-8") as fh:
        spec = yaml.safe_load(fh)
    hostname = spec["hostname"]

    # Resolve everything the manifest ships BEFORE touching the node. A
    # manifest whose files or scripts are missing fails here, with nothing
    # created, rather than after `pvesh create` has left a container that
    # is half of what was declared.
    root = _manifest_root(args.manifest)
    files = plan_files(spec, root, args.agent_roster)
    resolver_files = plan_resolver(spec)
    scripts = plan_provision(spec, root)
    addons = spec.get("addons", []) or []
    # Add-on names resolve at plan time too. They used to be checked only
    # inside apply_addons, AFTER `pvesh create`, so a misspelled set left a
    # running container holding nothing but its resolver files.
    plan_addons(addons, args.addons)

    existing = existing_hostnames(args.host, args.node)
    if hostname in existing:
        print(f"hee-pve-deploy: '{hostname}' already exists (vmid {existing[hostname]}) -- skipping, idempotent.")
        print("hee-pve-deploy: nothing was applied. A container an earlier run left half-provisioned is NOT "
              "repaired by re-running: destroy it and deploy again, or run its provision script by hand.")
        return

    template_storage = spec.get("template_storage", "local")
    ensure_template(args.host, template_storage, spec["template"])

    vmid = pvesh(args.host, ["get", "/cluster/nextid"]).strip()

    create_args = [
        "create", f"/nodes/{args.node}/lxc",
        "-vmid", vmid,
        "-hostname", hostname,
        "-ostemplate", f"{template_storage}:vztmpl/{spec['template']}",
        "-cores", str(spec.get("cores", 1)),
        "-memory", str(spec.get("memory_mb", 256)),
        "-rootfs", f"{require('storage')}:{spec.get('disk_gb', 4)}",
        "-net0", _net0(spec, args.anchors),
        "-unprivileged", "1" if spec.get("unprivileged", True) else "0",
        "-start", "1",
    ]

    if args.dry_run:
        print(f"hee-pve-deploy: DRY RUN, would run: pvesh {' '.join(create_args)}")
    else:
        print(f"hee-pve-deploy: creating '{hostname}' as vmid {vmid}...")
        pvesh(args.host, create_args, capture=False)
        print(f"hee-pve-deploy: '{hostname}' created and starting (vmid {vmid}).")
        if addons or files or scripts or resolver_files:
            # `-start 1` returns when the container is started, not when
            # its network is up. apk and every provision script need a
            # route out, and a DHCP-leased container can take a few seconds
            # to hold one -- so the first apk of the first agent container
            # would otherwise race the lease and fail on DNS.
            _wait_for_network(args.host, vmid)

    # Resolver first: every step after it -- apk, git clone, provision --
    # resolves through what the manifest declared, not through whatever pve
    # or DHCP wrote at start.
    apply_files(args.host, vmid, resolver_files, args.dry_run)
    apply_addons(args.host, vmid, addons, args.dry_run, args.addons)
    apply_files(args.host, vmid, files, args.dry_run)
    apply_provision(args.host, vmid, scripts, args.dry_run)

    if args.dry_run:
        print("hee-pve-deploy: DRY RUN complete -- nothing was created or changed.")


# ---------------------------------------------------------------------------
# Add-ons.
#
# The golden template is deliberately bare -- 12.8MB, ca-certificates and
# tzdata -- because a linked clone costs 0 bytes until it diverges, so
# anything baked into the template is the one cost a clone cannot avoid.
# Everything else is named here instead, per manifest.
#
# Sets are resolved from the org's container-addons registry (--addons,
# which defaults to fleet-ops's copy exactly as --anchors does) rather than
# written inline. A manifest saying `addons: [agent-tooling]` is reviewable;
# a manifest carrying its own apk list is the same ad hoc shell history the
# registry exists to replace, just committed.
#
# The registry lived in this repo until 2026-09-10. It names real
# containers (the one that proved each set) and the org's real runtime
# choices, which is fleet state, not doctrine -- operator: "should be in
# fleet-ops". This tool stays generic; the registry is the org's.
# ---------------------------------------------------------------------------

DEFAULT_ADDONS = os.path.expanduser(
    "~/git/fleet-ops/hee/registries/container-addons.registry.v1.yaml")


def load_addon_registry(path):
    """FAILS CLOSED: a registry that cannot be read refuses every add-on
    rather than installing nothing and reporting success."""
    if not os.path.isfile(path):
        sys.exit(f"hee-pve-deploy: add-on registry not found at {path}.\n"
                 f"  Point --addons at the org's container-addons registry, or drop "
                 f"'addons:' from the manifest. Could-not-read is not 'no add-ons'.")
    with open(path, encoding="utf-8") as fh:
        doc = yaml.safe_load(fh) or {}
    addons = ((doc.get("spec") or {}).get("addons") or {})
    if not addons:
        sys.exit(f"hee-pve-deploy: {path} declares no spec.addons -- refusing.")
    return addons


def plan_addons(wanted, registry_path=DEFAULT_ADDONS):
    """The registry, with every wanted set name confirmed in it. No sets, no
    registry read. Refuses unknown names -- at plan time, before anything is
    created."""
    if not wanted:
        return {}
    registry = load_addon_registry(registry_path)
    unknown = [a for a in wanted if a not in registry]
    if unknown:
        sys.exit(
            f"hee-pve-deploy: unknown add-on set(s): {', '.join(unknown)}\n"
            f"  Known: {', '.join(sorted(registry))}\n"
            f"  Add a set to the registry with the container that proved it\n"
            f"  needed -- evidence_before_entry -- rather than inlining\n"
            f"  packages here."
        )
    return registry


def apply_addons(host, vmid, wanted, dry_run, registry_path=DEFAULT_ADDONS):
    if not wanted:
        return
    registry = plan_addons(wanted, registry_path)
    for name in wanted:
        entry = registry[name]
        if entry.get("blocked_by"):
            print(f"hee-pve-deploy: WARNING add-on '{name}' is incomplete -- "
                  f"{' '.join(entry['blocked_by'].split())}")
        pkgs = entry.get("packages", [])
        if not pkgs:
            continue
        # Alpine. A set for another base would need its own installer; this
        # says so rather than silently running apk on a Debian container.
        cmd = _pct(vmid, ["sh", "-c", "apk add --no-cache " + " ".join(pkgs)])
        if dry_run:
            # Quoted exactly as it is sent: the unquoted preview pasted as
            # `sh -c apk` with the package names as positional parameters.
            print(f"hee-pve-deploy: DRY RUN, would run: {' '.join(shlex.quote(c) for c in cmd)}")
            continue
        print(f"hee-pve-deploy: applying add-on '{name}': {' '.join(pkgs)}")
        r = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", f"root@{host}",
             " ".join(shlex.quote(c) for c in cmd)],
            capture_output=True, text=True)
        if r.returncode != 0:
            sys.exit(f"hee-pve-deploy: add-on '{name}' failed:\n{r.stderr}")
        print(f"hee-pve-deploy: add-on '{name}' applied.")


# ---------------------------------------------------------------------------
# Files and provisioning.
#
# An add-on installs packages and nothing else -- the registry's own
# invariant says a set "never edits config, never starts a service.
# Anything that changes how a host behaves belongs in that host's own
# manifest where it is reviewable." This is that place. `files:` pushes
# committed files into the container; `provision:` runs committed POSIX sh
# scripts inside it. Both resolve against the manifest's repo root, so the
# thing that runs is the thing that was reviewed.
#
# One hop, no temp file on the node: ssh carries the bytes to the node on
# stdin and `pct exec` carries them on into the container. The same shape
# as the snmp-joe README's `ssh pve 'pct exec 113 -- sh -c "cat > ..."'`,
# which is the precedent this replaces, made declarative.
# ---------------------------------------------------------------------------

def _manifest_root(manifest):
    """The repo root the manifest lives in, so `files:` and `provision:`
    resolve against what is committed beside it -- never against whatever
    directory the tool happens to be invoked from."""
    d = os.path.dirname(os.path.abspath(manifest))
    r = subprocess.run(["git", "-C", d, "rev-parse", "--show-toplevel"],
                       capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else d


def _under(root, rel, what):
    """Resolve a manifest-relative path. Refuses absolute paths, paths that
    escape the root, and paths that do not exist -- a manifest names what
    it ships, and could-not-find is not permission to ship nothing."""
    rel = str(rel)
    if os.path.isabs(rel) or rel.startswith("~"):
        sys.exit(f"hee-pve-deploy: {what} '{rel}' must be relative to the manifest's "
                 f"repo root ({root}), not absolute.")
    real_root = os.path.realpath(root)
    p = os.path.realpath(os.path.join(real_root, rel))
    if not p.startswith(real_root + os.sep):
        sys.exit(f"hee-pve-deploy: {what} '{rel}' escapes the manifest's repo root {root}.")
    if not os.path.isfile(p):
        sys.exit(f"hee-pve-deploy: {what} '{rel}' not found under {root}.")
    return p


# ---- generated files -------------------------------------------------------
# See the docstring: a `files:` entry with `generate:` is rendered here at
# deploy time from a source of truth, never copied from a committed file that
# restates it. Every check fails closed, and fails at PLAN time -- before
# `pvesh create` -- like a missing `src`.

DEFAULT_AGENT_ROSTER = os.path.expanduser(
    "~/git/fleet-ops/hee/registries/agent-roster.registry.v1.yaml")


def _agent_roster_signature_ok(path, doc):
    """The agent roster's detached signature must verify, and the signing key must
    be one its own ratification_evidence names. A locally edited, unsigned
    agent roster would otherwise deploy a model nobody ratified. `status: ratified`
    alone is a string anyone can type."""
    asc = path + ".asc"
    if not os.path.isfile(asc):
        sys.exit(f"hee-pve-deploy: {asc} not found -- an unsigned agent roster names no model "
                 f"a container may run.")
    try:
        v = subprocess.run(["gpg", "--batch", "--status-fd", "1", "--verify", asc, path],
                           capture_output=True, text=True)
    except FileNotFoundError:
        sys.exit("hee-pve-deploy: gpg not found -- the agent roster's signature cannot be "
                 "checked, so no model is rendered.")
    fprs = set()
    for line in v.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 3 and parts[:2] == ["[GNUPG:]", "VALIDSIG"]:
            fprs.add(parts[2])           # the signing key
            fprs.add(parts[-1])          # the primary key, when gpg reports it
    if v.returncode != 0 or not fprs:
        sys.exit(f"hee-pve-deploy: the agent roster's signature does not verify ({asc}):\n"
                 f"{v.stderr.strip()}")
    evidence = str((doc.get("spec") or {}).get("ratification_evidence") or "").replace(" ", "")
    if not any(f in evidence for f in fprs):
        sys.exit(f"hee-pve-deploy: the agent roster verifies, but with {sorted(fprs)[0]}, a key its "
                 f"ratification_evidence does not name -- refusing.")


def load_agent_roster(path):
    if not os.path.isfile(path):
        sys.exit(f"hee-pve-deploy: agent roster not found at {path}.\n"
                 f"  Point --agent-roster at the org's signed agent roster. Could-not-read is "
                 f"not 'no model'.")
    with open(path, encoding="utf-8") as fh:
        doc = yaml.safe_load(fh) or {}
    status = (doc.get("spec") or {}).get("status")
    if status != "ratified":
        sys.exit(f"hee-pve-deploy: {path} is status '{status}', not ratified -- an "
                 f"unratified agent roster names no model a container may run.")
    _agent_roster_signature_ok(path, doc)
    return doc


def render_agent_roster_model(spec, agent_roster_path):
    """Claude Code managed settings pinning this manifest's agent to its
    agent roster model. Three keys, because each alone can be got around:
    `model` is overridden by a --model flag or ANTHROPIC_MODEL;
    `availableModels` + `enforceAvailableModels` refuse any other model;
    env ANTHROPIC_MODEL sets it for every session. Rendered as a drop-in
    (managed-settings.d/), which Claude Code merges over managed-settings.json,
    so the shared base file carries nothing per-agent.

    Precedence: file-based managed settings apply only while Claude Code
    selects the file source. Under its default first-wins rule, server-managed
    settings from a claude.ai organization login are ranked higher and replace
    them -- `model` and `availableModels` included -- without a warning."""
    agent = spec.get("agent")
    if not agent:
        sys.exit("hee-pve-deploy: 'generate: agent-roster-model' needs the manifest's 'agent:' "
                 "key -- the agent roster role whose model this container runs.")
    doc = load_agent_roster(agent_roster_path)
    agents = (doc.get("spec") or {}).get("agents") or {}
    entry = agents.get(agent)
    if not isinstance(entry, dict):
        sys.exit(f"hee-pve-deploy: agent '{agent}' is not in the agent roster ({agent_roster_path}). "
                 f"Known: {', '.join(sorted(agents)) or '(none)'}.")
    model = entry.get("model")
    if not isinstance(model, str) or not model.strip():
        sys.exit(f"hee-pve-deploy: agent roster agent '{agent}' names no model -- refusing to "
                 f"render a pin for nothing.")
    settings = {
        "model": model,
        "availableModels": [model],
        "enforceAvailableModels": True,
        "env": {"ANTHROPIC_MODEL": model},
    }
    return (json.dumps(settings, indent=2) + "\n").encode()


GENERATORS = {"agent-roster-model": render_agent_roster_model}


# ---- resolver ---------------------------------------------------------------
# See the docstring. Rendered at plan time, like every other file, so a bad
# resolver block fails before `pvesh create`.

_RESOLVER_KEYS = {"nameservers", "search", "ndots"}
_DOMAIN = re.compile(r"^(?=.{1,253}$)[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
                     r"(?:\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)+$")


def plan_resolver(spec):
    """Files entries that make the manifest's `resolver:` the container's
    /etc/resolv.conf and keep it there. No block, no entries."""
    r = spec.get("resolver")
    if r is None:
        return []
    if not isinstance(r, dict):
        sys.exit("hee-pve-deploy: 'resolver' must be a mapping of nameservers, search, ndots.")
    unknown = set(r) - _RESOLVER_KEYS
    if unknown:
        sys.exit(f"hee-pve-deploy: resolver has unknown key(s) {sorted(unknown)} -- "
                 f"known: {sorted(_RESOLVER_KEYS)}. resolv.conf options beyond ndots are "
                 f"not rendered, so they are refused rather than dropped.")
    ns = r.get("nameservers")
    if not isinstance(ns, list) or not 1 <= len(ns) <= 3:
        sys.exit("hee-pve-deploy: resolver.nameservers must list 1 to 3 addresses -- "
                 "the resolver reads no more than three.")
    for a in ns:
        try:
            ipaddress.IPv4Address(str(a))
        except ValueError:
            sys.exit(f"hee-pve-deploy: resolver nameserver '{a}' is not an IPv4 address.")
    search = r.get("search") or []
    if not isinstance(search, list) or len(search) > 6:
        sys.exit("hee-pve-deploy: resolver.search must be a list of at most 6 domains.")
    for d in search:
        if not isinstance(d, str) or not _DOMAIN.match(d):
            sys.exit(f"hee-pve-deploy: resolver search domain '{d}' is not a domain name.")
    ndots = r.get("ndots", 1)
    if isinstance(ndots, bool) or not isinstance(ndots, int) or not 1 <= ndots <= 15:
        sys.exit(f"hee-pve-deploy: resolver.ndots '{ndots}' must be an integer from 1 to 15.")

    lines = ["# Rendered by hee-pve-deploy from the manifest's resolver: block.",
             "# Edit the manifest, not this file; pve and DHCP no longer rewrite it."]
    if search:
        lines.append("search " + " ".join(search))
    lines += [f"nameserver {a}" for a in ns]
    lines.append(f"options ndots:{ndots}")
    resolv = ("\n".join(lines) + "\n").encode()

    out = [{"rel": "resolver: pve skips resolv.conf", "src": None, "dst": "/etc/.pve-ignore.resolv.conf",
            "mode": "0644",
            "data": b"# hee-pve-deploy: /etc/resolv.conf comes from the manifest's resolver: block.\n"}]
    if not spec.get("address"):
        out.append({"rel": "resolver: udhcpc leaves resolv.conf alone", "src": None,
                    "dst": "/etc/udhcpc/udhcpc.conf", "mode": "0644",
                    "data": (b"# hee-pve-deploy: /etc/resolv.conf comes from the manifest's resolver: block,\n"
                             b"# not from DHCP. See the manifest.\n"
                             b"RESOLV_CONF=\"no\"\n")})
    out.append({"rel": "resolver: /etc/resolv.conf", "src": None, "dst": "/etc/resolv.conf",
                "mode": "0644", "data": resolv})
    return out


def plan_files(spec, root, agent_roster_path=DEFAULT_AGENT_ROSTER):
    """`files:` entries, resolved and validated. Each is {src|generate, dst[, mode]}:
    src relative to the manifest's repo root, or generate naming a renderer
    in GENERATORS; dst absolute inside the container; mode octal (chmod'd
    after the write; omitted = leave the container's default)."""
    out = []
    for i, f in enumerate(spec.get("files") or []):
        if not isinstance(f, dict) or "dst" not in f or (("src" in f) == ("generate" in f)):
            sys.exit(f"hee-pve-deploy: files[{i}] must be a mapping with 'dst' and exactly "
                     f"one of 'src' or 'generate'.")
        dst = str(f["dst"])
        if not dst.startswith("/"):
            sys.exit(f"hee-pve-deploy: files[{i}] dst '{dst}' must be an absolute path "
                     f"inside the container.")
        mode = f.get("mode")
        if mode is not None and not re.fullmatch(r"0?[0-7]{3,4}", str(mode)):
            sys.exit(f"hee-pve-deploy: files[{i}] mode '{mode}' is not octal -- write it "
                     f"quoted, e.g. mode: \"0644\".")
        mode = str(mode) if mode is not None else None
        if "generate" in f:
            gen = GENERATORS.get(f["generate"])
            if gen is None:
                sys.exit(f"hee-pve-deploy: files[{i}] generate '{f['generate']}' is not a "
                         f"known generator ({', '.join(sorted(GENERATORS))}).")
            out.append({"rel": f"generated {f['generate']} for agent '{spec.get('agent')}'",
                        "src": None, "data": gen(spec, agent_roster_path), "dst": dst, "mode": mode})
        else:
            out.append({"rel": str(f["src"]), "src": _under(root, f["src"], f"files[{i}].src"),
                        "data": None, "dst": dst, "mode": mode})
    return out


def plan_provision(spec, root):
    """`provision:` entries, resolved and validated: committed scripts, run in
    order inside the container as `sh -s` with the script on stdin. POSIX
    sh, because the golden template is Alpine and bash is an add-on."""
    out = []
    for i, p in enumerate(spec.get("provision") or []):
        if not isinstance(p, str):
            sys.exit(f"hee-pve-deploy: provision[{i}] must be a path, got {p!r}.")
        out.append({"rel": p, "path": _under(root, p, f"provision[{i}]")})
    return out


# Every command this tool runs inside a container gets this PATH. `pct exec`
# runs lxc-attach with PVE's own CLI PATH, /sbin:/bin:/usr/sbin:/usr/bin
# (PVE/CLIHandler.pm), which has no /usr/local/bin -- so a provision script
# that links a tool there and then calls it exits 127 with the container
# already created. Measured 2026-09-10 on ct113. This is the PATH Alpine and
# Debian give a login shell.
CONTAINER_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def _pct(vmid, argv):
    """argv for `pct exec VMID -- ARGV`, with CONTAINER_PATH set."""
    return ["pct", "exec", str(vmid), "--", "env", f"PATH={CONTAINER_PATH}", *argv]


def _pct_exec_stdin(host, vmid, argv, data, what, capture=True):
    """Run ARGV inside the container with DATA on its stdin. Fails loudly
    with the container's own stderr; never interprets silence."""
    cmd = _pct(vmid, argv)
    r = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", f"root@{host}",
         " ".join(shlex.quote(c) for c in cmd)],
        input=data, capture_output=capture)
    if r.returncode != 0:
        err = (r.stderr or b"").decode("utf-8", "replace") if capture else ""
        sys.exit(f"hee-pve-deploy: {what} failed (exit {r.returncode}).\n{err}".rstrip())
    return r.stdout


def _wait_for_network(host, vmid, timeout=60):
    """Block until eth0 inside the container holds an IPv4 address, or fail.
    A container that never gets one is reported, not worked around."""
    deadline = time.monotonic() + timeout
    probe = ["sh", "-c", "ip -4 -o addr show dev eth0 2>/dev/null | grep -q ' inet '"]
    while True:
        r = subprocess.run(
            ["ssh", "-o", "BatchMode=yes", f"root@{host}",
             " ".join(shlex.quote(c) for c in _pct(vmid, probe))],
            capture_output=True)
        if r.returncode == 0:
            return
        if time.monotonic() > deadline:
            sys.exit(f"hee-pve-deploy: vmid {vmid} has no IPv4 address on eth0 after "
                     f"{timeout}s -- not applying add-ons, files or provisioning to a "
                     f"container with no network. Check the bridge, DHCP on it, and "
                     f"`pct exec {vmid} -- ip addr`.")
        time.sleep(2)


def apply_files(host, vmid, files, dry_run):
    for f in files:
        parent = os.path.dirname(f["dst"]) or "/"
        sh = f"mkdir -p {shlex.quote(parent)} && cat > {shlex.quote(f['dst'])}"
        if f["mode"]:
            sh += f" && chmod {f['mode']} {shlex.quote(f['dst'])}"
        label = f"{f['rel']} -> {f['dst']}" + (f" (mode {f['mode']})" if f["mode"] else "")
        if dry_run:
            print(f"hee-pve-deploy: DRY RUN, would push {label} via: "
                  f"pct exec {vmid} -- env PATH={CONTAINER_PATH} sh -c {shlex.quote(sh)}")
            if f["data"] is not None:
                print(textwrap.indent(f["data"].decode(), "    "), end="")
            continue
        print(f"hee-pve-deploy: pushing {label}")
        if f["data"] is not None:
            data = f["data"]
        else:
            with open(f["src"], "rb") as fh:
                data = fh.read()
        _pct_exec_stdin(host, vmid, ["sh", "-c", sh], data, f"files: {f['rel']}")


def apply_provision(host, vmid, scripts, dry_run):
    for s in scripts:
        if dry_run:
            print(f"hee-pve-deploy: DRY RUN, would run {s['rel']} via: "
                  f"pct exec {vmid} -- env PATH={CONTAINER_PATH} sh -s < {s['rel']}")
            continue
        print(f"hee-pve-deploy: provisioning with {s['rel']} ...")
        with open(s["path"], "rb") as fh:
            # Not captured: a provision script's own output is the evidence
            # of what it did, and it belongs in the operator's terminal
            # as it happens, not summarized afterwards.
            _pct_exec_stdin(host, vmid, ["sh", "-s"], fh.read(),
                            f"provision: {s['rel']}", capture=False)
        print(f"hee-pve-deploy: {s['rel']} finished.")


if __name__ == "__main__":
    main()
