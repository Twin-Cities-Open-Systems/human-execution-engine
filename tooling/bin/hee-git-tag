#!/usr/bin/env python3
# section: 1
"""hee-git-tag -- a GPG-signed git tag with the key that is really yours

SYNOPSIS
  hee git tag NAME -m MESSAGE [COMMIT] [--key ID] [--push] [--yes]
  hee git tag --show-key
  hee git tag help

DESCRIPTION
  Creates an annotated, GPG-signed tag (`git tag -s`) and, with --push,
  pushes exactly that ref. The point of the tool is the key choice: plain
  `git tag -s` asks gpg for a key whose uid matches user.email, and in this
  org user.email is the shared dev@tcos.us from the dotfiles gitconfig --
  no secret key carries that uid, so the first prod promote ended with
  "gpg: skipped Spencer Butler <dev@tcos.us>: No secret key" (2026-09-06).

  Dry run by default: prints the key, the tag, the commit and the message
  and changes nothing. --yes creates the tag; --push pushes it.

KEY SELECTION
  1. --key ID, if given (any form gpg accepts).
  2. Otherwise the secret keys in the caller's own keyring that can sign,
     are not expired or revoked, and carry ultimate trust (the keys this
     person generated here, as opposed to imported ones).
  3. If more than one remains, the one whose uid email host is this
     machine per the SOA anchor (~/.hee/index/_.yaml `host:`), e.g.
     spencer@kiosk.lab.tcos.us on kiosk.lab.tcos.us.
  4. Still more than one, or none: CRITICAL with the candidates listed --
     say --key. Never a guess.

  Nothing is read from gitconfig. The chosen key id is printed on every
  run so the record says which key signed.

EXIT STATUS
  0 OK, 2 CRITICAL (no key, ambiguous key, git or gpg failed), 3 UNKNOWN
  (gpg missing, not a git repo).

FILES
  ~/.hee/index/_.yaml    SOA anchor; only `host:` is read, for the tie-break

EXAMPLES
  hee git tag prod/tcos-www/20260906T0806Z -m "prod promotion: tcos.us" e7beec0 --yes --push
  hee git tag --show-key

SEE ALSO
  hee-git-merge(1), hee-ver(1), hee-contract-review(1)
"""
from __future__ import annotations

import argparse
import pathlib
import re
import subprocess
import sys
import time

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored  # noqa: E402
OK, CRITICAL, UNKNOWN = 0, 2, 3


def say(level: str, msg: str) -> None:
    icon = {"OK": "🟢 OK", "WARNING": "🟡 WARNING", "CRITICAL": "🔴 CRITICAL", "UNKNOWN": "⚪ UNKNOWN"}[level]
    print(f"{icon} hee-git-tag: {msg}", file=sys.stderr if level != "OK" else sys.stdout)


def anchor_host() -> str:
    p = pathlib.Path.home() / ".hee" / "index" / "_.yaml"
    try:
        m = re.search(r'^\s*host:\s*"?([^"\n]+)"?\s*$', p.read_text(), re.M)
        return m.group(1).strip() if m else ""
    except OSError:
        return ""


def parse_secret_keys(listing: str) -> list[dict]:
    """gpg --list-secret-keys --with-colons -> [{id, trust, caps, expires, uids}]"""
    keys: list[dict] = []
    cur: dict | None = None
    for line in listing.splitlines():
        f = line.split(":")
        if f[0] == "sec":
            cur = {"id": f[4], "trust": f[1], "caps": f[11], "expires": int(f[6]) if f[6] else 0, "uids": []}
            keys.append(cur)
        elif f[0] == "uid" and cur is not None:
            cur["uids"].append(f[9])
    return keys


def select_key(listing: str, host: str, explicit: str | None) -> tuple[str | None, str, list[dict]]:
    """-> (key id or None, reason, candidates)"""
    if explicit:
        return explicit, "--key given", []
    now = int(time.time())
    keys = parse_secret_keys(listing)
    usable = [k for k in keys if "s" in k["caps"].lower() and k["trust"] not in ("r", "e")
              and (k["expires"] == 0 or k["expires"] > now)]
    ultimate = [k for k in usable if k["trust"] == "u"]
    pool = ultimate or usable
    if len(pool) == 1:
        k = pool[0]
        return k["id"], f"the one {'ultimate-trust ' if ultimate else ''}signing key in this keyring ({k['uids'][0] if k['uids'] else '?'})", pool
    if len(pool) > 1 and host:
        by_host = [k for k in pool if any(u.strip().endswith(f"@{host}>") for u in k["uids"])]
        if len(by_host) == 1:
            k = by_host[0]
            return k["id"], f"uid on this host per the SOA anchor ({host}): {k['uids'][0]}", pool
    return None, "no single key: " + ("none usable" if not pool else "; ".join(f"{k['id']} {k['uids'][0] if k['uids'] else ''}" for k in pool)), pool


def sh(*args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(args, capture_output=True, text=True, check=check)


def main(argv: list[str]) -> int:
    if help_wanted(argv):
        note_ignored(argv)       # the CLI contract: say when arguments after the help token are ignored
        print(__doc__.strip()); return OK
    ap = argparse.ArgumentParser(prog="hee git tag", add_help=False)
    ap.add_argument("name", nargs="?")
    ap.add_argument("commit", nargs="?", default="HEAD")
    ap.add_argument("-m", "--message")
    ap.add_argument("--key")
    ap.add_argument("--push", action="store_true")
    ap.add_argument("--yes", action="store_true")
    ap.add_argument("--show-key", action="store_true")
    ap.add_argument("--remote", default="origin")
    a = ap.parse_intermixed_args(argv)  # NAME -m MSG COMMIT in any order

    try:
        listing = sh("gpg", "--list-secret-keys", "--with-colons").stdout
    except (OSError, subprocess.CalledProcessError) as e:
        say("UNKNOWN", f"gpg unavailable: {e}"); return UNKNOWN
    key, why, pool = select_key(listing, anchor_host(), a.key)
    if not key:
        say("CRITICAL", f"{why} -- pass --key ID"); return CRITICAL
    if a.show_key:
        print(key); say("OK", f"signing key {key}: {why}"); return OK

    if not a.name or not a.message:
        say("CRITICAL", "usage: hee git tag NAME -m MESSAGE [COMMIT] [--key ID] [--push] [--yes]"); return CRITICAL
    try:
        sha = sh("git", "rev-parse", "--verify", f"{a.commit}^{{commit}}").stdout.strip()
    except subprocess.CalledProcessError as e:
        say("CRITICAL", f"not a commit: {a.commit} ({e.stderr.strip()})"); return CRITICAL
    if sh("git", "tag", "-l", a.name).stdout.strip():
        say("CRITICAL", f"tag {a.name} already exists here -- tags are records, not overwritten"); return CRITICAL

    print(f"  tag:     {a.name}")
    print(f"  commit:  {sha[:12]}")
    print(f"  key:     {key}  ({why})")
    print(f"  message: {a.message.splitlines()[0]}" + (" ..." if len(a.message.splitlines()) > 1 else ""))
    if not a.yes:
        say("OK", f"dry run -- add --yes to create{' and --push to push' if not a.push else ' and push'}"); return OK

    r = subprocess.run(["git", "tag", "-s", "-u", key, a.name, "-m", a.message, sha], text=True)
    if r.returncode != 0:
        say("CRITICAL", f"git tag -s failed (exit {r.returncode}) with key {key}"); return CRITICAL
    if a.push:
        r = subprocess.run(["git", "push", a.remote, f"refs/tags/{a.name}"], capture_output=True, text=True)
        if r.returncode != 0:
            say("CRITICAL", f"tag {a.name} created but push to {a.remote} failed: {r.stderr.strip()[-200:]}"); return CRITICAL
    say("OK", f"{a.name} signed with {key} on {sha[:12]}" + (f", pushed to {a.remote}" if a.push else ", not pushed (--push)"))
    return OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
