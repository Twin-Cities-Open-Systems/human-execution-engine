#!/usr/bin/env python3
# section: 1
"""hee-dns -- generate BIND zones from one flat host file.

    hee-dns generate HOSTFILE [--out DIR]   write forward + reverse zones
    hee-dns check    HOSTFILE               parse and report, write nothing
    hee-dns help                            this page

WHY THIS EXISTS

lab.tcos.us had sixteen A records and zero PTR records. Not through
neglect -- through structure. BIND wants a forward zone and a separate
reverse zone, both maintained by hand, and the second one loses. Spencer,
2026-09-02: "make forward, make backward too (unless reason)".

So the rule is encoded in the source rather than remembered. The host file
is tinydns's format, whose first character says which directions a record
gets:

    =name:ip:ttl    A and PTR      -- a real machine
    +name:ip:ttl    A only         -- a vhost on a shared proxy
    ^rev:name:ttl   PTR only       -- an address in this network whose
                                      name lives in ANOTHER zone
    @zone::mx:dist:ttl             -- MX

"Unless reason" is the `+`. Eight names in this lab point at haproxy; an
address gets ONE PTR naming the machine, not every vhost it fronts.

`^` is tinydns's PTR-only record: `rev` is the full reverse name
(72.0.0.10.in-addr.arpa) and `name` the machine it answers with. It is for
a machine on this network that is named outside this zone -- an `=` there
would put an A record for it inside lab.tcos.us under the wrong name.
Spencer, 2026-09-16, of 10.0.0.72: "nuc-1.crooked.tcos.us (never lab)":

    ^72.0.0.10.in-addr.arpa:nuc-1.crooked.tcos.us:300

The format was chosen for a second reason: it is already djbdns-native. If
this lab ever swaps BIND for tinydns the source file is the input, not a
migration.

SERIAL NUMBERS are YYYYMMDDnn, bumped against whatever is already deployed
so a regeneration on the same day does not go backwards -- a stale serial
is silently ignored by secondaries, which is the classic way a zone update
"succeeds" and changes nothing.

SYNOPSIS
    hee-dns generate HOSTFILE --out DIR
    hee-dns check HOSTFILE
    hee-dns help | --help | -h

EXIT STATUS
    0   the host file parsed; zones written (generate) or reported (check)
    1   usage error -- unknown subcommand, or generate without --out
    2   the host file has a malformed record; nothing was written

    A duplicate-PTR warning does NOT change the exit status. It is a
    judgement call, not a parse error: two `=` records on one address is
    legal and occasionally deliberate.
"""
import ipaddress, os, sys, time
from pathlib import Path

# tooling/bin/hee-dns -> repo root -> library/py. THREE parents: two lands on
# tooling/library/py, which does not exist, and the ImportError fallback below
# then silently substitutes a no-op note_ignored -- so the "arguments were
# discarded" notice never prints and the help contract is quietly violated.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "library" / "py"))
try:
    from hee_cli import help_wanted, note_ignored
except ImportError:                                    # library not on path
    def help_wanted(a, **k): return any(x in ("help", "--help", "-h") for x in a)
    def note_ignored(a): pass


REV_SUFFIX = ".in-addr.arpa"


def rev_to_ip(rev):
    """72.0.0.10.in-addr.arpa -> 10.0.0.72, or raise ValueError."""
    if not rev.endswith(REV_SUFFIX):
        raise ValueError(f"{rev!r} is not an in-addr.arpa name")
    labels = rev[: -len(REV_SUFFIX)].split(".")
    if len(labels) != 4:
        raise ValueError(f"{rev!r} does not name one IPv4 address")
    return str(ipaddress.IPv4Address(".".join(reversed(labels))))


def parse(path):
    """-> hosts (=), vhosts (+), ptr_only (^, as (name, ip, ttl)), mx, errors."""
    hosts, vhosts, ptr_only, mx, errors = [], [], [], [], []
    for n, raw in enumerate(Path(path).read_text().splitlines(), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        kind, rest = line[0], line[1:]
        parts = rest.split(":")
        try:
            if kind in "=+":
                name, ip, ttl = parts[0], parts[1], (parts[2] if len(parts) > 2 else "300")
                ipaddress.IPv4Address(ip)
                (hosts if kind == "=" else vhosts).append((name, ip, ttl))
            elif kind == "^":
                rev, name, ttl = parts[0], parts[1], (parts[2] if len(parts) > 2 else "300")
                ip = rev_to_ip(rev)
                if not name or "." not in name:
                    raise ValueError(f"PTR target {name!r} is not a fully qualified name")
                ptr_only.append((name, ip, ttl))
            elif kind == "@":
                zone, _, target, dist, ttl = (parts + ["", "", "", "10", "300"])[:5]
                mx.append((zone, target, dist, ttl))
            else:
                errors.append(f"line {n}: unknown record type {kind!r}")
        except (IndexError, ValueError) as e:
            errors.append(f"line {n}: {e} -- {raw!r}")
    return hosts, vhosts, ptr_only, mx, errors


def check_ptr_collisions(hosts):
    """Two PTR sources (= or ^) on one IP means two PTRs, a config smell."""
    seen, dupes = {}, []
    for name, ip, _ in hosts:
        if ip in seen:
            dupes.append((ip, seen[ip], name))
        seen[ip] = name
    return dupes


def serial(existing=None):
    today = time.strftime("%Y%m%d")
    if existing and str(existing).startswith(today):
        return str(int(existing) + 1)
    return today + "01"


def forward_zone(zone, hosts, vhosts, mx, ser, ns):
    out = ["$TTL 300",
           f"@ IN SOA {ns}. hostmaster.{zone}. (",
           f"    {ser} ; serial",
           "    3600       ; refresh",
           "    900        ; retry",
           "    604800     ; expire",
           "    300 )      ; minimum",
           "",
           f"@       IN NS   {ns}.",
           "",
           "; -- generated by hee-dns from the host file. Do not hand-edit:",
           ";    regeneration overwrites this file, and the reverse zone is",
           ";    built from the same source so the two cannot drift.",
           ""]
    for name, ip, ttl in sorted(hosts + vhosts):
        label = "@" if name == zone else name[: -(len(zone) + 1)] if name.endswith("." + zone) else name
        out.append(f"{label}\t{ttl}\tIN A\t{ip}")
    for _, target, dist, ttl in mx:
        out.append(f"@\t{ttl}\tIN MX\t{dist} {target}.")
    return "\n".join(out) + "\n"


def reverse_zones(hosts, ser, ns, zone):
    """One reverse zone per /24 present. Only `=` and `^` records land here."""
    by_net = {}
    for name, ip, ttl in hosts:
        net = ".".join(ip.split(".")[:3])
        by_net.setdefault(net, []).append((int(ip.split(".")[3]), name, ttl))
    zones = {}
    for net, entries in by_net.items():
        rev = ".".join(reversed(net.split("."))) + ".in-addr.arpa"
        out = ["$TTL 300",
               f"@ IN SOA {ns}. hostmaster.{zone}. (",
               f"    {ser} ; serial",
               "    3600       ; refresh",
               "    900        ; retry",
               "    604800     ; expire",
               "    300 )      ; minimum",
               "",
               f"@       IN NS   {ns}.",
               "",
               "; -- generated by hee-dns. Only `=` and `^` records appear here;",
               ";    `+` vhosts are deliberately forward-only.",
               ""]
        for last, name, ttl in sorted(entries):
            out.append(f"{last}\t{ttl}\tIN PTR\t{name}.")
        zones[rev] = "\n".join(out) + "\n"
    return zones


def main():
    argv = sys.argv[1:]
    if help_wanted(argv) or not argv:
        print(__doc__.strip())
        note_ignored(argv)
        sys.exit(0)

    cmd = argv[0]
    if cmd not in ("generate", "check"):
        sys.exit(f"hee-dns: unknown subcommand {cmd!r}. Try: hee-dns help")
    if len(argv) < 2:
        sys.exit(f"hee-dns: {cmd} needs a host file")
    hostfile = argv[1]
    outdir = None
    if "--out" in argv:
        outdir = argv[argv.index("--out") + 1]

    hosts, vhosts, ptr_only, mx, errors = parse(hostfile)
    if errors:
        for e in errors:
            print(f"CRITICAL  {e}", file=sys.stderr)
        sys.exit(2)

    dupes = check_ptr_collisions(hosts + ptr_only)
    for ip, a, b in dupes:
        print(f"WARNING   {ip} has two PTR records ({a}, {b}) -- two PTRs for one "
              f"address. Make one of them '+' unless you mean it.", file=sys.stderr)

    zone = "lab.tcos.us"
    ns = f"ns1.{zone}"
    ser = serial()
    fwd = forward_zone(zone, hosts, vhosts, mx, ser, ns)
    revs = reverse_zones(hosts + ptr_only, ser, ns, zone)

    print(f"OK        {len(hosts)} host records (A + PTR), {len(vhosts)} vhosts "
          f"(A only), {len(ptr_only)} PTR-only, {len(mx)} MX, serial {ser}")
    for rev, body in revs.items():
        ptrs = sum(1 for line in body.splitlines() if "IN PTR" in line)
        print(f"OK        reverse zone {rev}: {ptrs} PTRs")

    if cmd == "check":
        return
    if not outdir:
        sys.exit("hee-dns: generate needs --out DIR")
    os.makedirs(outdir, exist_ok=True)
    Path(outdir, f"db.{zone}").write_text(fwd)
    print(f"OK        wrote {outdir}/db.{zone}")
    for rev, body in revs.items():
        Path(outdir, f"db.{rev}").write_text(body)
        print(f"OK        wrote {outdir}/db.{rev}")


if __name__ == "__main__":
    main()
