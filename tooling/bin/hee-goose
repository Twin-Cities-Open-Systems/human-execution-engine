#!/usr/bin/env python3
# section: 1
"""hee-goose -- honk.

Prints HONK in italics and a goose. That is all it does.

The goose is rendered with chafa, which uses the kitty graphics protocol
when the terminal supports it. Set HEE_GOOSE_IMAGE to render another image.

EXAMPLES
  hee goose
"""
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
IMAGE = os.environ.get("HEE_GOOSE_IMAGE", os.path.join(HERE, "..", "share", "hee-goose", "goose.png"))

if any(a in ("-h", "--help", "help") for a in sys.argv[1:]):
    print(__doc__)
    sys.exit(0)

print("\033[3mHONK\033[0m")
sys.exit(subprocess.run(["chafa", "--size=24x24", IMAGE]).returncode)
