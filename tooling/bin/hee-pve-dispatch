#!/usr/bin/env python3
# section: 8
# System administration -- runs work inside Proxmox containers. man-pages(7)
# puts commands that administer the system in 8.
"""hee-pve-dispatch -- hand one bounded job to one agent container and collect the result.

The first dispatch mechanism for the pve agent containers (fleet-ops#387):
until the GitHub App, the factory's per-job token and tick-task exist, this
is how work reaches an agent. Operator, 2026-09-10: "this jobs go to the new
agents", "do not run these on kiosk", "let's see if we can utilize hee cred
to provide the anthropic auth needed", "hee ticket and tick-task will be
merging soon".

What a dispatch is:
  1. AGENT names a role in the fleet allocation registry (ci-triage,
     docs-keeper, ...). The registry gives its hostname and says it is an
     agent; the live node gives its vmid. A non-agent container is refused.
  2. JOBDIR holds job.yaml, a prompt file, the inputs the job may read, and
     (after the run) results/. Everything the agent sees is in that
     directory, so a job is reviewable before it runs and reproducible after.
  3. The job's files are shipped INTO the container over pct exec (no repo
     credential in the container), claude runs there as the `agent` user in
     -p mode with a dollar budget and a wall-clock timeout, and the outputs
     come back the same way into JOBDIR/results/<job id>/.
  4. The Anthropic key never touches the container's disk or any command
     line. With --cred, this tool re-runs itself under `hee cred -pass`, so
     the key exists only in this process's environment and is written to the
     job's stdin, where the generated run.sh reads it into the environment of
     the one claude process. `hee cred -seal` is the only way a key gets into
     the store, and it accepts input only from a real terminal.
  5. A record of every dispatch is written to <repo>/.hee/dispatch/<job id>.yaml
     (the repo JOBDIR lives in): agent, vmid, ticket, cost, turns, exit.

job.yaml:
  name: convert-legacy-page           # short, becomes part of the job id
  prompt: prompt.md                   # file in JOBDIR; its text is the -p prompt
  inputs: [in/, rules.md]             # shipped; default: everything but results/
  outputs: [out/]                     # collected; default: out/
  agent: docs-keeper                  # optional: a dispatch that resolves to any other role is refused
  ticket: fleet-ops/0100              # optional: recorded when --ticket is not given
  blocked_by: [fleet-ops/0080]        # optional: while any is open a real dispatch refuses, a dry run warns
  budget_usd: 2.00                    # required -- claude --max-budget-usd; above 1.00 needs budget_reason
  budget_reason: "five doc pages to read and cite"   # required when budget_usd > 1.00
  timeout_s: 1800                     # default 1800 -- `timeout` around claude
  permission_mode: acceptEdits        # default; claude --permission-mode
  allowed_tools: [Read, Write, Edit, Glob, Grep]   # default; no Bash unless listed
  json_schema: schema.json            # optional; claude --json-schema
  system_prompt: system.md            # optional; claude --append-system-prompt-file

Usage:
  hee-pve-dispatch AGENT JOBDIR --cred ACCOUNT [--cred-dir DIR] [--ticket ID]
  hee-pve-dispatch AGENT JOBDIR --wif --cred ISSUER-KEY-ACCOUNT [--ticket ID]
  hee-pve-dispatch AGENT JOBDIR --collect JID [--ticket ID]     # a job whose dispatcher died: outputs, evidence, record
  hee-pve-dispatch AGENT JOBDIR --resume JID --budget USD --why TEXT   # a job that stopped at its ceiling: same session, same files

EXAMPLES
  $ hee pve dispatch ci-triage tests/fixtures/dispatch/job --dry-run --offline --allocations tests/fixtures/dispatch/allocations.yaml   # ci
  $ hee pve dispatch ci-triage tests/fixtures/dispatch/job --wif --dry-run --offline --allocations tests/fixtures/dispatch/allocations.yaml   # ci
  $ hee pve dispatch ci-triage pve/agents/jobs/wif-prep-readonly --wif --cred wif-issuer-lab --ticket 0090     # the real thing; needs the lab

  --wif: workload identity federation instead of a static key. --cred names
     the hee cred account holding the lab issuer's ES256 private key (made by
     `hee cred -seal ... -genkey es256`). This tool mints ONE JWT for the job
     (iss/sub/aud from the allocation registry's console: block, unique jti,
     exp = the job timeout + 2 min), ships it on stdin exactly as a key would
     be, and the generated run.sh exchanges it once at the Claude Console
     (POST /v1/oauth/token, jwt-bearer) for a short-lived token bound to the
     role's service account, then runs claude with ANTHROPIC_AUTH_TOKEN. No
     static API key exists anywhere for the agent. The registry entry needs
     console.organization_id, workspace_id, service_account_id,
     federation_rule_id, issuer and subject.
  hee-pve-dispatch AGENT JOBDIR --dry-run
"""
import argparse
import datetime as _dt
import hashlib
import io
import json
import os
import re
import shlex
import subprocess
import sys
import shutil
import tarfile
import time
import uuid

from pathlib import Path as _Path  # noqa: E402
sys.path.insert(0, str(_Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored  # noqa: E402

try:
    import yaml
except ImportError:
    sys.exit("Requires pyyaml: pip install pyyaml")

CONTAINER_PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
DEFAULT_ALLOCATIONS = os.path.expanduser(
    "~/git/fleet-ops/hee/registries/fleet-allocations.registry.v1.yaml")
DEFAULT_TOOLS = ["Read", "Write", "Edit", "Glob", "Grep"]
# A job that may Write may Edit: job one (2026-09-11) allowed Write without
# Edit and paid ~20% of its cost rewriting a 15 KB report six times after
# six Edit denials. Operator: "we need to nip that in the bud".
IMPLIED_TOOLS = {"Write": ["Edit"]}
JOBS_ROOT = "/home/agent/jobs"
# Appended to every prompt. Job one (wif-prep-readonly, 2026-09-11) opened its
# report by flagging out/auth.log -- the dispatcher's own exchange log -- as an
# unexplained anomaly, because nothing had told it what run.sh writes.
OUT_NOTE = ("\n\n## Files the dispatcher itself writes into out/ (not inputs, not yours to cite)\n"
            "out/auth.log (token exchange status), out/exit, out/result.json, out/stderr.log, out/stream.jsonl. "
            "Ignore them. Everything you produce goes under out/ beside them.\n")
# The agent is told its ceiling and to save work as it goes: a run that hits
# --max-budget-usd stops mid-turn, and anything not yet written is gone.
# Operator, 2026-09-11, after herbert's scrob-path-map hit $1.00: "must save
# the work and learn to bugdget better".
def budget_note(budget):
    return (f"\n## Your budget\nThis run stops, without warning, once it has spent ${budget:.2f}. Write each deliverable "
            "into out/ as soon as it is usable and improve it afterwards; finished work held back until the end is lost "
            "at the ceiling.\n")


RESUME_NOTE = ("You were stopped at your budget ceiling. Every file in this directory, out/ included, is exactly as you "
               "left it. Finish what prompt.md asks: first any deliverable that is missing or incomplete, then the rest. "
               "Do not redo finished work.\n")
KEY_ENV_DEFAULT = "HEE_CRED_PASS"
# Money discipline. Operator, 2026-09-11: "in=cheap, out=expensive. and we
# have 0 investors and the agents are not yet earning their keep." A job
# above the routine ceiling must say why; a day's spend has a lid.
ROUTINE_BUDGET_USD = 1.00       # above this, job.yaml needs budget_reason
DAILY_CAP_USD = float(os.environ.get("HEE_DISPATCH_DAILY_CAP_USD", "10.00"))


def emit(status, msg):
    icon = {"OK": "✅ OK", "WARNING": "⚠️  WARNING", "CRITICAL": "❌ CRITICAL", "UNKNOWN": "⚪ UNKNOWN"}[status]
    print(f"{icon} hee-pve-dispatch: {msg}")


def die(msg, code=2):
    emit("CRITICAL", msg)
    sys.exit(code)


# ---- workload identity federation --------------------------------------------

CONSOLE_KEYS = ("organization_id", "workspace_id", "service_account_id", "federation_rule_id", "issuer", "subject")
TOKEN_URL = "https://api.anthropic.com/v1/oauth/token"


def console_block(rec, role):
    c = rec.get("console") or {}
    missing = [k for k in CONSOLE_KEYS if not c.get(k)]
    if missing:
        die(f"{role}: allocation registry has no complete console: block for --wif (missing {', '.join(missing)})")
    return c


def _b64url(b):
    import base64
    return base64.urlsafe_b64encode(b).rstrip(b"=").decode()


def mint_jwt(pem, con, lifetime_s):
    """One ES256 JWT for one job. The private key arrives as PEM text (from
    hee cred -pass); the kid is the same sha256(point)[:16] hee cred printed
    in the JWKS, so the Console can match the key it was given."""
    try:
        from cryptography.hazmat.primitives import hashes, serialization
        from cryptography.hazmat.primitives.asymmetric import ec
        from cryptography.hazmat.primitives.asymmetric.utils import decode_dss_signature
    except ImportError:
        die("--wif needs python3-cryptography on the dispatcher")
    key = serialization.load_pem_private_key(pem.encode(), password=None)
    pub = key.public_key().public_numbers()
    raw = b"\x04" + pub.x.to_bytes(32, "big") + pub.y.to_bytes(32, "big")
    kid = hashlib.sha256(raw).hexdigest()[:16]
    now = int(time.time())
    header = {"alg": "ES256", "typ": "JWT", "kid": kid}
    claims = {"iss": con["issuer"], "sub": con["subject"], "aud": "https://api.anthropic.com",
              "iat": now, "nbf": now - 30, "exp": now + int(lifetime_s), "jti": str(uuid.uuid4())}
    signing_input = _b64url(json.dumps(header, separators=(",", ":")).encode()) + "." + \
        _b64url(json.dumps(claims, separators=(",", ":")).encode())
    der = key.sign(signing_input.encode(), ec.ECDSA(hashes.SHA256()))
    r, s_ = decode_dss_signature(der)
    sig = r.to_bytes(32, "big") + s_.to_bytes(32, "big")
    return signing_input + "." + _b64url(sig), claims


# ---- resolution -------------------------------------------------------------

def load_allocations(path):
    if not os.path.isfile(path):
        die(f"allocation registry not found at {path} -- point --allocations at "
            f"fleet-ops hee/registries/fleet-allocations.registry.v1.yaml")
    with open(path, encoding="utf-8") as fh:
        doc = yaml.safe_load(fh) or {}
    return ((doc.get("spec") or {}).get("allocations") or {})


def resolve_agent(agent, allocations):
    """(role, hostname, registry vmid). AGENT may be a role or a hostname.
    Only kind: agent may receive a dispatch."""
    for role, rec in allocations.items():
        if not isinstance(rec, dict):
            continue
        if agent in (role, rec.get("hostname")):
            if rec.get("kind") != "agent":
                die(f"'{agent}' is {rec.get('kind', 'unknown')} in the allocation registry, "
                    f"not an agent -- refusing to dispatch to it")
            return role, rec.get("hostname"), rec.get("vmid")
    die(f"'{agent}' is not in the allocation registry ({', '.join(sorted(allocations))})")


def ssh(host, remote, data=None, timeout=None):
    return subprocess.run(["ssh", "-o", "BatchMode=yes", f"root@{host}", remote],
                          input=data, capture_output=True, timeout=timeout)


def pct(vmid, argv):
    return " ".join(shlex.quote(c) for c in
                    ["pct", "exec", str(vmid), "--", "env", f"PATH={CONTAINER_PATH}", *argv])


def live_vmid(host, hostname):
    r = ssh(host, "pct list")
    if r.returncode != 0:
        die(f"pct list on {host} failed:\n{r.stderr.decode('utf-8', 'replace')}")
    for line in r.stdout.decode("utf-8", "replace").splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 3 and parts[-1] == hostname:
            return int(parts[0]), parts[1]
    return None, None


# ---- the job ----------------------------------------------------------------

def plan_job(jobdir):
    jobdir = os.path.abspath(jobdir)
    spec_path = os.path.join(jobdir, "job.yaml")
    if not os.path.isfile(spec_path):
        die(f"{spec_path} not found")
    with open(spec_path, encoding="utf-8") as fh:
        spec = yaml.safe_load(fh) or {}
    name = str(spec.get("name") or "").strip()
    if not re.fullmatch(r"[a-z0-9][a-z0-9-]{0,40}", name):
        die("job.yaml: name must be lowercase letters, digits and hyphens (it becomes the job id)")
    prompt = spec.get("prompt") or "prompt.md"
    if not os.path.isfile(os.path.join(jobdir, prompt)):
        die(f"job.yaml: prompt file '{prompt}' not found in {jobdir}")
    try:
        budget = float(spec["budget_usd"])
    except (KeyError, TypeError, ValueError):
        die("job.yaml: budget_usd is required (a number of US dollars) -- a job without a "
            "ceiling is not a job")
    if not 0 < budget <= 50:
        die(f"job.yaml: budget_usd {budget} is outside 0 < budget <= 50")
    if budget > ROUTINE_BUDGET_USD and not str(spec.get("budget_reason") or "").strip():
        die(f"job.yaml: budget_usd {budget} is above the routine ceiling ${ROUTINE_BUDGET_USD:.2f} -- add budget_reason: "
            f"saying what the extra buys (output tokens are the expensive kind; a shorter deliverable is usually the answer)")
    timeout_s = int(spec.get("timeout_s", 1800))
    if not 30 <= timeout_s <= 6 * 3600:
        die("job.yaml: timeout_s must be between 30 and 21600")
    tools = list(spec.get("allowed_tools") or DEFAULT_TOOLS)
    if isinstance(tools, list):
        for t, implied in IMPLIED_TOOLS.items():
            if t in tools:
                tools += [i for i in implied if i not in tools]
    if not isinstance(tools, list) or not all(re.fullmatch(r"[A-Za-z][A-Za-z0-9_()*:./ -]*", str(t)) for t in tools):
        die("job.yaml: allowed_tools must be a list of tool names")
    mode = str(spec.get("permission_mode") or "acceptEdits")
    if mode not in ("default", "acceptEdits", "plan"):
        die(f"job.yaml: permission_mode '{mode}' -- use default, acceptEdits or plan; "
            f"bypassPermissions is refused here on purpose")
    inputs = spec.get("inputs")
    if inputs is None:
        inputs = sorted(e for e in os.listdir(jobdir) if e != "results")
    if not isinstance(inputs, list) or not inputs:
        die("job.yaml: inputs must be a non-empty list")
    for i in inputs:
        p = os.path.join(jobdir, str(i))
        if os.path.isabs(str(i)) or ".." in str(i).split("/") or not os.path.exists(p):
            die(f"job.yaml: input '{i}' must be a relative path inside {jobdir}, and exist")
    outputs = spec.get("outputs") or ["out"]
    for o in outputs:
        if os.path.isabs(str(o)) or ".." in str(o).split("/"):
            die(f"job.yaml: output '{o}' must be a relative path")
    for key in ("json_schema", "system_prompt"):
        v = spec.get(key)
        if v and not os.path.isfile(os.path.join(jobdir, str(v))):
            die(f"job.yaml: {key} file '{v}' not found")
    blocked_by = spec.get("blocked_by") or []
    if not isinstance(blocked_by, list) or not all(isinstance(b, str) and b.strip() for b in blocked_by):
        die("job.yaml: blocked_by must be a list of ticket keys, repo/id -- e.g. [fleet-ops/0080]")
    return {
        "agent": spec.get("agent"), "ticket": str(spec["ticket"]) if spec.get("ticket") else None,
        "blocked_by": [b.strip() for b in blocked_by],
        "dir": jobdir, "name": name, "prompt": prompt, "budget_usd": budget,
        "timeout_s": timeout_s, "tools": [str(t) for t in tools], "mode": mode,
        "inputs": [str(i) for i in inputs], "outputs": [str(o).rstrip("/") for o in outputs],
        "json_schema": spec.get("json_schema"), "system_prompt": spec.get("system_prompt"),
    }


def open_blockers(job):
    """The ticket keys in job.yaml's blocked_by that are not closed. A key no
    repo under the workspace has counts as open: a blocker nobody can find has
    not been cleared. Operator, 2026-09-11: jobs go "through the agent roster,
    correctly per our dogfood plans" -- eight jobs sat committed for a day
    while the scope amendment they needed was unsigned, with nothing saying so."""
    if not job.get("blocked_by"):
        return []
    tool = str(_Path(__file__).resolve().parent / "hee-ticket")
    ws = os.environ.get("HEE_TICKET_WORKSPACE", os.path.expanduser("~/git"))
    r = subprocess.run([sys.executable, tool, "-json", "--workspace", ws], capture_output=True, text=True)
    try:
        tickets = {t["key"]: t for t in json.loads(r.stdout)["tickets"]}
    except (ValueError, KeyError):
        return [f"{k} (tickets unreadable: hee-ticket -json exit {r.returncode})" for k in job["blocked_by"]]
    out = []
    for k in job["blocked_by"]:
        t = tickets.get(k)
        if t is None:
            out.append(f"{k} (no such ticket under {ws})")
        elif t.get("status") != "closed":
            out.append(f"{k} ({t.get('stage')}: {str(t.get('description', ''))[:80]})")
    return out


def _dir_root(path):
    """The nearest directory holding .git, walking up from PATH -- no git
    subprocess, so a dry run still makes exactly one call (pct list)."""
    p = os.path.abspath(path)
    while p != os.path.dirname(p):
        if os.path.exists(os.path.join(p, ".git")):
            return p
        p = os.path.dirname(p)
    return os.path.abspath(path)


def load_resume(args, job):
    """What a --resume needs: the stopped job's record (session id, name) and
    this continuation's number. A resume is a new record that points at the
    job it continues; the container directory and the Claude session are the
    original's."""
    if args.budget is None or not (0 < args.budget <= 50):
        die("--resume needs --budget USD (0 < budget <= 50): the new ceiling for this continuation")
    if not str(args.why or "").strip():
        die("--resume needs --why TEXT: what the extra money buys -- a continuation is a spend decision, not a retry")
    root = _dir_root(job["dir"])
    rec_path = os.path.join(root, ".hee", "dispatch", f"{args.resume}.yaml")
    if not os.path.isfile(rec_path):
        die(f"no dispatch record {os.path.relpath(rec_path, root)} -- --resume takes the job id of a recorded run")
    with open(rec_path) as fh:
        rec = yaml.safe_load(fh) or {}
    if rec.get("name") != job["name"]:
        die(f"record {args.resume} is job {rec.get('name')!r}, not {job['name']!r}")
    if not rec.get("session_id"):
        die(f"record {args.resume} has no session_id -- there is no Claude session to continue")
    of = rec.get("resumes") or args.resume   # resuming a resume continues the original directory
    import glob
    n = 1 + sum(1 for f in glob.glob(os.path.join(root, ".hee", "dispatch", f"{of}-r*.yaml")))
    if rec.get("subtype") != "error_max_budget_usd":
        emit("WARNING", f"record {args.resume} ended {rec.get('subtype')!r}, not at its budget ceiling -- resuming anyway")
    return {"of": of, "jid": f"{of}-r{n}", "n": n, "session_id": rec["session_id"]}


def role_history(root, role):
    """This role's recorded spend, for sizing the next ceiling from evidence."""
    import glob
    costs, hits = [], 0
    for f in glob.glob(os.path.join(os.fsdecode(root), ".hee", "dispatch", "*.yaml")):
        try:
            with open(f) as fh:
                d = yaml.safe_load(fh) or {}
        except Exception:  # noqa: BLE001 -- a bad record must not block a dispatch
            continue
        if d.get("agent") != role or d.get("cost_usd") is None:
            continue
        costs.append(float(d["cost_usd"]))
        hits += 1 if (d.get("budget_hit") or d.get("subtype") == "error_max_budget_usd") else 0
    if not costs:
        return None
    costs.sort()
    return {"runs": len(costs), "min": costs[0], "max": costs[-1], "median": costs[len(costs) // 2], "hits": hits}


def job_id(job, when=None):
    when = when or _dt.datetime.now(_dt.timezone.utc)
    return f"{job['name']}-{when.strftime('%Y%m%dT%H%M%SZ')}"


def render_run_sh(job, jid, wif=None, resume=None):
    """The script that runs INSIDE the container. It reads the credential
    from its stdin into the environment, drops to the agent user with that
    environment preserved (busybox su -p), and runs one bounded claude -p.
    Nothing secret is ever on a command line or in a file. With wif, what
    arrives on stdin is the job's JWT; run.sh exchanges it once for a
    short-lived token (python3 stdlib -- the containers have no jq) and hands
    claude ANTHROPIC_AUTH_TOKEN, with ANTHROPIC_API_KEY guaranteed unset."""
    remote = f"{JOBS_ROOT}/{jid}"
    if resume:
        # the same session, in the same directory: claude keeps the transcript under
        # ~/.claude/projects/<cwd>, so the directory must be the original job's
        claude = ["claude", "-p", '"$(printf %s ' + shlex.quote(RESUME_NOTE + budget_note(job["budget_usd"])) + ')"',
                  "--resume", shlex.quote(resume["session_id"]),
                  "--output-format", "stream-json", "--verbose",
                  "--max-budget-usd", f"{job['budget_usd']:.2f}",
                  "--permission-mode", job["mode"]]
    else:
        claude = ["claude", "-p", '"$(cat ' + shlex.quote(job["prompt"]) + '; printf %s ' + shlex.quote(OUT_NOTE + budget_note(job["budget_usd"])) + ')"',
                  "--output-format", "stream-json", "--verbose",
                  "--max-budget-usd", f"{job['budget_usd']:.2f}",
                  "--permission-mode", job["mode"]]
    if job.get("system_prompt"):
        claude += ["--append-system-prompt-file", shlex.quote(job["system_prompt"])]
    if job.get("json_schema"):
        claude += ["--json-schema", '"$(cat ' + shlex.quote(job["json_schema"]) + ')"']
    claude += ["--allowedTools", *[shlex.quote(t) for t in job["tools"]]]
    # No `exec` here: it would replace this shell, and the grep that turns the
    # stream into result.json would never run. Measured on the first
    # stream-json job (review-resume-85, 2026-09-11): claude exited 0, exit
    # file written, no result.json. claude's own status is what run.sh reports.
    inner = (f"cd {shlex.quote(remote)} && timeout {job['timeout_s']} "
             + " ".join(claude) + " > out/stream.jsonl 2> out/stderr.log; rc=$?; "
             + "grep '\"type\":\"result\"' out/stream.jsonl | tail -n 1 > out/result.json; exit $rc")
    lines = [
        "#!/bin/sh",
        f"# generated by hee-pve-dispatch for job {jid} -- the record is the results dir on the dispatcher",
        "set -eu",
    ]
    if wif:
        exchange = json.dumps({"grant_type": "urn:ietf:params:oauth:grant-type:jwt-bearer",
                               "federation_rule_id": wif["federation_rule_id"], "organization_id": wif["organization_id"],
                               "service_account_id": wif["service_account_id"], "workspace_id": wif["workspace_id"]})
        py = ("import json,os,sys,urllib.request,urllib.error\n"
              "b=json.loads(os.environ['HEE_WIF_BODY']); b['assertion']=os.environ['HEE_WIF_JWT']\n"
              f"req=urllib.request.Request({TOKEN_URL!r},data=json.dumps(b).encode(),headers={{'content-type':'application/json'}})\n"
              "try:\n"
              "    d=json.load(urllib.request.urlopen(req,timeout=30)); sys.stdout.write(d['access_token'])\n"
              "    sys.stderr.write('exchange ok: expires_in=%s\\n'%d.get('expires_in'))\n"
              "except urllib.error.HTTPError as e:\n"
              "    sys.stderr.write('exchange failed: %s %s\\n'%(e.code,e.read()[:300].decode('utf-8','replace'))); sys.exit(3)\n")
        lines += [
            'IFS= read -r HEE_WIF_JWT || { echo "dispatch: no JWT on stdin" >&2; exit 2; }',
            '[ -n "$HEE_WIF_JWT" ] || { echo "dispatch: empty JWT on stdin" >&2; exit 2; }',
            "unset ANTHROPIC_API_KEY",
            f"export HEE_WIF_JWT HEE_WIF_BODY={shlex.quote(exchange)}",
            f"cd {shlex.quote(remote)} && mkdir -p out",
            f"ANTHROPIC_AUTH_TOKEN=$(python3 -c {shlex.quote(py)} 2>>out/auth.log) || {{ echo \"dispatch: token exchange failed (see out/auth.log)\" >&2; echo 3 > out/exit; exit 0; }}",
            "unset HEE_WIF_JWT HEE_WIF_BODY",
            '[ -n "$ANTHROPIC_AUTH_TOKEN" ] || { echo "dispatch: empty token from exchange" >&2; echo 3 > out/exit; exit 0; }',
            "export ANTHROPIC_AUTH_TOKEN",
        ]
    else:
        lines += [
            'IFS= read -r ANTHROPIC_API_KEY || { echo "dispatch: no key on stdin" >&2; exit 2; }',
            '[ -n "$ANTHROPIC_API_KEY" ] || { echo "dispatch: empty key on stdin" >&2; exit 2; }',
            "export ANTHROPIC_API_KEY",
        ]
    lines += [
        "export HOME=/home/agent",
        "export USE_BUILTIN_RIPGREP=0",
        f"cd {shlex.quote(remote)}",
        "mkdir -p out",
    ] + ([f"mkdir -p out/before-r{resume['n']}",
          f"for f in stream.jsonl result.json exit stderr.log; do [ ! -e out/$f ] || mv out/$f out/before-r{resume['n']}/$f; done"]
         if resume else []) + [
        f"chown -R agent:agent {shlex.quote(remote)}",
        "rc=0",
        f"su -p agent -c {shlex.quote(inner)} || rc=$?",
        "unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN",
        'echo "$rc" > out/exit',
        'echo "dispatch: claude exited $rc"',
        "exit 0",
    ]
    return "\n".join(lines) + "\n"


def spent_today(root, window=None):
    """Sum of cost_usd over this repo's dispatch records started today, where
    today is hee_day's window for the ledger (glossary: Day) -- a calendar day
    in the ledger's zone, not the UTC date. The records are the ledger; there
    is no second one."""
    import glob
    from hee_day import day_window, in_day
    root = os.fsdecode(root)   # repo_root_of hands back git's bytes
    window = window or day_window(root)
    total = 0.0
    for f in glob.glob(os.path.join(root, ".hee", "dispatch", "*.yaml")):
        try:
            with open(f) as fh:
                d = yaml.safe_load(fh) or {}
        except Exception:  # noqa: BLE001 -- a bad record must not block the ledger
            continue
        if in_day(d.get("started_at"), window):
            total += float(d.get("cost_usd") or 0)
    return total


def collect_only(args, job, role, hostname, vmid, wif, allocations):
    """The back half of a dispatch on its own: pull out/ from the container,
    keep the evidence, write the record. Refuses while claude is still
    running there, so a half-written result is never recorded."""
    jid = args.collect
    remote = f"{JOBS_ROOT}/{jid}"
    r = ssh(args.host, pct(vmid, ["sh", "-c", f"test -d {shlex.quote(remote)} && (pgrep -f '^claude -p' >/dev/null && echo running || echo done)"]), timeout=60)
    state = r.stdout.decode("utf-8", "replace").strip()
    if r.returncode != 0 or state not in ("running", "done"):
        die(f"{hostname}:{remote} is not there")
    if state == "running":
        die(f"claude is still running in {hostname} -- collect again when it has exited (hee view --job {jid})", code=1)
    results_dir = os.path.join(job["dir"], "results", jid)
    r = ssh(args.host, pct(vmid, ["tar", "-C", remote, "-cf", "-", *job["outputs"]]), timeout=300)
    if r.returncode != 0:
        die(f"collecting outputs failed:\n{r.stderr.decode('utf-8', 'replace')}")
    extract_results(r.stdout, results_dir)
    emit("OK", f"outputs collected into {results_dir}")
    if not ensure_result_json(results_dir):
        emit("WARNING", "no result.json and no result event in stream.jsonl -- the record will carry exit only")
    auth_log = os.path.join(results_dir, "out", "auth.log")
    if wif is None and os.path.isfile(auth_log) and open(auth_log, encoding="utf-8", errors="replace").read().startswith("exchange ok"):
        # the job ran federated (run.sh logged the token exchange); --wif was
        # not repeated on the collect, so take the console block from the registry
        wif = console_block(allocations[role], role)
    res = read_result(results_dir)
    src = os.path.join(results_dir, "out", "result.json")
    evidence = None
    started = _dt.datetime.strptime(jid.rsplit("-", 1)[-1], "%Y%m%dT%H%M%SZ").replace(tzinfo=_dt.timezone.utc)
    if os.path.isfile(src) and os.path.getsize(src) > 0:
        ev_dir = os.path.join(job["dir"], "evidence"); os.makedirs(ev_dir, exist_ok=True)
        evidence = os.path.join(ev_dir, f"result.json-{int(started.timestamp())}"); shutil.copyfile(src, evidence)
    root = repo_root_of(job["dir"]) or job["dir"]
    rec_dir = os.path.join(root, ".hee", "dispatch"); os.makedirs(rec_dir, exist_ok=True)
    record = {
        "job": jid, "name": job["name"], "agent": role, "hostname": hostname, "vmid": vmid,
        "ticket": args.ticket or job.get("ticket"), "cred": args.cred, "auth": "wif" if wif else "key",
        "federation_rule_id": wif["federation_rule_id"] if wif else None, "jwt_jti": None,
        "started_at": started.isoformat(timespec="seconds"), "ended_at": _dt.datetime.now(_dt.timezone.utc).isoformat(timespec="seconds"),
        "collected_late": True,
        "budget_usd": job["budget_usd"], "timeout_s": job["timeout_s"], "tools": job["tools"], "mode": job["mode"],
        "prompt_sha256": hashlib.sha256(open(os.path.join(job["dir"], job["prompt"]), "rb").read()).hexdigest(),
        "run_sh_sha256": None,
        "exit": res["exit"], "cost_usd": res["cost_usd"], "num_turns": res["num_turns"],
        "models": res["models"], "session_id": res["session_id"], "is_error": res["is_error"],
        "subtype": res["subtype"], "usage": res["usage"], "duration_ms": res["duration_ms"], "duration_api_ms": res["duration_api_ms"],
        "permission_denials": res["permission_denials"], "denied_tools": res["denied_tools"], "model_usage": res["model_usage"],
        "review": {"accepted": None, "corrections": None, "mistakes": [], "merged_pr": None, "reviewer": None, "method": None},
        "results_dir": os.path.relpath(results_dir, root),
        "evidence": os.path.relpath(evidence, root) if evidence else None,
        "remote_dir": f"{hostname}:{remote}",
    }
    with open(os.path.join(rec_dir, f"{jid}.yaml"), "w", encoding="utf-8") as fh:
        yaml.safe_dump(record, fh, sort_keys=False)
    status = "OK" if res["exit"] == 0 and not res["is_error"] and not res.get("permission_denials") else "WARNING"
    emit(status, f"job {jid} collected late: exit {res['exit']}, cost ${res['cost_usd']}, turns {res['num_turns']}, record .hee/dispatch/{jid}.yaml")
    return 0 if status == "OK" else 1


def make_tar(job, run_sh):
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w") as tar:
        for rel in sorted(set(job["inputs"]) | {"job.yaml", job["prompt"]}
                          | {x for x in (job.get("json_schema"), job.get("system_prompt")) if x}):
            tar.add(os.path.join(job["dir"], rel), arcname=rel)
        info = tarfile.TarInfo("run.sh")
        data = run_sh.encode()
        info.size = len(data); info.mode = 0o755; info.mtime = int(time.time())
        tar.addfile(info, io.BytesIO(data))
    return buf.getvalue()


def extract_results(tar_bytes, dest):
    os.makedirs(dest, exist_ok=True)
    with tarfile.open(fileobj=io.BytesIO(tar_bytes), mode="r") as tar:
        members = [m for m in tar.getmembers()
                   if not os.path.isabs(m.name) and ".." not in m.name.split("/")]
        try:
            tar.extractall(dest, members=members, filter="data")
        except TypeError:  # python < 3.12
            tar.extractall(dest, members=members)


def ensure_result_json(results_dir):
    """out/result.json is the last "type":"result" line of out/stream.jsonl.
    run.sh writes it; when it did not (older run.sh, or a container that lost
    its parent), derive it here so the record and the evidence are the same
    object either way. Returns True when result.json exists afterwards."""
    out = os.path.join(results_dir, "out")
    p = os.path.join(out, "result.json")
    if os.path.isfile(p) and os.path.getsize(p) > 0:
        return True
    stream = os.path.join(out, "stream.jsonl")
    if not os.path.isfile(stream):
        return False
    last = None
    with open(stream, "rb") as fh:
        for line in fh:
            if b'"type":"result"' in line:
                try:
                    if json.loads(line).get("type") == "result":
                        last = line
                except ValueError:
                    continue
    if last is None:
        return False
    with open(p, "wb") as fh:
        fh.write(last if last.endswith(b"\n") else last + b"\n")
    return True


def read_result(results_dir):
    p = os.path.join(results_dir, "out", "result.json")
    exit_p = os.path.join(results_dir, "out", "exit")
    out = {"exit": None, "cost_usd": None, "num_turns": None, "session_id": None,
           "is_error": None, "result": None, "models": None, "usage": None, "duration_ms": None,
           "duration_api_ms": None, "subtype": None, "permission_denials": None, "denied_tools": None, "model_usage": None}
    if os.path.isfile(exit_p):
        try:
            out["exit"] = int(open(exit_p).read().strip())
        except ValueError:
            pass
    if os.path.isfile(p):
        try:
            with open(p, encoding="utf-8") as fh:
                doc = json.load(fh)
            if isinstance(doc, list):
                doc = next((d for d in doc if d.get("type") == "result"), doc[-1] if doc else {})
            out["cost_usd"] = doc.get("total_cost_usd", doc.get("cost_usd"))
            u = doc.get("usage") or {}
            out["usage"] = {k: u.get(k) for k in ("input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens")}
            out["duration_ms"] = doc.get("duration_ms"); out["duration_api_ms"] = doc.get("duration_api_ms"); out["subtype"] = doc.get("subtype")
            den = doc.get("permission_denials") or []
            out["permission_denials"] = len(den); out["denied_tools"] = sorted({x.get("tool_name") for x in den if x.get("tool_name")})
            out["model_usage"] = {m: {"cost_usd": v.get("costUSD"), "input": v.get("inputTokens"), "output": v.get("outputTokens")}
                                  for m, v in (doc.get("modelUsage") or {}).items()}
            out["num_turns"] = doc.get("num_turns")
            out["session_id"] = doc.get("session_id")
            out["is_error"] = doc.get("is_error")
            out["result"] = doc.get("result") if isinstance(doc.get("result"), str) else None
            mu = doc.get("modelUsage")
            out["models"] = sorted(mu) if isinstance(mu, dict) else None
        except (ValueError, OSError) as e:
            out["result"] = f"(result.json unreadable: {e})"
    return out


def repo_root_of(path):
    r = subprocess.run(["git", "-C", path, "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else None


# ---- main -------------------------------------------------------------------

def main():
    ap = argparse.ArgumentParser(prog="hee-pve-dispatch", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("agent", help="a role (ci-triage) or hostname from the allocation registry; must be kind: agent")
    ap.add_argument("jobdir", help="directory holding job.yaml, the prompt and the inputs")
    ap.add_argument("--cred", metavar="ACCOUNT",
                    help="hee cred account holding the agent's Anthropic API key; this tool re-runs "
                         "itself under `hee cred -pass ACCOUNT` so the key is never printed or on argv")
    ap.add_argument("--cred-dir", metavar="DIR", help="passed to hee cred -dir (default: its own default)")
    ap.add_argument("--key-env", metavar="VAR",
                    help=f"read the key from this environment variable instead of --cred (what the "
                         f"--cred re-exec uses: {KEY_ENV_DEFAULT}). Never pass a key on the command line.")
    ap.add_argument("--wif", action="store_true",
                    help="federate instead of a static key: --cred is the lab issuer's signing key; the registry's "
                         "console: block for the role supplies rule, org, service account, workspace, issuer, subject")
    ap.add_argument("--ticket", metavar="ID", help="the hee ticket this dispatch works on; recorded, not enforced")
    ap.add_argument("--offline", action="store_true",
                    help="with --dry-run: do not ask the pve node for the container; take the registry's vmid (fixtures, CI)")
    ap.add_argument("--collect", metavar="JID",
                    help="collect a job that already ran (or is still running) in the container -- outputs, evidence, record -- "
                         "without shipping or running anything. For a dispatcher that died mid-job (kiosk killed one on low memory, 2026-09-11).")
    ap.add_argument("--resume", metavar="JID",
                    help="continue a job that stopped (its budget ceiling, usually) in the same container directory and the same "
                         "Claude session, instead of starting over; needs --budget and --why. Recorded as a new record that resumes JID.")
    ap.add_argument("--budget", type=float, metavar="USD", help="with --resume: the new ceiling for this continuation")
    ap.add_argument("--why", metavar="TEXT", help="with --resume: what the extra money buys (recorded as resume_reason)")
    ap.add_argument("--dry-run", action="store_true",
                    help="resolve the agent, validate the job, print run.sh and the file list; ship and run nothing")
    ap.add_argument("--host", default="10.0.0.153")
    ap.add_argument("--allocations", default=DEFAULT_ALLOCATIONS)
    if help_wanted(sys.argv[1:]):
        note_ignored(sys.argv[1:])
        ap.print_help()
        return 0
    args = ap.parse_args()

    # Re-exec under hee cred: the key arrives in this process's environment and
    # nowhere else. Done before anything else so a bad --cred fails fast.
    if args.cred and not args.key_env and not args.dry_run:
        hee_cred = str(_Path(__file__).resolve().parent / "hee-cred")
        argv = [hee_cred, "-pass", args.cred] + (["-dir", args.cred_dir] if args.cred_dir else []) \
            + ["-exec", sys.executable, os.path.abspath(__file__)] \
            + [a for a in sys.argv[1:] if a not in ("--cred", args.cred)
               and not (a == "--cred-dir" or a == args.cred_dir)] \
            + ["--key-env", KEY_ENV_DEFAULT]
        os.execv(hee_cred, argv)

    job = plan_job(args.jobdir)
    allocations = load_allocations(args.allocations)
    role, hostname, reg_vmid = resolve_agent(args.agent, allocations)
    if job.get("agent") and job["agent"] not in (role, hostname):
        die(f"job.yaml names agent {job['agent']}; this dispatch resolves to {role} ({hostname}) -- fix one of them")
    blockers = open_blockers(job)
    if blockers:
        why = "open blocker(s): " + "; ".join(blockers)
        if args.dry_run or args.collect:
            emit("WARNING", why + " -- a real dispatch refuses")
        else:
            die(why + " -- a blocked job does not ship; clear the ticket (hee ticket -close --why) first")
    wif = console_block(allocations[role], role) if args.wif else None
    if args.offline:
        if not args.dry_run:
            die("--offline only makes sense with --dry-run")
        vmid, state = reg_vmid, "running"
    else:
        vmid, state = live_vmid(args.host, hostname)
    if vmid is None:
        die(f"{hostname} ({role}) is not on the node -- deploy it first (hee pve deploy)")
    if state != "running":
        die(f"{hostname} is {state}, not running")
    if reg_vmid not in (None, vmid):
        die(f"registry says {role} is vmid {reg_vmid}, the node says {vmid} -- fix the registry first")
    if args.collect:
        return collect_only(args, job, role, hostname, vmid, wif, allocations)
    resume = load_resume(args, job) if args.resume else None
    if resume:
        job["budget_usd"] = args.budget
    history = role_history(_dir_root(job["dir"]), role)
    if history:
        emit("WARNING" if history["median"] > job["budget_usd"] else "OK",
             f"{role} so far: {history['runs']} run(s), ${history['min']:.2f}-${history['max']:.2f} (median ${history['median']:.2f}), "
             f"{history['hits']} stopped at the ceiling; this ceiling ${job['budget_usd']:.2f}"
             + (" is below the role's median spend" if history["median"] > job["budget_usd"] else ""))
    jid = resume["jid"] if resume else job_id(job)
    remote_jid = resume["of"] if resume else jid
    run_sh = render_run_sh(job, remote_jid, wif, resume=resume)
    emit("OK", f"agent {role} -> {hostname} vmid {vmid}; job {jid}; budget ${job['budget_usd']:.2f}, "
               f"timeout {job['timeout_s']}s, tools {' '.join(job['tools'])}, mode {job['mode']}")

    if args.dry_run:
        print("--- files shipped:")
        for rel in sorted(set(job["inputs"]) | {"job.yaml", job["prompt"]}):
            print(f"    {rel}")
        print("--- run.sh (runs inside the container; the " + ("JWT" if wif else "key") + " is read from stdin, never shown):")
        print("".join("    " + l + "\n" for l in run_sh.splitlines()), end="")
        emit("OK", "DRY RUN complete -- nothing shipped, nothing run")
        return 0

    key = os.environ.get(args.key_env or "", "") if args.key_env else ""
    if not key:
        die("no key: pass --cred ACCOUNT (the only supported path) -- a dispatch without a "
            "credential cannot run, and this tool will not take a key on the command line")

    from hee_day import day_window
    try:
        window = day_window(repo_root_of(job["dir"]) or job["dir"])
    except ValueError as e:
        die(str(e))
    spent = spent_today(repo_root_of(job["dir"]) or job["dir"], window)
    if spent + job["budget_usd"] > DAILY_CAP_USD:
        die(f"dispatch spend for {window['label']} is ${spent:.2f}; this job's ${job['budget_usd']:.2f} ceiling would pass the daily cap "
            f"${DAILY_CAP_USD:.2f} (HEE_DISPATCH_DAILY_CAP_USD). Not dispatching.")

    jwt_claims = None
    if wif:
        key, jwt_claims = mint_jwt(key, wif, job["timeout_s"] + 120)   # from here on, `key` is the one-job JWT
        emit("OK", f"minted the job's JWT for {wif['subject']} (jti {jwt_claims['jti'][:8]}..., exp +{job['timeout_s'] + 120}s)")

    remote = f"{JOBS_ROOT}/{remote_jid}"
    run_name = f"run-r{resume['n']}.sh" if resume else "run.sh"
    if resume:
        r = ssh(args.host, pct(vmid, ["sh", "-c", f"test -d {shlex.quote(remote)} && ! pgrep -f '^claude -p' >/dev/null && "
                                     f"cat > {shlex.quote(remote + '/' + run_name)} && chown agent:agent {shlex.quote(remote + '/' + run_name)}"]),
                data=run_sh.encode(), timeout=60)
        if r.returncode != 0:
            die(f"{hostname}:{remote} is gone or claude is still running there -- nothing to resume "
                f"({r.stderr.decode('utf-8', 'replace').strip()[:200]})")
        emit("OK", f"resuming {remote_jid} in {hostname}:{remote} with {run_name}, session {resume['session_id'][:8]}...")
    else:
        tar_bytes = make_tar(job, run_sh)
        r = ssh(args.host, pct(vmid, ["sh", "-c",
                f"mkdir -p {shlex.quote(remote)} && tar -C {shlex.quote(remote)} -xf - && chown -R agent:agent {shlex.quote(remote)}"]),
                data=tar_bytes, timeout=120)
        if r.returncode != 0:
            die(f"shipping the job failed:\n{r.stderr.decode('utf-8', 'replace')}")
        emit("OK", f"shipped {len(tar_bytes)} bytes to {hostname}:{remote}")

    started = _dt.datetime.now(_dt.timezone.utc)
    emit("OK", f"running claude as agent in {hostname} (up to {job['timeout_s']}s) ...")
    try:
        r = ssh(args.host, pct(vmid, ["sh", f"{remote}/{run_name}"]),
                data=(key + "\n").encode(), timeout=job["timeout_s"] + 120)
    except subprocess.TimeoutExpired:
        die(f"the dispatch did not return within {job['timeout_s'] + 120}s; the container may still be "
            f"running it -- inspect {hostname}:{remote}/out", code=1)
    del key
    ended = _dt.datetime.now(_dt.timezone.utc)
    tail = r.stdout.decode("utf-8", "replace").strip().splitlines()[-1:] or [""]
    emit("OK" if r.returncode == 0 else "WARNING", f"run.sh finished: {tail[0]}")

    results_dir = os.path.join(job["dir"], "results", jid)
    r = ssh(args.host, pct(vmid, ["tar", "-C", remote, "-cf", "-", *job["outputs"]]), timeout=300)
    if r.returncode != 0:
        emit("WARNING", f"collecting outputs failed:\n{r.stderr.decode('utf-8', 'replace')}")
    else:
        extract_results(r.stdout, results_dir)
        emit("OK", f"outputs collected into {results_dir}")
    ensure_result_json(results_dir)
    res = read_result(results_dir)
    # Evidence, committed: results/ is gitignored (raw, large), but the one
    # object that says what happened -- claude's result.json -- is copied
    # beside the job as evidence/result.json-<epoch>. Operator, 2026-09-11:
    # "we save those result.json in evidence with a ts, date +%s".
    src = os.path.join(results_dir, "out", "result.json")
    evidence = None
    if os.path.isfile(src) and os.path.getsize(src) > 0:
        ev_dir = os.path.join(job["dir"], "evidence")
        os.makedirs(ev_dir, exist_ok=True)
        evidence = os.path.join(ev_dir, f"result.json-{int(started.timestamp())}")
        shutil.copyfile(src, evidence)

    root = repo_root_of(job["dir"]) or job["dir"]
    rec_dir = os.path.join(root, ".hee", "dispatch")
    os.makedirs(rec_dir, exist_ok=True)
    record = {
        "job": jid, "name": job["name"], "agent": role, "hostname": hostname, "vmid": vmid,
        "ticket": args.ticket or job.get("ticket"), "cred": args.cred, "auth": "wif" if wif else "key",
        "federation_rule_id": wif["federation_rule_id"] if wif else None,
        "jwt_jti": jwt_claims["jti"] if jwt_claims else None,
        "started_at": started.isoformat(timespec="seconds"), "ended_at": ended.isoformat(timespec="seconds"),
        "budget_usd": job["budget_usd"], "timeout_s": job["timeout_s"], "tools": job["tools"], "mode": job["mode"],
        "prompt_sha256": hashlib.sha256(open(os.path.join(job["dir"], job["prompt"]), "rb").read()).hexdigest(),
        "run_sh_sha256": hashlib.sha256(run_sh.encode()).hexdigest(),
        "exit": res["exit"], "cost_usd": res["cost_usd"], "num_turns": res["num_turns"],
        "models": res["models"], "session_id": res["session_id"], "is_error": res["is_error"],
        "subtype": res["subtype"], "usage": res["usage"], "duration_ms": res["duration_ms"], "duration_api_ms": res["duration_api_ms"],
        "permission_denials": res["permission_denials"], "denied_tools": res["denied_tools"], "model_usage": res["model_usage"],
        "review": {"accepted": None, "corrections": None, "mistakes": [], "merged_pr": None, "reviewer": None, "method": None},
        "results_dir": os.path.relpath(results_dir, root),
        "evidence": os.path.relpath(evidence, root) if evidence else None,
        "remote_dir": f"{hostname}:{remote}",
        "budget_hit": res["subtype"] == "error_max_budget_usd",
        "resumes": remote_jid if resume else None,
        "resume_reason": args.why if resume else None,
    }
    with open(os.path.join(rec_dir, f"{jid}.yaml"), "w", encoding="utf-8") as fh:
        yaml.safe_dump(record, fh, sort_keys=False)
    if record["budget_hit"]:
        emit("WARNING", f"job {jid} stopped at its ${job['budget_usd']:.2f} ceiling; its work is in {hostname}:{remote}. Continue it with: "
                        f"hee pve dispatch {role} {os.path.relpath(job['dir'])} --wif --cred {args.cred} --resume {remote_jid} --budget USD --why TEXT")
    status = "OK" if res["exit"] == 0 and not res["is_error"] else "WARNING"
    if res.get("permission_denials"):
        status = "WARNING"
        emit("WARNING", f"job {jid}: {res['permission_denials']} permission denial(s) on {', '.join(res.get('denied_tools') or [])} "
                        f"-- friction the job definition caused; fix allowed_tools before the next run")
    emit(status, f"job {jid}: exit {res['exit']}, cost ${res['cost_usd']}, turns {res['num_turns']}, "
                 f"record .hee/dispatch/{jid}.yaml")
    if res["result"]:
        print("--- result:")
        print(res["result"][:4000])
    return 0 if status == "OK" else 1


if __name__ == "__main__":
    sys.exit(main())
