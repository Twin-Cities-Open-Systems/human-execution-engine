#!/bin/sh
# section: 1
# hee-index -- real, persisted index of every real HEE object
# (apiVersion: hee/v1), grouped by kind, with live pass/fail compliance
# status. Thin wrapper around hee-lint's own real scan -- reuses its
# pass/fail logic rather than re-parsing YAML separately (one real
# implementation, not two).
#
# Usage:
#   hee-index [--out <file>]   (default: hee/INDEX.md)
case "${1:-}" in
  --help|-h)
    echo "hee-index -- generate hee/INDEX.md, a real persisted index of every"
    echo "HEE object (apiVersion: hee/v1), grouped by kind, with pass/fail"
    echo "compliance status from hee-lint's own scan."
    echo "Usage: hee-index [--out <file>]"
    exit 0
    ;;
esac
set -eu

OUT="hee/INDEX.md"
while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    *) echo "hee-index: unknown arg: $1" >&2; exit 1 ;;
  esac
done

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$REPO_ROOT" ] || { echo "hee-index: not in a git repo" >&2; exit 2; }
cd "$REPO_ROOT"

SCRIPT_DIR="$(dirname "$0")"
LINT_OUT="$("$SCRIPT_DIR/hee-lint" --mode warn)"

mkdir -p "$(dirname "$OUT")"

{
  echo "# HEE Object Index"
  echo
  echo "Auto-generated by \`tooling/bin/hee-index\` -- reuses \`hee-lint\`'s"
  echo "own real compliance scan, grouped by kind. Do not hand-edit; re-run"
  echo "after adding/changing any real HEE object (apiVersion: hee/v1)."
  echo
  # Match "RESULT" without assuming the punctuation or the status prefix around
  # it, then keep from RESULT onward. Works against both the old
  # "# RESULT: fail=.." and the current "WARNING: RESULT fail=..".
  echo "$LINT_OUT" | grep "RESULT" | sed 's/^.*\(RESULT\)/**\1/;s/$/**/'
  echo

  # Real, deliberate simple grouping: extract each OK/ERROR/WARN line's
  # real file path, read that file's own real `kind:` field directly
  # (not re-parsed from hee-lint's text output, which doesn't carry it).
  # Each kind renders as a real, GitHub-native collapsible <details>
  # block, collapsed by default -- plain ## headers aren't real cards,
  # and markdown has no other native collapse mechanism.
  # Status is read from the TEXT token (`# ERROR:` / `# WARN:` / `# OK:`),
  # never from the leading emoji. The emoji was previously doing double
  # duty as both the human visual cue and the machine-parsed field, which
  # meant the icons could never be changed -- swapping a hue-only dot for
  # a shape-distinct one would silently break this parser. Decoupled
  # 2026-08-31 so presentation can evolve independently. The emoji prefix
  # is still tolerated on input for backward compatibility with older
  # hee-lint output; it is simply not what determines status.
  # LC_ALL=C on the sort below is REQUIRED, not tidiness. Without it this
  # script emits a different INDEX.md on different machines, and the CI
  # freshness check can never pass -- it failed every PR while reporting
  # "stale", when the content was identical and only the GROUP ORDER moved.
  #
  # Measured 2026-08-31. The sort key is "kind<TAB>status<TAB>path", and
  # en_US.UTF-8 collation IGNORES PUNCTUATION, so it compares
  # "BlueprintDoctrine..." against "Blueprint<TAB>ERROR..." as D vs E and puts
  # BlueprintDoctrine first. Under C the tab (0x09) sorts before any letter,
  # so Blueprint comes first. Same input, two different files:
  #
  #   LC_ALL=C           983a47c2923b0f0d271c7b4a1664f6df
  #   LC_ALL=en_US.UTF-8 269550f0640041d820609b89f36b24d4
  #
  # A generated file that is diffed against a committed copy must be byte
  # reproducible on any machine, so the collation has to be pinned.
  # Accepts BOTH hee-lint output vocabularies.
  #
  # hee-lint moved to the Nagios words the rest of the toolchain uses -- OK /
  # WARNING / CRITICAL -- and dropped a stray "# " prefix. This grep still
  # matched only the OLD tokens, so it silently produced an EMPTY index and the
  # hee-index freshness check went red. Silently: an empty result is not an
  # error to grep, so nothing failed until CI diffed the file.
  #
  # The old tokens are kept so this tool does not break against an older
  # hee-lint on a machine that has not pulled yet.
  #
  # The real fragility is structural, and worth fixing separately: this parses
  # another tool's HUMAN-READABLE output. Any wording change breaks it, at a
  # distance, with no error. A machine-readable mode on hee-lint would remove
  # the coupling entirely.
  echo "$LINT_OUT" | grep -E "(# )?(OK|ERROR|WARN|WARNING|CRITICAL): " | while IFS= read -r line; do
    path="${line##*: }"
    [ -f "$path" ] || continue
    kind="$(grep -m1 -E '^kind:[[:space:]]*' "$path" | sed 's/^kind:[[:space:]]*//' | tr -d '\r')"
    [ -n "$kind" ] || kind="(unknown)"
    status="OK"
    case "$line" in
      *"CRITICAL: "*) status="ERROR" ;;
      *"# ERROR: "*)  status="ERROR" ;;
      *"WARNING: "*)  status="WARN"  ;;
      *"# WARN: "*)   status="WARN"  ;;
    esac
    printf '%s\t%s\t%s\n' "$kind" "$status" "$path"
  done | LC_ALL=C sort | awk -F'\t' '
    BEGIN {
      icon["Blueprint"] = "\xF0\x9F\x93\x90"
      icon["BlueprintDoctrine"] = "\xF0\x9F\x93\x98"
      icon["Card"] = "\xF0\x9F\x83\x8F"
      icon["Contract"] = "\xF0\x9F\x93\x9C"
      icon["GreenCard"] = "\xF0\x9F\xAA\xAA"
      icon["Measure"] = "\xF0\x9F\x93\x8F"
      icon["Pill"] = "\xF0\x9F\x92\x8A"
      icon["Registry"] = "\xF0\x9F\x97\x82\xEF\xB8\x8F"
      icon["Skill"] = "\xF0\x9F\x8E\x93"
    }
    function flush() {
      if (prev != "") {
        ic = (prev in icon) ? icon[prev] : "\xE2\x96\xAA"
        printf "<details>\n<summary>%s %s (%d)</summary>\n\n%s\n</details>\n", ic, prev, n, items
      }
    }
    $1 != prev { flush(); items = ""; n = 0; prev = $1 }
    {
      n++
      badge = ($2 == "OK") ? "\xF0\x9F\x9F\xA2" : ($2 == "WARN" ? "\xF0\x9F\x9F\xA1" : "\xF0\x9F\x94\xB4")
      items = items sprintf("- %s [%s] `%s`\n", badge, $2, $3)
    }
    END { flush() }
  '
} > "$OUT"

echo "wrote: $OUT"
echo "$LINT_OUT" | grep "RESULT"
