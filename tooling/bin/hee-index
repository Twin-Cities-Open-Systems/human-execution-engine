#!/bin/sh
# hee-index -- real, persisted index of every real HEE object
# (apiVersion: hee/v1), grouped by kind, with live pass/fail compliance
# status. Thin wrapper around hee-lint's own real scan -- reuses its
# pass/fail logic rather than re-parsing YAML separately (one real
# implementation, not two).
#
# Usage:
#   hee-index [--out <file>]   (default: hee/INDEX.md)
case "${1:-}" in
  --help|-h)
    echo "hee-index -- generate hee/INDEX.md, a real persisted index of every"
    echo "HEE object (apiVersion: hee/v1), grouped by kind, with pass/fail"
    echo "compliance status from hee-lint's own scan."
    echo "Usage: hee-index [--out <file>]"
    exit 0
    ;;
esac
set -eu

OUT="hee/INDEX.md"
while [ $# -gt 0 ]; do
  case "$1" in
    --out) OUT="$2"; shift 2 ;;
    *) echo "hee-index: unknown arg: $1" >&2; exit 1 ;;
  esac
done

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
[ -n "$REPO_ROOT" ] || { echo "hee-index: not in a git repo" >&2; exit 2; }
cd "$REPO_ROOT"

SCRIPT_DIR="$(dirname "$0")"
LINT_OUT="$("$SCRIPT_DIR/hee-lint" --mode warn)"

mkdir -p "$(dirname "$OUT")"

{
  echo "# HEE Object Index"
  echo
  echo "Auto-generated by \`tooling/bin/hee-index\` -- reuses \`hee-lint\`'s"
  echo "own real compliance scan, grouped by kind. Do not hand-edit; re-run"
  echo "after adding/changing any real HEE object (apiVersion: hee/v1)."
  echo
  echo "$LINT_OUT" | grep "RESULT:" | sed 's/^.*# /**/;s/$/**/'
  echo

  # Real, deliberate simple grouping: extract each OK/ERROR/WARN line's
  # real file path, read that file's own real `kind:` field directly
  # (not re-parsed from hee-lint's text output, which doesn't carry it).
  # Each kind renders as a real, GitHub-native collapsible <details>
  # block, collapsed by default -- plain ## headers aren't real cards,
  # and markdown has no other native collapse mechanism.
  echo "$LINT_OUT" | grep -E "^(🟢|🔴|🟡)" | while IFS= read -r line; do
    path="${line##*: }"
    [ -f "$path" ] || continue
    kind="$(grep -m1 -E '^kind:[[:space:]]*' "$path" | sed 's/^kind:[[:space:]]*//' | tr -d '\r')"
    [ -n "$kind" ] || kind="(unknown)"
    status="OK"
    case "$line" in
      🔴*) status="ERROR" ;;
      🟡*) status="WARN" ;;
    esac
    printf '%s\t%s\t%s\n' "$kind" "$status" "$path"
  done | sort | awk -F'\t' '
    function flush() {
      if (prev != "") {
        printf "<details>\n<summary>%s (%d)</summary>\n\n%s\n</details>\n", prev, n, items
      }
    }
    $1 != prev { flush(); items = ""; n = 0; prev = $1 }
    {
      n++
      badge = ($2 == "OK") ? "\xF0\x9F\x9F\xA2" : ($2 == "WARN" ? "\xF0\x9F\x9F\xA1" : "\xF0\x9F\x94\xB4")
      items = items sprintf("- %s [%s] `%s`\n", badge, $2, $3)
    }
    END { flush() }
  '
} > "$OUT"

echo "wrote: $OUT"
echo "$LINT_OUT" | grep "RESULT:"
