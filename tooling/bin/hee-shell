#!/bin/sh
# section: 1
# hee-shell -- ssh into a known TCOS host by short alias.
#
# Real, deliberately thin: this is `ssh` with TCOS's own host aliases
# baked in, not a new protocol or a permissions mechanism. It cannot
# grant access a key doesn't already have -- if the calling session's
# key isn't authorized on the target host/account, this fails exactly
# like a bare `ssh` call would, with the same real error.
#
# Alias table only includes hosts actually confirmed reachable by name
# this session -- not speculative. Add more here as they're verified,
# not guessed.
#
# usage:
#   hee-shell <alias|host> [user]

set -eu

usage() {
  cat <<'TXT'
hee-shell -- ssh into a known TCOS host by alias

SYNOPSIS
  hee-shell <alias|host> [user]
  hee-shell help | --help | -h

DESCRIPTION
  Thin wrapper over ssh(1) with TCOS host aliases. It grants no access a key
  does not already have.

  A target that is not a known alias is passed to ssh VERBATIM. Be aware that
  with a DNS search domain configured, a bare word can resolve to a real host
  -- so a typo becomes a real connection attempt, not an error.

KNOWN ALIASES
  kiosk -> kiosk.lab.tcos.us
  man-tcos-us -> man.tcos.us   (the DigitalOcean droplet, 159.65.46.8; root = kiosk-spencer key, claude = no sudo)

EXIT STATUS
  0  OK        ssh ran (its own exit status is returned)
  3  UNKNOWN   no target given, or an option-shaped argument
TXT
}

# Help is answered FIRST, before $1 is ever treated as a hostname.
#
# Real incident, 2026-09-01: `hee check cli` probes every tool with the literal
# word `help`. This tool took that as a HOSTNAME. A DNS search domain is
# configured on this LAN, so a bare word resolves to a real address -- and
# running the CONFORMANCE CHECKER opened an ssh connection to a live host and
# sat at an interactive host-key prompt.
#
# This is the checker's own worst category -- help that executes something --
# and here it executed a network connection to a machine the session had been
# told not to touch.
# Resolve through symlinks before deriving TOOL_ROOT -- tools are symlinked
# onto PATH from ~/.local/bin, where a bare `dirname "$0"` finds no library/.
HEE_SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  HEE_SELF="$(realpath -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
elif command -v readlink >/dev/null 2>&1; then
  HEE_SELF="$(readlink -f -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
fi
TOOL_ROOT="$(cd "$(dirname "$HEE_SELF")/../.." && pwd)"

# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"

# Contextual help, via the shared contract. Replaces a positional check that
# saw only one argument position, and announces what it discarded.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  usage
  exit 0
fi


target="${1:-}"
user="${2:-}"

if [ -z "$target" ]; then
  usage >&2
  exit 3
fi

# An option-shaped argument is never a hostname. Without this, a stray flag
# becomes an ssh target the same way `help` did.
case "$target" in
  -*) echo "UNKNOWN: not a host: $target -- see: hee shell help" >&2; exit 3 ;;
esac

case "$target" in
  kiosk) host="kiosk.lab.tcos.us" ;;
  man-tcos-us|do) host="man.tcos.us" ;;
  *) host="$target" ;;
esac

if [ -n "$user" ]; then
  exec ssh "${user}@${host}"
else
  exec ssh "$host"
fi
