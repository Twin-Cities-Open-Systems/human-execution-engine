#!/usr/bin/env python3
# section: 1
"""hee-completion -- bash completion for hee that teaches while it completes

SYNOPSIS
  hee completion bash                  print the bash completion script (source it, or install it)
  hee completion -words WORD...        candidates for the next word, then a hint table (the script calls this)
  hee completion install               write ~/.local/share/bash-completion/completions/hee
  hee completion help

DESCRIPTION
  Every hee tool documents itself in its --help, the man pages are
  generated from that help (hee gen-manpages), and so is this: the
  candidates for the next word and the one-line meaning of each come from
  the same SYNOPSIS and SUBCOMMANDS text, read live and cached by the
  tool's mtime. Nothing is typed twice, nothing goes stale on its own.

  Two TABs show the hint table above the prompt:

    $ hee release -<TAB><TAB>
      -status    what main holds beyond the last release, per surface
      -cut       build, changelog, release commit + PR
      -promote   every surface from the release commit, tagged, published
      ...

  That is the point: a completion is a learning tool as much as a saving
  of keystrokes (operator, 2026-09-06: "guide the human opers to the
  possible next args ... a learning tool as much as a carpal tunnel
  strategy"). Completions are standard, not optional: dotfiles installs
  and loads them for every oper.

WHAT COMPLETES
  hee <TAB>              every tool under tooling/bin/hee-* plus the dispatcher's
                         families (git merge|tag, hooks install, ...), each with its NAME line
  hee TOOL <TAB>         the tool's subcommands and flags from its SYNOPSIS; -word and
                         --word forms as the tool spells them
  hee TOOL SUB <TAB>     flags that appear on that subcommand's SYNOPSIS line
  paths                  when the SYNOPSIS says PATH, FILE or DIR at that position, files complete

FILES
  ~/.cache/hee/completion/*.json                       per-tool cache, invalidated by the tool's mtime
  ~/.local/share/bash-completion/completions/hee       what `install` writes; dotfiles' .bashrc loads it

SEE ALSO
  hee-gen-manpages(1), hee-check(1) (cli: every tool's help obeys the contract)
"""
from __future__ import annotations

import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored  # noqa: E402
import hee_manpage  # noqa: E402

BIN = Path(__file__).resolve().parent
CACHE = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "hee" / "completion"
FAMILIES = {   # dispatcher verbs that are not one hee-* tool
    "git": {"merge": "approve/merge open PRs, in order (hee-git-merge)", "tag": "a GPG-signed tag with the key that is really yours (hee-git-tag)"},
    "hooks": {"install": "install the org's git hooks into this checkout"},
    "ssh": {"send-keys": "push your public key to a host (hee-ssh-send-keys)"},
    "contract": {"review": "review or ratify proposed contracts (hee-contract-review)"},
}
FAMILY_TOOL = {("git", "merge"): "hee-git-merge", ("git", "tag"): "hee-git-tag", ("ssh", "send-keys"): "hee-ssh-send-keys", ("contract", "review"): "hee-contract-review"}
PATH_WORDS = {"PATH", "FILE", "DIR", "TOOLDIR", "URL_OR_PATH", "JOB.json", "resume.md", "out.html"}

BASH_SCRIPT = r'''# hee bash completion -- generated by `hee completion bash`; do not edit.
# Candidates and hints come from each tool's own --help, live.
_hee() {
  local cur="${COMP_WORDS[COMP_CWORD]}"
  local out cands hints
  out="$(hee completion -words "${COMP_WORDS[@]:1:COMP_CWORD}" 2>/dev/null)" || return
  cands="${out%%$'\n\n'*}"
  hints="${out#*$'\n\n'}"
  [[ "$hints" == "$out" ]] && hints=""
  local want_paths=""
  if [[ "$cands" == *__PATHS__* ]]; then
    want_paths=1; cands="${cands//__PATHS__/}"
  fi
  mapfile -t COMPREPLY < <(compgen -W "$cands" -- "$cur")
  if [[ -n "$want_paths" ]]; then
    compopt -o filenames 2>/dev/null
    mapfile -t -O "${#COMPREPLY[@]}" COMPREPLY < <(compgen -f -- "$cur")
  fi
  # the second TAB (readline lists) also prints the meanings, once, above the prompt
  if [[ "$COMP_TYPE" == 63 && -n "$hints" && ${#COMPREPLY[@]} -gt 1 ]]; then
    printf '\n%s\n' "$hints" >/dev/tty
  fi
}
complete -F _hee hee
'''


def tools() -> dict[str, str]:
    """name -> one-line meaning, for every hee-* tool."""
    out = {}
    for p in sorted(BIN.glob("hee-*")):
        if not os.access(p, os.X_OK) or p.suffix == ".pyc":
            continue
        name = p.name[4:]
        out[name] = load(p.name).get("name_line", "")
    return out


def load(tool: str) -> dict:
    """Parsed SYNOPSIS/SUBCOMMANDS for one tool, cached by mtime."""
    path = BIN / tool
    if not path.is_file():
        return {}
    CACHE.mkdir(parents=True, exist_ok=True)
    cache = CACHE / f"{tool}.json"
    mtime = path.stat().st_mtime
    if cache.is_file():
        try:
            d = json.loads(cache.read_text())
            if d.get("mtime") == mtime:
                return d
        except ValueError:
            pass
    try:
        text = subprocess.run([str(path), "help"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        text = ""
    secs = hee_manpage.parse(tool, text).get("sections", {})
    d = {"mtime": mtime, "name_line": "", "lines": [], "subs": {}}
    first = (text.strip().splitlines() or [""])[0]
    m = re.match(r"^\S+\s+--\s+(.*)$", first)
    d["name_line"] = m.group(1).strip() if m else first[:80]
    d["lines"] = [l for l in secs.get("SYNOPSIS", []) if l.strip()]
    for l in secs.get("SUBCOMMANDS", []) + secs.get("OPTIONS", []):
        mm = re.match(r"^\s*(\S+)\s{2,}(.*)$", l)
        if mm:
            d["subs"][mm.group(1)] = mm.group(2).strip()
    cache.write_text(json.dumps(d))
    return d


def candidates(tool: str, words: list[str]) -> tuple[list[str], dict[str, str], bool]:
    """(candidates, hints, paths_expected) for the word after `words`."""
    d = load(tool)
    if not d:
        return [], {}, False
    lines = d["lines"]
    subs = dict(d["subs"])
    # a SYNOPSIS line: "hee release -status [SELECT]   what main holds..." -> tokens + trailing meaning
    parsed = []
    for l in lines:
        m = re.match(r"^\s*(\S+(?:\s+\S+)*?)\s{2,}(.+)$", l)
        toks, meaning = (m.group(1), m.group(2).strip()) if m else (l.strip(), "")
        toks = toks.split()
        # drop the tool name at the front however the SYNOPSIS spells it:
        # "hee release", "hee-check", "hee git tag" (tool hee-git-tag)
        lead = ["hee", tool, tool[4:]] + tool[4:].split("-")
        while toks and toks[0] in lead:
            toks.pop(0)
        parsed.append((toks, meaning))
    typed = [w for w in words if w]
    # lines whose leading verbs match what was typed; a flag typed anywhere
    # keeps a line only if that line knows the flag
    def fits(toks):
        verbs = [t for t in toks if not t.startswith("[") and not t.startswith("-") and t.islower()]
        for i, w in enumerate(typed):
            if w.startswith("-"):
                if not any(t.strip("[]") == w for t in toks):
                    return False
            elif i < len(verbs) and verbs[i] != w:
                return False
        return True
    live = [p for p in parsed if fits(p[0])] or parsed
    cands: dict[str, str] = {}
    paths = False
    for toks, meaning in live:
        verbs_seen = 0
        for t in toks:
            bare = t.strip("[]")
            is_flag = bare.startswith("-")
            is_verb = not is_flag and bare.islower() and bare.replace("-", "").isalpha()
            if is_verb:
                if verbs_seen < len([w for w in typed if not w.startswith("-")]):
                    verbs_seen += 1; continue            # already typed
                cands.setdefault(bare, subs.get(bare, meaning)); verbs_seen += 1
                break                                    # the next verb is the only next word
            if is_flag and bare not in typed:
                for x in bare.split("|"):
                    cands.setdefault(x, subs.get(x, meaning))
            if bare.split("|")[0] in PATH_WORDS or bare.endswith(".md") or bare.endswith(".json"):
                paths = True
    if not typed:
        for k, v in subs.items():
            cands.setdefault(k, v)
    hints = {k: v for k, v in cands.items() if v}
    return sorted(cands), hints, paths


def cmd_words(words: list[str]) -> int:
    words = list(words)
    cur = words[-1] if words else ""
    prev = words[:-1]
    if not prev:                                   # hee <TAB>
        t = tools()
        names = sorted(set(list(t) + list(FAMILIES)))
        print("\n".join(names)); print()
        for n in names:
            meaning = t.get(n) or f"{n} family: " + ", ".join(FAMILIES.get(n, {}))
            print(f"  {n:18} {meaning}")
        return 0
    head = prev[0]
    if head in FAMILIES and len(prev) == 1:        # hee git <TAB>
        fam = FAMILIES[head]
        print("\n".join(sorted(fam))); print()
        for k, v in fam.items():
            print(f"  {k:18} {v}")
        return 0
    tool = FAMILY_TOOL.get((head, prev[1] if len(prev) > 1 else ""), f"hee-{head}")
    rest = prev[2:] if (head, prev[1] if len(prev) > 1 else "") in FAMILY_TOOL else prev[1:]
    cands, hints, paths = candidates(tool, rest)
    if paths and not cands:
        print("__PATHS__"); return 0
    print("\n".join(c for c in cands if c.startswith(cur) or not cur) + ("\n__PATHS__" if paths else "")); print()
    for k in cands:
        if k in hints and (k.startswith(cur) or not cur):
            print(f"  {k:18} {hints[k]}")
    return 0


def main(argv: list[str]) -> int:
    if not argv or help_wanted(argv):
        note_ignored(argv); print(__doc__.strip()); return 0
    if argv[0] == "bash":
        print(BASH_SCRIPT, end=""); return 0
    if argv[0] == "install":
        dst = Path.home() / ".local/share/bash-completion/completions/hee"
        dst.parent.mkdir(parents=True, exist_ok=True); dst.write_text(BASH_SCRIPT)
        print(f"🟢 OK hee-completion: wrote {dst} -- open a new shell, or: source {dst}"); return 0
    if argv[0] == "-words":
        return cmd_words(argv[1:])
    print("🔴 CRITICAL hee-completion: bash | install | -words WORD...", file=sys.stderr); return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
