#!/bin/sh
# section: 1
# hee-gen-manpages -- real 0-token man-page generator. Mechanically
# extracts each tool's own --help/-h output (or, for shell scripts
# without one, its header comment block) into man/<tool>.1.md, then
# converts each into real roff man(1) format via pandoc.
# No LLM reasoning per tool -- pure extraction, so this scales to all
# 42+ tooling/bin/* entries at zero per-tool token cost. Re-run any
# time tools change; output is deterministic from the tool's own
# --help text, never hand-authored here.
#
# Real fix, 2026-08-30: this script previously had no --help of its
# own, so `hee-gen-manpages --help` ran a full real generation pass
# instead of printing usage -- slow enough to hit the per-tool 5s
# timeout used when THIS tool is scanned by a run of itself. Caught
# live, Spencer + touchy-claude, both independently hit the same
# hang running it fresh.
# The bare word `help` MUST be handled here, not only --help/-h.
#
# Real bug, 2026-08-31 (issue:471@human-execution-engine). The case below
# used to match only --help|-h, so the two call paths disagreed:
#
#   hee gen-manpages help    -> dispatcher translates it, prints usage
#   hee-gen-manpages help    -> fell through and REGENERATED EVERY MAN PAGE
#
# Asking for help must never be able to do anything. It went unnoticed for
# so long because the regenerated output is normally byte-identical, so
# `git status` stays clean and only mtime reveals the write.
# Resolve through symlinks before deriving TOOL_ROOT -- tools are symlinked
# onto PATH from ~/.local/bin, where a bare `dirname "$0"` finds no library/.
HEE_SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  HEE_SELF="$(realpath -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
elif command -v readlink >/dev/null 2>&1; then
  HEE_SELF="$(readlink -f -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
fi
TOOL_ROOT="$(cd "$(dirname "$HEE_SELF")/../.." && pwd)"

# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"

usage() {
  cat <<'USAGE'
hee-gen-manpages -- generate man pages from each tool's own --help

SYNOPSIS
  hee-gen-manpages                     dry run: report what would change
  hee-gen-manpages --write             write the pages
  hee-gen-manpages --gopher [DIR]      dry run of the published gopher tree
  hee-gen-manpages --gopher --write    build it
  hee-gen-manpages help

DESCRIPTION
  Extracts each tool's own --help output and renders it as a man page. No
  page is hand-authored here; the tool's help IS the page, per rule 17.

  DRY RUN IS THE DEFAULT. With no arguments this writes nothing at all --
  it generates into a temporary directory, compares that against what is
  committed, and prints the difference. Add --write to apply it.

  Operator, 2026-09-01: "I don't like that it just writes files when you
  run it without args. those file need to go to a certain spot and oper
  needs to know that." The precedent is real and already cost something:
  a bare run of this tool was once observed installing a pre-commit hook
  as a side effect of generating documentation (issue:464@human-execution-engine),
  which is why library/py/hee_toolver never invokes a tool without a flag.

DESTINATIONS
  Both are inside the repo that owns the TOOL, never the current
  directory -- this tool resolves its own location first. The absolute
  path is printed on every run, dry or not.

    man/tools/           generated pages, .N.md sources and manN/*.N roff
    man/tools/README.md  the index
    man/gopher/          --gopher only: the tree man.tcos.us serves

  man/manN/ holds pages written BY HAND. Those WIN: generation skips any
  tool with an authored page and says so.

OPTIONS
  --write        apply the changes. Without it nothing is written.
  --gopher [DIR] render the published gopher tree. DIR defaults to
                 man/gopher. Rebuilt from scratch, so with --write this
                 REMOVES the existing tree first.
  --publish [HOST]
                 with --gopher --write: push the tree to HOST (an ssh alias,
                 default man-tcos-us) into /var/gopher-man, the root
                 gophernicus serves, as the current user (the gopher group
                 owns it -- no root). Backs up the previous tree on the host,
                 verifies over port 70, and records who published (sig_tag).
                 Without --write it says what it would push and stops.

EXIT STATUS
  0 OK   1 nothing generated, or an unknown argument
USAGE
}

# Contextual help, via the shared contract -- never a positional check.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  usage
  exit 0
fi

# An authored page that names a path that is not on this machine is a
# claim nobody checked. Operator, 2026-09-06, reading man.tcos.us/.../hee.txt:
# "lies" -- it described a ~/.hee/bin toolchain and a completion file that
# existed for no one. Every ~/... or /... under .SH FILES of an authored
# page is tested here; a missing one is a WARNING naming page and path.
check_files_claims() {
  _warn=0
  for _pg in man/man[1-9]/*.[1-9]; do
    [ -f "$_pg" ] || continue
    awk '/^\.SH FILES/{f=1;next} /^\.SH/{f=0} f && /^\.B /{sub(/^\.B +/,""); gsub(/\\f[BIR]/,""); print}' "$_pg" | while IFS= read -r _path; do
      case "$_path" in "~"/*|/*) ;; *) continue ;; esac
      _abs="$_path"; case "$_abs" in "~"/*) _abs="$HOME${_abs#\~}" ;; esac; _abs="${_abs%/}"   # POSIX: no ${x/…}
      [ -e "$_abs" ] || { echo "⚠️ WARNING gen-manpages: $_pg claims $_path under FILES; not on this machine"; }
    done
  done
}
check_files_claims

WRITE=0
DO_GOPHER=0
DO_PUBLISH=0
PUBLISH_HOST="man-tcos-us"
PUBLISH_DIR="/var/gopher-man"
GOPHER_OUT="man/gopher"
while [ $# -gt 0 ]; do
  case "$1" in
    --write) WRITE=1; shift ;;
    --publish)
      DO_PUBLISH=1; shift
      case "${1:-}" in
        ""|-*) ;;
        *) PUBLISH_HOST="$1"; shift ;;
      esac
      ;;
    --gopher)
      DO_GOPHER=1; shift
      case "${1:-}" in
        ""|-*) ;;
        *) GOPHER_OUT="$1"; shift ;;
      esac
      ;;
    *) echo "hee-gen-manpages: unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
done
set -eu
cd "$TOOL_ROOT"
BIN_DIR="tooling/bin"
REAL_OUT="man/tools"

# Where generation actually lands. Without --write that is a temp tree the
# repo never sees, which is what makes the default safe rather than merely
# quiet: nothing downstream needs a dry-run branch, because every write goes
# somewhere disposable.
if [ "$WRITE" -eq 1 ]; then
  OUT_DIR="$REAL_OUT"
  STAGE=""
else
  STAGE="$(mktemp -d "${TMPDIR:-/tmp}/hee-gen-manpages.XXXXXXXX")"
  trap 'rm -rf "$STAGE"' EXIT INT TERM
  OUT_DIR="$STAGE/$REAL_OUT"
fi
mkdir -p "$OUT_DIR"

# Say WHERE, once, in absolute form, and say whether anything will land
# there. Operator, 2026-08-31: "if you run sans help it sayes it is
# genereted, where I hav no idea" -- every line below prints a path relative
# to a directory this script already cd-ed to, which is not the directory
# the operator ran it from.
if [ "$DO_GOPHER" -eq 1 ]; then _dest="$GOPHER_OUT"; else _dest="$REAL_OUT"; fi
if [ "$WRITE" -eq 1 ]; then
  printf 'WRITING to: %s/%s\n' "$(pwd)" "$_dest"
  [ "$DO_GOPHER" -eq 1 ] && printf 'this REMOVES the existing tree first.\n'
else
  printf 'DRY RUN -- nothing will be written.\n'
  printf 'would write to: %s/%s\n' "$(pwd)" "$_dest"
  printf 'staged in:      %s\n' "$STAGE"
fi

# In a dry run the per-file progress lines name the TEMP directory, which is
# worse than useless -- it is a path the operator will never see again. Park
# stdout until the plan is ready; stderr stays live so real errors surface.
if [ "$WRITE" -eq 0 ]; then
  exec 3>&1
  exec 1>/dev/null
fi

# report_plan STAGED REAL LABEL -- what --write would actually do.
#
# Compares the staged tree against what is committed and reports it in the
# canonical vocabulary. `diff -rq` is the whole mechanism: a dry run that
# reasons about what it WOULD have done is a dry run that can be wrong,
# whereas one that generates for real into a throwaway directory and diffs
# is answering with the same bytes --write would produce.
report_plan() {
  _staged="$1"; _real="$2"; _label="$3"
  _new=0; _changed=0; _gone=0; _same=0
  if [ ! -d "$_real" ]; then
    _new="$(find "$_staged" -type f 2>/dev/null | wc -l)"
    printf '%s: %s new, no existing tree\n' "$_label" "$_new"
    return 0
  fi
  # cat1/cat8/index.db are mandb's own formatted-page cache and whatis index.
  # mandb writes them into every directory on the manpath, they are gitignored,
  # and reporting them as "removed" would be a lie -- nothing removes them.
  diff -rq -x 'cat[1-9]' -x index.db "$_real" "$_staged" \
    2>/dev/null > "$_staged.diff" || true
  # grep -c always prints a count and exits 1 on zero matches, so `|| true`
  # is the whole guard -- an `|| echo 0` here appends a SECOND line and the
  # arithmetic below silently reads "0\n0".
  _changed="$(grep -c '^Files .* differ$' "$_staged.diff" || true)"
  _new="$(grep -c "^Only in $_staged" "$_staged.diff" || true)"
  _gone="$(grep -c "^Only in $_real" "$_staged.diff" || true)"
  _same=$(( $(find "$_real" -type f ! -name 'index.db' 2>/dev/null | wc -l) - _changed - _gone ))
  printf '\n%s -- what --write would do:\n' "$_label"
  printf '  %s changed  %s new  %s removed  %s unchanged\n' \
    "$_changed" "$_new" "$_gone" "$_same"
  if [ "$_changed" -gt 0 ] || [ "$_new" -gt 0 ] || [ "$_gone" -gt 0 ]; then
    # Classify BEFORE rewriting paths: `Only in <staged>` is a new file and
    # `Only in <real>` is one that would go away, and once both are rewritten
    # to the same prefix they are indistinguishable. Every line names a path
    # under the REAL destination, never the temp one -- reporting a path the
    # operator cannot go and look at is worse than reporting none.
    sed -e "s#^Files \([^ ]*\) and .* differ\$#  changed: \1#" \
        -e "s#^Only in $_staged\(.*\): \(.*\)\$#  new:     $_real\1/\2#" \
        -e "s#^Only in $_real\(.*\): \(.*\)\$#  removed: $_real\1/\2#" \
        "$_staged.diff" | sort
  fi
  rm -f "$_staged.diff"
}

# man_section FILE -- which manual section this tool belongs in.
#
# Declared BY THE TOOL, in its own header:
#
#     # section: 8
#
# not by a lookup table here. A table in the generator goes stale the moment
# someone adds a tool and forgets it, and the tool's own author is the one who
# knows whether it administers the system or just talks to it.
#
# Defaults to 1 (user commands), which is what the overwhelming majority are.
# 8 is system administration -- per man-pages(7), commands that manage the
# system and generally want root. That distinction is what tells a reader
# `hee-ssh-trust-ca` edits sshd config while `hee-print` formats a file, and
# it is what apropos/whatis categorise on.
man_section() {
  _s="$(sed -n 's/^#[[:space:]]*section:[[:space:]]*\([1-9]\)[[:space:]]*$/\1/p' "$1" 2>/dev/null | head -1)"
  [ -n "$_s" ] && printf '%s\n' "$_s" || printf '1\n'
}


# HAND-WRITTEN PAGES WIN. Operator, 2026-08-31: "use the hand written and
# update the tool so it presents this to our other tools. fix the source, no
# oneoffs!"
#
# man/ holds 9 pages written BY HAND, with real man structure -- .TH, NAME,
# SYNOPSIS, DESCRIPTION, FILES, ORGANIZATION. What this tool generates is a
# fenced --help dump under a single .SH. The authored pages are strictly
# better, and regenerating over them would replace documentation with a
# transcript.
#
# So generation SKIPS any tool that already has an authored page, and says so.
# The skip is reported rather than silent, because a stale authored page is
# the real failure mode here: man/hee.1 still documents ls, fileident,
# pathcheck, http404, uiboss and serve -- subcommands that no longer exist --
# and nothing ever flagged it.
AUTHORED_DIR="man"

# --gopher: render the artifacts man.tcos.us serves, as a SECTION TREE.
#
# A gopher menu is a directory, so the man section layout maps onto it
# one-to-one: root lists sections as type-1 entries, each section has its own
# gophermap of type-0 text entries. What is live today is one flat menu of
# every page, which carries no section signal and only grows.
#
# Only sections that actually have pages get a directory or a menu entry --
# no empty man2/man3/man4 stubs.
#
# `man -l FILE | col -bx` is byte-for-byte what gophernicus serves; verified
# against the live endpoint. col -bx strips backspace-overstrike bold and
# expands tabs, which is what makes it plain text rather than terminal output.
_sec_title() {
  case "$1" in
    1) echo "User Commands" ;;
    2) echo "System Calls" ;;
    3) echo "Library Functions" ;;
    4) echo "Special Files" ;;
    6) echo "Games" ;;
    5) echo "File Formats" ;;
    7) echo "Overviews and Conventions" ;;
    8) echo "System Administration" ;;
    *) echo "Section $1" ;;
  esac
}

gen_gopher() {
  _out="${1:-man/gopher}"
  rm -rf "$_out"; mkdir -p "$_out/man"
  command -v man >/dev/null 2>&1 || { echo "man(1) unavailable -- cannot render" >&2; return 3; }

  _total=0
  for _secdir in "$AUTHORED_DIR"/man[1-9] "$REAL_OUT"/man[1-9]; do
    [ -d "$_secdir" ] || continue
    _n="${_secdir##*/man}"
    for _src in "$_secdir"/*."$_n"; do
      [ -f "$_src" ] || continue
      _name="$(basename "$_src" ".$_n")"; _name="${_name%.py}"
      # Authored wins over generated, same precedence as the rest of the tool.
      if [ "$_secdir" != "$AUTHORED_DIR/man$_n" ] && [ -f "$AUTHORED_DIR/man$_n/$_name.$_n" ]; then
        continue
      fi
      mkdir -p "$_out/man/man$_n"
      man -l "$_src" 2>/dev/null | col -bx > "$_out/man/man$_n/$_name.txt" || continue
      _total=$((_total + 1))
    done
  done

  for _d in "$_out"/man/man[1-9]; do
    [ -d "$_d" ] || continue
    _n="${_d##*/man}"
    {
      printf 'iTwin Cities Open Systems -- section %s: %s\t\tman.tcos.us\t70\n' "$_n" "$(_sec_title "$_n")"
      printf 'i\t\tman.tcos.us\t70\n'
      [ -f "$_d/hee.txt" ] && printf '0hee(%s)\t/man/man%s/hee.txt\tman.tcos.us\t70\n' "$_n" "$_n"
      for _f in "$_d"/*.txt; do
        [ -f "$_f" ] || continue
        _b="$(basename "$_f" .txt)"; [ "$_b" = "hee" ] && continue
        printf '0%s(%s)\t/man/man%s/%s\tman.tcos.us\t70\n' "$_b" "$_n" "$_n" "$(basename "$_f")"
      done
      printf 'i\t\tman.tcos.us\t70\n'
      printf '1all sections\t/man\tman.tcos.us\t70\n'
    } > "$_d/gophermap"
  done

  {
    printf 'iTwin Cities Open Systems -- real man pages, real tools\t\tman.tcos.us\t70\n'
    printf 'iIANA Private Enterprise Number: 1.3.6.1.4.1.66550\t\tman.tcos.us\t70\n'
    printf 'i\t\tman.tcos.us\t70\n'
    for _d in "$_out"/man/man[1-9]; do
      [ -d "$_d" ] || continue
      _n="${_d##*/man}"
      _c=$(ls "$_d"/*.txt 2>/dev/null | wc -l)
      printf '1%s -- section %s (%s pages)\t/man/man%s\tman.tcos.us\t70\n' "$(_sec_title "$_n")" "$_n" "$_c" "$_n"
    done
  } > "$_out/man/gophermap"
  cp "$_out/man/gophermap" "$_out/gophermap"

  # The changelog rides along: CHANGELOG.md is generated from the merge
  # history (hee gen-changelog, rule 18), so the served tree carries the
  # same file as a type-0 text item. Operator, 2026-09-06: "where is the
  # changelog page for man pages?" -- there was none.
  if [ -f CHANGELOG.md ]; then
    cp CHANGELOG.md "$_out/CHANGELOG.txt"
    {
      printf 'i\t\tman.tcos.us\t70\n'
      printf '0Changelog -- every merge to main, generated by hee gen-changelog\t/CHANGELOG.txt\tman.tcos.us\t70\n'
    } >> "$_out/gophermap"
  fi

  # FLAT COPIES AT THE ROOT, for URL compatibility.
  #
  # Every page used to live flat at the root, so /gopher/0/<tool>.txt was the
  # published URL contract -- and docs/guides/ZERO_TOKEN_CONTINUITY.md links
  # every tool that way. Moving to man/manN/ 404'd all of them at once.
  # Operator hit it immediately:
  #
  #   curl gopher://man.tcos.us/gopher/0/hee.txt
  #   Error: File or directory not found!
  #
  # So both live: the section tree is the structure, the flat copies keep
  # existing links and bookmarks working. They are copies of generated output,
  # regenerated together, so they cannot drift from each other.
  for _d in "$_out"/man/man[1-9]; do
    [ -d "$_d" ] || continue
    for _f in "$_d"/*.txt; do
      [ -f "$_f" ] || cp "$_f" "$_out/" 2>/dev/null
      cp "$_f" "$_out/$(basename "$_f")" 2>/dev/null
    done
  done

  echo "gopher: $_total page(s) in $(ls -d "$_out"/man/man[1-9] 2>/dev/null | wc -l) section(s), plus flat copies -> $(pwd)/$_out"
}

# Publish the generated tree to the host that serves it. The served root is
# /var/gopher-man (gophernicus, socket-activated); /var/gopher on that box is
# an unserved leftover -- measured 2026-09-06 after a hand publish went there
# first (fleet-ops#392). No root: the gopher group owns the tree.
publish_gopher() {
  _src="$1"; _host="$2"; _dir="$3"
  [ -f "$_src/gophermap" ] && [ -d "$_src/man" ] || { hee_status CRITICAL "gen-manpages: $_src is not a generated gopher tree (no gophermap/man)"; return 2; }
  _n="$(find "$_src" -type f | wc -l)"
  _sig="$("$BIN_DIR/hee-ver" session --tag 2>/dev/null || echo unknown)"
  if [ "$WRITE" -ne 1 ]; then
    echo "publish (dry run): would push $_n file(s) from $_src to $_host:$_dir as $_sig -- add --write"
    return 0
  fi
  _stamp="$(date -u +%Y%m%dT%H%MZ)"
  if ! tar -C "$_src" -cf - . | ssh -o BatchMode=yes -o StrictHostKeyChecking=accept-new "$_host" \
      "set -e; d='$_dir'; [ -w \"\$d\" ] || { echo \"not writable: \$d (join the gopher group)\" >&2; exit 2; }; \
       cp -a \"\$d\" \"\$d.bak-$_stamp\" && rm -rf \"\$d\"/* && tar -C \"\$d\" -xf - && \
       printf 'published by %s at %s\n' '$_sig' '$_stamp' > \"\$d/.published\""; then
    hee_status CRITICAL "gen-manpages: publish to $_host failed"; return 2
  fi
  # Verify what the daemon serves, not what the disk holds.
  _h="$(ssh -o BatchMode=yes "$_host" 'hostname -f' 2>/dev/null || echo "$_host")"
  _menu="$(printf '\r\n' | timeout 8 nc "$_h" 70 2>/dev/null | head -1)"
  _page="$(printf '/man/man1/hee.txt\r\n' | timeout 8 nc "$_h" 70 2>/dev/null | head -1)"
  case "$_menu" in i*) ;; *) hee_status CRITICAL "gen-manpages: $_h:70 did not answer with the root menu after publish"; return 2 ;; esac
  [ -n "$_page" ] || { hee_status CRITICAL "gen-manpages: $_h:70 does not serve /man/man1/hee.txt after publish"; return 2; }
  hee_status OK "gen-manpages: published $_n file(s) to $_host:$_dir (backup $_dir.bak-$_stamp), serving on $_h:70, by $_sig"
}

if [ "$DO_GOPHER" -eq 1 ]; then
  if [ "$WRITE" -eq 1 ]; then
    gen_gopher "$GOPHER_OUT" || exit $?
    [ "$DO_PUBLISH" -eq 1 ] && { publish_gopher "$GOPHER_OUT" "$PUBLISH_HOST" "$PUBLISH_DIR"; exit $?; }
    exit 0
  fi
  [ "$DO_PUBLISH" -eq 1 ] && publish_gopher "$GOPHER_OUT" "$PUBLISH_HOST" "$PUBLISH_DIR"
  # Dry run. gen_gopher's first act is `rm -rf` on its output directory, so
  # it is never pointed at the real tree without --write.
  gen_gopher "$STAGE/gopher" >/dev/null 2>&1
  exec 1>&3
  report_plan "$STAGE/gopher" "$GOPHER_OUT" "gopher tree ($GOPHER_OUT)"
  exit 0
fi
authored_kept=""

# Structured rendering lives in library/py -- turning help text into man
# sections is real parsing, so it graduates out of sh per rule 13. Missing
# library falls back to the old dump rather than failing the run.
HEE_MANPAGE_PY=""
if [ -f "library/py/hee_manpage/__init__.py" ] && command -v python3 >/dev/null 2>&1; then
  HEE_MANPAGE_PY=1
fi

# A page is generated if pandoc stamped it, authored otherwise.
_is_authored() {
  [ -f "$1" ] || return 1
  head -3 "$1" | grep -q 'Automatically generated by Pandoc' && return 1
  return 0
}

authored_page_for() {
  # authored_page_for TOOLNAME -> path, or empty
  _p="$AUTHORED_DIR/man1/$1.1"
  if _is_authored "$_p"; then printf '%s\n' "$_p"; fi
}


# extract_doc FILE -- the tool's own leading documentation block, in whatever
# comment syntax its language uses.
#
# Real gap, measured 2026-08-31: the old extractor read '#' comments ONLY.
# But 31 of this repo's 32 Python tools document themselves with a MODULE
# DOCSTRING, which it could not see. Any Python tool whose --help also failed
# fell through to a fallback that returned nothing and was SKIPPED outright --
# which is why hee-ticket, hee-stat, hee-hg, hee-lg, hee-filter, hee-publish,
# hee-worktree, hee-contract-review and hee-ssh-trust-ca have no published man
# page at all.
#
# Go and Rust use '//' (and Rust '//!' for module docs), so a compiled tool
# would have hit the same wall the moment one was added. cmd/hee is already Go.
#
# Comparisons use substr(), never a regex literal, because a triple-quote
# inside an awk regex inside a shell single-quoted string is unquotable in
# POSIX sh -- and mawk does not support \x27 escapes to get around it.
extract_doc() {
  _f="$1"

  # 1. Python/other module docstring: triple-quoted block at top level.
  _doc="$(awk -v dq='"""' -v sq="'''" '
    function opener(s) { return (substr(s,1,3) == dq || substr(s,1,3) == sq) }
    # Leading comments -- shebang, section declaration -- are metadata, not
    # the start of code. Exiting on them is what made a declared section
    # suppress the docstring entirely. No apostrophes in this comment: the
    # awk program is inside a single-quoted shell string.
    /^#/ { next }
    !started && opener($0) {
      started = 1
      q = substr($0,1,3)
      line = substr($0,4)
      i = index(line, q)
      if (i > 0) { line = substr(line,1,i-1); if (length(line)) print line; exit }
      if (length(line)) print line
      next
    }
    started {
      i = index($0, q)
      if (i > 0) { line = substr($0,1,i-1); if (length(line)) print line; exit }
      print; next
    }
    NF { exit }
  ' "$_f")"
  if [ -n "$_doc" ]; then printf '%s\n' "$_doc"; return 0; fi

  # 2. Shell-style leading '#' block.
  _doc="$(awk '/^#!/{next} /^#[ \t]*section:[ \t]*[1-9][ \t]*$/{next} /^#/{print substr($0,3); next} {exit}' "$_f")"
  if [ -n "$_doc" ]; then printf '%s\n' "$_doc"; return 0; fi

  # 3. Go / Rust leading '//' or '//!' block. Build tags and //go: directives
  #    are machine pragmas, not prose, so they are skipped rather than printed.
  _doc="$(awk '
    substr($0,1,5) == "//go:" { next }
    substr($0,1,3) == "//!" { print substr($0,4); next }
    substr($0,1,2) == "//"  { print substr($0,3); next }
    NF { exit }
  ' "$_f")"
  if [ -n "$_doc" ]; then printf '%s\n' "$_doc"; return 0; fi

  return 1
}


for f in "$BIN_DIR"/*; do
  [ -f "$f" ] && [ -x "$f" ] || continue
  name="$(basename "$f")"
  _sec="$(man_section "$f")"
  out="$OUT_DIR/$name.$_sec.md"

  # A tool's section can CHANGE (# section: 1 -> 8, as hee-cache-prune and
  # hee-reset-tooling just did). The page in the old section is not
  # overwritten by the new one, it is ORPHANED -- and the pandoc pass at the
  # bottom converts every *.[1-9].md it finds, so the orphan regenerates
  # itself on every subsequent run. Two pages for one tool, and whichever the
  # publisher reaches first wins, which is exactly how man/hee.1 and
  # man/tools/hee.1 diverged.
  #
  # Caught 2026-09-01 by the dry run predicting four removals that --write
  # then did not perform. A dry run and a real run disagreeing is the one
  # thing this tool must never do, so the real run was wrong, not the report.
  for _os in 1 2 3 4 5 6 7 8 9; do
    [ "$_os" = "$_sec" ] && continue
    if [ -e "$OUT_DIR/$name.$_os.md" ]; then
      rm -f "$OUT_DIR/$name.$_os.md"
      echo "  removed stale section-$_os page: $OUT_DIR/$name.$_os.md"
    fi
    if [ -e "$OUT_DIR/man$_os/$name.$_os" ]; then
      rm -f "$OUT_DIR/man$_os/$name.$_os"
      echo "  removed stale section-$_os roff: $OUT_DIR/man$_os/$name.$_os"
    fi
  done

  # Authored page wins -- never regenerate over hand-written documentation.
  _authored="$(authored_page_for "$name")"
  if [ -n "$_authored" ]; then
    echo "authored (kept, not regenerated): $_authored"
    authored_kept="$authored_kept $name"
    # Remove a stale generated sibling. Leaving it means two pages for one
    # tool, and whichever the installer or publisher happens to reach first
    # wins -- which is exactly how man/hee.1 and man/tools/hee.1 diverged.
    [ -e "$out" ] && { rm -f "$out" "$OUT_DIR/man1/$name.1"; echo "  removed stale generated: $out"; }
    continue
  fi
  help_text=""
  help_text="$(timeout -s KILL 5 "$f" --help </dev/null 2>&1)" && ok=1 || ok=0
  if [ "$ok" -ne 1 ] || [ -z "$help_text" ]; then
    help_text="$(timeout -s KILL 5 "$f" -h </dev/null 2>&1)" && ok=1 || ok=0
  fi
  if [ "$ok" -eq 1 ] && [ -n "$help_text" ]; then
      # Structured man markdown, not a fenced transcript. The old form gave
      # pandoc no title, so every page rendered "()" as its header and footer
      # instead of "HEE-VER(1)  HEE Tools  HEE-VER(1)", with no NAME,
      # SYNOPSIS or DESCRIPTION at all. Operator: "all pro style man for all
      # our shit."
      _rendered=0
      if [ -n "$HEE_MANPAGE_PY" ]; then
        if printf '%s\n' "$help_text" | PYTHONPATH="$PWD/library/py" python3 -c \
             'import sys, hee_manpage; sys.stdout.write(hee_manpage.render(sys.argv[1], sys.stdin.read(), int(sys.argv[2])))' \
             "$name" "$_sec" > "$out" 2>/dev/null && [ -s "$out" ]; then
          _rendered=1
        fi
      fi
      if [ "$_rendered" -eq 0 ]; then
        # Same structured rendering as the --help path. Without this the
        # 15 tools whose --help genuinely fails (hee-cache-prune errors with
        # "find: invalid argument") kept the old shape and still rendered
        # "()" as their header.
        _rendered=0
        if [ -n "$HEE_MANPAGE_PY" ]; then
          if printf '%s\n' "$header" | PYTHONPATH="$PWD/library/py" python3 -c \
               'import sys, hee_manpage; sys.stdout.write(hee_manpage.render(sys.argv[1], sys.stdin.read()))' \
               "$name" > "$out" 2>/dev/null && [ -s "$out" ]; then
            _rendered=1
            printf '\n*(no --help output -- generated from the script header comment)*\n' >> "$out"
          fi
        fi
        if [ "$_rendered" -eq 0 ]; then
          {
            echo "# $name(1)"
            echo
            echo "$header"
            echo
            echo "*(no --help/-h output -- generated from the script's own header comment)*"
          } > "$out"
        fi
      fi
    echo "generated (from --help): $out"
  else
    # No working --help -- fall back to the tool's own leading '#'
    # comment block (shell scripts document themselves this way in
    # this repo already; still 0-token, just a different extraction).
    header="$(extract_doc "$f" || true)"
    if [ -n "$header" ]; then
      {
        echo "# $name(1)"
        echo
        echo "$header"
        echo
        echo "*(no --help/-h output -- generated from the script's own header comment)*"
      } > "$out"
      echo "generated (from header, no --help): $out"
    else
      echo "SKIPPED (no --help and no header comment): $name" >&2
    fi
  fi
done

{
  echo "# HEE Tooling Reference"
  echo
  echo "Auto-generated by \`tooling/bin/hee-gen-manpages\` -- mechanical extraction"
  echo "of each tool's own --help output, not hand-written. Re-run after any"
  echo "tool change; do not hand-edit the per-tool files, edit the tool's"
  echo "--help text instead so this stays accurate."
  echo
  for f in "$OUT_DIR"/*.[1-9].md; do
    n="$(basename "$f" | sed 's/\.[1-9]\.md$//')"
    [ "$n" = "README" ] && continue
    echo "- [\`$n\`]($n.1.md)"
  done

# Compiled-language tools (Go, Rust) live as SOURCE under cmd/, not as an
# executable in tooling/bin, so the loop above never saw them. cmd/hee is
# already Go. Without this they are silently absent from the man pages --
# the operator asked specifically that py/go/rust all be captured.
#
# A built binary is preferred when present (its --help is the real thing);
# otherwise the leading doc comment is extracted, same as any other tool.
for d in cmd/*/; do
  [ -d "$d" ] || continue
  name="$(basename "$d")"
  src=""
  [ -f "$d/main.go" ] && src="${d%/}/main.go"
  [ -f "$d/src/main.rs" ] && src="${d%/}/src/main.rs"
  [ -n "$src" ] || continue

  _sec="$(man_section "$f")"
  out="$OUT_DIR/$name.$_sec.md"
  if [ -e "$out" ] || [ -n "$(authored_page_for "$name")" ]; then
    # NOT a conflict -- the same tool at two rungs of the maturity ladder.
    # Operator, 2026-08-31: "what conflict, this is _the_ hee we are building
    # now. one damn script at a time. we are working _towards_ cmd/hee.go".
    # Rule 13 has a tool climb sh -> py -> Go/Rust, so tooling/bin/hee (sh,
    # current) and cmd/hee/main.go (Go, destination) are one tool mid-climb.
    # One page documents the tool, not the implementation, so the existing
    # page stands and the Go source is simply noted as the next rung.
    echo "ladder: $name also has $src (next rung) -- existing page kept" >&2
    continue
  fi

  help_text=""
  if [ -x "${d%/}/$name" ]; then
    help_text="$(timeout -s KILL 5 "${d%/}/$name" --help </dev/null 2>&1)" || help_text=""
  fi
  if [ -n "$help_text" ]; then
    { echo "# $name(1)"; echo; echo '```'; printf '%s\n' "$help_text"; echo '```'; } > "$out"
    echo "generated (from --help, compiled): $out"
  else
    header="$(extract_doc "$src" || true)"
    if [ -n "$header" ]; then
      { echo "# $name(1)"; echo; echo "$header"; echo
        echo "*(no built binary -- generated from the doc comment in $src)*"; } > "$out"
      echo "generated (from source doc comment): $out"
    else
      echo "SKIPPED (no binary, no doc comment): $src" >&2
    fi
  fi
done

  if [ -n "$authored_kept" ]; then
    echo
    echo "## Hand-authored pages (authoritative)"
    echo
    echo "These live in \`man/\` and are written by hand. They are NOT"
    echo "regenerated: an authored page has real man structure, while a"
    echo "generated one is a fenced \`--help\` dump. Any tool consuming this"
    echo "index -- installer, publisher, freshness check -- must prefer these."
    echo
    for _a in $authored_kept; do
      echo "- [$_a](../$_a.1) -- authored"
    done
  fi
} > "$OUT_DIR/README.md"
# REDACT HOME PATHS FROM EVERY GENERATED PAGE.
#
# Pages are built from each tool's --help, verbatim, so any tool that prints a
# resolved absolute path bakes THAT MACHINE's homedir into checked-in docs.
# That already happened once and has its own incident: fleet-ops#352,
# "man-page regen tool run under Spencer's own account, baked his personal
# homedir path into checked-in docs".
#
# Caught again here, 2026-08-31, on 8 pages -- including one caused by this
# very tool, whose help had started printing its own resolved output path.
# Fixing the four offending tools one at a time would not stop the fifth, so
# the guard belongs at the point of writing.
#
# ~/ is the org's own convention for a portable home-relative path, and is
# what PROMPTING_RULES already requires in shared scripts.
for _p in "$OUT_DIR"/*.[1-9].md "$OUT_DIR"/README.md; do
  [ -f "$_p" ] || continue
  if grep -q '/home/[a-z]' "$_p" 2>/dev/null; then
    sed -i 's#/home/[a-z][a-z0-9_-]*/#~/#g' "$_p"
    echo "redacted home path: $_p"
  fi
done

# A tool that no longer EXISTS leaves its page behind forever, and the pandoc
# pass below regenerates the roff from that orphaned .md on every run -- so
# the page outlives the tool and keeps re-creating itself. Same class as the
# stale-section orphan handled per-tool above, but that check only visits
# tools that are still here, so it cannot see a deletion.
#
# Caught 2026-09-01 the same way the first one was: the dry run predicted 4
# removals after two tools were deleted, and --write performed none. The dry
# run and the real run must never disagree.
#
# Everything under man/tools/ is generated -- authored pages live in
# man/manN/ -- so "no matching tool in BIN_DIR" is sufficient to remove it.
for _pg in "$OUT_DIR"/*.[1-9].md "$OUT_DIR"/man[1-9]/*.[1-9]; do
  [ -f "$_pg" ] || continue
  _base="$(basename "$_pg")"
  case "$_base" in README.md) continue ;; esac
  _tool="${_base%.[1-9].md}"; _tool="${_tool%.[1-9]}"
  if [ ! -f "$BIN_DIR/$_tool" ]; then
    rm -f "$_pg"
    echo "  removed page for a tool that no longer exists: $_pg"
  fi
done

echo "index: $OUT_DIR/README.md"

# Real md -> real roff man(1) conversion, 2026-08-30. The .1.md files
# above are the real source; these .1 files are what a real `man`
# command (or gophernicus, which serves plain real man-format text)
# actually wants. Requires pandoc -- skip conversion with a clear
# message rather than fail the whole run if it's not installed.
if command -v pandoc >/dev/null 2>&1; then
  for f in "$OUT_DIR"/*.[1-9].md; do
    n="$(basename "$f" | sed 's/\.[1-9]\.md$//')"
    [ "$n" = "README" ] && continue
    _s="$(basename "$f" | sed 's/^.*\.\([1-9]\)\.md$/\1/')"
    mkdir -p "$OUT_DIR/man$_s"
    pandoc -s -f markdown-smart -t man "$f" -o "$OUT_DIR/man$_s/$n.$_s" 2>/dev/null && \
      echo "converted (real roff): $OUT_DIR/man$_s/$n.$_s" || \
      echo "SKIPPED roff conversion (pandoc error): $n" >&2
  done
else
  echo "pandoc not found -- skipping real .1.md -> .1 roff conversion" >&2
fi

if [ "$WRITE" -eq 0 ]; then
  exec 1>&3
  report_plan "$OUT_DIR" "$REAL_OUT" "pages ($REAL_OUT)"
  printf '\nNothing was written. Re-run with --write to apply.\n'
fi
