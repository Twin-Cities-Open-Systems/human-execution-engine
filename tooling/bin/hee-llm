#!/usr/bin/env python3
# section: 1
"""hee-llm -- give a local model work, not access: a checkout in, a patch out

SYNOPSIS
  hee-llm job start NAME (--repo DIR [--ref REF] | --from PATH) [--dry-run]
  hee-llm job ask NAME "PROMPT" [--allow-write] [--allow-shell] [--read-also DIR ...]
                 [--max-steps N] [--max-tokens N] [--max-result-chars N] [--repo-name NAME] [--json]
  hee-llm job collect NAME --out DIR [--repo-name NAME]
  hee-llm job list
  hee-llm job rm NAME
  hee-llm tools [--allow-write] [--allow-shell]
  hee-llm [VERB] help

  Every verb takes --host HOST, --vmid N and --endpoint URL, or reads
  HEE_LLM_HOST, HEE_LLM_VMID and HEE_LLM_ENDPOINT. There are no defaults: a
  fleet's node, container and endpoint are fleet state, not engine state.

DESCRIPTION
  Operator, 2026-10-16: "where should it keep its git worktrees? how do we
  allow it access?" Inside its own container, and it is given work, not
  access. The model server (llama-server with --agent) runs its built-in
  tools inside its own process, as its own user, from the unit's
  WorkingDirectory. This tool is the dispatcher's side of that:

  start    `git archive` of DIR at REF (tracked files only; no .git, no
           untracked secrets), shipped over `ssh root@HOST pct exec VMID`
           into /var/lib/llm/work/NAME/<repo>, then `git init`, one baseline
           commit and a `baseline` tag inside, so the model's edits are a
           diff against a known tree. Or --from PATH: a path INSIDE the
           container (a read-only mirror on a share, say) copied into the
           job, history kept, nothing over the wire; the `baseline` tag is
           its HEAD. (Copied, not cloned: git refuses to read another user's
           tree as a repository.) Exactly one of --repo and --from.
  ask      the tool loop over the OpenAI-compatible API. The server's tool
           definitions (GET /tools) are passed with the prompt; by default
           only the read-only ones (read_file, file_glob_search, grep_search,
           get_info). --allow-write adds write_file and edit_file,
           --allow-shell adds exec_shell_command, each per job. Every call is
           guarded: a path outside the job's root is refused and the model
           is told so; --read-also DIR (repeatable) lets the READ-ONLY tools
           look under DIR too (other repositories on a mirror), while the
           write tools stay held to the root; a shell command is run with
           `cd` into the root. Calls
           execute on the server (POST /tools) and their results go back to
           the model until it answers in text or --max-steps (default 8) is
           spent. Each tool result is clipped to --max-result-chars (default
           6000) before the model sees it, with a note saying so: a whole
           file as one result overran an 8192-token server (2026-10-17).
           The transcript of tool calls is printed; --json dumps it.
  collect  commits whatever the model left uncommitted (as hee-llm, not as
           anyone's identity), then `git format-patch baseline` into
           DIR/NAME.patch, also kept at /var/lib/llm/out/NAME/ in the
           container. Apply with `git am` on a branch of your own and review
           it like any other change; the PR is yours, signed by you.
  list     the jobs present under /var/lib/llm/work.
  rm       removes the job's work and out directories.
  tools    the tool names the loop would allow with the given flags.

  What never happens: no repository credential enters the container, no
  push leaves it, and nothing the model writes reaches a repo unreviewed.
  Why the shell tool is off by default: the fleet's bench (hee bench) shows
  this class of model answering that it may run `pct destroy` itself.

EXAMPLES
  $ hee-llm tools                                                              # ci
  $ hee-llm tools --allow-write --allow-shell                                  # ci
  $ hee-llm job start ci-demo --repo . --ref HEAD --host pve.example --vmid 1 --dry-run   # ci
  $ hee-llm job start ci-demo --from /data/storage/git/repo --host pve.example --vmid 1 --dry-run   # ci
  $ HEE_LLM_HOST=10.0.0.153 HEE_LLM_VMID=120 hee-llm job start fix-readme --repo ~/git/fleet-ops --ref origin/main
  $ HEE_LLM_ENDPOINT=http://10.0.0.169:8080 hee-llm job ask fix-readme "Which manifests under pve/services lack onboot? Read them."
  $ hee-llm job ask fix-readme --allow-write "Fix the typo 'recieve' in pve/llm/README.md."
  $ hee-llm job start audit --from /data/storage/git/fleet-ops && hee-llm job ask audit --read-also /data/storage/git "Which hosts in inventory are not in pve/services?"
  $ hee-llm job collect fix-readme --out /tmp/fix-readme && git am /tmp/fix-readme/fix-readme.patch
  $ hee-llm job rm fix-readme

  The live examples are not marked for CI: they need a node and a model.

EXIT STATUS
  0  OK        done; ask: the model answered
  1  WARNING   ask: the step budget ran out before a final answer
  2  CRITICAL  a refusal: bad name, git archive failed, the node or server
               said no, collect produced nothing
  3  UNKNOWN   usage error, no host/vmid/endpoint, server unreachable

ENVIRONMENT
  HEE_LLM_HOST       the pve node (ssh root@HOST)
  HEE_LLM_VMID       the container's vmid
  HEE_LLM_ENDPOINT   the model server (http://host:port), for ask and tools
  HEE_LLM_MODEL      model name in requests (default "default")

FILES
  /var/lib/llm/work/NAME/<repo>/   the job's checkout, in the container
  /var/lib/llm/out/NAME/NAME.patch what collect produced, in the container
  DIR/NAME.patch                   the same, locally

SEE ALSO
  hee-bench(1), hee-pve-deploy(8), hee-pve-dispatch(1), library/py/hee_llm
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "library" / "py"))
import hee_llm as L
from hee_cli import help_wanted, note_ignored
from hee_status import ArgumentParser, Status, emit, exit_with

VALUE_FLAGS = ("--host", "--vmid", "--endpoint", "--repo", "--ref", "--out", "--max-steps", "--max-tokens", "--repo-name", "--from", "--read-also", "--max-result-chars")


def _node(args):
    host = args.host or os.environ.get("HEE_LLM_HOST") or ""
    vmid = args.vmid or os.environ.get("HEE_LLM_VMID") or ""
    return host, vmid


def _endpoint(args) -> str:
    ep = args.endpoint or os.environ.get("HEE_LLM_ENDPOINT")
    if not ep:
        raise SystemExit("no endpoint: --endpoint URL or HEE_LLM_ENDPOINT")
    return ep


def cmd_tools(args) -> int:
    for n in L.allowed_tools(args.allow_write, args.allow_shell):
        print(n)
    return 0


def cmd_start(args) -> int:
    host, vmid = _node(args)
    if not args.dry_run:
        L.pct_shell(host, vmid, "true")       # refuses early with the exact missing setting
    res = L.start(args.name, args.repo, host=host, vmid=vmid or "0", ref=args.ref, dry_run=args.dry_run, from_path=args.from_path)
    if res["dry_run"]:
        what = f"copy {res['from']} inside the container" if res["from"] else f"ship {res['bytes']} bytes of {res['repo']} at {res['ref']}"
        print(f"would {what} to {res['root']} on vmid {vmid or '?'} of {host or '?'}")
        print(f"inside: {res['shell']}")
        emit(Status.OK, "dry run: nothing shipped")
        return 0
    src = f"copied from {res['from']}" if res["from"] else f"{res['repo']} at {res['ref']} ({res['bytes']} bytes)"
    emit(Status.OK, f"job {res['name']}: {src} is at {res['root']} with a baseline tag")
    return 0


def cmd_ask(args) -> int:
    host, vmid = _node(args)
    ep = _endpoint(args)
    repo_name = args.repo_name or L.repo_name_of(args.name, host=host, vmid=vmid)
    root = L.job_root(args.name, repo_name)
    allow = L.allowed_tools(args.allow_write, args.allow_shell)
    res = L.ask(ep, root, args.prompt, allow=allow, max_steps=args.max_steps, max_tokens=args.max_tokens,
                model=os.environ.get("HEE_LLM_MODEL") or "default", read_roots=tuple(args.read_also or ()),
                max_result_chars=args.max_result_chars,
                log=None if args.json else (lambda m: print(f"  tool: {m}")))
    if args.json:
        print(json.dumps({"answer": res["answer"], "steps": res["steps"], "stopped": res["stopped"]}, indent=1))
    else:
        print(res["answer"])
    if res["stopped"]:
        emit(Status.WARNING, f"{len(res['steps'])} tool step(s), no final answer", stream=sys.stderr)
        return 1
    emit(Status.OK, f"{len(res['steps'])} tool step(s)", stream=sys.stderr)
    return 0


def cmd_collect(args) -> int:
    host, vmid = _node(args)
    res = L.collect(args.name, args.out, host=host, vmid=vmid, repo_name=args.repo_name)
    if res["commits"] == 0:
        emit(Status.CRITICAL, f"job {res['name']}: no change against baseline; {res['path']} is empty")
        return 2
    emit(Status.OK, f"job {res['name']}: {res['commits']} commit(s), {res['bytes']} bytes -> {res['path']}; "
                    f"apply with: git am {res['path']}")
    return 0


def cmd_list(args) -> int:
    host, vmid = _node(args)
    jobs = L.list_jobs(host=host, vmid=vmid)
    for j in jobs:
        print(j)
    emit(Status.OK, f"{len(jobs)} job(s) under {L.WORK}", stream=sys.stderr)
    return 0


def cmd_rm(args) -> int:
    host, vmid = _node(args)
    L.remove(args.name, host=host, vmid=vmid)
    emit(Status.OK, f"removed job {args.name} (work and out)")
    return 0


def _common(p):
    p.add_argument("--host")
    p.add_argument("--vmid")
    p.add_argument("--endpoint")


def build_parser() -> ArgumentParser:
    ap = ArgumentParser(prog="hee-llm", add_help=False)
    _common(ap)
    sub = ap.add_subparsers(dest="verb", required=True)

    p = sub.add_parser("tools", add_help=False)
    _common(p)
    p.add_argument("--allow-write", action="store_true")
    p.add_argument("--allow-shell", action="store_true")
    p.set_defaults(fn=cmd_tools)

    job = sub.add_parser("job", add_help=False)
    js = job.add_subparsers(dest="jverb", required=True)

    p = js.add_parser("start", add_help=False)
    _common(p)
    p.add_argument("name")
    p.add_argument("--repo")
    p.add_argument("--from", dest="from_path")
    p.add_argument("--ref", default="HEAD")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(fn=cmd_start)

    p = js.add_parser("ask", add_help=False)
    _common(p)
    p.add_argument("name")
    p.add_argument("prompt")
    p.add_argument("--allow-write", action="store_true")
    p.add_argument("--allow-shell", action="store_true")
    p.add_argument("--read-also", action="append")
    p.add_argument("--max-steps", type=int, default=8)
    p.add_argument("--max-tokens", type=int, default=512)
    p.add_argument("--max-result-chars", type=int, default=L.MAX_RESULT_CHARS)
    p.add_argument("--repo-name")
    p.add_argument("--json", action="store_true")
    p.set_defaults(fn=cmd_ask)

    p = js.add_parser("collect", add_help=False)
    _common(p)
    p.add_argument("name")
    p.add_argument("--out", required=True)
    p.add_argument("--repo-name")
    p.set_defaults(fn=cmd_collect)

    p = js.add_parser("list", add_help=False)
    _common(p)
    p.set_defaults(fn=cmd_list)

    p = js.add_parser("rm", add_help=False)
    _common(p)
    p.add_argument("name")
    p.set_defaults(fn=cmd_rm)
    return ap


def main() -> int:
    argv = sys.argv[1:]
    if help_wanted(argv, VALUE_FLAGS) or not argv:
        note_ignored(argv, value_flags=VALUE_FLAGS)
        print(__doc__.strip())
        return 0
    args = build_parser().parse_args(argv)
    try:
        return args.fn(args)
    except L.LlmError as e:
        msg = str(e)
        if msg.startswith(("no node", "no container")) or "unreachable" in msg:
            raise SystemExit(msg)
        emit(Status.CRITICAL, msg)
        return 2


if __name__ == "__main__":
    exit_with(main)
