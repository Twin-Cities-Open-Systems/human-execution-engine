#!/usr/bin/env python3
# section: 1
"""hee-pve-health: real, 0-token health check for a pve node and every
LXC on it -- node resources, real storage overcommit ratio (allocated
vs. actual thin-pool size, not just "used"), and per-container status.

Real trigger (2026-08-24, Spencer): "write a quick tool to get an
overall health of the pve and of our infra" -- after standing up 8
real containers via hee-pve-deploy and hitting a real, growing thin-
pool overcommit (48GB allocated on a 32GB pool) with no single command
to see that at a glance.

Usage:
  hee-pve-health status [--host IP] [--node NAME] [--json]
  hee-pve-health warn [--host IP] [--node NAME] [--overcommit-max N]
                 -- exit 1 if real overcommit ratio (allocated/pool)
                    exceeds N (default 3.0x), or any container isn't
                    'running', otherwise exit 0 silently.
"""
import argparse
import os
import re
import json
import ssl
import subprocess
import sys
import urllib.error
import urllib.request

# library/py lives in this tool's own repo -- derive it from this script's
# own location, resolved through symlinks, never from the repo the tool
# happens to be invoked against.
from pathlib import Path as _Path  # noqa: E402
sys.path.insert(0, str(_Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored  # noqa: E402

# Real KISS fallback (Spencer, live): not every real account has SSH
# root access to pve (by design -- see fleet-ops#285's real user/token
# work). A scoped API token already exists for exactly this
# (spencer@pve!hee-cli, heeLabVM+PVEAuditor, verified working). If SSH
# isn't available, fall back to the real HTTPS API using that token --
# same pvesh-style path, no new flags, no user action needed beyond
# having sealed the token once (hee-cred -seal pve-api-token-spencer).
_TOKEN_ID = "spencer@pve!hee-cli"
_TOKEN_ACCOUNT = "pve-api-token-spencer"
_SSL_CTX = ssl.create_default_context()
_SSL_CTX.check_hostname = False
_SSL_CTX.verify_mode = ssl.CERT_NONE


def _token_api_json(host, path):
    script_dir = __file__.rsplit("/", 1)[0]
    tool = script_dir + "/hee-cred"
    secrets_dir = script_dir + "/../../.hee/secrets"  # real repo root, where -seal put it
    # hee-cred passes the secret via $HEE_CRED_PASS to the exec'd
    # command only -- relay it out through a tiny real subprocess so it
    # never touches this process's own argv/stdout, just an in-memory
    # env var handoff.
    relay = subprocess.run(
        [sys.executable, tool, "-pass", _TOKEN_ACCOUNT, "-dir", secrets_dir, "-exec",
         sys.executable, "-c", "import os,sys; sys.stdout.write(os.environ['HEE_CRED_PASS'])"],
        capture_output=True, text=True,
    )
    if relay.returncode != 0:
        return None
    secret = relay.stdout.strip()
    if not secret:
        return None
    req = urllib.request.Request(
        f"https://{host}:8006/api2/json{path}",
        headers={"Authorization": f"PVEAPIToken={_TOKEN_ID}={secret}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=5, context=_SSL_CTX) as r:
            return json.loads(r.read().decode())["data"]
    except (urllib.error.URLError, urllib.error.HTTPError, KeyError, json.JSONDecodeError):
        return None


def pvesh_json(host, path):
    proc = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", f"root@{host}", "pvesh", "get", path, "--output-format", "json"],
        capture_output=True, text=True,
    )
    if proc.returncode == 0:
        return json.loads(proc.stdout)

    token_result = _token_api_json(host, path)
    if token_result is not None:
        return token_result

    sys.exit(f"hee-pve-health: pvesh get {path} failed (SSH and API-token fallback both "
             f"failed):\n{proc.stderr}")


def gather(host, node):
    node_status = pvesh_json(host, f"/nodes/{node}/status")
    storages = pvesh_json(host, f"/nodes/{node}/storage")
    lxcs = pvesh_json(host, f"/nodes/{node}/lxc")

    # Real overcommit: sum of every LXC's configured rootfs size against
    # the real backing pool's total capacity -- pvesh's own per-storage
    # "total" is the real pool size; maxdisk summed across LXCs on that
    # storage is what's actually been promised out of it.
    rootdir_storages = {s["storage"]: s for s in storages if "rootdir" in s.get("content", "")}
    allocated_by_storage = {}
    for c in lxcs:
        cfg = pvesh_json(host, f"/nodes/{node}/lxc/{c['vmid']}/config")
        rootfs = cfg.get("rootfs", "")
        for sname in rootdir_storages:
            if rootfs.startswith(f"{sname}:"):
                allocated_by_storage[sname] = allocated_by_storage.get(sname, 0) + c.get("maxdisk", 0)

    return node_status, rootdir_storages, allocated_by_storage, lxcs



def _container_rows(args):
    """(vmid, name, address, state) per container, plus the DNS map.

    Shared by `inventory` and `map` on purpose. These two render the same
    facts in two shapes, and the whole point of both is that they cannot
    disagree with the machine -- so they must not disagree with each other
    either. A second copy of this loop would be the fourth instance of the
    shape that produced three divergent TCOS taxonomies.

    Returns (None, {}) when pve is unreachable; callers decide how loud to be.
    """
    try:
        _, _, _, lxcs = gather(args.host, args.node)
    except SystemExit:
        return None, {}

    # DNS is the zone's stated SSOT; use it when present, shrug when not.
    dns = {}
    if getattr(args, "dns", None) and os.path.isfile(args.dns):
        for line in open(args.dns, encoding="utf-8", errors="replace"):
            line = line.strip()
            if not line.startswith("="):
                continue
            parts = line[1:].split(":")
            if len(parts) >= 2:
                dns[parts[0].strip()] = parts[1].strip()      # name -> address

    rows = []
    for c in sorted(lxcs, key=lambda x: int(x.get("vmid", 0))):
        vmid = c.get("vmid", "?")
        name = c.get("name") or "(unnamed)"
        state = c.get("status", "unknown")
        ip = ""
        try:
            cfg = pvesh_json(args.host, f"/nodes/{args.node}/lxc/{vmid}/config")
            net0 = cfg.get("net0", "")
            for field in net0.split(","):
                if field.startswith("ip="):
                    ip = field[3:].split("/")[0]
        except SystemExit:
            ip = ""            # tolerated: one unreadable config is not a failure
        # A dhcp lease is not an address. Fall back to what DNS asserts,
        # matching on the short name either side of the tcos- prefix.
        if ip in ("", "dhcp"):
            short = name.replace("tcos-", "")
            for host_name, addr in dns.items():
                if host_name.split(".")[0] in (name, short):
                    ip = addr
                    break
        rows.append((vmid, name, ip or "dhcp", state))
    return rows, dns


def _haproxy_backends(via, vmid):
    """Real backend -> address edges, read from the running haproxy.

    THIS IS THE POINT OF THE WHOLE SUBCOMMAND. The hand-drawn map in
    issue:408@fleet-ops asserted edges that no file anywhere declares: the
    pve/services/*.yaml specs carry template, storage, cores, memory and
    bridge, and nothing about what talks to what. Measured 2026-09-08, two
    of its edges were simply wrong -- it drew haproxy fronting `soju`, which
    has no backend at all, and marked `thesis-engine` a stub while it served
    two live backends.

    So the edges come from haproxy's own config on the running container.
    Returns {} and says nothing when unreachable; the caller reports that
    rather than quietly drawing an edgeless graph, because a map with no
    lines looks like a fleet with no connections.
    """
    cmd = ("pct exec %d -- sh -c "
           "'cat /etc/haproxy/haproxy.cfg 2>/dev/null'" % vmid)
    try:
        out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                              via, cmd], capture_output=True, text=True, timeout=45)
    except Exception:
        return {}
    if out.returncode != 0 or not out.stdout.strip():
        return {}

    backends, cur = {}, None
    for line in out.stdout.splitlines():
        st = line.strip()
        m = re.match(r"^(backend|listen)\s+(\S+)", st)
        if m:
            cur = m.group(2)
            backends.setdefault(cur, [])
            continue
        if cur and st.startswith("server "):
            parts = st.split()
            if len(parts) >= 3 and ":" in parts[2]:
                backends[cur].append(parts[2].split(":")[0])
        if st.startswith("frontend "):
            cur = None
    return {k: v for k, v in backends.items() if v}


def _mermaid_id(name):
    """A mermaid-safe node id. Hyphens and dots break the parser unquoted."""
    return re.sub(r"[^A-Za-z0-9_]", "_", name)


def _undeclared(lines, declared):
    """Node ids used on an edge but never declared. Empty set means renderable."""
    used = set()
    for ln in lines:
        m = re.match(r"^\s*([A-Za-z0-9_]+)\s*-{2,3}>?\|?", ln)
        if m and not ln.strip().startswith(("subgraph", "class", "end")):
            used.add(m.group(1))
        m2 = re.search(r"-->(?:\|[^|]*\|)?\s*([A-Za-z0-9_]+)", ln)
        if m2:
            used.add(m2.group(1))
    return used - declared


def cmd_map(args):
    """Emit the pve topology as mermaid, from the machine rather than memory.

    issue:408@fleet-ops: "generate it, don't draw it". The map it carries was
    drawn by hand on 2026-09-06 and had drifted in six measured ways by
    2026-09-08 -- two containers missing, two mislabelled as stubs while
    running, one name stale, and one edge to a backend that does not exist.
    """
    if args.proposed:
        return _cmd_map_proposed(args)

    rows, _ = _container_rows(args)
    if rows is None:
        print("❓ UNKNOWN hee-pve-health map: cannot reach pve -- map not rendered", file=sys.stderr)
        return 3

    backends = _haproxy_backends(args.haproxy_via, args.haproxy_vmid)
    by_ip = {ip: (vmid, name) for vmid, name, ip, _ in rows}

    # The haproxy container is the graph's entry point, so edges leave the
    # node that really terminates them rather than a floating label.
    hap_id = None
    for vmid, name, ip, _ in rows:
        if int(vmid) == int(args.haproxy_vmid):
            hap_id = _mermaid_id(name)

    out, declared = [], set()
    out.append("graph TD")
    out.append("  lan([LAN · gateway])")
    declared.add("lan")
    out.append(f'  pvehost["pve host API<br/>{args.host}"]')
    declared.add("pvehost")
    out.append('  subgraph pve["pve host · vmbr0"]')
    for vmid, name, ip, state in rows:
        nid = _mermaid_id(name)
        stopped = "" if state == "running" else "<br/>STOPPED"
        out.append(f'    {nid}["{name}<br/>{ip} · {vmid}{stopped}"]')
        declared.add(nid)
    out.append("  end")
    if hap_id:
        out.append(f"  lan --> {hap_id}")

    # Edges, and ONLY edges something real declares. An address haproxy
    # serves that is not a container on this node is drawn as the pve host
    # itself when it matches, and otherwise skipped and counted -- never
    # invented, and never silently dropped.
    drawn, skipped = 0, []
    for be, addrs in sorted(backends.items()):
        for a in addrs:
            hit = by_ip.get(a)
            if hit and hap_id:
                out.append(f"  {hap_id} -->|{be}| {_mermaid_id(hit[1])}")
                drawn += 1
            elif a == args.host and hap_id:
                out.append(f"  {hap_id} -->|{be}| pvehost")
                drawn += 1
            else:
                skipped.append(f"{be}->{a}")
    out.append("  classDef stopped stroke-dasharray:4 3")
    stopped_ids = [_mermaid_id(n) for _, n, _, st in rows if st != "running"]
    if stopped_ids:
        out.append("  class " + ",".join(stopped_ids) + " stopped")

    # A diagram that references a node it never declared does not render at
    # all -- it fails as a blank box in GitHub, which reads as "no data"
    # rather than "broken". Refuse to emit one.
    bad = _undeclared(out, declared)
    if bad:
        print("❌ CRITICAL hee-pve-health map: edge references undeclared node(s): "
              + ", ".join(sorted(bad)), file=sys.stderr)
        return 2

    print("```mermaid")
    for line in out:
        print(line)
    print("```")
    print()
    if backends:
        note = (f"_{len(rows)} containers and {drawn} haproxy route(s), read from the pve API and "
                f"the running haproxy config.")
        if skipped:
            # Say what was dropped. A quiet omission is how a map comes to
            # show fewer connections than the fleet really has.
            note += (f" **{len(skipped)} backend target(s) are not containers on this node "
                     f"and are not drawn: {', '.join(skipped)}.**")
        print(note + " Generated by `hee pve-health map` -- do not hand-edit._")
    else:
        # Loud, not silent. An edgeless map is a real result only if haproxy
        # really has no backends, and that is not what happened here.
        print(f"_{len(rows)} containers, read from the pve API. **haproxy was unreachable, so NO "
              f"routes are drawn** -- this map shows hosts only, not what talks to what. "
              f"Generated by `hee pve-health map` -- do not hand-edit._")
    return 0


def _cmd_map_proposed(args):
    """The proposed map, from the agent roster registry.

    Stamps the registry's OWN spec.status into the diagram title. The roster
    is `status: proposed` and says plainly that no agent is dispatched until
    its hire-authority Contract is ratified. A picture of unratified agents
    that does not say so is how `mx1` came to be called a stub in a
    disaster-recovery ticket.
    """
    if not os.path.isfile(args.roster):
        print(f"❓ UNKNOWN hee-pve-health map --proposed: no roster at {args.roster}", file=sys.stderr)
        return 3
    try:
        import yaml
    except ImportError:
        print("❓ UNKNOWN hee-pve-health map --proposed: pyyaml not available", file=sys.stderr)
        return 3
    doc = yaml.safe_load(open(args.roster, encoding="utf-8")) or {}
    spec = doc.get("spec", {}) or {}
    status = spec.get("status", "unknown")
    needs = spec.get("ratification_required_from", []) or []

    agents = []
    for key in ("agents", "roster", "narrow_agents"):
        if isinstance(spec.get(key), list):
            agents = spec[key]
            break
        if isinstance(spec.get(key), dict):
            agents = [dict(name=k, **(v or {})) for k, v in spec[key].items()]
            break

    boundaries = spec.get("common_boundaries", {}) or {}
    reach = boundaries.get("reach", "")

    out, declared = [], set()
    out.append("graph TD")
    label = f"PROPOSED · status={status}"
    if status != "ratified":
        label += " · NOT AUTHORIZED"
    out.append(f'  title["{label}"]')
    declared.add("title")
    out.append('  gh([GitHub])')
    declared.add("gh")
    out.append('  fac["container-factory<br/>mints a 1h scoped token per job"]')
    declared.add("fac")
    # One LXC each, per the roster's own common_boundaries.container. The
    # subgraph label says it so the picture cannot imply shared tenancy.
    out.append('  subgraph agents["narrow agents · one LXC each"]')
    if agents:
        for a in agents:
            nm = a.get("name", "agent")
            model = a.get("model", "unspecified")
            nid = _mermaid_id(nm)
            out.append(f'    {nid}["{nm}<br/>{model}"]')
            declared.add(nid)
    else:
        out.append('    none["roster declares no agents yet"]')
        declared.add("none")
    out.append("  end")

    # Every agent lands work through a pull request and reaches nothing else.
    # Drawn per-agent rather than from one collective node, because the
    # collective node was not a real thing and did not render.
    for a in agents:
        out.append(f'  fac --> {_mermaid_id(a.get("name", "agent"))}')
    for a in agents:
        out.append(f'  {_mermaid_id(a.get("name", "agent"))} -->|pull requests only| gh')

    out.append("  classDef banner fill:#7c2d12,color:#fff,stroke-width:0px")
    out.append("  classDef unratified stroke-dasharray:5 3")
    out.append("  class title banner")
    if agents:
        out.append("  class " + ",".join(_mermaid_id(a.get("name", "agent")) for a in agents) + " unratified")

    bad = _undeclared(out, declared)
    if bad:
        print("❌ CRITICAL hee-pve-health map --proposed: edge references undeclared node(s): "
              + ", ".join(sorted(bad)), file=sys.stderr)
        return 2

    print("```mermaid")
    for line in out:
        print(line)
    print("```")
    print()
    print(f"_Generated by `hee pve-health map --proposed` from "
          f"`{os.path.basename(args.roster)}` (spec.status = **{status}**"
          + (f", ratification required from {', '.join(needs)}" if needs else "")
          + "). Dashed means not built and not authorized._")
    if reach:
        print()
        print(f"_Boundary, quoted from the registry rather than redrawn: {reach}_")
    return 0


def cmd_inventory(args):
    """Render the container table from the machine, not from memory.

    Real trigger 2026-09-06: pve/addressing.md described mx1 as a stub with
    no MTA while OpenSMTPD 7.8.0 was installed, running and listening on
    four addresses, and omitted soju (vmid 111) entirely. Two drifts in one
    46-line file, both found by accident. A hand-kept table of live
    infrastructure is a promise nobody renews.

    Deliberately TOLERANT. A container the API cannot describe, a missing
    DNS file, an unresolvable name -- none of those are failures. They are
    rendered as what they are, because a generator that dies on one odd row
    teaches people to stop running it, and a table that omits what it could
    not explain is how mx1 stayed a stub in writing for weeks.
    """
    rows, dns = _container_rows(args)
    if rows is None:
        print("❓ UNKNOWN hee-pve-health inventory: cannot reach pve -- table not rendered", file=sys.stderr)
        return 3

    print("| vmid | hostname | address | state |")
    print("|---|---|---|---|")
    for vmid, name, ip, state in rows:
        flag = "" if state == "running" else f" **{state}**"
        print(f"| {vmid} | `{name}` | {ip} | {state}{flag and ''} |")
    print()
    print(f"_{len(rows)} containers, read from the pve API"
          + (f" with addresses from {os.path.basename(args.dns)}" if dns else "")
          + ". Generated by `hee pve-health inventory` -- do not hand-edit._")
    return 0

def cmd_status(args):
    node_status, rootdir_storages, allocated_by_storage, lxcs = gather(args.host, args.node)

    mem = node_status["memory"]
    cpu_pct = node_status["cpu"] * 100

    result = {
        "node": {"cpu_pct": round(cpu_pct, 1), "mem_used_mb": mem["used"] // 1024 // 1024,
                  "mem_total_mb": mem["total"] // 1024 // 1024, "uptime_s": node_status["uptime"]},
        "storage": {}, "lxc": [],
    }
    for sname, s in rootdir_storages.items():
        allocated = allocated_by_storage.get(sname, 0)
        result["storage"][sname] = {
            "pool_total_gb": round(s["total"] / 1e9, 1),
            "pool_used_gb": round(s["used"] / 1e9, 1),
            "allocated_gb": round(allocated / 1e9, 1),
            "overcommit_ratio": round(allocated / s["total"], 2) if s["total"] else 0,
        }
    totals = {"mem_mb": 0, "diskread_mb": 0, "diskwrite_mb": 0, "netin_mb": 0, "netout_mb": 0}
    for c in lxcs:
        entry = {
            "vmid": c["vmid"], "name": c["name"], "status": c["status"],
            # a template never runs; pvesh reports it as stopped (measured 2026-09-06, vmid 112)
            "template": bool(c.get("template", 0)),
            "cpu_pct": round(c.get("cpu", 0) * 100, 1),
            "mem_mb": c.get("mem", 0) // 1024 // 1024,
            "maxmem_mb": c.get("maxmem", 0) // 1024 // 1024,
            "diskread_mb": c.get("diskread", 0) // 1024 // 1024,
            "diskwrite_mb": c.get("diskwrite", 0) // 1024 // 1024,
            "netin_mb": c.get("netin", 0) // 1024 // 1024,
            "netout_mb": c.get("netout", 0) // 1024 // 1024,
            "uptime_s": c.get("uptime", 0),
        }
        result["lxc"].append(entry)
        for k in totals:
            totals[k] += entry.get(k, 0)
    result["totals"] = totals

    if args.json:
        print(json.dumps(result))
        return

    n = result["node"]
    print(f"node {args.node}: cpu {n['cpu_pct']}%  mem {n['mem_used_mb']}/{n['mem_total_mb']}MB  "
          f"uptime {n['uptime_s']//3600}h")
    for sname, s in result["storage"].items():
        flag = "🔴" if s["overcommit_ratio"] > 3 else ("🟡" if s["overcommit_ratio"] > 1 else "🟢")
        print(f"{flag} storage {sname}: pool {s['pool_total_gb']}GB, real used {s['pool_used_gb']}GB, "
              f"allocated {s['allocated_gb']}GB ({s['overcommit_ratio']}x overcommit)")
    for c in result["lxc"]:
        flag = "🟢" if c["status"] == "running" else "🔴"
        if args.nerd:
            h, rem = divmod(c['uptime_s'], 3600)
            m = rem // 60
            print(f"{flag} lxc {c['vmid']:>4} {c['name']:20} {c['status']:8} "
                  f"cpu {c['cpu_pct']:5.1f}%  mem {c['mem_mb']:5}/{c['maxmem_mb']:5}MB  "
                  f"disk r/w {c['diskread_mb']:6}/{c['diskwrite_mb']:6}MB  "
                  f"net in/out {c['netin_mb']:6}/{c['netout_mb']:6}MB  "
                  f"elapsed {h}h{m}m")
        else:
            print(f"{flag} lxc {c['vmid']:>4} {c['name']:20} {c['status']}")
    if args.nerd:
        t = result["totals"]
        print(f"🔹 totals across {len(result['lxc'])} container(s): mem {t['mem_mb']}MB  "
              f"disk r/w {t['diskread_mb']}/{t['diskwrite_mb']}MB  "
              f"net in/out {t['netin_mb']}/{t['netout_mb']}MB")


def cmd_warn(args):
    node_status, rootdir_storages, allocated_by_storage, lxcs = gather(args.host, args.node)
    bad = []
    for sname, s in rootdir_storages.items():
        allocated = allocated_by_storage.get(sname, 0)
        ratio = allocated / s["total"] if s["total"] else 0
        if ratio > args.overcommit_max:
            bad.append(f"storage {sname}: {ratio:.2f}x overcommit (max {args.overcommit_max})")
    for c in lxcs:
        if c.get("template"):
            continue  # a template never runs
        if c["status"] != "running":
            bad.append(f"lxc {c['vmid']} {c['name']}: status={c['status']}, not running")
    if bad:
        for line in bad:
            print(f"WARN: {line}", file=sys.stderr)
        sys.exit(1)
    sys.exit(0)


def main():
    ap = argparse.ArgumentParser(prog="hee-pve-health")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("status")
    s.add_argument("--host", default="10.0.0.153")
    s.add_argument("--node", default="pve")
    s.add_argument("--json", action="store_true")
    s.add_argument("--nerd", action="store_true",
                    help="per-container cpu/mem/disk-io/net-io/elapsed + totals (real stats-for-nerds)")
    i = sub.add_parser("inventory")
    i.add_argument("--host", default="10.0.0.153")
    i.add_argument("--node", default="pve")
    i.add_argument("--dns", default=os.path.expanduser("~/git/fleet-ops/dns/lab.tcos.us.hosts"),
                   help="tinydns-format zone file for addresses; skipped if absent")

    m = sub.add_parser("map")
    m.add_argument("--host", default="10.0.0.153")
    m.add_argument("--node", default="pve")
    m.add_argument("--dns", default=os.path.expanduser("~/git/fleet-ops/dns/lab.tcos.us.hosts"),
                   help="tinydns-format zone file for addresses; skipped if absent")
    m.add_argument("--haproxy-via", default="root@pve.lab.tcos.us",
                   help="ssh target that can `pct exec` the haproxy container; edges come from "
                        "its live config, because no file in the repo declares them")
    m.add_argument("--haproxy-vmid", type=int, default=103)
    m.add_argument("--proposed", action="store_true",
                   help="render the PROPOSED map from the agent roster instead of the live fleet, "
                        "stamped with the roster's own spec.status")
    m.add_argument("--roster",
                   default=os.path.expanduser("~/git/fleet-ops/hee/registries/agent-roster.registry.v1.yaml"),
                   help="agent roster registry, for --proposed")
    w = sub.add_parser("warn")
    w.add_argument("--host", default="10.0.0.153")
    w.add_argument("--node", default="pve")
    w.add_argument("--overcommit-max", type=float, default=3.0)
    # Contextual help BEFORE argparse parses anything. argparse owns -h and
    # --help but not the bare `help` verb, and resolves either only after
    # parsing -- so an unrelated argument errors first and the help never
    # prints. Measured: 8 tools exited non-zero for --help for exactly this
    # reason. See library/py/hee_cli.
    if help_wanted(sys.argv[1:]):
        note_ignored(sys.argv[1:])
        ap.print_help()
        return 0

    args = ap.parse_args()
    return {"status": cmd_status, "inventory": cmd_inventory,
            "warn": cmd_warn, "map": cmd_map}[args.cmd](args)


if __name__ == "__main__":
    main()
