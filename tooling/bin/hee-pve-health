#!/usr/bin/env python3
# section: 1
"""hee-pve-health: real, 0-token health check for a pve node and every
LXC on it -- node resources, real storage overcommit ratio (allocated
vs. actual thin-pool size, not just "used"), and per-container status.

Real trigger (2026-08-24, Spencer): "write a quick tool to get an
overall health of the pve and of our infra" -- after standing up 8
real containers via hee-pve-deploy and hitting a real, growing thin-
pool overcommit (48GB allocated on a 32GB pool) with no single command
to see that at a glance.

Usage:
  hee-pve-health status [--host IP] [--node NAME] [--json]
  hee-pve-health map [-src SRC] [-out FMT] [-diff MODE [-a SRC] [-b SRC]]
                     [-archive SPEC] [-o PATH]
                 -- four independent axes. -src is where the facts come from
                    (live|roster|target|pfsense), -out is the shape they are
                    rendered in (mmd|term|md|json|png), -diff is which
                    comparison runs (none|sub|add|both), -archive ranges over
                    the committed history of the map block.
                    --term, --proposed and --diff still work as aliases.
  hee-pve-health snmp [--host IP] [--node NAME] [--out PATH] [--repo PATH] [--json]
                 -- emit TCOS-MIB (PEN 66550) fleetTable as a sorted
                    OID/type/value table for the SNMP agent to serve. Joins
                    the roles git declares with the containers the node has.
  hee-pve-health templates [--host IP] [--node NAME] [--json] [--registry PATH]
                 -- compare the node's templates against the ones the
                    registry declares, in BOTH directions, and name any
                    stopped non-template guest as cruft.
  hee-pve-health warn [--host IP] [--node NAME] [--overcommit-max N]
                      [--registry PATH]
                 -- exit 1 if real overcommit ratio (allocated/pool)
                    exceeds N (default 3.0x), or any container isn't
                    'running', or a guest carries template=1 without being
                    in the registry; otherwise exit 0 silently.
"""
import argparse
import os
import difflib
import contextlib
import io
import re
import json
import ssl
import subprocess
import sys
import urllib.error
import urllib.request

# library/py lives in this tool's own repo -- derive it from this script's
# own location, resolved through symlinks, never from the repo the tool
# happens to be invoked against.
from pathlib import Path as _Path  # noqa: E402
sys.path.insert(0, str(_Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored  # noqa: E402
from hee_status import ArgumentParser, Status, emit, exit_with  # noqa: E402

# Real KISS fallback (Spencer, live): not every real account has SSH
# root access to pve (by design -- see fleet-ops#285's real user/token
# work). A scoped API token already exists for exactly this
# (spencer@pve!hee-cli, heeLabVM+PVEAuditor, verified working). If SSH
# isn't available, fall back to the real HTTPS API using that token --
# same pvesh-style path, no new flags, no user action needed beyond
# having sealed the token once (hee-cred -seal pve-api-token-spencer).
# Overridable, because they are per-operator, not properties of the fleet.
# Hardcoding one person's account is what made the API path dead for everyone
# else: the tool asked for `pve-api-token-spencer` in the hee checkout, while
# the real sealed credentials are `pve-api-token-factory` and
# `pve-api-token-touchy-claude` in fleet-ops, and the operator's own hee
# checkout holds `pve-admin-spencer`. Three names, none of them the one asked
# for. Measured 2026-09-08.
_TOKEN_ID = os.environ.get("HEE_PVE_TOKEN_ID", "spencer@pve!hee-cli")
_TOKEN_ACCOUNT = os.environ.get("HEE_PVE_TOKEN_ACCOUNT", "pve-api-token-spencer")
_CRED_DIR = os.environ.get("HEE_PVE_CRED_DIR", "")
_SSL_CTX = ssl.create_default_context()
_SSL_CTX.check_hostname = False
_SSL_CTX.verify_mode = ssl.CERT_NONE

# Which PVE guests are allowed to carry `template: 1`. Registry lives in
# fleet-ops beside the other fleet-state registries, not here: which templates
# this org keeps is fleet state, not doctrine -- the same reasoning that moved
# container-addons out of this repo on 2026-09-10. Overridable for a second
# checkout or a test fixture; the default matches `--roster` below.
_TEMPLATES_REGISTRY = os.environ.get(
    "HEE_PVE_TEMPLATES_REGISTRY",
    os.path.expanduser("~/git/fleet-ops/hee/registries/pve-templates.registry.v1.yaml"))


def _token_api_json(host, path):
    script_dir = __file__.rsplit("/", 1)[0]
    tool = script_dir + "/hee-cred"
    # HEE_PVE_CRED_DIR wins; otherwise this tool's own repo root. The default
    # is only correct when the credential happens to be sealed in the hee
    # checkout, which is not where fleet credentials actually live.
    secrets_dir = _CRED_DIR or (script_dir + "/../../.hee/secrets")
    # hee-cred passes the secret via $HEE_CRED_PASS to the exec'd
    # command only -- relay it out through a tiny real subprocess so it
    # never touches this process's own argv/stdout, just an in-memory
    # env var handoff.
    relay = subprocess.run(
        [sys.executable, tool, "-pass", _TOKEN_ACCOUNT, "-dir", secrets_dir, "-exec",
         sys.executable, "-c", "import os,sys; sys.stdout.write(os.environ['HEE_CRED_PASS'])"],
        capture_output=True, text=True,
    )
    if relay.returncode != 0:
        return None
    secret = relay.stdout.strip()
    if not secret:
        return None
    req = urllib.request.Request(
        f"https://{host}:8006/api2/json{path}",
        headers={"Authorization": f"PVEAPIToken={_TOKEN_ID}={secret}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=5, context=_SSL_CTX) as r:
            return json.loads(r.read().decode())["data"]
    except (urllib.error.URLError, urllib.error.HTTPError, KeyError, json.JSONDecodeError):
        return None


def pvesh_json(host, path):
    """The pve API first, ssh second.

    Reversed 2026-09-08. Operator: "should be using the api for pve anyway" --
    and the old order made ssh load-bearing, so clearing known_hosts took the
    whole tool down while the "fallback" had never worked. The API needs no
    host key and no shell on the node.
    """
    token_result = _token_api_json(host, path)
    if token_result is not None:
        return token_result

    proc = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", f"root@{host}",
         "pvesh", "get", path, "--output-format", "json"],
        capture_output=True, text=True,
    )
    if proc.returncode == 0:
        return json.loads(proc.stdout)

    # Name what was tried. "cannot reach pve" sent the operator to clear
    # known_hosts, which cannot help: ssh runs with BatchMode=yes and so can
    # never accept an unknown key -- an empty known_hosts fails identically.
    sys.exit(
        f"hee-pve-health: cannot read {path} from {host}.\n"
        f"  API token: account '{_TOKEN_ACCOUNT}' id '{_TOKEN_ID}' in "
        f"{_CRED_DIR or '<hee-repo>/.hee/secrets'} -- not usable.\n"
        f"  ssh root@{host}: exit {proc.returncode}: {(proc.stderr or '').strip().splitlines()[-1] if proc.stderr.strip() else 'no stderr'}\n"
        f"  Set HEE_PVE_TOKEN_ACCOUNT / HEE_PVE_TOKEN_ID / HEE_PVE_CRED_DIR to a sealed\n"
        f"  credential that exists, or add the host key (ssh runs BatchMode, so it will\n"
        f"  never accept one on its own)."
    )


def gather(host, node):
    node_status = pvesh_json(host, f"/nodes/{node}/status")
    storages = pvesh_json(host, f"/nodes/{node}/storage")
    lxcs = pvesh_json(host, f"/nodes/{node}/lxc")

    # Real overcommit: sum of every LXC's configured rootfs size against
    # the real backing pool's total capacity -- pvesh's own per-storage
    # "total" is the real pool size; maxdisk summed across LXCs on that
    # storage is what's actually been promised out of it.
    rootdir_storages = {s["storage"]: s for s in storages if "rootdir" in s.get("content", "")}
    allocated_by_storage = {}
    for c in lxcs:
        cfg = pvesh_json(host, f"/nodes/{node}/lxc/{c['vmid']}/config")
        rootfs = cfg.get("rootfs", "")
        for sname in rootdir_storages:
            if rootfs.startswith(f"{sname}:"):
                allocated_by_storage[sname] = allocated_by_storage.get(sname, 0) + c.get("maxdisk", 0)

    return node_status, rootdir_storages, allocated_by_storage, lxcs



_PVE_WHY = []


def _container_rows(args):
    """(vmid, name, address, state) per container, plus the DNS map.

    Shared by `inventory` and `map` on purpose. These two render the same
    facts in two shapes, and the whole point of both is that they cannot
    disagree with the machine -- so they must not disagree with each other
    either. A second copy of this loop would be the fourth instance of the
    shape that produced three divergent TCOS taxonomies.

    Returns (None, {}) when pve is unreachable; callers decide how loud to be.
    """
    try:
        _, _, _, lxcs = gather(args.host, args.node)
    except SystemExit as e:
        # Keep the REASON, the same way _HAPROXY_WHY does. This used to
        # swallow it, so every caller could say only "cannot reach pve" --
        # which reads identically for a wrong --host, an unsealed API token,
        # a firewalled node and a dead one. A checker that cannot say why it
        # failed trains people to assume the check, not the fleet, is broken.
        _PVE_WHY.append(str(e.code).strip() if e.code else "reason not reported")
        return None, {}

    # DNS is the zone's stated SSOT; use it when present, shrug when not.
    dns = {}
    if getattr(args, "dns", None) and os.path.isfile(args.dns):
        for line in open(args.dns, encoding="utf-8", errors="replace"):
            line = line.strip()
            if not line.startswith("="):
                continue
            parts = line[1:].split(":")
            if len(parts) >= 2:
                dns[parts[0].strip()] = parts[1].strip()      # name -> address

    rows = []
    for c in sorted(lxcs, key=lambda x: int(x.get("vmid", 0))):
        vmid = c.get("vmid", "?")
        name = c.get("name") or "(unnamed)"
        state = c.get("status", "unknown")
        ip = ""
        try:
            cfg = pvesh_json(args.host, f"/nodes/{args.node}/lxc/{vmid}/config")
            net0 = cfg.get("net0", "")
            for field in net0.split(","):
                if field.startswith("ip="):
                    ip = field[3:].split("/")[0]
        except SystemExit:
            ip = ""            # tolerated: one unreadable config is not a failure
        # A dhcp lease is not an address. Fall back to what DNS asserts,
        # matching on the short name either side of the tcos- prefix.
        if ip in ("", "dhcp"):
            short = name.replace("tcos-", "")
            for host_name, addr in dns.items():
                if host_name.split(".")[0] in (name, short):
                    ip = addr
                    break
        rows.append((vmid, name, ip or "dhcp", state))
    return rows, dns


_HAPROXY_WHY = []
_PVE_WHY = []


def _haproxy_raw(via, vmid):
    """The running haproxy config, verbatim, or None if it cannot be read.

    None means "could not read", never "empty". The difference is the whole
    point: a drift check that reads nothing and reports no drift is the
    namespace-audit failure (issue:423@fleet-ops) in a new costume.
    """
    cmd = ("pct exec %d -- sh -c "
           "'cat /etc/haproxy/haproxy.cfg 2>/dev/null'" % vmid)
    try:
        out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                              via, cmd], capture_output=True, text=True, timeout=45)
    except Exception as e:
        _HAPROXY_WHY.append(f"ssh to {via} failed: {e}")
        return None
    if out.returncode != 0:
        # Say WHY. Returning a bare None here is how an operator gets a map
        # with no routes and no idea that anything went wrong -- measured
        # 2026-09-08, a run under a different account produced an edgeless
        # map because its key could not reach the host.
        _HAPROXY_WHY.append(f"ssh to {via} exited {out.returncode}: "
                            f"{(out.stderr or '').strip().splitlines()[-1] if out.stderr.strip() else 'no stderr'}")
        return None
    if not out.stdout.strip():
        _HAPROXY_WHY.append(f"ct{vmid} returned an empty haproxy.cfg")
        return None
    return out.stdout


def _haproxy_stats(ip, port):
    """Live backend -> server routing, from haproxy's own stats CSV.

    HTTP, not ssh. The previous version shelled out to `ssh root@<fqdn> pct
    exec`, which hardcoded one FQDN and therefore worked only for whoever
    happened to have that exact name in known_hosts. Measured 2026-09-08: the
    operator's own account has `Host pve -> HostName 10.0.0.153` in
    ~/.ssh/config, so `ssh root@pve` worked while the tool's
    `root@pve.lab.tcos.us` failed host key verification and silently produced
    a map with no routes at all.

    The stats endpoint is better than the config file on its own terms: it is
    what haproxy is REALLY doing, including whether each server is UP, where
    the file only says what it was told.

    Returns a list of (backend, server, addr, status), or None with the reason
    recorded. None means "could not read", never "no routes".
    """
    url = f"http://{ip}:{port}/;csv"
    try:
        with urllib.request.urlopen(url, timeout=15) as r:
            body = r.read().decode("utf-8", "replace")
    except Exception as e:
        _HAPROXY_WHY.append(f"haproxy stats at {url}: {e}")
        return None

    lines = [l for l in body.splitlines() if l.strip()]
    if not lines or not lines[0].startswith("#"):
        _HAPROXY_WHY.append(f"haproxy stats at {url}: unexpected format")
        return None

    # Address the columns BY NAME. haproxy's CSV has ~200 fields and grows
    # between releases; a positional index silently reads the wrong column
    # after an upgrade.
    cols = [c.strip() for c in lines[0].lstrip("#").split(",")]
    def col(row, name):
        try:
            return row[cols.index(name)].strip()
        except (ValueError, IndexError):
            return ""

    out = []
    for line in lines[1:]:
        row = line.split(",")
        px, sv = col(row, "pxname"), col(row, "svname")
        if not px or sv in ("FRONTEND", "BACKEND", ""):
            continue
        addr = col(row, "addr").split(":")[0]
        out.append((px, sv, addr, col(row, "status")))
    if not out:
        _HAPROXY_WHY.append(f"haproxy stats at {url}: no server rows")
        return None
    return out


def _haproxy_backends_from_cfg(path):
    """{backend: [addresses]} parsed from the COMMITTED haproxy config.

    Topology comes from the repo, not the network, for three measured reasons.

    The ssh route hardcoded one FQDN and so worked only for whoever had that
    exact string in known_hosts -- 2026-09-08, the operator's own account had
    `Host pve -> HostName 10.0.0.153` and got a silent no-routes map. It also
    used BatchMode, which can never accept an unknown key, so clearing
    known_hosts made it worse rather than better.

    The stats endpoint cannot supply it either: its CSV `addr` column is empty
    on every server row here, so it knows liveness but not addresses.

    And the repo is the right source anyway -- `hee pve-health drift` proves
    the committed config still matches the running one, so reading the file is
    reading the machine, with the difference made loud instead of assumed.
    """
    if not os.path.isfile(path):
        _HAPROXY_WHY.append(f"no haproxy config at {path}")
        return {}
    backends, cur = {}, None
    for line in open(path, encoding="utf-8", errors="replace"):
        st = line.strip()
        m = re.match(r"^(backend|listen)\s+(\S+)", st)
        if m:
            cur = m.group(2)
            backends.setdefault(cur, [])
            continue
        if st.startswith("frontend "):
            cur = None
            continue
        if cur and st.startswith("server "):
            parts = st.split()
            if len(parts) >= 3 and ":" in parts[2]:
                backends[cur].append(parts[2].split(":")[0])
    out = {k: v for k, v in backends.items() if v}
    if not out:
        _HAPROXY_WHY.append(f"{path} declares no backend servers")
    return out


def _haproxy_live_status(ip, port):
    """{(backend, server): status} from the stats API, or {} if unreachable.

    Enrichment only. The map is still correct without it; a route that exists
    is a route whether or not this answers.
    """
    rows = _haproxy_stats(ip, port)
    return {} if rows is None else {(px, sv): st for px, sv, _a, st in rows}


def _haproxy_backends(ip, port):
    """{backend: [addresses]} from the live stats, DOWN servers included.

    A server that is DOWN is still a declared route; drawing only UP ones
    would make an outage look like a topology change.
    """
    rows = _haproxy_stats(ip, port)
    if rows is None:
        return {}
    backends = {}
    for px, _sv, addr, _st in rows:
        if addr:
            backends.setdefault(px, []).append(addr)
    return backends


def _mermaid_id(name):
    """A mermaid-safe node id. Hyphens and dots break the parser unquoted."""
    return re.sub(r"[^A-Za-z0-9_]", "_", name)


def _undeclared(lines, declared):
    """Node ids used on an edge but never declared. Empty set means renderable."""
    used = set()
    for ln in lines:
        m = re.match(r"^\s*([A-Za-z0-9_]+)\s*-{2,3}>?\|?", ln)
        if m and not ln.strip().startswith(("subgraph", "class", "end")):
            used.add(m.group(1))
        m2 = re.search(r"-->(?:\|[^|]*\|)?\s*([A-Za-z0-9_]+)", ln)
        if m2:
            used.add(m2.group(1))
    return used - declared


def _term_map(args, rows, backends, by_ip):
    """The same facts as the mermaid map, drawn for a terminal.

    Not a picture of a picture. Rendering mermaid to an image and then to
    cells would need a browser engine, and the only zero-install way to do it
    is to POST the topology to a public rendering service -- which would ship
    this lab's internal addressing to a third party. This draws from the same
    rows instead, so it needs nothing and leaks nothing.
    """
    hap = None
    for vmid, name, ip, _ in rows:
        if int(vmid) == int(args.haproxy_vmid):
            hap = (vmid, name, ip)

    w = max((len(n) for _, n, _, _ in rows), default=12)
    out = []
    out.append("LAN · gateway")
    if hap:
        out.append(f"  └─ {hap[1]} · {hap[0]} · {hap[2]}   ← ingress, every vhost")
        routes = []
        for be, addrs in sorted(backends.items()):
            for a in addrs:
                hit = by_ip.get(a)
                if hit:
                    routes.append((be, f"{hit[1]} · {hit[0]} · {a}"))
                elif a == args.host:
                    routes.append((be, f"pve host · {a}"))
                else:
                    routes.append((be, f"{a}  (not a container on this node)"))
        if routes:
            bw = max(len(b) for b, _ in routes)
            for i, (be, tgt) in enumerate(routes):
                tee = "└─" if i == len(routes) - 1 else "├─"
                out.append(f"       {tee} {be.ljust(bw)} → {tgt}")
        else:
            out.append("       (no routes read -- see the warning below)")
    out.append("")
    out.append(f"pve host · vmbr0 · {len(rows)} containers")
    for vmid, name, ip, state in rows:
        mark = "  " if state == "running" else "!!"
        tail = "" if state == "running" else f"   {state.upper()}"
        out.append(f"  {mark} {str(vmid).ljust(4)} {name.ljust(w)}  {ip}{tail}")
    return out


# ---------------------------------------------------------------------
# THE AXES.
#
# `map` grew three flags that look like siblings and are not: --term is an
# OUTPUT FORMAT, --proposed is a SOURCE SELECTOR, and --diff is a COMPARISON
# MODE. Three different questions in one flat namespace, which is why
# `--term --diff` and `--proposed --term` each meant something the names did
# not say. Spencer's sketch splits them, and this is that split:
#
#   -src      where the facts come from
#   -out      what shape they are rendered in
#   -diff     which comparison runs, over -a and -b
#   -archive  which historical revisions to range over
#
# Every old flag survives as an alias. Nothing that worked stops working.
# ---------------------------------------------------------------------

_OUT_CHOICES = ("mmd", "term", "md", "json", "png", "svg")
_DIFF_CHOICES = ("none", "sub", "add", "both", "diff")
_MARKER = "pve-map"

# The AUTHORED blocks. These are extracted and re-emitted, NEVER regenerated.
# fleet-ops#443 wrote the rule down: "network-map.md is generated because it
# describes what is running, and reality drifts without anyone deciding it
# should. This describes what we intend, and intent changes only when a person
# changes it, in a commit, under review. Generate what reality says, author
# what you intend." A tool that printed "Generated by `hee pve-health map`"
# under a hand-drawn diagram would be lying about where the picture came from.
_AUTHORED = {
    "target": ("~/git/fleet-ops/pve/network-172.16-migration.md", "pve-target"),
    "pfsense": ("~/git/fleet-ops/pve/network-172.16-migration.md", "pve-pfsense"),
}
# The GENERATED block, and the file whose history `-archive` ranges over.
_GENERATED_MD = "~/git/fleet-ops/pve/network-map.md"


def _resolve_out(args):
    """-out wins, --term is its alias, `mmd` is the default.

    MMD IS THE DEFAULT AND THAT IS NOT TASTE. cmd_drift calls
    _capture(cmd_map, args), and both pve/network-map.md and the meme-factory
    jobs consume mermaid, so any other default silently breaks `drift`.
    """
    out = getattr(args, "out", None)
    if out:
        return out
    return "term" if getattr(args, "term", False) else "mmd"


def _resolve_src(args):
    """-src wins, --proposed is its alias for `roster`.

    --proposed DOES NOT RENDER A PROPOSED INFRASTRUCTURE. It renders the
    proposed AGENT ROSTER. The proposed infrastructure is a different artifact
    in a different repo -- the authored pve-target/pve-pfsense blocks, reached
    as `-src target` / `-src pfsense`. The old flag is kept because callers
    exist; its help now says which of the two it is.
    """
    src = getattr(args, "src", None)
    if src:
        return src
    return "roster" if getattr(args, "proposed", False) else "live"


def _resolve_diff(args):
    """-diff MODE, a bare --diff, or neither.

    `--diff` was a store_true and must keep working, so the flag takes an
    OPTIONAL value whose const is `both` -- which is what the boolean always
    meant. #645 prints A-B as TO BUILD and B-A as UNDECLARED in one run; the
    two directions were already there, they just had no names.

    Reads True as well as a string because cmd_drift mirrors this flag as a
    plain store_true and hands its own namespace to cmd_map.
    """
    d = getattr(args, "diff", None)
    if d is True:
        return "both"
    if not d:
        return "none"
    return "both" if d == "diff" else d


def _fence(text):
    """The lines inside a ```mermaid fence, or None. Loud by omission: the
    caller reports "no fence" rather than rendering an empty diagram."""
    if not text:
        return None
    m = re.search(r"```mermaid\n(.*?)\n```", text, re.S)
    return m.group(1).splitlines() if m else None


def _git_show(md_path, rev, block):
    """A marker block as it was COMMITTED at REV, or (None, why).

    git is the archive. The rendered-PNG store is not: it is one fixed
    filename per job, clobbered on every render, and its .meta.json carries no
    timestamp at all -- so there is no series there to range over. What the
    .meta.json does carry is `commit`, which is the join key back into this.
    """
    repo = os.path.dirname(os.path.abspath(md_path))
    r = subprocess.run(["git", "-C", repo, "show", f"{rev}:./{os.path.basename(md_path)}"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None, (r.stderr or "").strip().splitlines()[-1:] or ["git show failed"]
    txt = r.stdout
    a = txt.find(f"<!-- {block}:start -->")
    b = txt.find(f"<!-- {block}:end -->")
    if a < 0 or b < 0 or b < a:
        return None, [f"no {block} block at {rev}"]
    return txt[a + len(f"<!-- {block}:start -->"):b].strip("\n"), None


def _archive_commits(md_path):
    """(ordinal, sha, date, subject) per commit that touched MD_PATH, newest
    first. Ordinal 1 is newest, so `-archive 1-5` reads as "the last five"."""
    p = os.path.abspath(md_path)
    repo = os.path.dirname(p)
    r = subprocess.run(["git", "-C", repo, "log", "--follow", "--format=%h\t%cs\t%s",
                        "--", p], capture_output=True, text=True)
    if r.returncode != 0:
        return None, (r.stderr or "git log failed").strip()
    rows = []
    for i, line in enumerate(r.stdout.splitlines(), start=1):
        parts = line.split("\t", 2)
        if len(parts) == 3:
            rows.append((str(i), parts[0], parts[1], parts[2]))
    return rows, None


def _find_renderer(args):
    """The ONE local renderer, or None. $HEE_DIAGRAM_RUN, then -renderer, then
    the default fleet-ops path. There is no hosted fallback and there must
    never be one: these maps carry the lab's internal addressing and its
    haproxy backend names, so an off-host render is an exfiltration."""
    for cand in (os.environ.get("HEE_DIAGRAM_RUN"),
                 getattr(args, "renderer", None),
                 os.path.expanduser("~/git/fleet-ops/tools/meme-factory/diagram/run.sh")):
        if cand and os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


def _render_image(args, lines):
    """-out png: DRIVE the renderer we already have, never become a second one.

    Writes the generated block to a temp markdown and a temp job JSON, then
    execs tools/meme-factory/diagram/run.sh. diagram.py's resolve_source()
    already accepts an absolute `source`, which also skips its repo_root()
    git requirement -- so nothing here needs the block to be committed first.
    """
    if _resolve_out(args) == "svg":
        emit(Status.UNKNOWN,
             "-out svg is not implemented here on purpose: meme-factory/diagram's run() "
             "calls PIL.Image.open().size and og_card() unconditionally and both are "
             "raster-only. Teaching it vector output is a fleet-ops change; building it "
             "here would mean a second renderer by accident.")
        return Status.UNKNOWN
    dest = getattr(args, "output", None)
    if not dest:
        emit(Status.CRITICAL, "-out png needs -o PATH -- where the render should land")
        return Status.CRITICAL
    runner = _find_renderer(args)
    if runner is None:
        emit(Status.UNKNOWN, "-out png: no local renderer found. Tried $HEE_DIAGRAM_RUN, "
                             "-renderer, and ~/git/fleet-ops/tools/meme-factory/diagram/run.sh. "
                             "No hosted renderer is used as a fallback.")
        return Status.UNKNOWN

    import tempfile
    tmpdir = tempfile.mkdtemp(prefix="hee-pve-health-map.")
    md = os.path.join(tmpdir, "map.md")
    with open(md, "w", encoding="utf-8") as f:
        f.write(f"<!-- {_MARKER}:start -->\n```mermaid\n" + "\n".join(lines)
                + f"\n```\n<!-- {_MARKER}:end -->\n")
    job = {
        "source": md, "block": _MARKER, "output": os.path.abspath(dest),
        "theme": "dark", "background": "#0b0f11", "width": 3200, "scale": 2,
        "title": f"pve network map · {_resolve_src(args)}",
        # Say what the render IS. diagram.py stamps .meta.json's `commit` from
        # the RENDERER's checkout, which for a live read is not a commit that
        # contains this map. Naming it here keeps the picture honest about a
        # provenance field that would otherwise over-claim.
        "eyebrow": f"hee pve-health map · -src {_resolve_src(args)} · live read, not from a commit",
        "host": getattr(args, "node", "pve"),
    }
    jobf = os.path.join(tmpdir, "map.diagram.json")
    with open(jobf, "w", encoding="utf-8") as f:
        json.dump(job, f, indent=1, sort_keys=True)
    r = subprocess.run([runner, jobf], capture_output=True, text=True)
    if r.returncode != 0:
        emit(Status.CRITICAL, f"renderer exited {r.returncode}: "
                              f"{(r.stderr or r.stdout).strip().splitlines()[-1:] or ['no output']}")
        return Status.CRITICAL
    print(r.stdout.strip())
    emit(Status.OK, f"rendered {dest} locally via {runner}")
    return Status.OK


def _emit_graph(args, lines, note):
    """One exit for every -out that produces a graph.

    The `mmd` branch is deliberately byte-for-byte what this tool printed
    before the axes existed -- it is what pve/network-map.md, the meme-factory
    jobs and cmd_drift all consume.
    """
    out = _resolve_out(args)
    if out == "mmd":
        print("```mermaid")
        for line in lines:
            print(line)
        print("```")
        print()
        print(note)
        return 0
    if out == "md":
        print(f"<!-- {_MARKER}:start -->")
        print("```mermaid")
        for line in lines:
            print(line)
        print("```")
        print()
        print(note)
        print(f"<!-- {_MARKER}:end -->")
        return 0
    if out == "json":
        print(json.dumps({"src": _resolve_src(args), "block": _MARKER,
                          "mermaid": lines, "note": note}, indent=1))
        return 0
    if out in ("png", "svg"):
        return _render_image(args, lines)
    emit(Status.CRITICAL, f"-out {out} is not a renderable target here")
    return Status.CRITICAL


def _cmd_map_authored(args, src):
    """`-src target` / `-src pfsense`: extract and re-emit. NEVER regenerate.

    These blocks are AUTHORED (fleet-ops#443). The provenance line says so,
    because reprinting "Generated by `hee pve-health map`" over a diagram a
    person drew would be a lie about where the picture came from.
    """
    rel, block = _AUTHORED[src]
    path = os.path.expanduser(rel)
    text = _block(path, block)
    if text is None:
        emit(Status.UNKNOWN, f"-src {src}: no {block} block in {path}")
        return Status.UNKNOWN
    lines = _fence(text)
    if lines is None:
        emit(Status.UNKNOWN, f"-src {src}: no ```mermaid fence inside the {block} block")
        return Status.UNKNOWN
    note = (f"_Extracted verbatim from the authored `{block}` block in "
            f"`{os.path.basename(path)}` -- **authored, not generated**. "
            f"`hee pve-health map` re-emits it and never redraws it._")
    return _emit_graph(args, lines, note)


def _cmd_map_archive(args):
    """-archive SPEC: range over the COMMITTED history of the map block.

    The selector is library/py/hee_range.resolve_spec, the org's one range
    implementation -- an ordinal id/range list (1-5 = the last five, newest
    first) or a case-insensitive regex over "<sha> <date> <subject>". Not a
    second copy of a selector that already exists twice.
    """
    from hee_range import resolve_spec  # the org's one selector, not a copy

    md = os.path.expanduser(_GENERATED_MD)
    if not os.path.isfile(md):
        emit(Status.UNKNOWN, f"-archive: no {md} to range over")
        return Status.UNKNOWN
    commits, err = _archive_commits(md)
    if err:
        emit(Status.UNKNOWN, f"-archive: {err}")
        return Status.UNKNOWN
    if not commits:
        emit(Status.UNKNOWN, f"-archive: git records no commit touching {md} -- "
                             "that is not an empty archive, it is an unreadable one")
        return Status.UNKNOWN

    picked = resolve_spec(args.archive, commits,
                          lambda c: c[0],
                          lambda c: f"{c[1]} {c[2]} {c[3]}")
    if not picked:
        emit(Status.WARNING, f"-archive {args.archive!r} matched none of "
                             f"{len(commits)} commit(s) touching {os.path.basename(md)}")
        return Status.WARNING

    out = _resolve_out(args)
    print(f"archive: {os.path.basename(md)} · {_MARKER} · "
          f"{len(picked)} of {len(commits)} commit(s)")
    print()
    rc = Status.OK
    for ordinal, sha, date, subject in picked:
        text, why = _git_show(md, sha, _MARKER)
        head = f"{ordinal:>3}  {sha}  {date}  {subject}"
        if text is None:
            print(f"{head}   [no block: {'; '.join(why)}]")
            rc = Status.WARNING
            continue
        lines = _fence(text)
        if lines is None:
            print(f"{head}   [no ```mermaid fence]")
            rc = Status.WARNING
            continue
        if out == "term":
            # A historical block is mermaid text, not rows -- _term_map needs
            # rows it cannot have. The table is the honest terminal answer.
            print(f"{head}   [{len(lines)} line(s)]")
            continue
        print(f"<!-- {sha} · {date} · {subject} -->")
        _emit_graph(args, lines, f"_Committed at `{sha}` ({date}). Extracted from git, "
                                 f"not re-read from the machine._")
        print()
    sys.stdout.flush()
    emit(rc, f"-archive {args.archive!r}: {len(picked)} of {len(commits)} commit(s) selected "
             f"via hee_range")
    return rc


def cmd_map(args):
    """Emit the pve topology as mermaid, from the machine rather than memory.

    issue:408@fleet-ops: "generate it, don't draw it". The map it carries was
    drawn by hand on 2026-09-06 and had drifted in six measured ways by
    2026-09-08 -- two containers missing, two mislabelled as stubs while
    running, one name stale, and one edge to a backend that does not exist.
    """
    out, src, mode = _resolve_out(args), _resolve_src(args), _resolve_diff(args)

    if out not in _OUT_CHOICES:
        emit(Status.CRITICAL, f"-out {out}: not one of {', '.join(_OUT_CHOICES)}")
        return Status.CRITICAL

    # Refuse what argv alone already decides, BEFORE the pve read. Measured:
    # `-out svg` and `-out png` with no -o each spent 34s reading the node and
    # the running haproxy config before failing on a condition known at parse
    # time. Nothing is learned by that read, and a tool that makes you wait
    # half a minute for a usage error trains people to stop running it.
    if out == "svg":
        return _render_image(args, [])
    if out == "png" and not getattr(args, "output", None):
        emit(Status.CRITICAL, "-out png needs -o PATH -- where the render should land")
        return Status.CRITICAL

    # A diff is a REPORT, not a graph. Refused rather than rendered as
    # something arbitrary: nobody has decided what a diff picture should look
    # like, and if one is wanted the A-only/B-only distinction has to live in
    # the NODE LABEL TEXT (TO BUILD / UNDECLARED), never stroke color alone.
    if mode != "none" and out in ("png", "svg"):
        emit(Status.CRITICAL,
             f"-diff {mode} with -out {out} has no defined picture: a diff renders a "
             "text report, not a graph. Use -out term or -out json.")
        return Status.CRITICAL

    if getattr(args, "archive", None):
        return _cmd_map_archive(args)
    if mode != "none":
        return _cmd_map_diff(args)
    if src in _AUTHORED:
        return _cmd_map_authored(args, src)
    if src == "roster":
        return _cmd_map_proposed(args)
    if src != "live":
        emit(Status.CRITICAL, f"-src {src}: not one of live, roster, "
                              f"{', '.join(_AUTHORED)}")
        return Status.CRITICAL

    rows, _ = _container_rows(args)
    if rows is None:
        print("❓ UNKNOWN hee-pve-health map: cannot reach pve -- map not rendered ("
              + ("; ".join(_PVE_WHY) or "reason not reported") + ")", file=sys.stderr)
        return 3

    backends = _haproxy_backends_from_cfg(args.haproxy_cfg)
    by_ip = {ip: (vmid, name) for vmid, name, ip, _ in rows}

    # The haproxy container is the graph's entry point, so edges leave the
    # node that really terminates them rather than a floating label.
    hap_id = None
    for vmid, name, ip, _ in rows:
        if int(vmid) == int(args.haproxy_vmid):
            hap_id = _mermaid_id(name)

    mmd_lines, declared = [], set()
    mmd_lines.append("graph TD")
    mmd_lines.append("  lan([LAN · gateway])")
    declared.add("lan")
    mmd_lines.append(f'  pvehost["pve host API<br/>{args.host}"]')
    declared.add("pvehost")
    mmd_lines.append('  subgraph pve["pve host · vmbr0"]')
    for vmid, name, ip, state in rows:
        nid = _mermaid_id(name)
        stopped = "" if state == "running" else "<br/>STOPPED"
        mmd_lines.append(f'    {nid}["{name}<br/>{ip} · {vmid}{stopped}"]')
        declared.add(nid)
    mmd_lines.append("  end")
    if hap_id:
        mmd_lines.append(f"  lan --> {hap_id}")

    # Edges, and ONLY edges something real declares. An address haproxy
    # serves that is not a container on this node is drawn as the pve host
    # itself when it matches, and otherwise skipped and counted -- never
    # invented, and never silently dropped.
    drawn, skipped = 0, []
    for be, addrs in sorted(backends.items()):
        for a in addrs:
            hit = by_ip.get(a)
            if hit and hap_id:
                mmd_lines.append(f"  {hap_id} -->|{be}| {_mermaid_id(hit[1])}")
                drawn += 1
            elif a == args.host and hap_id:
                mmd_lines.append(f"  {hap_id} -->|{be}| pvehost")
                drawn += 1
            else:
                skipped.append(f"{be}->{a}")
    mmd_lines.append("  classDef stopped stroke-dasharray:4 3")
    stopped_ids = [_mermaid_id(n) for _, n, _, st in rows if st != "running"]
    if stopped_ids:
        mmd_lines.append("  class " + ",".join(stopped_ids) + " stopped")

    # A diagram that references a node it never declared does not render at
    # all -- it fails as a blank box in GitHub, which reads as "no data"
    # rather than "broken". Refuse to emit one.
    bad = _undeclared(mmd_lines, declared)
    if bad:
        print("❌ CRITICAL hee-pve-health map: edge references undeclared node(s): "
              + ", ".join(sorted(bad)), file=sys.stderr)
        return 2

    if out == "term":
        for line in _term_map(args, rows, backends, by_ip):
            print(line)
        print()
        # stdout is block-buffered when piped and emit() writes to stderr
        # unbuffered, so without this flush the warning lands ABOVE the map it
        # is warning about -- or gets cut off by a pager. Measured 2026-09-08.
        sys.stdout.flush()
        if backends:
            emit(Status.OK, f"{len(rows)} containers, {drawn} route(s), read from the machine")
        else:
            # LOUD. An edgeless map is a real result only if haproxy really
            # has no backends, and that is not what happens when ssh fails.
            for why in _HAPROXY_WHY:
                emit(Status.CRITICAL, f"haproxy not read -- {why}")
            emit(Status.CRITICAL,
                 "NO ROUTES DRAWN. This shows hosts only, not what talks to what.")
        return 0

    if backends:
        note = (f"_{len(rows)} containers and {drawn} haproxy route(s), read from the pve API and "
                f"the running haproxy config.")
        if skipped:
            # Say what was dropped. A quiet omission is how a map comes to
            # show fewer connections than the fleet really has.
            note += (f" **{len(skipped)} backend target(s) are not containers on this node "
                     f"and are not drawn: {', '.join(skipped)}.**")
        note += " Generated by `hee pve-health map` -- do not hand-edit._"
    else:
        # Loud, not silent. An edgeless map is a real result only if haproxy
        # really has no backends, and that is not what happened here.
        why = ("; ".join(_HAPROXY_WHY)) or "reason not reported"
        note = (f"_{len(rows)} containers, read from the pve API. **haproxy was unreachable, so NO "
                f"routes are drawn** ({why}) -- this map shows hosts only, not what talks to what. "
                f"Generated by `hee pve-health map` -- do not hand-edit._")
    return _emit_graph(args, mmd_lines, note)


def _load_roster(path):
    """(spec, agents, error) from the agent roster registry.

    ONE reader, shared by `--proposed` and `--diff` on purpose. Two readers
    of the same registry is how a picture and a build queue come to disagree
    about what was declared -- the same shape that produced three divergent
    TCOS taxonomies. `agents` is normalized to a list of dicts each carrying
    `name`, whether the registry writes a dict keyed by role (it does today)
    or a list.

    Every failure is an error string, never an empty roster. "The file did
    not parse" and "the roster declares no agents" are different facts and a
    build queue that confuses them is worse than no build queue.
    """
    if not os.path.isfile(path):
        return None, [], f"no roster at {path}"
    try:
        import yaml
    except ImportError:
        return None, [], "pyyaml not available"
    try:
        doc = yaml.safe_load(open(path, encoding="utf-8")) or {}
    except Exception as e:
        return None, [], f"{os.path.basename(path)} did not parse: {e}"
    spec = doc.get("spec", {}) or {}
    agents = []
    for key in ("agents", "roster", "narrow_agents"):
        if isinstance(spec.get(key), list):
            agents = spec[key]
            break
        if isinstance(spec.get(key), dict):
            # role key wins over any `name:` inside the body -- the key is
            # what the rest of the registry references.
            agents = [{**(v or {}), "name": k} for k, v in spec[key].items()]
            break
    return spec, agents, None


def _norm(s):
    """Loose comparison form: lowercase, non-alphanumerics to hyphens, and
    the `tcos-` hostname prefix dropped (ct109/ct112/ct113 carry it, the
    other eleven do not)."""
    return re.sub(r"^tcos-", "", re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-"))


def _match_kind(role, name):
    """How a role name relates to a container name, or None.

    THIS IS A GUESS ABOUT NAMING AND NOTHING MORE. It is spelled out as four
    named cases rather than one regex so the output can say WHICH weak thing
    it did, and so a reader can see that none of them is a recorded binding.
    """
    r, n = _norm(role), _norm(name)
    if r == n:
        return "container name IS the role name"
    if r in n:
        return "role name appears in the container name"
    # Guarded: a two- or three-character container name is inside far too
    # many words to mean anything (`mx1`, `ns1`, `view`).
    if len(n) >= 5 and n in r:
        return "container name appears in the role name"
    rt, nt = set(r.split("-")), set(n.split("-"))
    if rt and rt <= nt:
        return "every word of the role appears in the container name"
    return None


_DIFF_CAVEAT = """MATCH IS HEURISTIC, AND IT IS THE WEAKEST PART OF THIS OUTPUT.
No role -> container binding is recorded anywhere in this org today. The roster
refuses to record one on purpose -- common_boundaries.container: "allocated by
hee name from the durable pool ... This registry records the role; the name is
not hardcoded here." So there is no key to join on, and the only signal left is
whether the role name happens to turn up in the container name.

What that cannot know, stated rather than papered over:
  * A container built for a role and named from the durable pool shares no
    substring with it. It reads here as UNDECLARED and as TO BUILD at the same
    time -- one real thing counted as two wrong ones.
  * A name that matches proves a naming coincidence, not that the container
    runs that role, is scoped to it, or has a ratified contract.
  * Nothing here reads the model an agent actually runs, so a matched row says
    nothing about the model-drift footgun the roster names.
This becomes a real join, not a guess, when issue:434@fleet-ops step 1 lands:
an allocation record in git binding role -> hostname -> vmid. Until then the
UNDECLARED list is the honest answer and it is supposed to be long."""


def _cmd_map_diff(args):
    """Roster minus machine. That difference IS the build queue.

    issue:434@fleet-ops step 4. Two pictures already existed and nothing
    subtracted one from the other: `map` renders what the pve API says does
    exist, `map --proposed` renders what the roster says should exist, and
    the queue between them lived only in somebody's head.

    FAILS CLOSED, which is the whole point. Either side unreadable is UNKNOWN
    (exit 3), never an empty build queue -- "nothing to build" from a tool
    that could not see the machine is exactly how `namespace-audit` reported
    OK across 17 repos it had never read (issue:423@fleet-ops).
    """
    mode = _resolve_diff(args)
    a_src, b_src = getattr(args, "a_src", "roster"), getattr(args, "b_src", "live")
    # Only one pair can be joined today, and saying so beats pretending.
    # The roster refuses to record a role -> container binding on purpose, so
    # there is no key to join arbitrary sources on -- the same reason this
    # subcommand's own caveat calls its match a guess. An unsupported pair is
    # refused rather than silently answered against the wrong sides.
    if (a_src, b_src) != ("roster", "live"):
        emit(Status.CRITICAL,
             f"-diff {mode} -a {a_src} -b {b_src}: only `-a roster -b live` is joinable "
             "today. No role -> container binding is recorded anywhere in this org, so "
             "there is no key to join any other pair on (issue:434@fleet-ops step 1).")
        return Status.CRITICAL

    spec, agents, err = _load_roster(args.roster)
    if err:
        emit(Status.UNKNOWN, f"roster not read: {err}")
        emit(Status.UNKNOWN, "the DECLARED side is missing -- this is not an empty build queue")
        return Status.UNKNOWN

    rows, _ = _container_rows(args)
    if rows is None:
        for why in (_PVE_WHY or ["reason not reported"]):
            emit(Status.UNKNOWN, f"pve not read: {why}")
        emit(Status.UNKNOWN, "the MEASURED side is missing -- this is not an empty build queue")
        return Status.UNKNOWN

    status = spec.get("status", "unknown")
    no_model = (spec.get("no_model", {}) or {}).get("entries", {}) or {}
    by_name = {name: (vmid, ip, state) for vmid, name, ip, state in rows}

    def candidates(role):
        return [(n, k) for n in by_name if (k := _match_kind(role, n))]

    claimed, to_build, matched, ambiguous = set(), [], [], []
    for a in agents:
        role = a.get("name", "agent")
        hits = candidates(role)
        claimed.update(n for n, _ in hits)
        if not hits:
            to_build.append((role, a.get("model", "unspecified")))
        elif len(hits) == 1:
            matched.append((role, hits[0][0], hits[0][1]))
        else:
            ambiguous.append((role, hits))

    deterministic = []
    for role in sorted(no_model):
        hits = candidates(role)
        claimed.update(n for n, _ in hits)
        deterministic.append((role, [n for n, _ in hits]))

    undeclared = [(v, n, ip, st) for v, n, ip, st in rows if n not in claimed]

    print(f"declared: {os.path.basename(args.roster)}  spec.status = {status}"
          + ("  ·  NOT AUTHORIZED" if status != "ratified" else ""))
    print(f"measured: pve node {args.node} via {args.host}  ·  {len(rows)} containers, read live")
    print()
    print(_DIFF_CAVEAT)
    print()

    if mode in ("sub", "both"):
        print(f"TO BUILD -- declared by the roster, no container matches ({len(to_build)})")
        for role, model in to_build:
            print(f"     {role.ljust(18)} {model}")
        if not to_build:
            print("     (none)")
        print()

    if mode == "both":
        print(f"MATCHED (heuristically) -- one candidate container ({len(matched)})")
        for role, name, why in matched:
            vmid, ip, st = by_name[name]
            print(f"     {role.ljust(18)} -> ct{vmid} {name} {ip} {st}   [{why}]")
        if not matched:
            print("     (none -- not one roster role's name occurs in any container name)")
        print()

    if ambiguous and mode in ("sub", "both"):
        print(f"AMBIGUOUS -- more than one container matches, so none is the answer ({len(ambiguous)})")
        for role, hits in ambiguous:
            print(f"     {role.ljust(18)} -> " + ", ".join(n for n, _ in hits))
        print()

    if mode == "both":
        print(f"DECLARED WITH NO MODEL -- roster names these as deterministic, not agents ({len(deterministic)})")
        for role, hits in deterministic:
            print(f"     {role.ljust(18)} " + (", ".join(hits) if hits else "(no container matches)"))
        print("     Not in the build queue: the roster lists them so a later session cannot")
        print("     mistake the absence of an agent for an oversight.")
        print()

    if mode in ("add", "both"):
        print(f"UNDECLARED -- running, no roster role matches ({len(undeclared)})")
        for vmid, name, ip, st in undeclared:
            print(f"     ct{str(vmid).ljust(4)} {name.ljust(22)} {ip.ljust(12)} {st}")
        print("     REPORTED, NOT AN ERROR. Most of this fleet predates the roster, which")
        print("     covers agent roles only and never claimed to describe the whole node.")
        print()

    if not agents:
        emit(Status.UNKNOWN, "the roster declares no agents -- nothing to subtract, so this is not a pass")
        return Status.UNKNOWN

    queue = len(to_build) + len(ambiguous)
    if queue and status == "ratified":
        # Only once the roster is real intent. A ratified role with nothing
        # running is a promise the fleet is not keeping.
        emit(Status.WARNING, f"{queue} ratified role(s) unbuilt or unresolved")
        return Status.WARNING
    if queue:
        # Deliberately not red on day one (rule 16). The roster is `proposed`
        # and says no agent is dispatched before its hire-authority Contract
        # is ratified -- so an unbuilt role is the correct state, not a fault.
        emit(Status.OK, f"build queue is {queue} role(s); roster is `{status}`, so unbuilt is correct")
    else:
        emit(Status.OK, "every declared role has a candidate container")
    emit(Status.OK, f"diff ran against a live pve read: {len(rows)} containers, "
                    f"{len(agents)} declared role(s), {len(undeclared)} undeclared")
    return Status.OK


def _cmd_map_proposed(args):
    """The proposed map, from the agent roster registry.

    Stamps the registry's OWN spec.status into the diagram title. The roster
    is `status: proposed` and says plainly that no agent is dispatched until
    its hire-authority Contract is ratified. A picture of unratified agents
    that does not say so is how `mx1` came to be called a stub in a
    disaster-recovery ticket.
    """
    spec, agents, err = _load_roster(args.roster)
    if err:
        print(f"❓ UNKNOWN hee-pve-health map --proposed: {err}", file=sys.stderr)
        return 3
    status = spec.get("status", "unknown")
    needs = spec.get("ratification_required_from", []) or []

    boundaries = spec.get("common_boundaries", {}) or {}
    reach = boundaries.get("reach", "")

    out, declared = [], set()
    out.append("graph TD")
    label = f"PROPOSED · status={status}"
    if status != "ratified":
        label += " · NOT AUTHORIZED"
    out.append(f'  title["{label}"]')
    declared.add("title")
    out.append('  gh([GitHub])')
    declared.add("gh")
    out.append('  fac["container-factory<br/>mints a 1h scoped token per job"]')
    declared.add("fac")
    # One LXC each, per the roster's own common_boundaries.container. The
    # subgraph label says it so the picture cannot imply shared tenancy.
    out.append('  subgraph agents["narrow agents · one LXC each"]')
    if agents:
        for a in agents:
            nm = a.get("name", "agent")
            model = a.get("model", "unspecified")
            nid = _mermaid_id(nm)
            out.append(f'    {nid}["{nm}<br/>{model}"]')
            declared.add(nid)
    else:
        out.append('    none["roster declares no agents yet"]')
        declared.add("none")
    out.append("  end")

    # Every agent lands work through a pull request and reaches nothing else.
    # Drawn per-agent rather than from one collective node, because the
    # collective node was not a real thing and did not render.
    for a in agents:
        out.append(f'  fac --> {_mermaid_id(a.get("name", "agent"))}')
    for a in agents:
        out.append(f'  {_mermaid_id(a.get("name", "agent"))} -->|pull requests only| gh')

    out.append("  classDef banner fill:#7c2d12,color:#fff,stroke-width:0px")
    out.append("  classDef unratified stroke-dasharray:5 3")
    out.append("  class title banner")
    if agents:
        out.append("  class " + ",".join(_mermaid_id(a.get("name", "agent")) for a in agents) + " unratified")

    bad = _undeclared(out, declared)
    if bad:
        print("❌ CRITICAL hee-pve-health map --proposed: edge references undeclared node(s): "
              + ", ".join(sorted(bad)), file=sys.stderr)
        return 2

    print("```mermaid")
    for line in out:
        print(line)
    print("```")
    print()
    print(f"_Generated by `hee pve-health map --proposed` from "
          f"`{os.path.basename(args.roster)}` (spec.status = **{status}**"
          + (f", ratification required from {', '.join(needs)}" if needs else "")
          + "). Dashed means not built and not authorized._")
    if reach:
        print()
        print(f"_Boundary, quoted from the registry rather than redrawn: {reach}_")
    return 0


def cmd_inventory(args):
    """Render the container table from the machine, not from memory.

    Real trigger 2026-09-06: pve/addressing.md described mx1 as a stub with
    no MTA while OpenSMTPD 7.8.0 was installed, running and listening on
    four addresses, and omitted soju (vmid 111) entirely. Two drifts in one
    46-line file, both found by accident. A hand-kept table of live
    infrastructure is a promise nobody renews.

    Deliberately TOLERANT. A container the API cannot describe, a missing
    DNS file, an unresolvable name -- none of those are failures. They are
    rendered as what they are, because a generator that dies on one odd row
    teaches people to stop running it, and a table that omits what it could
    not explain is how mx1 stayed a stub in writing for weeks.
    """
    rows, dns = _container_rows(args)
    if rows is None:
        print("❓ UNKNOWN hee-pve-health inventory: cannot reach pve -- table not rendered ("
              + ("; ".join(_PVE_WHY) or "reason not reported") + ")", file=sys.stderr)
        return 3

    print("| vmid | hostname | address | state |")
    print("|---|---|---|---|")
    for vmid, name, ip, state in rows:
        flag = "" if state == "running" else f" **{state}**"
        print(f"| {vmid} | `{name}` | {ip} | {state}{flag and ''} |")
    print()
    print(f"_{len(rows)} containers, read from the pve API"
          + (f" with addresses from {os.path.basename(args.dns)}" if dns else "")
          + ". Generated by `hee pve-health inventory` -- do not hand-edit._")
    return 0

def _capture(fn, args):
    """Run a renderer and capture exactly what it would have printed.

    Re-uses the REAL renderer rather than a second copy. A drift checker that
    renders differently from the generator reports drift that does not exist
    and misses drift that does -- and a second copy of a renderer is the same
    shape that produced three divergent TCOS taxonomies.
    """
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        rc = fn(args)
    return rc, buf.getvalue()


def _block(path, marker):
    """Text between <!-- marker:start --> and <!-- marker:end -->, or None."""
    if not os.path.isfile(path):
        return None
    txt = open(path, encoding="utf-8", errors="replace").read()
    a = txt.find(f"<!-- {marker}:start -->")
    b = txt.find(f"<!-- {marker}:end -->")
    if a < 0 or b < 0 or b < a:
        return None
    return txt[a + len(f"<!-- {marker}:start -->"):b].strip("\n")


def cmd_drift(args):
    """Does what is committed still match the machine?

    Real trigger, measured 2026-09-08: ten lines had been live in ct103's
    haproxy config since 2026-09-06 and were never committed. Git was the
    stale copy and the box was correct -- so provisioning a second ingress
    from git would have served 404 where the first served 200, decided per
    request by whichever instance held the address (issue:428@fleet-ops).

    FAILS CLOSED. Anything it cannot read is UNKNOWN, never "no drift".
    """
    findings, unknown = [], []

    # 1. haproxy: committed vs running.
    cfg = os.path.join(args.repo, "pve/haproxy/haproxy.cfg")
    # cmd_map is re-used verbatim below and reads args.haproxy_cfg, so derive
    # it from --repo rather than adding a second flag that could disagree.
    args.haproxy_cfg = cfg
    # Derived, never a hardcoded name. A fixed FQDN only works for whoever has
    # that exact string in known_hosts -- measured 2026-09-08, the operator's
    # own account did not, and got a silent no-routes map for it.
    via = args.haproxy_via or f"root@{args.host}"
    live = _haproxy_raw(via, args.haproxy_vmid)
    if live is None:
        why = ("; ".join(_HAPROXY_WHY)) or "reason not reported"
        unknown.append(f"haproxy config unreadable via {via} ct{args.haproxy_vmid} ({why})")
    elif not os.path.isfile(cfg):
        unknown.append(f"no committed config at {cfg}")
    else:
        committed = open(cfg, encoding="utf-8", errors="replace").read()
        if committed != live:
            d = list(difflib.unified_diff(committed.splitlines(), live.splitlines(),
                                          "committed", "running", lineterm="", n=0))
            adds = sum(1 for x in d if x.startswith("+") and not x.startswith("+++"))
            dels = sum(1 for x in d if x.startswith("-") and not x.startswith("---"))
            findings.append(("haproxy.cfg",
                             f"{adds} line(s) on the box are not committed, "
                             f"{dels} committed line(s) are not on the box",
                             [x for x in d if x[:1] in "+-" and not x.startswith(("+++", "---"))][:8]))
        else:
            emit(Status.OK, "haproxy.cfg: committed matches running")

    # 2 and 3. Generated blocks, compared against a fresh render of the same
    # generator -- not a reimplementation of it.
    for label, path, marker, fn in (
        ("network-map.md", os.path.join(args.repo, "pve/network-map.md"), "pve-map", cmd_map),
        ("addressing.md", os.path.join(args.repo, "pve/addressing.md"), "pve-inventory", cmd_inventory),
    ):
        have = _block(path, marker)
        if have is None:
            unknown.append(f"{label}: no {marker} block found")
            continue
        rc, fresh = _capture(fn, args)
        if rc != 0:
            unknown.append(f"{label}: generator exited {rc}, cannot compare")
            continue
        if have.strip() != fresh.strip():
            findings.append((label, "committed block differs from a fresh render",
                             [x for x in difflib.unified_diff(
                                 have.strip().splitlines(), fresh.strip().splitlines(),
                                 "committed", "fresh", lineterm="", n=0)
                              if x[:1] in "+-" and not x.startswith(("+++", "---"))][:8]))
        else:
            emit(Status.OK, f"{label}: committed block matches a fresh render")

    for u in unknown:
        emit(Status.UNKNOWN, u)
    for name, what, sample in findings:
        emit(Status.CRITICAL, f"{name}: {what}")
        for line in sample:
            print(f"     {line}")

    if findings:
        emit(Status.CRITICAL, f"{len(findings)} artifact(s) drifted from the machine")
        return Status.CRITICAL
    if unknown:
        # Deliberately not OK. Something could not be read, and reporting
        # that as clean is the exact failure this tool exists to catch.
        emit(Status.UNKNOWN, f"{len(unknown)} check(s) could not run -- this is NOT a pass")
        return Status.UNKNOWN
    emit(Status.OK, "every generated artifact matches the machine")
    return Status.OK


def cmd_status(args):
    node_status, rootdir_storages, allocated_by_storage, lxcs = gather(args.host, args.node)

    mem = node_status["memory"]
    cpu_pct = node_status["cpu"] * 100

    result = {
        "node": {"cpu_pct": round(cpu_pct, 1), "mem_used_mb": mem["used"] // 1024 // 1024,
                  "mem_total_mb": mem["total"] // 1024 // 1024, "uptime_s": node_status["uptime"]},
        "storage": {}, "lxc": [],
    }
    for sname, s in rootdir_storages.items():
        allocated = allocated_by_storage.get(sname, 0)
        result["storage"][sname] = {
            "pool_total_gb": round(s["total"] / 1e9, 1),
            "pool_used_gb": round(s["used"] / 1e9, 1),
            "allocated_gb": round(allocated / 1e9, 1),
            "overcommit_ratio": round(allocated / s["total"], 2) if s["total"] else 0,
        }
    totals = {"mem_mb": 0, "diskread_mb": 0, "diskwrite_mb": 0, "netin_mb": 0, "netout_mb": 0}
    for c in lxcs:
        entry = {
            "vmid": c["vmid"], "name": c["name"], "status": c["status"],
            # a template never runs; pvesh reports it as stopped (measured 2026-09-06, vmid 112)
            "template": bool(c.get("template", 0)),
            "cpu_pct": round(c.get("cpu", 0) * 100, 1),
            "mem_mb": c.get("mem", 0) // 1024 // 1024,
            "maxmem_mb": c.get("maxmem", 0) // 1024 // 1024,
            "diskread_mb": c.get("diskread", 0) // 1024 // 1024,
            "diskwrite_mb": c.get("diskwrite", 0) // 1024 // 1024,
            "netin_mb": c.get("netin", 0) // 1024 // 1024,
            "netout_mb": c.get("netout", 0) // 1024 // 1024,
            "uptime_s": c.get("uptime", 0),
        }
        result["lxc"].append(entry)
        for k in totals:
            totals[k] += entry.get(k, 0)
    result["totals"] = totals

    if args.json:
        print(json.dumps(result))
        return

    n = result["node"]
    print(f"node {args.node}: cpu {n['cpu_pct']}%  mem {n['mem_used_mb']}/{n['mem_total_mb']}MB  "
          f"uptime {n['uptime_s']//3600}h")
    for sname, s in result["storage"].items():
        flag = "🔴" if s["overcommit_ratio"] > 3 else ("🟡" if s["overcommit_ratio"] > 1 else "🟢")
        print(f"{flag} storage {sname}: pool {s['pool_total_gb']}GB, real used {s['pool_used_gb']}GB, "
              f"allocated {s['allocated_gb']}GB ({s['overcommit_ratio']}x overcommit)")
    for c in result["lxc"]:
        # A template is stopped BY DEFINITION -- that is what a template is,
        # and pvesh reports it as stopped. Painting it red makes a permanently
        # red line that is never actionable, which is precisely the "trains
        # people to ignore red" failure rule 16 names. `warn` already skips
        # templates for this reason; `status` captured the flag in its JSON
        # and then ignored it when rendering. Measured 2026-09-08 on vmid 112,
        # tcos-golden-tiny, which carries `template: 1`.
        if c.get("template"):
            flag = "⚪"
        else:
            flag = "🟢" if c["status"] == "running" else "🔴"
        if args.nerd:
            h, rem = divmod(c['uptime_s'], 3600)
            m = rem // 60
            print(f"{flag} lxc {c['vmid']:>4} {c['name']:20} {c['status']:8} "
                  f"cpu {c['cpu_pct']:5.1f}%  mem {c['mem_mb']:5}/{c['maxmem_mb']:5}MB  "
                  f"disk r/w {c['diskread_mb']:6}/{c['diskwrite_mb']:6}MB  "
                  f"net in/out {c['netin_mb']:6}/{c['netout_mb']:6}MB  "
                  f"elapsed {h}h{m}m")
        else:
            print(f"{flag} lxc {c['vmid']:>4} {c['name']:20} {c['status']}")
    if args.nerd:
        t = result["totals"]
        print(f"🔹 totals across {len(result['lxc'])} container(s): mem {t['mem_mb']}MB  "
              f"disk r/w {t['diskread_mb']}/{t['diskwrite_mb']}MB  "
              f"net in/out {t['netin_mb']}/{t['netout_mb']}MB")


def _load_templates(path):
    """(templates, error) from the pve-templates registry.

    Same contract as _load_roster, for the same reason: every failure is an
    error string, never an empty dict. "The file did not parse" and "the
    registry declares no templates" are different facts, and a check that
    cannot tell them apart reports a clean fleet when it has read nothing.
    That is rule 16's fail-closed rule, and the exact shape of the
    namespace-audit failure -- "OK, no naming ambiguity across 17 repo(s)"
    every day while its token was empty and it had read none of them.

    Keyed by template hostname: the key is what the registry and the node
    both reference, and unlike vmid it survives a rebuild.
    """
    if not os.path.isfile(path):
        return None, f"no template registry at {path}"
    try:
        import yaml
    except ImportError:
        return None, "pyyaml not available"
    try:
        doc = yaml.safe_load(open(path, encoding="utf-8")) or {}
    except Exception as e:
        return None, f"{os.path.basename(path)} did not parse: {e}"
    spec = doc.get("spec", {}) or {}
    declared = spec.get("templates")
    if not isinstance(declared, dict):
        return None, f"{os.path.basename(path)} declares no `spec.templates` mapping"
    return {k: (v or {}) for k, v in declared.items()}, None


# ---------------------------------------------------------------- fleetTable
#
# TCOS-MIB (PEN 66550) fleetTable, declared since the module was written and
# served by nothing. Build order is fleet-ops#434.
#
#   ownerFleetOrg .1.3.6.1.4.1.66550.1
#   fleetTable                        .1
#   fleetEntry                          .1
#   columns  fleetIndex(1) fleetRole(2) fleetHostname(3) fleetVmid(4)
#            fleetAddress(5) fleetState(6) fleetAnchor(7)
#
# fleetIndex is MAX-ACCESS not-accessible, so it is never emitted as a value.
# An index column that answers a GET is a walk that returns the index twice.
_FLEET_ENTRY = ".1.3.6.1.4.1.66550.1.1.1"

# Column -> (number, pass-protocol type). The pass protocol has a short type
# list; HeeStatus and TruthValue are both INTEGER enumerations on the wire, so
# they go out as `integer` and the MIB supplies the names to a reader.
_FLEET_COLUMNS = (
    ("fleetRole", 2, "string"),
    ("fleetHostname", 3, "string"),
    ("fleetVmid", 4, "integer"),
    ("fleetAddress", 5, "string"),
    ("fleetState", 6, "integer"),
    ("fleetAnchor", 7, "integer"),
)

_TRUE, _FALSE = 1, 2          # TruthValue, from SNMPv2-TC


def oid_sortkey(oid: str) -> str:
    """An OID as a string that sorts in OID order.

    Lexicographic string order is WRONG for OIDs: ".10" sorts before ".9",
    so a GETNEXT implemented with a string compare walks the table in the
    wrong order and can loop. Zero-padding every arc to a fixed width makes
    string order and numeric order the same thing, which lets the agent-side
    handler stay a few lines of awk instead of needing a parser.

    10 digits covers a sub-identifier's full unsigned 32-bit range
    (4294967295), so nothing can overflow the padding and re-order the file.
    """
    return ".".join(f"{int(a):010d}" for a in oid.strip(".").split("."))


def _services_roles(repo):
    """{role: hostname} from pve/services/*.yaml. (roles, error).

    The manifest FILENAME is the role -- "THE IDENTITY ... as declared in the
    agent roster, e.g. ci-triage or haproxy" (fleetRole's DESCRIPTION) -- and
    the `hostname:` inside it is what `hee name` allocated. A manifest that
    declares no hostname yields "", which the MIB pairs with fleetState
    unknown(3): declared, nothing allocated yet.
    """
    d = os.path.join(repo, "pve", "services")
    if not os.path.isdir(d):
        return None, f"no service manifests at {d}"
    try:
        import yaml
    except ImportError:
        return None, "pyyaml not available"
    roles = {}
    for fn in sorted(os.listdir(d)):
        if not fn.endswith(".yaml"):
            continue            # soju.md / thesis-engine.md are prose beside the manifest
        try:
            doc = yaml.safe_load(open(os.path.join(d, fn), encoding="utf-8")) or {}
        except Exception as e:
            return None, f"pve/services/{fn} did not parse: {e}"
        roles[fn[:-5]] = (doc.get("hostname") or "") if isinstance(doc, dict) else ""
    if not roles:
        return None, f"no service manifests found in {d}"
    return roles, None


def _anchor_roles(repo):
    """(set-of-anchor-roles, error) from the ratified network-anchors registry.

    That registry's own parent_thesis is issue:434@fleet-ops -- this table --
    and it is GPG-ratified, so it is the declared source for fleetAnchor
    rather than anything re-derived here.

    KNOWN DISCREPANCY, surfaced rather than silently resolved: fleetAnchor's
    DESCRIPTION defines true(1) as "pinned by a DHCP reservation on a MAC",
    but the registry pins its four anchors three different ways -- `mac`
    (resolver, hypervisor-api), `address` (lab-dhcp, static in its manifest)
    and `role` (lab-gateway, deliberately a role and not a box). Reading the
    MIB literally would make two ratified anchors false(2). This returns
    "the role is an anchor", which is what the registry ratified and what
    fleetAnchor's own second paragraph describes ("the roles that discovery
    bootstraps FROM"). The MIB DESCRIPTION wants a revision to match; that is
    an operator call, not this tool's.
    """
    p = os.path.join(repo, "hee", "registries", "network-anchors.registry.v1.yaml")
    if not os.path.isfile(p):
        return None, f"no anchors registry at {p}"
    try:
        import yaml
    except ImportError:
        return None, "pyyaml not available"
    try:
        doc = yaml.safe_load(open(p, encoding="utf-8")) or {}
    except Exception as e:
        return None, f"network-anchors registry did not parse: {e}"
    anchors = (doc.get("spec", {}) or {}).get("anchors")
    if not isinstance(anchors, dict) or not anchors:
        return None, "network-anchors registry declares no `spec.anchors`"
    return anchors, None


def is_anchor(role, hostname, anchors):
    """Is this role one of the ratified anchors?

    Three spellings have to be accepted, because the registry uses all three,
    and matching on the registry key alone silently drops half of them:

      lab-dhcp        key == role
      resolver        current_role_holder "ns1" == role
      hypervisor-api  current_role_holder "pve"     -- not a container at all
      lab-gateway     pinned by role, no holder     -- not a container at all

    A holder may name the allocated HOSTNAME rather than the role, so both
    are checked. Measured 2026-09-21: key-only matching marked lab-dhcp as
    the fleet's only anchor and left the resolver false(2).
    """
    if role in anchors:
        return True
    for entry in anchors.values():
        if not isinstance(entry, dict):
            continue
        holder = entry.get("current_role_holder")
        if holder and (holder == role or (hostname and holder == hostname)):
            return True
    return False


def fleet_rows(roles, anchors, declared_templates, measured):
    """The join, as a list of dicts in fleetRole order.

    `measured` is {hostname: {vmid, status, template, address}} read off the
    node. The table is the join of what git declares with what the node has,
    and it deliberately lists roles that SHOULD exist as well as those that
    DO -- fleetTable's DESCRIPTION: "A role declared but not yet built appears
    with fleetState unknown(3), which makes the build queue visible as a query
    against the inventory rather than as a separate mechanism."

    Row order is fleetRole, so the table is reproducible. fleetIndex itself
    "carries no meaning of its own and is not stable across a rebuild"; making
    it deterministic anyway costs nothing and keeps a diff of two walks
    readable.
    """
    rows = []
    for i, role in enumerate(sorted(roles), start=1):
        hostname = roles[role] or ""
        # Declared hostname first, then the role name. Eight containers on
        # this node predate `hee name` and still run under their plain role
        # name while their manifest declares an allocated tcos-* one -- the
        # hostname_mismatch that makes `hee pve deploy` want to build a
        # second container beside the running one. Joining on the declared
        # name alone reported all eight as vmid 0 / unknown(3), i.e. a walk
        # claiming eight running services did not exist. Measured 2026-09-21.
        matched_by = None
        m = None
        if hostname and hostname in measured:
            m, matched_by = measured[hostname], "hostname"
        elif role in measured:
            m, matched_by = measured[role], "role"

        if m is None:
            # Declared, not built. Zero is not a legal Proxmox VMID (the range
            # starts at 100), which is why the MIB gives it this meaning.
            rows.append({"index": i, "role": role, "hostname": hostname,
                         "vmid": 0, "address": "",
                         "state": Status.UNKNOWN.value,
                         "anchor": _TRUE if is_anchor(role, hostname, anchors) else _FALSE,
                         "matched_by": None})
            continue

        if m.get("template"):
            # Stopped by definition. ok(0) when the registry declares it,
            # warning(1) when it does not -- the same rule `templates` and
            # `warn` apply, so the three cannot disagree about one container.
            state = Status.OK if m.get("name") in declared_templates else Status.WARNING
        elif m.get("status") == "running":
            state = Status.OK
        else:
            state = Status.WARNING
        # git and the machine disagree about this role's identity. The service
        # is up, so this is not critical, but it is not clean either: it is
        # the condition under which a redeploy forks the container.
        if matched_by == "role" and hostname and hostname != role:
            state = max(state, Status.WARNING, key=lambda s: s.value)

        rows.append({"index": i, "role": role, "hostname": hostname,
                     "vmid": int(m.get("vmid") or 0),
                     "address": m.get("address") or "",
                     "state": state.value,
                     "anchor": _TRUE if is_anchor(role, hostname, anchors) else _FALSE,
                     "matched_by": matched_by})
    return rows


def undeclared_containers(roles, measured):
    """Container names the node has that no service manifest declares.

    fleetTable is keyed on declared role, so these can have no row: a
    container nobody declared is structurally invisible in it. That is a
    property of the MIB's design, not an oversight, but a count that is
    never reported would make the table look complete when it is not.
    Measured 2026-09-21: mx1 (ct108) and tcos-gopher-gateway (ct109) both
    run with no manifest at all.
    """
    claimed = set()
    for role, hostname in roles.items():
        if hostname and hostname in measured:
            claimed.add(hostname)
        elif role in measured:
            claimed.add(role)
    return sorted(set(measured) - claimed)


def fleet_table_lines(rows):
    """Rows -> sorted `sortkey\\toid\\ttype\\tvalue` lines for the agent.

    One flat, pre-sorted file is the whole interface to the SNMP side. The
    expensive half (pvesh, git, the join) happens here on a timer; the agent
    side only ever does a lookup in a sorted file. net-snmp gives a pass
    handler a short timeout and blocks the WHOLE agent while it waits, and
    `pvesh get /cluster/resources` measured 0.70s on this node -- far too slow
    to run inside a GET. Cache-and-serve is not an optimisation here, it is
    the only shape that works.
    """
    out = []
    for r in rows:
        for key, col, typ in _FLEET_COLUMNS:
            oid = f"{_FLEET_ENTRY}.{col}.{r['index']}"
            val = r[{"fleetRole": "role", "fleetHostname": "hostname",
                     "fleetVmid": "vmid", "fleetAddress": "address",
                     "fleetState": "state", "fleetAnchor": "anchor"}[key]]
            out.append(f"{oid_sortkey(oid)}\t{oid}\t{typ}\t{val}")
    out.sort()
    return out


def _template_findings(lxcs, declared):
    """[(Status, text)] comparing the node against the registry, both ways.

    Both directions are checked because they are different facts. An
    undeclared template on the node is a guest somebody converted and walked
    away from. A declared template with no guest is one that is gone --
    possibly deleted by accident, possibly never built. A registry read in
    only one direction cannot tell those apart.

    A non-template guest sitting stopped is cruft. `warn` already reports it
    as "not running", which is true and says nothing about whether anyone
    meant it; naming it cruft is what makes it actionable.
    """
    findings = []
    live = {c["name"]: c for c in lxcs if c.get("template")}

    for name, c in sorted(live.items()):
        if name not in declared:
            findings.append((Status.WARNING,
                             f"lxc {c['vmid']} {name}: carries template=1 but is not in "
                             f"the registry -- undeclared template"))
            continue
        want = declared[name].get("vmid")
        # Compare as strings. pvesh returns vmid as an int over the HTTPS API
        # and as a string over the SSH path, so an int-vs-int comparison
        # reports a mismatch between 112 and "112" depending only on how the
        # tool reached the node. Measured 2026-09-21.
        if want is not None and str(want) != str(c["vmid"]):
            findings.append((Status.WARNING,
                             f"lxc {c['vmid']} {name}: registry declares vmid {want}, "
                             f"node says {c['vmid']}"))
        else:
            findings.append((Status.OK, f"lxc {c['vmid']} {name}: declared template"))

    for name in sorted(set(declared) - set(live)):
        want = declared[name].get("vmid", "?")
        findings.append((Status.WARNING,
                         f"{name} (vmid {want}): declared template, not present on the node"))

    for c in sorted(lxcs, key=lambda x: x["vmid"]):
        if c.get("template") or c["status"] == "running":
            continue
        findings.append((Status.WARNING,
                         f"lxc {c['vmid']} {c['name']}: stopped and not a template -- cruft"))

    return findings


def _worst(findings):
    return max((s for s, _ in findings), key=lambda s: s.value, default=Status.OK)


def cmd_templates(args):
    lxcs = gather(args.host, args.node)[3]
    declared, err = _load_templates(args.registry)
    if err:
        return emit(Status.UNKNOWN, f"templates: {err}")

    findings = _template_findings(lxcs, declared)
    if args.json:
        print(json.dumps([{"status": s.name, "detail": t} for s, t in findings]))
        return _worst(findings)

    # Status is an icon AND a text label, never color alone (rule 11).
    #
    # Flush both streams after every line. emit() sends OK to stdout and
    # WARNING to stderr, and the two are buffered differently -- so a reader
    # merging them with 2>&1 sees the report out of order, with the OK lines
    # arriving last. A status list whose order depends on buffering is the
    # kind of detail that makes a monitor look untrustworthy. Measured
    # 2026-09-21: the declared-template OK line printed after both cruft
    # WARNINGs.
    for level, text in findings:
        emit(level, text)
        sys.stdout.flush()
        sys.stderr.flush()
    return _worst(findings)


def cmd_snmp(args):
    """Emit fleetTable for the SNMP agent to serve.

    Fails closed on every source. A table built from a registry that could not
    be read is not a smaller table, it is a WRONG one: every role in the unread
    file silently becomes "not declared", and a walk then reports a fleet that
    does not exist. UNKNOWN(3) and no output is the honest answer.
    """
    roles, err = _services_roles(args.repo)
    if err:
        return emit(Status.UNKNOWN, f"snmp: {err}")
    anchors, err = _anchor_roles(args.repo)
    if err:
        return emit(Status.UNKNOWN, f"snmp: {err}")
    declared_templates, err = _load_templates(args.registry)
    if err:
        return emit(Status.UNKNOWN, f"snmp: {err}")

    rows_raw, _dns = _container_rows(args)
    lxcs = gather(args.host, args.node)[3]
    tmpl = {c["name"]: bool(c.get("template")) for c in lxcs}
    measured = {}
    for vmid, name, ip, state in rows_raw:
        # _container_rows yields the literal "dhcp" when no address could be
        # read. That is not an address: fleetAddress is measured state, and
        # the MIB spells an unmeasured one as the empty string.
        measured[name] = {"vmid": vmid, "status": state, "name": name,
                          "address": "" if ip == "dhcp" else ip,
                          "template": tmpl.get(name, False)}

    rows = fleet_rows(roles, anchors, declared_templates, measured)
    orphans = undeclared_containers(roles, measured)
    if args.json:
        print(json.dumps({"rows": rows, "undeclared_containers": orphans}))
        return Status.OK

    lines = fleet_table_lines(rows)
    if args.out:
        # Write-then-rename: the agent may read this file at any moment, and a
        # half-written table is a walk that stops in the middle of a row.
        tmp = args.out + ".new"
        os.makedirs(os.path.dirname(os.path.abspath(args.out)), exist_ok=True)
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.write("\n".join(lines) + "\n")
        os.replace(tmp, args.out)
        built = sum(1 for r in rows if r["vmid"])
        drift = sum(1 for r in rows if r.get("matched_by") == "role")
        msg = (f"snmp: {len(rows)} role(s), {built} built, "
               f"{len(lines)} cell(s) -> {args.out}")
        if drift:
            msg += f"; {drift} matched by role name, not declared hostname"
        # fleetTable cannot represent these, so say so rather than let the
        # table read as a complete picture of the node.
        if orphans:
            msg += f"; {len(orphans)} container(s) with no manifest: {', '.join(orphans)}"
        return emit(Status.WARNING if (drift or orphans) else Status.OK, msg)
    print("\n".join(lines))
    return Status.OK


def cmd_warn(args):
    node_status, rootdir_storages, allocated_by_storage, lxcs = gather(args.host, args.node)
    bad = []
    for sname, s in rootdir_storages.items():
        allocated = allocated_by_storage.get(sname, 0)
        ratio = allocated / s["total"] if s["total"] else 0
        if ratio > args.overcommit_max:
            bad.append(f"storage {sname}: {ratio:.2f}x overcommit (max {args.overcommit_max})")

    # A DECLARED template is skipped, as before -- it is stopped by definition.
    # An undeclared one used to be skipped too, so a guest could be converted
    # to a template and drop out of this check entirely, silently. Skipping on
    # a flag the guest sets about itself is not an exemption anyone reviewed;
    # skipping on the registry is.
    declared, reg_err = _load_templates(args.registry)
    if reg_err:
        # Fail closed: if we cannot read which templates were sanctioned, none
        # are exempt, and the reason is printed rather than swallowed.
        print(f"WARN: template registry unreadable, no template is exempt: {reg_err}",
              file=sys.stderr)
        declared = {}

    for c in lxcs:
        if c.get("template"):
            if c["name"] in declared:
                continue
            bad.append(f"lxc {c['vmid']} {c['name']}: template=1 but undeclared "
                       f"-- not in the template registry")
            continue
        if c["status"] != "running":
            bad.append(f"lxc {c['vmid']} {c['name']}: status={c['status']}, not running")
    if bad:
        for line in bad:
            print(f"WARN: {line}", file=sys.stderr)
        sys.exit(1)
    sys.exit(0)


def main():
    ap = ArgumentParser(
        prog="hee-pve-health",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""
THE MAP AXES

  `map` used to carry --term, --proposed and --diff as three peer flags. They
  are not peers: --term is an output format, --proposed is a source selector,
  and --diff is a comparison mode. Three questions, one flat namespace. They
  are now four independent axes, and every old flag still works as an alias.

  -src SRC      WHERE THE FACTS COME FROM
                  live      the pve API + the running haproxy config (default)
                  roster    the agent roster registry
                  target    the AUTHORED proposed-network block, extracted and
                            re-emitted -- never regenerated
                  pfsense   the AUTHORED pfSense destination block, same rule

                --proposed is an alias for `-src roster`. It renders the
                proposed AGENT ROSTER, not a proposed network; the proposed
                infrastructure is `-src target` / `-src pfsense`.

  -out FMT      WHAT SHAPE IT IS RENDERED IN
                  mmd       the fenced mermaid block (default)
                  term      a terminal drawing; --term is an alias
                  md        the block wrapped in its <!-- pve-map --> markers
                  json      mermaid lines + provenance note, as data
                  png       the local meme-factory renderer; needs -o PATH
                  svg       NOT IMPLEMENTED -- meme-factory/diagram's run()
                            calls PIL.Image.open().size and og_card()
                            unconditionally and both are raster-only

                mmd is the default and that is not taste: `drift` renders the
                map through this same code path and compares it against the
                committed block, so any other default silently breaks it.

  -diff MODE    WHICH COMPARISON RUNS, over -a and -b
                  none      no comparison (default)
                  sub       A minus B -- declared and not built, the build queue
                  add       B minus A -- running and undeclared
                  both      each direction; a bare --diff means this
                `diff` is accepted as a spelling of `both`. Only
                `-a roster -b live` is joinable today: no role -> container
                binding is recorded anywhere, so there is no key for any other
                pair. `-out png` with a diff is refused -- a diff is a text
                report, not a graph.

  -archive SPEC WHICH REVISIONS, over the COMMITTED history of the map block
                  1-5       ordinal id/range, newest first
                  'REGEX'   matched against "<sha> <date> <subject>"
                Selection is library/py/hee_range, the org's one range
                implementation -- not a second copy of it. Git is the archive
                because the rendered-PNG store is a single clobbered filename
                per job whose .meta.json carries no timestamp at all.

RENDERING IS LOCAL, ALWAYS. -out png drives the renderer that already exists
(tools/meme-factory/diagram) rather than becoming a second one. There is no
hosted fallback and there must never be one: these maps carry the lab's
internal addressing and its haproxy backend names, so an off-host render is
an exfiltration.
""")
    sub = ap.add_subparsers(dest="cmd", required=True)
    # A one-line help per subcommand, because the top-level --help IS the
    # published man page (rule 17) and without these it listed five bare
    # words and nothing about what any of them does.
    s = sub.add_parser("status", help="node, storage overcommit and per-container state")
    s.add_argument("--host", default="10.0.0.153")
    s.add_argument("--node", default="pve")
    s.add_argument("--json", action="store_true")
    s.add_argument("--nerd", action="store_true",
                    help="per-container cpu/mem/disk-io/net-io/elapsed + totals (real stats-for-nerds)")
    i = sub.add_parser("inventory", help="the container table, rendered from the pve API")
    i.add_argument("--host", default="10.0.0.153")
    i.add_argument("--node", default="pve")
    i.add_argument("--dns", default=os.path.expanduser("~/git/fleet-ops/dns/lab.tcos.us.hosts"),
                   help="tinydns-format zone file for addresses; skipped if absent")

    m = sub.add_parser("map", help="topology on four axes: -src (where the facts come from), "
                                   "-out (what shape), -diff (which comparison), -archive (which revisions)")
    m.add_argument("--host", default="10.0.0.153")
    m.add_argument("--node", default="pve")
    m.add_argument("--dns", default=os.path.expanduser("~/git/fleet-ops/dns/lab.tcos.us.hosts"),
                   help="tinydns-format zone file for addresses; skipped if absent")
    m.add_argument("--haproxy-vmid", type=int, default=103)
    m.add_argument("-src", "--src", choices=("live", "roster", "target", "pfsense"),
                   help="WHERE THE FACTS COME FROM. live (default) = the pve API and the "
                        "running haproxy config. roster = the agent roster registry. "
                        "target/pfsense = the AUTHORED proposed-network blocks in "
                        "fleet-ops pve/network-172.16-migration.md, extracted and re-emitted, "
                        "never regenerated")
    m.add_argument("-out", "--out", choices=_OUT_CHOICES,
                   help="WHAT SHAPE IT IS RENDERED IN. mmd (default) = the fenced mermaid "
                        "block. term = a terminal drawing. md = the block wrapped in its "
                        "markers. json = rows and edges as data. png = the local "
                        "meme-factory renderer, needs -o. svg = not implemented, see -h")
    m.add_argument("-diff", "--diff", nargs="?", const="both", default=None,
                   choices=_DIFF_CHOICES,
                   help="WHICH COMPARISON RUNS, over -a and -b. sub = A minus B (the build "
                        "queue). add = B minus A (undeclared). both (default when the flag "
                        "is given bare) = each direction. Fails closed -- an unreadable pve "
                        "or roster is UNKNOWN, never an empty build queue")
    m.add_argument("-a", "--a-src", dest="a_src", default="roster",
                   help="the DECLARED side of -diff (default: roster)")
    m.add_argument("-b", "--b-src", dest="b_src", default="live",
                   help="the MEASURED side of -diff (default: live)")
    m.add_argument("-archive", "--archive", metavar="SPEC",
                   help="range over the COMMITTED history of the map block: an ordinal "
                        "id/range list newest-first (1-5 = the last five) or a regex over "
                        "'<sha> <date> <subject>'. Selection is library/py/hee_range, the "
                        "org's one range implementation. Git is the archive because the "
                        "rendered-PNG store is one clobbered filename per job with no "
                        "timestamp in its .meta.json")
    m.add_argument("-o", "--output", help="where -out png writes the render")
    m.add_argument("-renderer", "--renderer",
                   help="the local mermaid renderer; defaults to $HEE_DIAGRAM_RUN then "
                        "~/git/fleet-ops/tools/meme-factory/diagram/run.sh. Local only -- "
                        "there is no hosted fallback and there must never be one")
    m.add_argument("--haproxy-cfg",
                   default=os.path.expanduser("~/git/fleet-ops/pve/haproxy/haproxy.cfg"),
                   help="committed haproxy config; routes are read from it rather than over "
                        "ssh, and `hee pve-health drift` is what proves it still matches the box")
    m.add_argument("--term", action="store_true",
                   help="alias for -out term, kept working")
    m.add_argument("--proposed", action="store_true",
                   help="alias for -src roster, kept working. NOTE: this renders the proposed "
                        "AGENT ROSTER, not a proposed network -- the proposed infrastructure "
                        "is -src target / -src pfsense")
    m.add_argument("--roster",
                   default=os.path.expanduser("~/git/fleet-ops/hee/registries/agent-roster.registry.v1.yaml"),
                   help="agent roster registry, for -src roster")
    d = sub.add_parser("drift", help="do the committed artifacts still match the machine?")
    d.add_argument("--host", default="10.0.0.153")
    d.add_argument("--node", default="pve")
    d.add_argument("--repo", default=os.path.expanduser("~/git/fleet-ops"),
                   help="checkout holding the committed pve artifacts")
    d.add_argument("--dns", default=os.path.expanduser("~/git/fleet-ops/dns/lab.tcos.us.hosts"))
    d.add_argument("--haproxy-via", default=None,
                   help="ssh target that can `pct exec` the haproxy container. Only the "
                        "CONFIG comparison needs this -- the pve API has no file-read for "
                        "LXC. Defaults to root@ the --host address, never a hardcoded name.")
    d.add_argument("--haproxy-stats-port", type=int, default=8404)
    d.add_argument("--haproxy-vmid", type=int, default=103)
    d.add_argument("--proposed", action="store_true", help=argparse.SUPPRESS)
    d.add_argument("--diff", nargs="?", const="both", default=None,
                   choices=_DIFF_CHOICES, help=argparse.SUPPRESS)
    d.add_argument("--term", action="store_true", help=argparse.SUPPRESS)
    d.add_argument("-src", "--src", default=None, help=argparse.SUPPRESS)
    d.add_argument("-out", "--out", default=None, help=argparse.SUPPRESS)
    d.add_argument("-a", "--a-src", dest="a_src", default="roster", help=argparse.SUPPRESS)
    d.add_argument("-b", "--b-src", dest="b_src", default="live", help=argparse.SUPPRESS)
    d.add_argument("-archive", "--archive", default=None, help=argparse.SUPPRESS)
    d.add_argument("-o", "--output", default=None, help=argparse.SUPPRESS)
    d.add_argument("-renderer", "--renderer", default=None, help=argparse.SUPPRESS)
    d.add_argument("--roster",
                   default=os.path.expanduser("~/git/fleet-ops/hee/registries/agent-roster.registry.v1.yaml"),
                   help=argparse.SUPPRESS)

    sn = sub.add_parser("snmp",
                        help="emit TCOS-MIB fleetTable for the SNMP agent to serve")
    sn.add_argument("--host", default="10.0.0.153")
    sn.add_argument("--node", default="pve")
    sn.add_argument("--json", action="store_true",
                    help="the joined rows, before they become OIDs")
    sn.add_argument("--out", default=None,
                    help="write the table here atomically instead of to stdout")
    sn.add_argument("--repo", default=os.path.expanduser("~/git/fleet-ops"),
                    help="fleet-ops checkout holding pve/services and the registries")
    sn.add_argument("--registry", default=_TEMPLATES_REGISTRY)
    sn.add_argument("--dns", default=None, help=argparse.SUPPRESS)

    t = sub.add_parser("templates",
                       help="do the node's templates match the ones the registry declares?")
    t.add_argument("--host", default="10.0.0.153")
    t.add_argument("--node", default="pve")
    t.add_argument("--json", action="store_true")
    t.add_argument("--registry", default=_TEMPLATES_REGISTRY)

    w = sub.add_parser("warn", help="exit 1 on real overcommit or a container that is not running")
    w.add_argument("--host", default="10.0.0.153")
    w.add_argument("--node", default="pve")
    w.add_argument("--overcommit-max", type=float, default=3.0)
    w.add_argument("--registry", default=_TEMPLATES_REGISTRY)
    # Contextual help BEFORE argparse parses anything. argparse owns -h and
    # --help but not the bare `help` verb, and resolves either only after
    # parsing -- so an unrelated argument errors first and the help never
    # prints. Measured: 8 tools exited non-zero for --help for exactly this
    # reason. See library/py/hee_cli.
    if help_wanted(sys.argv[1:]):
        note_ignored(sys.argv[1:])
        ap.print_help()
        return 0

    args = ap.parse_args()
    return {"status": cmd_status, "inventory": cmd_inventory,
            "warn": cmd_warn, "map": cmd_map, "drift": cmd_drift,
            "templates": cmd_templates, "snmp": cmd_snmp}[args.cmd](args)


if __name__ == "__main__":
    # exit_with(main), not a bare main(): the return value was once discarded,
    # so every subcommand exited 0 no matter what it found (issue:423@fleet-ops,
    # found 2026-09-08). exit_with also maps a Status member to its value (a
    # bare Enum member exits 1), and turns sys.exit("cannot read ...") -- pve
    # unreachable -- into UNKNOWN 3 instead of exit 1.
    exit_with(main)
