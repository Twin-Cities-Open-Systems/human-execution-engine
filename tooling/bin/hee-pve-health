#!/usr/bin/env python3
# section: 1
"""hee-pve-health: real, 0-token health check for a pve node and every
LXC on it -- node resources, real storage overcommit ratio (allocated
vs. actual thin-pool size, not just "used"), and per-container status.

Real trigger (2026-08-24, Spencer): "write a quick tool to get an
overall health of the pve and of our infra" -- after standing up 8
real containers via hee-pve-deploy and hitting a real, growing thin-
pool overcommit (48GB allocated on a 32GB pool) with no single command
to see that at a glance.

Usage:
  hee-pve-health status [--host IP] [--node NAME] [--json]
  hee-pve-health warn [--host IP] [--node NAME] [--overcommit-max N]
                 -- exit 1 if real overcommit ratio (allocated/pool)
                    exceeds N (default 3.0x), or any container isn't
                    'running', otherwise exit 0 silently.
"""
import argparse
import os
import difflib
import contextlib
import io
import re
import json
import ssl
import subprocess
import sys
import urllib.error
import urllib.request

# library/py lives in this tool's own repo -- derive it from this script's
# own location, resolved through symlinks, never from the repo the tool
# happens to be invoked against.
from pathlib import Path as _Path  # noqa: E402
sys.path.insert(0, str(_Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored  # noqa: E402
from hee_status import Status, emit  # noqa: E402

# Real KISS fallback (Spencer, live): not every real account has SSH
# root access to pve (by design -- see fleet-ops#285's real user/token
# work). A scoped API token already exists for exactly this
# (spencer@pve!hee-cli, heeLabVM+PVEAuditor, verified working). If SSH
# isn't available, fall back to the real HTTPS API using that token --
# same pvesh-style path, no new flags, no user action needed beyond
# having sealed the token once (hee-cred -seal pve-api-token-spencer).
# Overridable, because they are per-operator, not properties of the fleet.
# Hardcoding one person's account is what made the API path dead for everyone
# else: the tool asked for `pve-api-token-spencer` in the hee checkout, while
# the real sealed credentials are `pve-api-token-factory` and
# `pve-api-token-touchy-claude` in fleet-ops, and the operator's own hee
# checkout holds `pve-admin-spencer`. Three names, none of them the one asked
# for. Measured 2026-09-08.
_TOKEN_ID = os.environ.get("HEE_PVE_TOKEN_ID", "spencer@pve!hee-cli")
_TOKEN_ACCOUNT = os.environ.get("HEE_PVE_TOKEN_ACCOUNT", "pve-api-token-spencer")
_CRED_DIR = os.environ.get("HEE_PVE_CRED_DIR", "")
_SSL_CTX = ssl.create_default_context()
_SSL_CTX.check_hostname = False
_SSL_CTX.verify_mode = ssl.CERT_NONE


def _token_api_json(host, path):
    script_dir = __file__.rsplit("/", 1)[0]
    tool = script_dir + "/hee-cred"
    # HEE_PVE_CRED_DIR wins; otherwise this tool's own repo root. The default
    # is only correct when the credential happens to be sealed in the hee
    # checkout, which is not where fleet credentials actually live.
    secrets_dir = _CRED_DIR or (script_dir + "/../../.hee/secrets")
    # hee-cred passes the secret via $HEE_CRED_PASS to the exec'd
    # command only -- relay it out through a tiny real subprocess so it
    # never touches this process's own argv/stdout, just an in-memory
    # env var handoff.
    relay = subprocess.run(
        [sys.executable, tool, "-pass", _TOKEN_ACCOUNT, "-dir", secrets_dir, "-exec",
         sys.executable, "-c", "import os,sys; sys.stdout.write(os.environ['HEE_CRED_PASS'])"],
        capture_output=True, text=True,
    )
    if relay.returncode != 0:
        return None
    secret = relay.stdout.strip()
    if not secret:
        return None
    req = urllib.request.Request(
        f"https://{host}:8006/api2/json{path}",
        headers={"Authorization": f"PVEAPIToken={_TOKEN_ID}={secret}"},
    )
    try:
        with urllib.request.urlopen(req, timeout=5, context=_SSL_CTX) as r:
            return json.loads(r.read().decode())["data"]
    except (urllib.error.URLError, urllib.error.HTTPError, KeyError, json.JSONDecodeError):
        return None


def pvesh_json(host, path):
    """The pve API first, ssh second.

    Reversed 2026-09-08. Operator: "should be using the api for pve anyway" --
    and the old order made ssh load-bearing, so clearing known_hosts took the
    whole tool down while the "fallback" had never worked. The API needs no
    host key and no shell on the node.
    """
    token_result = _token_api_json(host, path)
    if token_result is not None:
        return token_result

    proc = subprocess.run(
        ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=3", f"root@{host}",
         "pvesh", "get", path, "--output-format", "json"],
        capture_output=True, text=True,
    )
    if proc.returncode == 0:
        return json.loads(proc.stdout)

    # Name what was tried. "cannot reach pve" sent the operator to clear
    # known_hosts, which cannot help: ssh runs with BatchMode=yes and so can
    # never accept an unknown key -- an empty known_hosts fails identically.
    sys.exit(
        f"hee-pve-health: cannot read {path} from {host}.\n"
        f"  API token: account '{_TOKEN_ACCOUNT}' id '{_TOKEN_ID}' in "
        f"{_CRED_DIR or '<hee-repo>/.hee/secrets'} -- not usable.\n"
        f"  ssh root@{host}: exit {proc.returncode}: {(proc.stderr or '').strip().splitlines()[-1] if proc.stderr.strip() else 'no stderr'}\n"
        f"  Set HEE_PVE_TOKEN_ACCOUNT / HEE_PVE_TOKEN_ID / HEE_PVE_CRED_DIR to a sealed\n"
        f"  credential that exists, or add the host key (ssh runs BatchMode, so it will\n"
        f"  never accept one on its own)."
    )


def gather(host, node):
    node_status = pvesh_json(host, f"/nodes/{node}/status")
    storages = pvesh_json(host, f"/nodes/{node}/storage")
    lxcs = pvesh_json(host, f"/nodes/{node}/lxc")

    # Real overcommit: sum of every LXC's configured rootfs size against
    # the real backing pool's total capacity -- pvesh's own per-storage
    # "total" is the real pool size; maxdisk summed across LXCs on that
    # storage is what's actually been promised out of it.
    rootdir_storages = {s["storage"]: s for s in storages if "rootdir" in s.get("content", "")}
    allocated_by_storage = {}
    for c in lxcs:
        cfg = pvesh_json(host, f"/nodes/{node}/lxc/{c['vmid']}/config")
        rootfs = cfg.get("rootfs", "")
        for sname in rootdir_storages:
            if rootfs.startswith(f"{sname}:"):
                allocated_by_storage[sname] = allocated_by_storage.get(sname, 0) + c.get("maxdisk", 0)

    return node_status, rootdir_storages, allocated_by_storage, lxcs



def _container_rows(args):
    """(vmid, name, address, state) per container, plus the DNS map.

    Shared by `inventory` and `map` on purpose. These two render the same
    facts in two shapes, and the whole point of both is that they cannot
    disagree with the machine -- so they must not disagree with each other
    either. A second copy of this loop would be the fourth instance of the
    shape that produced three divergent TCOS taxonomies.

    Returns (None, {}) when pve is unreachable; callers decide how loud to be.
    """
    try:
        _, _, _, lxcs = gather(args.host, args.node)
    except SystemExit as e:
        # Keep the reason. Catching SystemExit and returning a bare None threw
        # away a message that named exactly which credential and which host had
        # been tried, and replaced it with "cannot reach pve" -- which is what
        # sent the operator to clear known_hosts on 2026-09-08.
        if e.code:
            _PVE_WHY.append(str(e.code))
        return None, {}

    # DNS is the zone's stated SSOT; use it when present, shrug when not.
    dns = {}
    if getattr(args, "dns", None) and os.path.isfile(args.dns):
        for line in open(args.dns, encoding="utf-8", errors="replace"):
            line = line.strip()
            if not line.startswith("="):
                continue
            parts = line[1:].split(":")
            if len(parts) >= 2:
                dns[parts[0].strip()] = parts[1].strip()      # name -> address

    rows = []
    for c in sorted(lxcs, key=lambda x: int(x.get("vmid", 0))):
        vmid = c.get("vmid", "?")
        name = c.get("name") or "(unnamed)"
        state = c.get("status", "unknown")
        ip = ""
        try:
            cfg = pvesh_json(args.host, f"/nodes/{args.node}/lxc/{vmid}/config")
            net0 = cfg.get("net0", "")
            for field in net0.split(","):
                if field.startswith("ip="):
                    ip = field[3:].split("/")[0]
        except SystemExit:
            ip = ""            # tolerated: one unreadable config is not a failure
        # A dhcp lease is not an address. Fall back to what DNS asserts,
        # matching on the short name either side of the tcos- prefix.
        if ip in ("", "dhcp"):
            short = name.replace("tcos-", "")
            for host_name, addr in dns.items():
                if host_name.split(".")[0] in (name, short):
                    ip = addr
                    break
        rows.append((vmid, name, ip or "dhcp", state))
    return rows, dns


_HAPROXY_WHY = []
_PVE_WHY = []


def _haproxy_raw(via, vmid):
    """The running haproxy config, verbatim, or None if it cannot be read.

    None means "could not read", never "empty". The difference is the whole
    point: a drift check that reads nothing and reports no drift is the
    namespace-audit failure (issue:423@fleet-ops) in a new costume.
    """
    cmd = ("pct exec %d -- sh -c "
           "'cat /etc/haproxy/haproxy.cfg 2>/dev/null'" % vmid)
    try:
        out = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10",
                              via, cmd], capture_output=True, text=True, timeout=45)
    except Exception as e:
        _HAPROXY_WHY.append(f"ssh to {via} failed: {e}")
        return None
    if out.returncode != 0:
        # Say WHY. Returning a bare None here is how an operator gets a map
        # with no routes and no idea that anything went wrong -- measured
        # 2026-09-08, a run under a different account produced an edgeless
        # map because its key could not reach the host.
        _HAPROXY_WHY.append(f"ssh to {via} exited {out.returncode}: "
                            f"{(out.stderr or '').strip().splitlines()[-1] if out.stderr.strip() else 'no stderr'}")
        return None
    if not out.stdout.strip():
        _HAPROXY_WHY.append(f"ct{vmid} returned an empty haproxy.cfg")
        return None
    return out.stdout


def _haproxy_stats(ip, port):
    """Live backend -> server routing, from haproxy's own stats CSV.

    HTTP, not ssh. The previous version shelled out to `ssh root@<fqdn> pct
    exec`, which hardcoded one FQDN and therefore worked only for whoever
    happened to have that exact name in known_hosts. Measured 2026-09-08: the
    operator's own account has `Host pve -> HostName 10.0.0.153` in
    ~/.ssh/config, so `ssh root@pve` worked while the tool's
    `root@pve.lab.tcos.us` failed host key verification and silently produced
    a map with no routes at all.

    The stats endpoint is better than the config file on its own terms: it is
    what haproxy is REALLY doing, including whether each server is UP, where
    the file only says what it was told.

    Returns a list of (backend, server, addr, status), or None with the reason
    recorded. None means "could not read", never "no routes".
    """
    url = f"http://{ip}:{port}/;csv"
    try:
        with urllib.request.urlopen(url, timeout=15) as r:
            body = r.read().decode("utf-8", "replace")
    except Exception as e:
        _HAPROXY_WHY.append(f"haproxy stats at {url}: {e}")
        return None

    lines = [l for l in body.splitlines() if l.strip()]
    if not lines or not lines[0].startswith("#"):
        _HAPROXY_WHY.append(f"haproxy stats at {url}: unexpected format")
        return None

    # Address the columns BY NAME. haproxy's CSV has ~200 fields and grows
    # between releases; a positional index silently reads the wrong column
    # after an upgrade.
    cols = [c.strip() for c in lines[0].lstrip("#").split(",")]
    def col(row, name):
        try:
            return row[cols.index(name)].strip()
        except (ValueError, IndexError):
            return ""

    out = []
    for line in lines[1:]:
        row = line.split(",")
        px, sv = col(row, "pxname"), col(row, "svname")
        if not px or sv in ("FRONTEND", "BACKEND", ""):
            continue
        addr = col(row, "addr").split(":")[0]
        out.append((px, sv, addr, col(row, "status")))
    if not out:
        _HAPROXY_WHY.append(f"haproxy stats at {url}: no server rows")
        return None
    return out


def _haproxy_backends_from_cfg(path):
    """{backend: [addresses]} parsed from the COMMITTED haproxy config.

    Topology comes from the repo, not the network, for three measured reasons.

    The ssh route hardcoded one FQDN and so worked only for whoever had that
    exact string in known_hosts -- 2026-09-08, the operator's own account had
    `Host pve -> HostName 10.0.0.153` and got a silent no-routes map. It also
    used BatchMode, which can never accept an unknown key, so clearing
    known_hosts made it worse rather than better.

    The stats endpoint cannot supply it either: its CSV `addr` column is empty
    on every server row here, so it knows liveness but not addresses.

    And the repo is the right source anyway -- `hee pve-health drift` proves
    the committed config still matches the running one, so reading the file is
    reading the machine, with the difference made loud instead of assumed.
    """
    if not os.path.isfile(path):
        _HAPROXY_WHY.append(f"no haproxy config at {path}")
        return {}
    backends, cur = {}, None
    for line in open(path, encoding="utf-8", errors="replace"):
        st = line.strip()
        m = re.match(r"^(backend|listen)\s+(\S+)", st)
        if m:
            cur = m.group(2)
            backends.setdefault(cur, [])
            continue
        if st.startswith("frontend "):
            cur = None
            continue
        if cur and st.startswith("server "):
            parts = st.split()
            if len(parts) >= 3 and ":" in parts[2]:
                backends[cur].append(parts[2].split(":")[0])
    out = {k: v for k, v in backends.items() if v}
    if not out:
        _HAPROXY_WHY.append(f"{path} declares no backend servers")
    return out


def _haproxy_live_status(ip, port):
    """{(backend, server): status} from the stats API, or {} if unreachable.

    Enrichment only. The map is still correct without it; a route that exists
    is a route whether or not this answers.
    """
    rows = _haproxy_stats(ip, port)
    return {} if rows is None else {(px, sv): st for px, sv, _a, st in rows}


def _haproxy_backends(ip, port):
    """{backend: [addresses]} from the live stats, DOWN servers included.

    A server that is DOWN is still a declared route; drawing only UP ones
    would make an outage look like a topology change.
    """
    rows = _haproxy_stats(ip, port)
    if rows is None:
        return {}
    backends = {}
    for px, _sv, addr, _st in rows:
        if addr:
            backends.setdefault(px, []).append(addr)
    return backends


def _mermaid_id(name):
    """A mermaid-safe node id. Hyphens and dots break the parser unquoted."""
    return re.sub(r"[^A-Za-z0-9_]", "_", name)


def _undeclared(lines, declared):
    """Node ids used on an edge but never declared. Empty set means renderable."""
    used = set()
    for ln in lines:
        m = re.match(r"^\s*([A-Za-z0-9_]+)\s*-{2,3}>?\|?", ln)
        if m and not ln.strip().startswith(("subgraph", "class", "end")):
            used.add(m.group(1))
        m2 = re.search(r"-->(?:\|[^|]*\|)?\s*([A-Za-z0-9_]+)", ln)
        if m2:
            used.add(m2.group(1))
    return used - declared


def _term_map(args, rows, backends, by_ip):
    """The same facts as the mermaid map, drawn for a terminal.

    Not a picture of a picture. Rendering mermaid to an image and then to
    cells would need a browser engine, and the only zero-install way to do it
    is to POST the topology to a public rendering service -- which would ship
    this lab's internal addressing to a third party. This draws from the same
    rows instead, so it needs nothing and leaks nothing.
    """
    hap = None
    for vmid, name, ip, _ in rows:
        if int(vmid) == int(args.haproxy_vmid):
            hap = (vmid, name, ip)

    w = max((len(n) for _, n, _, _ in rows), default=12)
    out = []
    out.append("LAN · gateway")
    if hap:
        out.append(f"  └─ {hap[1]} · {hap[0]} · {hap[2]}   ← ingress, every vhost")
        routes = []
        for be, addrs in sorted(backends.items()):
            for a in addrs:
                hit = by_ip.get(a)
                if hit:
                    routes.append((be, f"{hit[1]} · {hit[0]} · {a}"))
                elif a == args.host:
                    routes.append((be, f"pve host · {a}"))
                else:
                    routes.append((be, f"{a}  (not a container on this node)"))
        if routes:
            bw = max(len(b) for b, _ in routes)
            for i, (be, tgt) in enumerate(routes):
                tee = "└─" if i == len(routes) - 1 else "├─"
                out.append(f"       {tee} {be.ljust(bw)} → {tgt}")
        else:
            out.append("       (no routes read -- see the warning below)")
    out.append("")
    out.append(f"pve host · vmbr0 · {len(rows)} containers")
    for vmid, name, ip, state in rows:
        mark = "  " if state == "running" else "!!"
        tail = "" if state == "running" else f"   {state.upper()}"
        out.append(f"  {mark} {str(vmid).ljust(4)} {name.ljust(w)}  {ip}{tail}")
    return out


def cmd_map(args):
    """Emit the pve topology as mermaid, from the machine rather than memory.

    issue:408@fleet-ops: "generate it, don't draw it". The map it carries was
    drawn by hand on 2026-09-06 and had drifted in six measured ways by
    2026-09-08 -- two containers missing, two mislabelled as stubs while
    running, one name stale, and one edge to a backend that does not exist.
    """
    if args.proposed:
        return _cmd_map_proposed(args)

    rows, _ = _container_rows(args)
    if rows is None:
        emit(Status.UNKNOWN, "hee-pve-health map: cannot reach pve -- map not rendered")
        for why in _PVE_WHY:
            print(why, file=sys.stderr)
        return 3

    backends = _haproxy_backends_from_cfg(args.haproxy_cfg)
    by_ip = {ip: (vmid, name) for vmid, name, ip, _ in rows}

    # The haproxy container is the graph's entry point, so edges leave the
    # node that really terminates them rather than a floating label.
    hap_id = None
    for vmid, name, ip, _ in rows:
        if int(vmid) == int(args.haproxy_vmid):
            hap_id = _mermaid_id(name)

    out, declared = [], set()
    out.append("graph TD")
    out.append("  lan([LAN · gateway])")
    declared.add("lan")
    out.append(f'  pvehost["pve host API<br/>{args.host}"]')
    declared.add("pvehost")
    out.append('  subgraph pve["pve host · vmbr0"]')
    for vmid, name, ip, state in rows:
        nid = _mermaid_id(name)
        stopped = "" if state == "running" else "<br/>STOPPED"
        out.append(f'    {nid}["{name}<br/>{ip} · {vmid}{stopped}"]')
        declared.add(nid)
    out.append("  end")
    if hap_id:
        out.append(f"  lan --> {hap_id}")

    # Edges, and ONLY edges something real declares. An address haproxy
    # serves that is not a container on this node is drawn as the pve host
    # itself when it matches, and otherwise skipped and counted -- never
    # invented, and never silently dropped.
    drawn, skipped = 0, []
    for be, addrs in sorted(backends.items()):
        for a in addrs:
            hit = by_ip.get(a)
            if hit and hap_id:
                out.append(f"  {hap_id} -->|{be}| {_mermaid_id(hit[1])}")
                drawn += 1
            elif a == args.host and hap_id:
                out.append(f"  {hap_id} -->|{be}| pvehost")
                drawn += 1
            else:
                skipped.append(f"{be}->{a}")
    out.append("  classDef stopped stroke-dasharray:4 3")
    stopped_ids = [_mermaid_id(n) for _, n, _, st in rows if st != "running"]
    if stopped_ids:
        out.append("  class " + ",".join(stopped_ids) + " stopped")

    # A diagram that references a node it never declared does not render at
    # all -- it fails as a blank box in GitHub, which reads as "no data"
    # rather than "broken". Refuse to emit one.
    bad = _undeclared(out, declared)
    if bad:
        print("❌ CRITICAL hee-pve-health map: edge references undeclared node(s): "
              + ", ".join(sorted(bad)), file=sys.stderr)
        return 2

    if getattr(args, "term", False):
        for line in _term_map(args, rows, backends, by_ip):
            print(line)
        print()
        # stdout is block-buffered when piped and emit() writes to stderr
        # unbuffered, so without this flush the warning lands ABOVE the map it
        # is warning about -- or gets cut off by a pager. Measured 2026-09-08.
        sys.stdout.flush()
        if backends:
            emit(Status.OK, f"{len(rows)} containers, {drawn} route(s), read from the machine")
        else:
            # LOUD. An edgeless map is a real result only if haproxy really
            # has no backends, and that is not what happens when ssh fails.
            for why in _HAPROXY_WHY:
                emit(Status.CRITICAL, f"haproxy not read -- {why}")
            emit(Status.CRITICAL,
                 "NO ROUTES DRAWN. This shows hosts only, not what talks to what.")
        return 0

    print("```mermaid")
    for line in out:
        print(line)
    print("```")
    print()
    if backends:
        note = (f"_{len(rows)} containers and {drawn} haproxy route(s), read from the pve API and "
                f"the running haproxy config.")
        if skipped:
            # Say what was dropped. A quiet omission is how a map comes to
            # show fewer connections than the fleet really has.
            note += (f" **{len(skipped)} backend target(s) are not containers on this node "
                     f"and are not drawn: {', '.join(skipped)}.**")
        print(note + " Generated by `hee pve-health map` -- do not hand-edit._")
    else:
        # Loud, not silent. An edgeless map is a real result only if haproxy
        # really has no backends, and that is not what happened here.
        why = ("; ".join(_HAPROXY_WHY)) or "reason not reported"
        print(f"_{len(rows)} containers, read from the pve API. **haproxy was unreachable, so NO "
              f"routes are drawn** ({why}) -- this map shows hosts only, not what talks to what. "
              f"Generated by `hee pve-health map` -- do not hand-edit._")
    return 0


def _cmd_map_proposed(args):
    """The proposed map, from the agent roster registry.

    Stamps the registry's OWN spec.status into the diagram title. The roster
    is `status: proposed` and says plainly that no agent is dispatched until
    its hire-authority Contract is ratified. A picture of unratified agents
    that does not say so is how `mx1` came to be called a stub in a
    disaster-recovery ticket.
    """
    if not os.path.isfile(args.roster):
        print(f"❓ UNKNOWN hee-pve-health map --proposed: no roster at {args.roster}", file=sys.stderr)
        return 3
    try:
        import yaml
    except ImportError:
        print("❓ UNKNOWN hee-pve-health map --proposed: pyyaml not available", file=sys.stderr)
        return 3
    doc = yaml.safe_load(open(args.roster, encoding="utf-8")) or {}
    spec = doc.get("spec", {}) or {}
    status = spec.get("status", "unknown")
    needs = spec.get("ratification_required_from", []) or []

    agents = []
    for key in ("agents", "roster", "narrow_agents"):
        if isinstance(spec.get(key), list):
            agents = spec[key]
            break
        if isinstance(spec.get(key), dict):
            agents = [dict(name=k, **(v or {})) for k, v in spec[key].items()]
            break

    boundaries = spec.get("common_boundaries", {}) or {}
    reach = boundaries.get("reach", "")

    out, declared = [], set()
    out.append("graph TD")
    label = f"PROPOSED · status={status}"
    if status != "ratified":
        label += " · NOT AUTHORIZED"
    out.append(f'  title["{label}"]')
    declared.add("title")
    out.append('  gh([GitHub])')
    declared.add("gh")
    out.append('  fac["container-factory<br/>mints a 1h scoped token per job"]')
    declared.add("fac")
    # One LXC each, per the roster's own common_boundaries.container. The
    # subgraph label says it so the picture cannot imply shared tenancy.
    out.append('  subgraph agents["narrow agents · one LXC each"]')
    if agents:
        for a in agents:
            nm = a.get("name", "agent")
            model = a.get("model", "unspecified")
            nid = _mermaid_id(nm)
            out.append(f'    {nid}["{nm}<br/>{model}"]')
            declared.add(nid)
    else:
        out.append('    none["roster declares no agents yet"]')
        declared.add("none")
    out.append("  end")

    # Every agent lands work through a pull request and reaches nothing else.
    # Drawn per-agent rather than from one collective node, because the
    # collective node was not a real thing and did not render.
    for a in agents:
        out.append(f'  fac --> {_mermaid_id(a.get("name", "agent"))}')
    for a in agents:
        out.append(f'  {_mermaid_id(a.get("name", "agent"))} -->|pull requests only| gh')

    out.append("  classDef banner fill:#7c2d12,color:#fff,stroke-width:0px")
    out.append("  classDef unratified stroke-dasharray:5 3")
    out.append("  class title banner")
    if agents:
        out.append("  class " + ",".join(_mermaid_id(a.get("name", "agent")) for a in agents) + " unratified")

    bad = _undeclared(out, declared)
    if bad:
        print("❌ CRITICAL hee-pve-health map --proposed: edge references undeclared node(s): "
              + ", ".join(sorted(bad)), file=sys.stderr)
        return 2

    print("```mermaid")
    for line in out:
        print(line)
    print("```")
    print()
    print(f"_Generated by `hee pve-health map --proposed` from "
          f"`{os.path.basename(args.roster)}` (spec.status = **{status}**"
          + (f", ratification required from {', '.join(needs)}" if needs else "")
          + "). Dashed means not built and not authorized._")
    if reach:
        print()
        print(f"_Boundary, quoted from the registry rather than redrawn: {reach}_")
    return 0


def cmd_inventory(args):
    """Render the container table from the machine, not from memory.

    Real trigger 2026-09-06: pve/addressing.md described mx1 as a stub with
    no MTA while OpenSMTPD 7.8.0 was installed, running and listening on
    four addresses, and omitted soju (vmid 111) entirely. Two drifts in one
    46-line file, both found by accident. A hand-kept table of live
    infrastructure is a promise nobody renews.

    Deliberately TOLERANT. A container the API cannot describe, a missing
    DNS file, an unresolvable name -- none of those are failures. They are
    rendered as what they are, because a generator that dies on one odd row
    teaches people to stop running it, and a table that omits what it could
    not explain is how mx1 stayed a stub in writing for weeks.
    """
    rows, dns = _container_rows(args)
    if rows is None:
        emit(Status.UNKNOWN, "hee-pve-health inventory: cannot reach pve -- table not rendered")
        for why in _PVE_WHY:
            print(why, file=sys.stderr)
        return 3

    print("| vmid | hostname | address | state |")
    print("|---|---|---|---|")
    for vmid, name, ip, state in rows:
        flag = "" if state == "running" else f" **{state}**"
        print(f"| {vmid} | `{name}` | {ip} | {state}{flag and ''} |")
    print()
    print(f"_{len(rows)} containers, read from the pve API"
          + (f" with addresses from {os.path.basename(args.dns)}" if dns else "")
          + ". Generated by `hee pve-health inventory` -- do not hand-edit._")
    return 0

def _capture(fn, args):
    """Run a renderer and capture exactly what it would have printed.

    Re-uses the REAL renderer rather than a second copy. A drift checker that
    renders differently from the generator reports drift that does not exist
    and misses drift that does -- and a second copy of a renderer is the same
    shape that produced three divergent TCOS taxonomies.
    """
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf):
        rc = fn(args)
    return rc, buf.getvalue()


def _block(path, marker):
    """Text between <!-- marker:start --> and <!-- marker:end -->, or None."""
    if not os.path.isfile(path):
        return None
    txt = open(path, encoding="utf-8", errors="replace").read()
    a = txt.find(f"<!-- {marker}:start -->")
    b = txt.find(f"<!-- {marker}:end -->")
    if a < 0 or b < 0 or b < a:
        return None
    return txt[a + len(f"<!-- {marker}:start -->"):b].strip("\n")


def cmd_drift(args):
    """Does what is committed still match the machine?

    Real trigger, measured 2026-09-08: ten lines had been live in ct103's
    haproxy config since 2026-09-06 and were never committed. Git was the
    stale copy and the box was correct -- so provisioning a second ingress
    from git would have served 404 where the first served 200, decided per
    request by whichever instance held the address (issue:428@fleet-ops).

    FAILS CLOSED. Anything it cannot read is UNKNOWN, never "no drift".
    """
    findings, unknown = [], []

    # 1. haproxy: committed vs running.
    cfg = os.path.join(args.repo, "pve/haproxy/haproxy.cfg")
    # cmd_map is re-used verbatim below and reads args.haproxy_cfg, so derive
    # it from --repo rather than adding a second flag that could disagree.
    args.haproxy_cfg = cfg
    # Derived, never a hardcoded name. A fixed FQDN only works for whoever has
    # that exact string in known_hosts -- measured 2026-09-08, the operator's
    # own account did not, and got a silent no-routes map for it.
    via = args.haproxy_via or f"root@{args.host}"
    live = _haproxy_raw(via, args.haproxy_vmid)
    if live is None:
        why = ("; ".join(_HAPROXY_WHY)) or "reason not reported"
        unknown.append(f"haproxy config unreadable via {via} ct{args.haproxy_vmid} ({why})")
    elif not os.path.isfile(cfg):
        unknown.append(f"no committed config at {cfg}")
    else:
        committed = open(cfg, encoding="utf-8", errors="replace").read()
        if committed != live:
            d = list(difflib.unified_diff(committed.splitlines(), live.splitlines(),
                                          "committed", "running", lineterm="", n=0))
            adds = sum(1 for x in d if x.startswith("+") and not x.startswith("+++"))
            dels = sum(1 for x in d if x.startswith("-") and not x.startswith("---"))
            findings.append(("haproxy.cfg",
                             f"{adds} line(s) on the box are not committed, "
                             f"{dels} committed line(s) are not on the box",
                             [x for x in d if x[:1] in "+-" and not x.startswith(("+++", "---"))][:8]))
        else:
            emit(Status.OK, "haproxy.cfg: committed matches running")

    # 2 and 3. Generated blocks, compared against a fresh render of the same
    # generator -- not a reimplementation of it.
    for label, path, marker, fn in (
        ("network-map.md", os.path.join(args.repo, "pve/network-map.md"), "pve-map", cmd_map),
        ("addressing.md", os.path.join(args.repo, "pve/addressing.md"), "pve-inventory", cmd_inventory),
    ):
        have = _block(path, marker)
        if have is None:
            unknown.append(f"{label}: no {marker} block found")
            continue
        rc, fresh = _capture(fn, args)
        if rc != 0:
            unknown.append(f"{label}: generator exited {rc}, cannot compare")
            continue
        if have.strip() != fresh.strip():
            findings.append((label, "committed block differs from a fresh render",
                             [x for x in difflib.unified_diff(
                                 have.strip().splitlines(), fresh.strip().splitlines(),
                                 "committed", "fresh", lineterm="", n=0)
                              if x[:1] in "+-" and not x.startswith(("+++", "---"))][:8]))
        else:
            emit(Status.OK, f"{label}: committed block matches a fresh render")

    for u in unknown:
        emit(Status.UNKNOWN, u)
    for name, what, sample in findings:
        emit(Status.CRITICAL, f"{name}: {what}")
        for line in sample:
            print(f"     {line}")

    if findings:
        emit(Status.CRITICAL, f"{len(findings)} artifact(s) drifted from the machine")
        return Status.CRITICAL
    if unknown:
        # Deliberately not OK. Something could not be read, and reporting
        # that as clean is the exact failure this tool exists to catch.
        emit(Status.UNKNOWN, f"{len(unknown)} check(s) could not run -- this is NOT a pass")
        return Status.UNKNOWN
    emit(Status.OK, "every generated artifact matches the machine")
    return Status.OK


def cmd_status(args):
    node_status, rootdir_storages, allocated_by_storage, lxcs = gather(args.host, args.node)

    mem = node_status["memory"]
    cpu_pct = node_status["cpu"] * 100

    result = {
        "node": {"cpu_pct": round(cpu_pct, 1), "mem_used_mb": mem["used"] // 1024 // 1024,
                  "mem_total_mb": mem["total"] // 1024 // 1024, "uptime_s": node_status["uptime"]},
        "storage": {}, "lxc": [],
    }
    for sname, s in rootdir_storages.items():
        allocated = allocated_by_storage.get(sname, 0)
        result["storage"][sname] = {
            "pool_total_gb": round(s["total"] / 1e9, 1),
            "pool_used_gb": round(s["used"] / 1e9, 1),
            "allocated_gb": round(allocated / 1e9, 1),
            "overcommit_ratio": round(allocated / s["total"], 2) if s["total"] else 0,
        }
    totals = {"mem_mb": 0, "diskread_mb": 0, "diskwrite_mb": 0, "netin_mb": 0, "netout_mb": 0}
    for c in lxcs:
        entry = {
            "vmid": c["vmid"], "name": c["name"], "status": c["status"],
            # a template never runs; pvesh reports it as stopped (measured 2026-09-06, vmid 112)
            "template": bool(c.get("template", 0)),
            "cpu_pct": round(c.get("cpu", 0) * 100, 1),
            "mem_mb": c.get("mem", 0) // 1024 // 1024,
            "maxmem_mb": c.get("maxmem", 0) // 1024 // 1024,
            "diskread_mb": c.get("diskread", 0) // 1024 // 1024,
            "diskwrite_mb": c.get("diskwrite", 0) // 1024 // 1024,
            "netin_mb": c.get("netin", 0) // 1024 // 1024,
            "netout_mb": c.get("netout", 0) // 1024 // 1024,
            "uptime_s": c.get("uptime", 0),
        }
        result["lxc"].append(entry)
        for k in totals:
            totals[k] += entry.get(k, 0)
    result["totals"] = totals

    if args.json:
        print(json.dumps(result))
        return

    n = result["node"]
    print(f"node {args.node}: cpu {n['cpu_pct']}%  mem {n['mem_used_mb']}/{n['mem_total_mb']}MB  "
          f"uptime {n['uptime_s']//3600}h")
    for sname, s in result["storage"].items():
        flag = "🔴" if s["overcommit_ratio"] > 3 else ("🟡" if s["overcommit_ratio"] > 1 else "🟢")
        print(f"{flag} storage {sname}: pool {s['pool_total_gb']}GB, real used {s['pool_used_gb']}GB, "
              f"allocated {s['allocated_gb']}GB ({s['overcommit_ratio']}x overcommit)")
    for c in result["lxc"]:
        flag = "🟢" if c["status"] == "running" else "🔴"
        if args.nerd:
            h, rem = divmod(c['uptime_s'], 3600)
            m = rem // 60
            print(f"{flag} lxc {c['vmid']:>4} {c['name']:20} {c['status']:8} "
                  f"cpu {c['cpu_pct']:5.1f}%  mem {c['mem_mb']:5}/{c['maxmem_mb']:5}MB  "
                  f"disk r/w {c['diskread_mb']:6}/{c['diskwrite_mb']:6}MB  "
                  f"net in/out {c['netin_mb']:6}/{c['netout_mb']:6}MB  "
                  f"elapsed {h}h{m}m")
        else:
            print(f"{flag} lxc {c['vmid']:>4} {c['name']:20} {c['status']}")
    if args.nerd:
        t = result["totals"]
        print(f"🔹 totals across {len(result['lxc'])} container(s): mem {t['mem_mb']}MB  "
              f"disk r/w {t['diskread_mb']}/{t['diskwrite_mb']}MB  "
              f"net in/out {t['netin_mb']}/{t['netout_mb']}MB")


def cmd_warn(args):
    node_status, rootdir_storages, allocated_by_storage, lxcs = gather(args.host, args.node)
    bad = []
    for sname, s in rootdir_storages.items():
        allocated = allocated_by_storage.get(sname, 0)
        ratio = allocated / s["total"] if s["total"] else 0
        if ratio > args.overcommit_max:
            bad.append(f"storage {sname}: {ratio:.2f}x overcommit (max {args.overcommit_max})")
    for c in lxcs:
        if c.get("template"):
            continue  # a template never runs
        if c["status"] != "running":
            bad.append(f"lxc {c['vmid']} {c['name']}: status={c['status']}, not running")
    if bad:
        for line in bad:
            print(f"WARN: {line}", file=sys.stderr)
        sys.exit(1)
    sys.exit(0)


def main():
    ap = argparse.ArgumentParser(prog="hee-pve-health")
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("status")
    s.add_argument("--host", default="10.0.0.153")
    s.add_argument("--node", default="pve")
    s.add_argument("--json", action="store_true")
    s.add_argument("--nerd", action="store_true",
                    help="per-container cpu/mem/disk-io/net-io/elapsed + totals (real stats-for-nerds)")
    i = sub.add_parser("inventory")
    i.add_argument("--host", default="10.0.0.153")
    i.add_argument("--node", default="pve")
    i.add_argument("--dns", default=os.path.expanduser("~/git/fleet-ops/dns/lab.tcos.us.hosts"),
                   help="tinydns-format zone file for addresses; skipped if absent")

    m = sub.add_parser("map")
    m.add_argument("--host", default="10.0.0.153")
    m.add_argument("--node", default="pve")
    m.add_argument("--dns", default=os.path.expanduser("~/git/fleet-ops/dns/lab.tcos.us.hosts"),
                   help="tinydns-format zone file for addresses; skipped if absent")
    m.add_argument("--haproxy-vmid", type=int, default=103)
    m.add_argument("--haproxy-cfg",
                   default=os.path.expanduser("~/git/fleet-ops/pve/haproxy/haproxy.cfg"),
                   help="committed haproxy config; routes are read from it rather than over "
                        "ssh, and `hee pve-health drift` is what proves it still matches the box")
    m.add_argument("--term", action="store_true",
                   help="draw it for a terminal instead of emitting mermaid -- same rows, "
                        "no browser engine, and nothing leaves this network")
    m.add_argument("--proposed", action="store_true",
                   help="render the PROPOSED map from the agent roster instead of the live fleet, "
                        "stamped with the roster's own spec.status")
    m.add_argument("--roster",
                   default=os.path.expanduser("~/git/fleet-ops/hee/registries/agent-roster.registry.v1.yaml"),
                   help="agent roster registry, for --proposed")
    d = sub.add_parser("drift")
    d.add_argument("--host", default="10.0.0.153")
    d.add_argument("--node", default="pve")
    d.add_argument("--repo", default=os.path.expanduser("~/git/fleet-ops"),
                   help="checkout holding the committed pve artifacts")
    d.add_argument("--dns", default=os.path.expanduser("~/git/fleet-ops/dns/lab.tcos.us.hosts"))
    d.add_argument("--haproxy-via", default=None,
                   help="ssh target that can `pct exec` the haproxy container. Only the "
                        "CONFIG comparison needs this -- the pve API has no file-read for "
                        "LXC. Defaults to root@ the --host address, never a hardcoded name.")
    d.add_argument("--haproxy-stats-port", type=int, default=8404)
    d.add_argument("--haproxy-vmid", type=int, default=103)
    d.add_argument("--proposed", action="store_true", help=argparse.SUPPRESS)
    d.add_argument("--roster",
                   default=os.path.expanduser("~/git/fleet-ops/hee/registries/agent-roster.registry.v1.yaml"),
                   help=argparse.SUPPRESS)

    w = sub.add_parser("warn")
    w.add_argument("--host", default="10.0.0.153")
    w.add_argument("--node", default="pve")
    w.add_argument("--overcommit-max", type=float, default=3.0)
    # Contextual help BEFORE argparse parses anything. argparse owns -h and
    # --help but not the bare `help` verb, and resolves either only after
    # parsing -- so an unrelated argument errors first and the help never
    # prints. Measured: 8 tools exited non-zero for --help for exactly this
    # reason. See library/py/hee_cli.
    if help_wanted(sys.argv[1:]):
        note_ignored(sys.argv[1:])
        ap.print_help()
        return 0

    args = ap.parse_args()
    return {"status": cmd_status, "inventory": cmd_inventory,
            "warn": cmd_warn, "map": cmd_map, "drift": cmd_drift}[args.cmd](args)


if __name__ == "__main__":
    # sys.exit(main()), not a bare main(): the return value was discarded, so
    # every subcommand exited 0 no matter what it found. `drift` would have
    # reported CRITICAL and exited 0 -- a checker that cannot fail is the
    # failure it exists to catch (issue:423@fleet-ops). Found 2026-09-08.
    _rc = main()
    # Status is a plain enum.Enum, not IntEnum -- its members are TRUTHY and
    # sys.exit(member) prints the repr and exits 1. `.value` is the real code,
    # as hee_status's own class docstring says. Measured 2026-09-08: `drift`
    # reported OK and exited 1 before this.
    sys.exit(_rc.value if isinstance(_rc, Status) else (_rc or 0))
