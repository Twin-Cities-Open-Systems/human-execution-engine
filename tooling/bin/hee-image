#!/usr/bin/env python3
# section: 1
"""hee-image -- inspect and flash images onto devices, safely.

One verb for the fleet's "write an image to a thing" jobs. Today it does the
block-device domain: flash a TCOS Pi image (installer/pi, e.g.
tcos-pi-hera-*.img.xz) onto an SD/MMC or USB card, with the device safety that
makes it a tool and not a bare `dd` -- it refuses to write anything that carries
a system mountpoint (/, /boot...), is a fixed internal disk (sata/nvme), or
backs the running root, so a mistyped device can never clobber the machine you
build on. The `RM` (removable) flag is deliberately NOT trusted alone: a
laptop's built-in SD reader shows RM=0 just like the NVMe system disk (measured
on flippy: mmcblk0). The safe discriminator is transport (mmc/usb) + hotplug +
"hosts no system mount" + "is not the root disk", stacked so any one failing
refuses the write.

The second domain is firmware over serial: build an ESP32 image from a firmware
checkout and write it to a board on /dev/ttyUSB*, through esptool, so the fleet
has one verb for "put an image on a thing" whether the thing is an SD card or a
microcontroller. Same shape: the plan first, a typed confirmation, a sha256 the
inventory record can point at.

Usage:
  hee image list                 -- flashable targets: cards and ttyUSB serial
  hee image check DEVICE         -- deep pre-flight on one block device
                                    e.g. hee image check /dev/mmcblk0
  hee image flash --image FILE --device DEVICE [--yes] [--no-verify]
                                 -- flash a .img or .img.xz to a card, then verify
  hee image flash --image FILE.bin --device /dev/ttyUSB0 [--chip esp32|esp8266]
                  [--offset 0x0] [--erase] [--yes]
                                 -- write a merged firmware image to a board
  hee image build --firmware espectre --chip esp32 [--repo DIR]
                  [--ota-channel release|preview|develop] [--clean] [--out DIR]
                  [--dry-run]    -- build ESPectre Native and merge it into one
                                    flashable .bin, named by chip and version
  hee image make --size SIZE [PATH] [--pattern zero|random]
                                 -- make a scratch image (default random) for
                                    testing flash, e.g. --size 1M (K/M/G suffix)

flash (card):
  Refuses any protected device (system mount, fixed sata/nvme, the root disk,
  read-only) or one too small for the image. Unmounts the target's own
  partitions first. Interactively it asks you to type the device path back;
  --yes bypasses that for automation. Without a tty and without --yes it prints
  the plan and writes nothing. Writes with `dd conv=fsync` (root, via sudo) and,
  unless --no-verify, reads the written region back and compares its sha256 to
  the decompressed image.

flash (serial):
  The device must be one `hee image list` shows as SERIAL. esptool first reads
  the board's MAC (the inventory's stableid) so you confirm the board, not just
  the port; a port another process holds (a monitor) fails here, before any
  write, with the fuser hint. Classic ESP32 is driven at 115200: esptool 5.3+
  loses it at 460800 during the stub's SFDP probe (ESPectre measured this;
  esptool_runner.py). The write is esptool's own, which hashes every region
  after writing; --no-verify has no meaning here and is ignored. --erase wipes
  the whole flash first (NVS, Wi-Fi credentials, OTA data) -- use it for a
  board changing firmware families, not for an update.
  --chip esp8266 flashes the fleet's NodeMCU soil/weather nodes, whose
  arduino-cli build is a single image at 0x0 (esp32/firmware/soil-weather-node);
  it runs at 460800 like every non-classic-esp32 chip. `build` stays esp32-only:
  it drives ESPectre Native, which is ESP-IDF.

build:
  Runs the firmware's own CLI (`./espectre native build`, in its checkout, with
  the shared ESP-IDF from /etc/profile.d/esp-idf.sh when the shell did not read
  it) and then merges bootloader, partition table, OTA data and app into ONE
  image at offset 0, so flash needs one file and one offset. The name carries
  the chip and the checkout's `git describe`, the output line carries the
  sha256: that pair is what an inventory record's firmware/flash_image_sha256
  fields want. A lab build with Wi-Fi baked in is the checkout's own
  app/sdkconfig.wifi overlay (fleet-ops esp32/bin/render-secrets.sh
  --format sdkconfig); this verb does not touch secrets.

Planned (own PRs, tracked as issues): `stick` (fold in installer/debian/
build-stick, the Ventoy Debian installer); `docker` image build/save/load.

Env:
  HEE_SD_LSBLK    override the lsblk binary (testing)
  ESPECTRE_REPO   the ESPectre checkout (default ~/git/espectre)
  IDF_PATH, IDF_TOOLS_PATH   an active ESP-IDF; else read from
                  /etc/profile.d/esp-idf.sh (fleet-ops esp32/bin/install-esp-idf.sh)

EXAMPLES
  $ hee image build --firmware espectre --chip esp32 --dry-run   # ci
  $ hee image build --firmware espectre --chip esp32 --ota-channel develop --out /srv/tcos/esp32/firmware
  $ hee image flash --image espectre-native-esp32-v3.0.0.bin --device /dev/ttyUSB0
  $ hee image flash --image soil-weather-node.ino.bin --device /dev/ttyUSB0 --chip esp8266

Exit: Nagios -- 0 OK, 1 WARNING (a refusal or a dry-run plan), 2 CRITICAL
      (a write/verify/read failed), 3 UNKNOWN (environment/usage).
"""

import argparse
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# library/py lives in this tool's own repo -- derive it from this script's own
# location (resolved through symlinks), never from the repo it is invoked
# against. Provides the uniform `help`/`--help`/`-h` contract (hee-check cli).
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_wanted, note_ignored

CHUNK = 4 * 1024 * 1024
GIB = 1024 ** 3
# A card larger than this smells like a real drive, not an SD/MMC card. Warned,
# not refused: high-endurance cards do exist above it.
CARD_SIZE_WARN = 128 * GIB
# A make target bigger than this is almost certainly a mistake (this makes test
# images, not real ones).
MAKE_SIZE_WARN = 2 * GIB
# A mountpoint under any of these (or exactly "/") means the disk carries the
# running system and must never be a write target. "[SWAP]" is lsblk's label
# for active swap.
SYSTEM_MOUNT_PREFIXES = ("/boot", "/etc", "/usr", "/var", "/home", "/nix", "/srv")
# Transports that are always fixed internal storage -- never a removable card.
FIXED_TRANSPORTS = ("sata", "nvme", "ata", "scsi")
REMOVABLE_TRANSPORTS = ("usb", "mmc")
SIZE_UNITS = {"": 1, "B": 1, "K": 1024, "M": 1024 ** 2, "G": 1024 ** 3, "T": 1024 ** 4}


def say(level, msg):
    icon = {"OK": "✅", "WARNING": "⚠️", "CRITICAL": "❌", "UNKNOWN": "❓", "INFO": "·"}[level]
    print(f"{icon} {level} {msg}" if level != "INFO" else f"  {msg}")


def die(code, msg):
    say({2: "CRITICAL", 3: "UNKNOWN"}[code], msg)
    sys.exit(code)


def human(n):
    if n is None:
        return "?"
    f = float(n)
    for unit in ("B", "K", "M", "G", "T"):
        if f < 1024 or unit == "T":
            return f"{f:.0f}{unit}" if unit == "B" else f"{f:.1f}{unit}"
        f /= 1024
    return f"{f:.1f}T"


def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, check=False, **kw)


# --- reading the block layout -------------------------------------------------

def lsblk_json():
    lb = os.environ.get("HEE_SD_LSBLK") or "lsblk"
    if not shutil.which(lb):
        die(3, f"{lb} not found -- lsblk (util-linux) is required.")
    cols = "NAME,PATH,SIZE,TYPE,RM,RO,HOTPLUG,MODEL,MOUNTPOINT,MOUNTPOINTS,PKNAME,TRAN"
    r = run([lb, "-J", "-b", "-o", cols])
    if r.returncode != 0:
        die(3, f"lsblk failed: {r.stderr.strip()[:200]}")
    import json
    try:
        return json.loads(r.stdout)["blockdevices"]
    except (ValueError, KeyError) as exc:
        die(3, f"cannot parse lsblk JSON: {exc}")


def mounts_of(node):
    """Every mountpoint on a node and its descendants, empty strings dropped."""
    out = []
    if node.get("mountpoint"):
        out.append(node["mountpoint"])
    for mp in node.get("mountpoints") or []:
        if mp:
            out.append(mp)
    for child in node.get("children") or []:
        out.extend(mounts_of(child))
    return sorted(set(out))


def is_system_mount(mp):
    return mp == "/" or mp == "[SWAP]" or mp.startswith(SYSTEM_MOUNT_PREFIXES)


def truthy(v):
    return str(v) in ("1", "True", "true")


def root_disk_names():
    """Base disk names (e.g. 'nvme0n1') that back /, /boot*, /home -- via findmnt.

    A second, independent guard on top of classify(): even if lsblk's view were
    odd, we resolve the running system's own block sources and refuse them.
    """
    names = set()
    if not shutil.which("findmnt"):
        return names
    for mp in ("/", "/boot", "/boot/efi", "/boot/firmware", "/home", "/var"):
        r = run(["findmnt", "-no", "SOURCE", mp])
        src = r.stdout.strip()
        if not src or not src.startswith("/dev/"):
            continue
        pk = run(["lsblk", "-no", "PKNAME", src]).stdout.strip().splitlines()
        if pk and pk[0].strip():
            names.add(pk[0].strip())
        else:
            names.add(Path(src).name)  # source is itself a whole disk
    return names


def classify(disk):
    """Return (kind, reason). kind in {SYSTEM, CARD, EMPTY, OTHER}."""
    sysmounts = [m for m in mounts_of(disk) if is_system_mount(m)]
    size = disk.get("size") or 0
    tran = (disk.get("tran") or "").lower()
    hotplug = truthy(disk.get("hotplug"))
    if sysmounts:
        return "SYSTEM", "carries " + ", ".join(sysmounts)
    if disk.get("name") in root_disk_names():
        return "SYSTEM", "backs the running root filesystem"
    if tran in FIXED_TRANSPORTS:
        return "SYSTEM", f"fixed {tran} disk"
    if not hotplug and tran not in REMOVABLE_TRANSPORTS:
        return "SYSTEM", "fixed disk (not hotplug, not usb/mmc)"
    if truthy(disk.get("ro")):
        return "OTHER", "read-only (write-locked?)"
    if size == 0:
        return "EMPTY", "empty reader slot (no card)"
    if disk.get("type") != "disk":
        return "OTHER", f"type={disk.get('type')}"
    return "CARD", f"hotplug/{tran or 'removable'}, no system mount"


def disks():
    return [d for d in lsblk_json() if d.get("type") in ("disk", "loop")]


def find_disk(device):
    """Resolve a device name/path to its lsblk disk node, or die."""
    want = Path(device).name  # accept /dev/mmcblk0 or mmcblk0
    for d in lsblk_json():
        if d.get("name") == want:
            if d.get("type") != "disk":
                die(3, f"{device} is a {d.get('type')}, not a whole disk -- pass the disk "
                       "(e.g. /dev/mmcblk0), never a partition.")
            return d
    die(3, f"no such block device: {device} (see `hee image list`).")


def serial_targets():
    """USB serial devices (ttyUSB/ttyACM) -- flashable firmware targets (future)."""
    out = []
    for path in sorted(glob.glob("/dev/ttyUSB*") + glob.glob("/dev/ttyACM*")):
        vid = pid = model = ""
        if shutil.which("udevadm"):
            u = run(["udevadm", "info", "--query=property", "--name", path])
            if u.returncode == 0:
                props = dict(line.split("=", 1) for line in u.stdout.splitlines() if "=" in line)
                vid, pid = props.get("ID_VENDOR_ID", ""), props.get("ID_MODEL_ID", "")
                model = props.get("ID_MODEL", "") or props.get("ID_VENDOR", "")
        out.append({"path": path, "id": f"{vid}:{pid}" if vid else "-", "model": model or "-"})
    return out


# --- list / check -------------------------------------------------------------

def describe(disk):
    kind, reason = classify(disk)
    model = (disk.get("model") or "").strip() or "-"
    tran = disk.get("tran") or "-"
    return kind, reason, model, tran


def cmd_list():
    ds = disks()
    tag = {"SYSTEM": "🔒 SYSTEM", "CARD": "💾 CARD  ", "EMPTY": "·  empty ", "OTHER": "?  other "}
    cards = 0
    for d in ds:
        kind, reason, model, tran = describe(d)
        cards += kind == "CARD"
        say("INFO", f"{tag[kind]}  {d['path']:14} {human(d.get('size')):>7}  {tran:5} {model:22} -- {reason}")
        for m in mounts_of(d):
            say("INFO", f"                       mounted: {m}")
    serial = serial_targets()
    for s in serial:
        say("INFO", f"🔌 SERIAL   {s['path']:14} {'':>7}  {s['id']:11} {s['model']:16} -- flash: hee image flash --image X.bin --device {s['path']}")
    print()
    if cards == 0 and not serial:
        say("WARNING", "no writable card or serial device detected. Insert one and re-run.")
        return 1
    say("OK", f"{cards} writable card(s), {len(serial)} serial device(s); "
              f"{len(ds) - cards} block device(s) locked as system/fixed/empty/ro.")
    return 0


def cmd_check(device):
    d = find_disk(device)
    kind, reason, model, tran = describe(d)
    size = d.get("size") or 0
    say("INFO", f"device : {d['path']}  ({model}, {tran}, {human(size)})")
    parts = d.get("children") or []
    for p in parts:
        mp = ", ".join(mounts_of(p)) or "(not mounted)"
        say("INFO", f"  part {p['path']:16} {human(p.get('size')):>7}  {mp}")
    if not parts:
        say("INFO", "  no partitions (blank or whole-disk image)")
    if kind == "SYSTEM":
        say("CRITICAL", f"PROTECTED: {reason}. hee image will never write here.")
        return 2
    if kind == "EMPTY":
        say("WARNING", f"{reason} -- nothing to flash onto.")
        return 1
    if kind != "CARD":
        say("WARNING", f"not a flashable card: {reason}.")
        return 1
    if size > CARD_SIZE_WARN:
        say("WARNING", f"{human(size)} is large for a card -- double-check this is not a real drive.")
    if mounts_of(d):
        say("WARNING", f"WRITABLE, but {len(mounts_of(d))} partition(s) mounted; flash unmounts them first.")
    else:
        say("OK", f"WRITABLE: {tran} hotplug card, {human(size)}, no system mount. Ready to flash.")
    if any(p.get("children") or mounts_of(p) for p in parts):
        say("INFO", "NOTE: this card already holds data -- flashing ERASES it.")
    return 0


# --- make (scratch test image) ------------------------------------------------

def parse_size(s):
    s = s.strip().upper()
    unit = s[-1] if s and s[-1] in SIZE_UNITS and not s[-1].isdigit() else ""
    num = s[:-1] if unit else s
    try:
        n = int(float(num) * SIZE_UNITS[unit])
    except (ValueError, KeyError):
        die(3, f"bad --size {s!r} -- use a number with an optional K/M/G/T suffix, e.g. 1M.")
    if n <= 0:
        die(3, "--size must be positive.")
    return n


def cmd_make(size_str, path, pattern):
    n = parse_size(size_str)
    if n > MAKE_SIZE_WARN:
        say("WARNING", f"{human(n)} is large for a scratch test image.")
    out = Path(path or f"test-{size_str.lower()}.img")
    h = hashlib.sha256()
    written = 0
    with open(out, "wb") as f:
        while written < n:
            block = min(CHUNK, n - written)
            chunk = b"\0" * block if pattern == "zero" else os.urandom(block)
            f.write(chunk)
            h.update(chunk)
            written += block
    say("OK", f"wrote {human(n)} {pattern} image -> {out} (sha256 {h.hexdigest()[:16]}...)")
    say("INFO", f"test a flash:  hee image flash --image {out} --device /dev/DISK")
    return 0


# --- flash --------------------------------------------------------------------

def _open_image(path, decompress):
    if decompress:
        src = subprocess.Popen(["xz", "-dc", str(path)], stdout=subprocess.PIPE)
        return src, src.stdout
    return None, open(path, "rb")


def image_size_and_sha(path, decompress):
    """Stream the (optionally xz-decompressed) image once: return (size, sha256)."""
    src, stream = _open_image(path, decompress)
    h = hashlib.sha256()
    size = 0
    while True:
        chunk = stream.read(CHUNK)
        if not chunk:
            break
        h.update(chunk)
        size += len(chunk)
    stream.close()
    if src is not None and src.wait() != 0:
        die(2, f"xz -dc failed on {path}.")
    return size, h.hexdigest()


def write_image(path, decompress, dev, expected_size):
    """dd the (decompressed) image onto dev via sudo, hashing as it goes."""
    src, stream = _open_image(path, decompress)
    dd = subprocess.Popen(["sudo", "dd", f"of={dev}", "bs=4M", "conv=fsync", "iflag=fullblock"],
                          stdin=subprocess.PIPE)
    h = hashlib.sha256()
    written = 0
    next_report = 0
    try:
        while True:
            chunk = stream.read(CHUNK)
            if not chunk:
                break
            dd.stdin.write(chunk)
            h.update(chunk)
            written += len(chunk)
            if written >= next_report:
                pct = 100 * written / expected_size if expected_size else 0
                print(f"\r  writing {human(written)} / {human(expected_size)} ({pct:.0f}%) ...",
                      end="", file=sys.stderr, flush=True)
                next_report += CHUNK * 16
    finally:
        stream.close()
        if dd.stdin:
            dd.stdin.close()
    print(file=sys.stderr)
    if dd.wait() != 0:
        die(2, "dd reported a write error.")
    if src is not None and src.wait() != 0:
        die(2, "xz -dc failed mid-write.")
    return written, h.hexdigest()


def readback_sha(dev, nbytes):
    """sha256 of the first nbytes read back from dev (root, via sudo dd)."""
    dd = subprocess.Popen(
        ["sudo", "dd", f"if={dev}", "bs=4M", "iflag=count_bytes,fullblock", f"count={nbytes}"],
        stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    h = hashlib.sha256()
    got = 0
    while True:
        chunk = dd.stdout.read(CHUNK)
        if not chunk:
            break
        h.update(chunk)
        got += len(chunk)
    if dd.wait() != 0:
        die(2, "reading the device back failed.")
    if got != nbytes:
        die(2, f"read back {got} bytes, expected {nbytes} -- short read.")
    return h.hexdigest()


def confirm(dev, model, dev_size, yes):
    """True to proceed with the write. --yes bypasses; else a tty must type the path."""
    if yes:
        return True
    if not sys.stdin.isatty():
        say("WARNING", f"DRY RUN (no tty, no --yes): would ERASE {dev} ({model}, {human(dev_size)}).")
        say("INFO", f"to write:  hee image flash --image ... --device {dev} --yes")
        return False
    say("WARNING", f"About to ERASE {dev} ({model}, {human(dev_size)}) and overwrite it entirely.")
    try:
        typed = input(f"  Type the device path to confirm ({dev}), or anything else to abort: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    if typed != dev:
        say("INFO", "aborted -- device path not confirmed.")
        return False
    return True


def cmd_flash(image, device, yes, no_verify):
    img = Path(image)
    if not img.is_file():
        die(3, f"no such image file: {image}")
    for need in ("sudo", "dd"):
        if not shutil.which(need):
            die(3, f"{need} is required for flashing.")
    decompress = img.name.endswith(".xz")
    if decompress and not shutil.which("xz"):
        die(3, "xz is required to flash a .xz image.")

    d = find_disk(device)
    dev = d["path"]
    kind, reason, model, tran = describe(d)
    if kind == "SYSTEM":
        die(2, f"REFUSING to flash {dev}: PROTECTED -- {reason}.")
    if kind != "CARD":
        die(2, f"REFUSING to flash {dev}: not a writable card ({reason}).")

    say("INFO", f"image  : {img.name}  ({human(img.stat().st_size)} on disk"
                f"{', xz-compressed' if decompress else ''})")
    say("INFO", f"target : {dev}  ({model}, {tran}, hotplug card, {human(d.get('size'))})")
    dev_size = d.get("size") or 0
    if dev_size > CARD_SIZE_WARN:
        say("WARNING", f"{human(dev_size)} is large for a card -- confirm this is really an SD/MMC card.")

    say("INFO", "measuring the image (decompress + sha256) ...")
    size, want_sha = image_size_and_sha(img, decompress)
    say("INFO", f"image is {human(size)} decompressed; card is {human(dev_size)}; sha256 {want_sha[:16]}...")
    if size > dev_size:
        die(2, f"image ({human(size)}) is larger than the card ({human(dev_size)}). Use a bigger card.")

    mounted = [(p["path"], m) for p in (d.get("children") or []) for m in mounts_of(p)]
    if any(is_system_mount(m) for _, m in mounted):
        die(2, f"{dev} has a SYSTEM mount -- refusing (should have been caught as protected).")

    if not confirm(dev, model, dev_size, yes):
        if mounted:
            say("INFO", "(would first unmount: " + ", ".join(f"{p}->{m}" for p, m in mounted) + ")")
        return 1

    for p, m in mounted:
        say("INFO", f"unmounting {p} ({m}) ...")
        r = run(["sudo", "umount", p])
        if r.returncode != 0:
            die(2, f"could not unmount {p}: {r.stderr.strip()[:160]}")

    say("INFO", f"writing {img.name} -> {dev} (dd conv=fsync) ...")
    written, write_sha = write_image(img, decompress, dev, size)
    if written != size or write_sha != want_sha:
        die(2, "the bytes sent to dd did not match the image -- aborting before verify.")
    run(["sudo", "blockdev", "--flushbufs", dev])

    if no_verify:
        say("OK", f"wrote {human(written)} to {dev} (verify skipped by --no-verify). Eject before removing.")
        return 0

    say("INFO", "verifying: reading the card back and comparing sha256 ...")
    got_sha = readback_sha(dev, size)
    if got_sha != want_sha:
        say("CRITICAL", f"VERIFY FAILED: card sha {got_sha[:16]}... != image {want_sha[:16]}...")
        say("INFO", "the card may be faulty, counterfeit, or was disturbed mid-write. Do NOT boot it.")
        return 2
    say("OK", f"flashed and verified {human(size)} to {dev} (sha256 {want_sha[:16]}...). Safe to eject.")
    return 0


# --- firmware over serial (esptool) ------------------------------------------

IDF_PROFILE = "/etc/profile.d/esp-idf.sh"
FIRMWARES = ("espectre",)
CHIPS = ("esp32", "esp32s2", "esp32s3", "esp32c3", "esp32c5", "esp32c6")
# `build` targets ESPectre Native, which is ESP-IDF and ESP32-family only, so it
# uses CHIPS. `flash` just writes a prebuilt .bin with esptool, which speaks the
# ESP8266 too -- and the fleet's soil/weather nodes are ESP8266 (NodeMCU), built
# by arduino-cli into a single image at 0x0. So flashing accepts one more chip
# than building does. esptool reports "This chip is ESP8266, not ESP32" if the
# --chip is wrong, which is exactly the wall a bare `flash` hit on 2026-09-26.
FLASH_CHIPS = CHIPS + ("esp8266",)
# ESPectre's chip names for its own CLI; esptool and ESP-IDF use the idf_target.
ESPECTRE_CHIP = {"esp32": "esp32", "esp32s2": "s2", "esp32s3": "s3",
                 "esp32c3": "c3", "esp32c5": "c5", "esp32c6": "c6"}
FLASH_BAUD = "460800"
# esptool 5.3+ loses the classic ESP32 at 460800 during its stub SFDP probe
# (measured upstream by ESPectre, src/python/espectre_cli/esptool_runner.py).
ESP32_SAFE_BAUD = "115200"


def is_serial_device(device):
    return any(device == s["path"] for s in serial_targets())


def idf_env():
    """The caller's environment plus the shared ESP-IDF's IDF_PATH and
    IDF_TOOLS_PATH from /etc/profile.d when this shell did not read it
    (tmux-agent sessions and cron do not)."""
    env = os.environ.copy()
    if "IDF_PATH" not in env and os.path.isfile(IDF_PROFILE):
        with open(IDF_PROFILE, encoding="utf-8") as fh:
            for line in fh:
                m = re.match(r'\s*export\s+(IDF_PATH|IDF_TOOLS_PATH)="?([^"\n]*)"?', line)
                if m:
                    env[m.group(1)] = m.group(2)
    return env


def esptool_cmd(env):
    """esptool: the one on PATH, else the shared ESP-IDF venv's module. Returns
    (argv prefix, major version) -- esptool 5 renamed verbs and options to
    hyphens (write-flash, --flash-mode); 4 has underscores."""
    exe = shutil.which("esptool")
    cmd = [exe] if exe else None
    if cmd is None:
        tools = env.get("IDF_TOOLS_PATH", "")
        for py in sorted(glob.glob(os.path.join(tools, "python_env", "*", "bin", "python"))):
            cmd = [py, "-m", "esptool"]
            break
    if cmd is None:
        die(3, "esptool not found on PATH and no ESP-IDF python env "
               "(fleet-ops esp32/bin/install-esp-idf.sh installs one).")
    r = run(cmd + ["version"])
    m = re.search(r"v?(\d+)\.\d+", r.stdout or "")
    if r.returncode != 0 or not m:
        die(3, f"{' '.join(cmd)} version failed: {(r.stderr or r.stdout).strip()[:160]}")
    return cmd, int(m.group(1))


def et(word, major):
    """Spell an esptool verb/option/value for the installed major version:
    5 has write-flash / --flash-mode / hard-reset, 4 has write_flash /
    --flash_mode / hard_reset. Leading dashes of an option stay dashes."""
    if major >= 5:
        return word
    lead = len(word) - len(word.lstrip("-"))
    return word[:lead] + word[lead:].replace("-", "_")


def git_describe(repo):
    r = run(["git", "-c", "safe.directory=*", "-C", str(repo), "describe", "--tags", "--always", "--dirty"])
    return r.stdout.strip() if r.returncode == 0 and r.stdout.strip() else "unknown"


def cmd_build(firmware, chip, repo, ota_channel, clean, out, dry_run):
    if firmware not in FIRMWARES:
        die(3, f"unknown firmware {firmware!r}; known: {', '.join(FIRMWARES)}")
    repo = Path(repo or os.environ.get("ESPECTRE_REPO") or Path.home() / "git" / "espectre").expanduser()
    cli = repo / "espectre"
    app = repo / "src" / "cpp" / "frontend" / "native" / "app"
    build_dir = app / f"build-{chip}"
    overlay = app / "sdkconfig.wifi"
    env = idf_env()
    out_dir = Path(out or ".")
    say("INFO", f"firmware : {firmware} native, chip {chip}, OTA channel {ota_channel}")
    say("INFO", f"checkout : {repo}  ({git_describe(repo) if cli.is_file() else 'not present'})")
    say("INFO", f"ESP-IDF  : {env.get('IDF_PATH', 'not found -- no IDF_PATH and no ' + IDF_PROFILE)}")
    say("INFO", f"overlay  : {'app/sdkconfig.wifi present (Wi-Fi baked in)' if overlay.is_file() else 'none (Improv provisioning at first boot)'}")
    say("INFO", f"output   : {out_dir.resolve()}/{firmware}-native-{chip}-<version>.bin")
    if dry_run:
        say("OK", "dry run: nothing built.")
        return 0
    if not cli.is_file():
        die(3, f"no ESPectre checkout at {repo} (set --repo or ESPECTRE_REPO).")
    if "IDF_PATH" not in env:
        die(3, "no ESP-IDF: run fleet-ops esp32/bin/install-esp-idf.sh, or source your IDF's export.sh.")

    cmd = [str(cli), "native", "build", "--chip", ESPECTRE_CHIP[chip], "--backend", "local",
           "--ota-channel", ota_channel] + (["--clean"] if clean else [])
    say("INFO", "running: " + " ".join(cmd))
    if subprocess.run(cmd, cwd=repo, env=env, check=False).returncode != 0:
        die(2, "the firmware build failed (see its output above).")

    meta_path = build_dir / "flasher_args.json"
    if not meta_path.is_file():
        die(2, f"build finished but {meta_path} is missing -- not an ESP-IDF build dir?")
    with meta_path.open(encoding="utf-8") as fh:
        meta = json.load(fh)
    settings = meta.get("flash_settings") or {}
    files = meta.get("flash_files") or {}
    if not files:
        die(2, f"{meta_path} lists no flash files.")

    esptool, major = esptool_cmd(env)
    out_dir.mkdir(parents=True, exist_ok=True)
    out_path = out_dir / f"{firmware}-native-{chip}-{git_describe(repo)}.bin"
    merge = esptool + ["--chip", chip, et("merge-bin", major), "-o", str(out_path.resolve())]
    for key in ("flash_mode", "flash_freq", "flash_size"):
        if settings.get(key):
            merge += [et("--" + key.replace("_", "-"), major), settings[key]]
    for addr, name in sorted(files.items(), key=lambda kv: int(kv[0], 0)):
        merge += [addr, name]
    r = run(merge, cwd=build_dir)
    if r.returncode != 0:
        die(2, f"esptool merge failed: {(r.stderr or r.stdout).strip()[-300:]}")
    size, sha = image_size_and_sha(out_path, False)
    say("OK", f"built {out_path} ({human(size)}, sha256 {sha})")
    say("INFO", f"flash it:  hee image flash --image {out_path} --device /dev/ttyUSB0 --chip {chip}")
    return 0


def confirm_serial(dev, mac, chip, yes):
    if yes:
        return True
    if not sys.stdin.isatty():
        say("WARNING", f"DRY RUN (no tty, no --yes): would WRITE {chip} at MAC {mac} on {dev}.")
        say("INFO", f"to write:  hee image flash --image ... --device {dev} --yes")
        return False
    say("WARNING", f"About to WRITE firmware to the {chip} at MAC {mac} on {dev}.")
    try:
        typed = input(f"  Type the device path to confirm ({dev}), or anything else to abort: ").strip()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    if typed != dev:
        say("INFO", "aborted -- device path not confirmed.")
        return False
    return True


def cmd_flash_serial(image, device, chip, offset, erase, yes, no_verify):
    img = Path(image)
    if not img.is_file():
        die(3, f"no such image file: {image}")
    if not os.access(device, os.R_OK | os.W_OK):
        die(3, f"{device} is not writable by you: join group dialout (then re-login), "
               f"or run under `sg dialout -c '...'`.")
    try:
        int(offset, 0)
    except ValueError:
        die(3, f"bad --offset {offset!r}; use hex like 0x0 or 0x10000.")
    if no_verify:
        say("INFO", "--no-verify has no meaning over serial: esptool hashes every written region itself.")
    env = idf_env()
    esptool, major = esptool_cmd(env)
    # Classic esp32 loses the stub's SFDP probe at 460800 (measured on ESPectre);
    # every other chip, esp8266 included, flashes fine at the faster rate.
    baud = ESP32_SAFE_BAUD if chip == "esp32" else FLASH_BAUD
    base = esptool + ["--chip", chip, "--port", device, "--baud", baud,
                      "--before", et("default-reset", major), "--after", et("hard-reset", major)]

    size, sha = image_size_and_sha(img, False)
    say("INFO", f"image  : {img.name}  ({human(size)}, sha256 {sha[:16]}...) at offset {offset}")
    say("INFO", f"target : {device}  ({chip} @ {baud} baud{', full erase first' if erase else ''})")

    r = run(base + [et("read-mac", major)])
    m = re.search(r"MAC:\s*([0-9a-f:]{17})", r.stdout or "", re.IGNORECASE)
    if r.returncode != 0 or not m:
        holder = run(["fuser", "-v", device]).stderr.strip().splitlines()[-1:] if shutil.which("fuser") else []
        say("CRITICAL", f"cannot talk to the board on {device}: {(r.stderr or r.stdout).strip().splitlines()[-1:] or 'no MAC'}")
        if holder:
            say("INFO", f"the port is held by: {holder[0].strip()} -- close that monitor first.")
        else:
            say("INFO", "is a monitor open on the port? try: fuser -v " + device)
        return 2
    mac = m.group(1).lower()
    say("INFO", f"board  : MAC {mac}  (inventory stableid {mac.replace(':', '')})")

    if not confirm_serial(device, mac, chip, yes):
        return 1
    args = base + [et("write-flash", major)] + (["--erase-all"] if erase else []) + [offset, str(img)]
    say("INFO", "running: " + " ".join(args))
    if subprocess.run(args, check=False).returncode != 0:
        die(2, "esptool reported a failure -- the board may be half-written; re-run, or --erase and re-run.")
    say("OK", f"flashed {img.name} to {chip} {mac} on {device}; esptool verified every region.")
    say("INFO", f"inventory: stableid {mac.replace(':', '')}  flash_image_sha256 {sha}")
    return 0


def main(argv=None):
    ap = argparse.ArgumentParser(prog="hee image", description=__doc__.split("\n")[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = ap.add_subparsers(dest="command", required=True)
    sub.add_parser("list", help="flashable targets: cards and ttyUSB serial")
    c = sub.add_parser("check", help="deep pre-flight on one block device")
    c.add_argument("device", help="e.g. /dev/mmcblk0")
    f = sub.add_parser("flash", help="flash an image onto a card or a serial board, then verify")
    f.add_argument("--image", required=True, help="the .img/.img.xz (card) or merged .bin (serial) to write")
    f.add_argument("--device", required=True, help="the card, e.g. /dev/mmcblk0, or the board, e.g. /dev/ttyUSB0")
    f.add_argument("--yes", action="store_true", help="skip the typed confirmation (automation)")
    f.add_argument("--no-verify", action="store_true", help="card only: skip the read-back sha256 check")
    f.add_argument("--chip", choices=FLASH_CHIPS, default="esp32",
                   help="serial only: the chip (default esp32; esp8266 for the NodeMCU soil/weather nodes)")
    f.add_argument("--offset", default="0x0", help="serial only: flash offset of the image (default 0x0, a merged image)")
    f.add_argument("--erase", action="store_true", help="serial only: erase the whole flash first (NVS, credentials, OTA data)")
    b = sub.add_parser("build", help="build a firmware and merge it into one flashable .bin")
    b.add_argument("--firmware", choices=FIRMWARES, required=True, help="which firmware")
    b.add_argument("--chip", choices=CHIPS, required=True, help="the target chip")
    b.add_argument("--repo", help="the firmware checkout (default $ESPECTRE_REPO or ~/git/espectre)")
    b.add_argument("--ota-channel", choices=["release", "preview", "develop"], default="release",
                   help="ESPectre's compiled-in OTA channel (default release)")
    b.add_argument("--clean", action="store_true", help="clean the chip's build directory first")
    b.add_argument("--out", help="directory for the merged .bin (default .)")
    b.add_argument("--dry-run", action="store_true", help="print the plan, build nothing")
    m = sub.add_parser("make", help="make a scratch test image")
    m.add_argument("--size", required=True, help="e.g. 1M, 64M, 512K (K/M/G/T suffix)")
    m.add_argument("path", nargs="?", help="output file (default test-<size>.img)")
    m.add_argument("--pattern", choices=["zero", "random"], default="random", help="fill (default random)")
    # The bare `help` verb, plus --help/-h, uniformly -- before argparse, which
    # owns only -h/--help and would error on an unrelated arg first. value_flags
    # keep `--image help` (etc.) a filename, not a help request.
    value_flags = ("--image", "--device", "--size", "--pattern", "--chip", "--offset",
                   "--firmware", "--repo", "--ota-channel", "--out")
    raw = list(argv) if argv is not None else sys.argv[1:]
    if help_wanted(raw, value_flags):
        note_ignored(raw, value_flags=value_flags)
        ap.print_help()
        return 0
    try:
        a = ap.parse_args(argv)
    except SystemExit as exc:
        return 0 if exc.code == 0 else 3
    if a.command == "list":
        return cmd_list()
    if a.command == "check":
        return cmd_check(a.device)
    if a.command == "make":
        return cmd_make(a.size, a.path, a.pattern)
    if a.command == "build":
        return cmd_build(a.firmware, a.chip, a.repo, a.ota_channel, a.clean, a.out, a.dry_run)
    if is_serial_device(a.device):
        return cmd_flash_serial(a.image, a.device, a.chip, a.offset, a.erase, a.yes, a.no_verify)
    return cmd_flash(a.image, a.device, a.yes, a.no_verify)


if __name__ == "__main__":
    sys.exit(main())
