#!/bin/sh
# section: 1
# hee-lint: fast lint gate for HEE-object YAML (apiVersion: hee/v1)
# Modes:
#   --mode warn|error   (default warn)
# Behavior:
#   Scans tracked *.yml/*.yaml. Governance objects (contracts/blueprints/plans,
#   by dir or name) MUST carry the envelope; other files are checked only if they
#   declare `apiVersion: hee/v1`.

usage() {
  cat <<'TXT'
hee-lint -- fast lint gate for HEE-object YAML

SYNOPSIS
  hee-lint [--mode warn|error]
  hee-lint help | --help | -h

DESCRIPTION
  Scans TRACKED *.yml/*.yaml. Two gates:

  1. GOVERNANCE OBJECTS (fail-closed). A file that lives under contracts/,
     hee/contracts/, blueprints/ or plans/ -- OR is named *.contract.yaml,
     *.blueprint.yaml or *.plan.yaml -- MUST be a HEE object: it must carry
     `apiVersion: hee/v1`, a top-level `kind:` matching its convention
     (contract->Contract, blueprint->Blueprint|BlueprintDoctrine, plan->Plan),
     and a top-level `spec:`. This closes the blind spot where a contract that
     simply omitted the envelope was classified "not a HEE object" and passed
     silently -- the malformation was what hid it. Derived/sample/archive trees
     (tests/, */fixtures/, */examples/, */templates/, docs/history/) are exempt.

  2. ENVELOPE OBJECTS. Any other file declaring `apiVersion: hee/v1` is checked;
     everything else is ignored, so this is safe to run across a mixed repo.

  Checks (both gates): metadata present and parseable, metadata.annotations present,
  a null inuid's inuid_null_reason is in the sanctioned enum (bootstrap / test /
  fixture / example / soa_pending; SSoT: the kind-registry's allowed_null_reasons),
  metadata.annotations.inuid present, a null inuid accompanied by
  inuid_null_reason, and -- when the object declares
  inuid_derivation: sha256(inuid_seed) -- that the recorded inuid actually
  reproduces from its own seed. An identity hash that does not derive from
  the seed it names is a determinism claim the object cannot support.

OPTIONS
  --mode warn    report findings, exit 0 -- non-blocking (default)
  --mode error   report findings, exit 2 if any

ENVIRONMENT
  HEE_LINT_SKIP  git pathspecs to exclude, space-separated, e.g.
                 ':!viz-dashboard/public/*' -- a rendered surface holding
                 copies of objects it does not own is derived, not a source,
                 and declaring that is the repo's job.

EXAMPLES
  $ hee lint --mode warn tests/fixtures   # ci

  --mode warn reports findings without failing (exit 0), so it proves the
  linter runs over the fixtures deterministically. --mode error exits 2 on a
  finding and is left unmarked (it depends on what is under the path).

EXIT STATUS
  0  OK        clean, OR any findings under --mode warn
  2  CRITICAL  findings under --mode error
  3  UNKNOWN   cannot run -- not in a git repo, or an unrecognized option

  --mode warn ALWAYS exits 0. That is deliberate, not an oversight: warn
  mode's own name promises a non-blocking report, and it previously exited 1
  on any finding, silently gating commits on pre-existing unrelated failures
  (real incident, 2026-08-24). Only --mode error blocks.

  Documented as measured, not as it "should" be -- this help IS the published
  man page, so an aspirational exit table would publish a lie.
TXT
}

# Help is answered FIRST: before argument parsing, and before the git-repo
# check. It needs neither. This tool is the reason library/py/hee_clicheck
# exists -- `hee lint help` printed "not in a git repo" in bare color, which is
# two defects in one line, and the generated man page became this tool's own
# lint output because --help fell through to a silent `shift`.
# Resolve through symlinks before deriving TOOL_ROOT -- tools are symlinked
# onto PATH from ~/.local/bin, where a bare `dirname "$0"` finds no library/.
HEE_SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  HEE_SELF="$(realpath "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
elif command -v readlink >/dev/null 2>&1; then
  HEE_SELF="$(readlink -f -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
fi
TOOL_ROOT="$(cd "$(dirname "$HEE_SELF")/../.." && pwd)"

# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"

# Contextual help, via the shared contract. Replaces a positional check that
# saw only one argument position, and announces what it discarded.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  usage
  exit 0
fi


MODE="warn"
while [ $# -gt 0 ]; do
  case "$1" in
    --mode) MODE="$2"; shift 2;;
    -*) echo "UNKNOWN: unrecognized option: $1 -- see: hee lint help" >&2; exit 3;;
    *) shift;;
  esac
done

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "${REPO_ROOT}" ]; then
  echo "🔴 UNKNOWN: not in a git repo -- hee-lint needs a checkout" >&2
  exit 3
fi

FAIL=0
WARN=0

# Only tracked YAML files (avoid untracked noise). HEE_LINT_SKIP holds
# space-separated git pathspecs to exclude, e.g. ':!viz-dashboard/public/*'
# -- for a rendered surface that carries copies of objects it does not own.
# A derived directory is not a source of truth and should not be linted as
# one; declaring it here is the repo saying so, out loud, per rule 16.
# shellcheck disable=SC2086
FILES="$(cd "${REPO_ROOT}" && eval git ls-files "'*.yml'" "'*.yaml'" ${HEE_LINT_SKIP:-} 2>/dev/null)"
if [ -z "${FILES}" ]; then
  echo "🟢 OK: no tracked YAML files"
  exit 0
fi

# Governance objects -- contracts, blueprints, plans -- MUST be HEE objects of
# the MATCHING kind, by where they live or what they are named. This is the
# fail-CLOSED half of the gate. The check below it only ever looked at files
# that ALREADY declared `apiVersion: hee/v1`, so a contract that dropped the
# envelope was classified "not ours" and passed silently -- the malformation
# was exactly what hid it (measured 2026-09-27: 14 such contracts in HEE
# contracts/, 1 blueprint in fleet-ops). A governance object with no envelope
# is now CRITICAL, not skipped. Derived/sample trees are exempt: a fixture is
# allowed to be a deliberately broken object.
expected_kind_of() {
  # Derived, sample and archived trees are exempt: a fixture may be a
  # deliberately broken object, and docs/history/ is a snapshot of the past,
  # not a live source of truth.
  case "$1" in
    tests/*|*/tests/*|*/fixtures/*|*/examples/*|*/templates/*) return 1;;
    docs/history/*|*/docs/history/*) return 1;;
  esac
  # Echo the SET of kinds allowed for this convention (space-separated). The
  # blueprint set carries BlueprintDoctrine as well as Blueprint: the two are
  # in tension across the registry (active_kinds, authoritative) and
  # schemas/hee/v1/blueprint-doctrine.schema.json (const BlueprintDoctrine),
  # and this gate refuses to adjudicate that -- it enforces the envelope, not
  # the taxonomy fight. First word is the display label.
  case "$1" in
    *.contract.*|contracts/*|*/contracts/*)    echo "Contract";  return 0;;
    *.blueprint.*|blueprints/*|*/blueprints/*) echo "Blueprint BlueprintDoctrine"; return 0;;
    *.plan.*|plans/*|*/plans/*)                echo "Plan";      return 0;;
  esac
  return 1
}

check_file() {
  f="$1"

  has_env=0
  rg -n --no-messages -q '^[[:space:]]*apiVersion:[[:space:]]*hee/v1[[:space:]]*$' "$f" && has_env=1

  want_kind="$(expected_kind_of "$f")" || want_kind=""

  if [ -n "$want_kind" ]; then
    label="${want_kind%% *}"
    # A governance object: the HEE envelope is mandatory, not opt-in.
    if [ "$has_env" -eq 0 ]; then
      echo "🔴 CRITICAL: missing 'apiVersion: hee/v1' -- a $label object must carry the HEE envelope: $f"
      FAIL=$((FAIL+1)); return 0
    fi
    got_kind="$(rg --no-messages -N -o '^kind:[[:space:]]*.+' "$f" | head -1 | sed -e 's/^kind:[[:space:]]*//' -e 's/[[:space:]]*#.*$//' -e 's/^["'"'"']//' -e 's/["'"'"']$//' -e 's/[[:space:]]*$//')"
    case " $want_kind " in
      *" ${got_kind:-none} "*) : ;;
      *) echo "🔴 CRITICAL: kind must be one of [$want_kind] (got '${got_kind:-none}') -- governance object: $f"
         FAIL=$((FAIL+1)); return 0;;
    esac
    if ! rg --no-messages -q '^spec:' "$f"; then
      echo "🔴 CRITICAL: missing top-level 'spec:' -- a $label object: $f"
      FAIL=$((FAIL+1)); return 0
    fi
    # fall through: metadata / annotations / inuid are still enforced below.
  elif [ "$has_env" -eq 0 ]; then
    # Not a governance object and it did not opt in -- ignore, as before.
    return 0
  fi

  perl -0777 -ne '
    my $txt = $_;

    # crude YAML block scan (indent-based) for metadata.annotations.inuid + optional null reason
    my ($inuid, $inuid_val, $null_reason) = (0, "", 0);

    # find metadata block
    if ($txt !~ /(^|\n)\s*metadata:\s*\n/s) {
      print "🔴 CRITICAL: missing metadata: $ARGV\n";
      exit 3;
    }

    # find annotations block under metadata (best-effort, indent based)
    if ($txt !~ /(^|\n)\s*metadata:\s*\n(.*?)(\n\S|$)/s) {
      print "🔴 CRITICAL: cannot parse metadata block: $ARGV\n";
      exit 3;
    }
    my $meta = $2;

    if ($meta !~ /(^|\n)(\s*)annotations:\s*\n((?:\2[ \t]+\S.*\n?)*)/s) {
      print "🔴 CRITICAL: missing metadata.annotations: $ARGV\n";
      exit 3;
    }
    my $ann = $3;

    if ($ann =~ /(^|\n)\s*inuid:\s*(.*?)\s*(\n|$)/s) {
      $inuid = 1;
      $inuid_val = $2;
      $inuid_val =~ s/#.*$//;  # strip inline comment
      $inuid_val =~ s/^\s+|\s+$//g;
    }

    my $null_reason_val = "";
    if ($ann =~ /(^|\n)\s*inuid_null_reason:\s*(.*?)\s*(\n|$)/s) {
      $null_reason = 1;
      $null_reason_val = $2;
      $null_reason_val =~ s/#.*$//;
      $null_reason_val =~ s/^["'\''"]|["'\''"]$//g;
      $null_reason_val =~ s/^\s+|\s+$//g;
    }

    if (!$inuid) {
      print "🔴 CRITICAL: missing metadata.annotations.inuid: $ARGV\n";
      exit 3;
    }

    # treat null/~ as null
    if ($inuid_val eq "null" || $inuid_val eq "~") {
      if (!$null_reason) {
        print "🔴 CRITICAL: inuid is null but missing inuid_null_reason: $ARGV\n";
        exit 3;
      }
      # inuid_null_reason is an ENUM. A value outside it is a footgun that used to
      # pass silently. SSoT: hee/contracts/hee.kind-registry.contract.v1.yaml
      # spec.inuid_rules.allowed_null_reasons (mirrored here for cross-repo runs).
      my %allowed = map { $_ => 1 } qw(bootstrap test fixture example soa_pending);
      if (!$allowed{$null_reason_val}) {
        print "🔴 CRITICAL: inuid_null_reason \"$null_reason_val\" not in allowed set (bootstrap/test/fixture/example/soa_pending): $ARGV\n";
        exit 3;
      }
    }

    # An inuid that declares sha256(inuid_seed) must actually reproduce from it.
    # Determinism is one of this project stated top-level priorities; an
    # identity hash that does not derive from its own stated seed is a claim
    # the object cannot support. Measured 2026-09-06: 19 of 21 objects across
    # the org reproduced, one did not.
    my ($deriv) = $ann =~ /(?:^|\n)\s*inuid_derivation:\s*"?(.*?)"?\s*(?:\n|$)/s;
    my ($seed)  = $ann =~ /(?:^|\n)\s*inuid_seed:\s*"?(.*?)"?\s*(?:\n|$)/s;
    my ($hex)   = $inuid_val =~ /^"?([0-9a-f]{64})"?$/;
    if (defined $deriv && defined $seed && defined $hex && $deriv =~ /sha256\(inuid_seed\)/) {
      require Digest::SHA;
      my $calc = Digest::SHA::sha256_hex($seed);
      if ($calc ne $hex) {
        print "🔴 CRITICAL: inuid does not reproduce from inuid_seed: $ARGV\n";
        exit 3;
      }
    }

    # if it exists and is quoted empty -> warn/error
    if ($inuid_val =~ /^""$/ || $inuid_val =~ /^'\'''\''$/) {
      print "🟡 WARNING: inuid is empty string: $ARGV\n";
      exit 4;
    }

    print "🟢 OK: $ARGV\n";
    exit 0;
  ' "$f"
  rc=$?
  if [ $rc -eq 3 ]; then
    FAIL=$((FAIL+1))
  elif [ $rc -eq 4 ]; then
    WARN=$((WARN+1))
  fi
}

cd "${REPO_ROOT}" || exit 3
for f in $FILES; do
  check_file "$f"
done

if [ "${MODE}" = "error" ]; then
  if [ $FAIL -ne 0 ] || [ $WARN -ne 0 ]; then
    echo "🔴 CRITICAL: RESULT fail=${FAIL} warn=${WARN} (mode=error)"
    exit 2
  fi
fi

# Real bug fix (2026-08-24): mode=warn's own name promises a non-blocking
# report, but this exited 1 on any FAIL, silently gating commits/hooks the
# same as mode=error -- hit live blocking an unrelated pve/haproxy commit
# on ~23 pre-existing, unrelated blueprint/card failures. mode=warn now
# always reports and exits 0; only mode=error (handled above) blocks.
if [ $FAIL -ne 0 ]; then
  echo "🟡 WARNING: RESULT fail=${FAIL} warn=${WARN} (mode=warn, non-blocking)"
  exit 0
fi

if [ $WARN -ne 0 ]; then
  echo "🟡 WARNING: RESULT fail=${FAIL} warn=${WARN} (mode=warn)"
  exit 0
fi

echo "🟢 OK: RESULT fail=0 warn=0"
exit 0
