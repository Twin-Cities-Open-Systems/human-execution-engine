#!/usr/bin/env python3
# section: 1
"""hee-ticket -- the real, minimal first step of an internal ticket
system, dogfooded, not the full thing.

Real trigger (2026-08-21): "we need a workflow for that, ticket may
not be right and just glogging gh, we need internal ticket system...
./hee ticket -new 'perm change for oper/agent@host:/foo/bar'". GitHub
Issues is itself an external dependency for all of TCOS's tracking
(same class of concern as primitives#5's dependency-removal work) --
this is the smallest real, dogfoodable step toward a TCOS-owned
alternative, not a declaration that it replaces GitHub Issues as
standard practice yet.

Storage: `.hee/tickets/<id>.yaml`, one real record per ticket -- .hee/
is already real, git-tracked working-state (see .hee/spool/*.yaml's
phase_id/status/timestamps shape, same idea, this is a sibling of
that, not a new convention invented from nothing).

Real trigger for the `stage` field specifically (2026-08-21): Spencer's
own pseudocode, `idea:{1,}->footgun:{1,}->dogfood:{1,}` -- the real
idea->footgun->dogfood pipeline named as a heeism much earlier the same
session, now made structural rather than staying prose-only. Real,
not aspirational: `stage_history` records every transition with a
timestamp, so "how many tickets are actually at each stage, and how
long did each stage take" is a real, derivable count -- not asserted.

Usage:
  hee-ticket -new "description text" [--source WHERE] [--ref URL] [--tag T,T]
  hee-ticket -list [--open | --closed]
  hee-ticket -advance ID     # idea -> footgun -> dogfood, one step at a time
  hee-ticket -close SPEC [--why TEXT]   # mark one or more tickets closed
  hee-ticket -html [--workspace [DIR]] [--out FILE]   # the todo page body, from the records
                             #   SPEC: comma list (1,2,3), ranges (1-3,7),
                             #   or mixed (1-3,7,9) -- digits/commas/hyphens
                             #   only. Anything else is treated as a regex
                             #   matched against each ticket's description.
"""
import argparse
import html as _html
import os
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

STAGES = ["idea", "footgun", "dogfood"]

# Help is contextual: `help` as the LAST argument prints help for wherever
# you are in the command (issue:462@human-execution-engine).
#   hee-ticket help          -> the tool
#   hee-ticket -close help   -> the -close action
# A trailing help ALWAYS wins, even where the action takes a value. That
# is deliberate and safety-relevant: `-close help` reading "help" as a
# regex would close every ticket whose description contains the word.
# To really match that pattern, write it so it is not the bare word --
# `hee-ticket -close 'hel[p]'`.
HELP_NEW = """hee-ticket -new -- open a ticket

SYNOPSIS
  hee-ticket -new "DESCRIPTION"

DESCRIPTION
  Writes one new record to .hee/tickets/<id>.yaml and prints its id,
  stage and repo-relative path.

  The id is the highest existing numeric id plus one, zero-padded to four
  digits, so ids are per-repo and never reused. New tickets always start
  at status open, stage idea, with the first stage_history entry stamped
  in UTC.

  DESCRIPTION is stored verbatim and is the only field you can set at
  creation -- there is no priority, assignee, or label. Quote it; an
  unquoted multi-word description is not concatenated for you.

EXIT STATUS
  0 OK   ticket written
  1      not inside a git repo, or pyyaml is not installed
"""

HELP_LIST = """hee-ticket -list -- every ticket in this repo

SYNOPSIS
  hee-ticket -list

DESCRIPTION
  Prints one line per ticket:

      <id>  [<status>]  (<stage>)  <description>  (<created_at>)

  Ordered by filename, which for zero-padded numeric ids is creation
  order. Closed tickets are listed alongside open ones -- there is no
  filter, and no count summary. Prints "No tickets yet." when the
  directory is empty.

EXIT STATUS
  0 OK   listing printed, including the empty case
  1      not inside a git repo, or pyyaml is not installed
"""

HELP_ADVANCE = """hee-ticket -advance -- move a ticket one stage forward

SYNOPSIS
  hee-ticket -advance ID

DESCRIPTION
  Advances exactly one stage along the real idea -> footgun -> dogfood
  pipeline, never more, and never backwards. There is no way to skip a
  stage or to reverse one with this tool.

  ID is zero-padded to four digits for you, so 7 and 0007 are the same
  ticket. Every transition appends {stage, at} to the ticket's
  stage_history with a UTC timestamp, which is what makes "how long did
  each stage take" a derivable number rather than an assertion.

  A ticket already at dogfood prints a "nothing to advance to" line and
  succeeds -- advancing is idempotent at the end of the pipeline.

EXIT STATUS
  0 OK   advanced, or already at the final stage
  1      no such ticket, the ticket carries an unrecognized stage, not
         inside a git repo, or pyyaml is not installed
"""

HELP_CLOSE = """hee-ticket -close -- close one or more tickets

SYNOPSIS
  hee-ticket -close SPEC

DESCRIPTION
  Sets status to closed and stamps closed_at (UTC) on every ticket SPEC
  selects. Stage is left exactly as it was -- closing is not advancing.

  SPEC is resolved by the shared selector in library/py/hee_range, the
  same one hee-git-merge uses, and takes one of two forms:

    id / range list   digits, commas and hyphens only: 3, 1,2,3, 1-3,
                      or mixed 1-3,7,9. Matched against ticket ids
                      ignoring zero-padding, so 7 selects 0007. Ids in
                      the spec that do not exist are reported to stderr
                      and make the run exit 1, but every id that DOES
                      exist is still closed.
    regex             anything containing another character is compiled
                      as a case-insensitive Python regex and searched
                      (not fullmatched) against each description. No
                      match at all is an error; there is no confirmation
                      prompt before closing whatever it does match.

  A ticket that is already closed is reported as a no-op and is not
  re-stamped.

  Note the trailing-`help` rule above: `hee-ticket -close help` prints
  this page rather than closing tickets whose description says "help".

EXIT STATUS
  0 OK   every selected ticket is now closed
  1      an id in the spec does not exist, a regex matched nothing, not
         inside a git repo, or pyyaml is not installed

EXAMPLES
  hee-ticket -close 7
  hee-ticket -close 1-3,9
  hee-ticket -close 'perm change'
"""

HELP = """hee-ticket -- repo-local tickets, stored as real YAML in git

SYNOPSIS
  hee-ticket -new "DESCRIPTION" [--source WHERE] [--ref URL] [--tag T[,T...]]
  hee-ticket -list [--open | --closed]
  hee-ticket -advance ID
  hee-ticket -close SPEC [--why TEXT]
  hee-ticket -html [--workspace [DIR]] [--out FILE]
  hee-ticket [-ACTION] help

DESCRIPTION
  The smallest real, dogfoodable step toward tracking that TCOS owns
  outright, rather than renting from GitHub Issues. It does not replace
  GitHub Issues and does not sync with them -- nothing here reaches the
  network at all.

  Storage is one file per ticket at .hee/tickets/<id>.yaml under a repo
  root. Which repo: --repo NAME (a repo under ~/git), else the repo the
  current directory is inside. From any other directory -- like every hee
  tool, this one runs from anywhere (operator, 2026-09-10) -- the reading
  actions (-list, -html) show every repo under ~/git, one per origin, and
  the writing ones (-new, -advance, -close) ask for --repo rather than
  guess. The files are ordinary tracked YAML: commit them like anything
  else, and read or edit them by hand when this tool cannot express what
  you need.

  Every ticket carries the real idea -> footgun -> dogfood pipeline as a
  structural `stage` field plus a `stage_history` of timestamped
  transitions -- so stage counts and durations are derived from record,
  never asserted.

ACTIONS
  -new       open a ticket at stage idea. --source records where it came
             from (a page, a brain dump timestamp, a review); --ref a
             GitHub issue or PR URL it tracks; --tag comma-separated tags.
  -list      print every ticket in this repo (--workspace, or outside any
             repo: every repo under ~/git, repo first); --open/--closed filter
  -advance   move one ticket one stage forward
  -close     close tickets by id, range, or description regex; --why
             records the evidence as closed_reason -- a closed ticket with
             no reason is a claim, one with a reason is a record
  -html      render the tickets as the body of a todo page: a stats strip
             and two cards (open, done -- struck through), rows carrying
             stage, repo, source and ref as pills, in the org's card markup
             (data-tc-collapse, data-tc-arrange, data-tc-table) so the
             shared library/js components work on it. --workspace renders
             every repo under DIR (default ~/git) that has .hee/tickets,
             which is what "one todo.html" means. Prints to stdout, or
             --out FILE. Real trigger (2026-09-10, operator): "take all the
             old todo's ... cross off all those that are done. let's use
             our own hee ticket system for this. I just want one todo.html".

  Exactly one action runs per invocation. If several are passed they are
  tested in the order above and the first one present wins; the rest are
  silently ignored rather than rejected.

  Add `help` after any action for its own page:
      hee-ticket -close help

EXIT STATUS
  Nagios plugin convention.
  0 OK        the action completed
  1 WARNING   no action given (this page is printed), not inside a git
              repo, pyyaml missing, or the action's own failure -- see
              each action's page. Note: several of these are UNKNOWN- or
              CRITICAL-shaped in the org vocabulary; the tool really
              exits 1 today and is documented as-is, not changed here.

ENVIRONMENT
  No environment variables are read. `git` must be on PATH, the current
  directory must be inside a git repo, and pyyaml must be importable.

FILES
  .hee/tickets/<id>.yaml   one record per ticket, under the repo root.
                           Fields written by this tool: id, created_at,
                           description, status, stage, stage_history, and
                           when given source, ref, tags, closed_at,
                           closed_reason. Anything else you add by hand is
                           kept and, for -html, shown when it is a string.

SEE ALSO
  hee-git-merge -- shares the same id/range/regex selector
  (library/py/hee_range)
"""

_ACTION_HELP = {
    "-new": HELP_NEW,
    "-list": HELP_LIST,
    "-advance": HELP_ADVANCE,
    "-close": HELP_CLOSE,
}


# library/py lives in this tool's own repo, not the target repo -- derive
# from this script's own location, not repo_root() (which resolves to
# whatever repo this tool is currently invoked against). Inserted here,
# above the pyyaml import, because hee_cli must answer help first.
sys.path.insert(0, str(Path(__file__).resolve().parent.parent.parent / "library" / "py"))
from hee_cli import help_left, help_wanted, note_ignored  # noqa: E402


def _print_help_and_exit(argv):
    """Answer help BEFORE the pyyaml import below. A tool must be able to
    explain itself on a machine where its dependencies are not installed
    -- that is exactly when someone reads the help.

    Help dispatch goes through the shared contract (library/py/hee_cli), not
    the old `argv[-1]` idiom. That idiom only looked at the FINAL argument,
    so `hee-ticket -close help --force` was not recognized as help at all and
    ran the real -close. Asking for help must never be able to do anything.

    Actions here are spelled as flags (-close), so the topic comes from
    help_left, which keeps them, rather than help_verbs, which does not."""
    if not help_wanted(argv):
        return
    note_ignored(argv)
    left = help_left(argv)
    print(_ACTION_HELP.get(left[0] if left else "", HELP), end="")
    sys.exit(0)


_print_help_and_exit(sys.argv[1:])

try:
    import yaml
except ImportError:
    sys.exit("Requires pyyaml: pip install pyyaml")

from hee_range import resolve_spec  # noqa: E402


WORKSPACE_ROOT = os.path.join(os.path.expanduser("~"), "git")
_REPO_OVERRIDE = None   # --repo NAME: a repo under WORKSPACE_ROOT, from any directory


def repo_root():
    """The repo whose tickets this run reads or writes: --repo NAME under
    ~/git, else the git repo the current directory is inside, else None.
    None is a real answer, not an error: like every hee tool this one runs
    from any directory (operator, 2026-09-10), and outside a repo the reading
    actions fall back to the workspace while the writing ones ask for --repo."""
    if _REPO_OVERRIDE:
        p = Path(WORKSPACE_ROOT) / _REPO_OVERRIDE
        if not p.is_dir():
            sys.exit(f"hee-ticket: --repo {_REPO_OVERRIDE}: no {p}")
        return p
    out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    return Path(out.stdout.strip()) if out.returncode == 0 else None


def require_repo(action: str) -> Path:
    root = repo_root()
    if root is None:
        sys.exit(f"hee-ticket {action}: not inside a git repo -- pass --repo NAME "
                 f"(a repo under {WORKSPACE_ROOT}) to say which ticket set, or cd into one")
    return root


def tickets_dir(action: str = "") -> Path:
    d = require_repo(action) / ".hee" / "tickets"
    d.mkdir(parents=True, exist_ok=True)
    return d


def next_id(d: Path) -> str:
    existing = sorted(p.stem for p in d.glob("*.yaml") if p.stem.isdigit())
    n = int(existing[-1]) + 1 if existing else 1
    return f"{n:04d}"


def now_iso() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def cmd_new(description: str, source=None, ref=None, tags=None):
    d = tickets_dir("-new")
    tid = next_id(d)
    ts = now_iso()
    record = {
        "id": tid,
        "created_at": ts,
        "description": description,
        "status": "open",
        "stage": STAGES[0],
        "stage_history": [{"stage": STAGES[0], "at": ts}],
    }
    path = d / f"{tid}.yaml"
    if source:
        record["source"] = source
    if ref:
        record["ref"] = ref
    if tags:
        record["tags"] = [t.strip() for t in tags.split(",") if t.strip()]
    with open(path, "w") as f:
        yaml.safe_dump(record, f, sort_keys=False)
    print(f"hee-ticket {tid}: {description}")
    print(f"  stage: {STAGES[0]}")
    print(f"  {path.relative_to(repo_root())}")


def cmd_advance(tid: str):
    tid = tid.zfill(4)
    path = tickets_dir("-advance") / f"{tid}.yaml"
    if not path.exists():
        sys.exit(f"hee-ticket: no ticket {tid}")
    with open(path) as f:
        rec = yaml.safe_load(f)
    cur = rec.get("stage", STAGES[0])
    if cur not in STAGES:
        sys.exit(f"hee-ticket: unknown stage '{cur}' on ticket {tid} -- can't advance")
    idx = STAGES.index(cur)
    if idx == len(STAGES) - 1:
        print(f"hee-ticket {tid}: already at final stage ({cur}), nothing to advance to")
        return
    new_stage = STAGES[idx + 1]
    rec["stage"] = new_stage
    rec.setdefault("stage_history", []).append({"stage": new_stage, "at": now_iso()})
    with open(path, "w") as f:
        yaml.safe_dump(rec, f, sort_keys=False)
    print(f"hee-ticket {tid}: {cur} -> {new_stage}")


def die(msg):
    sys.exit(f"hee-ticket: {msg}")


def cmd_close(spec: str, why=None):
    from hee_range import is_id_range_spec, parse_id_range

    d = tickets_dir("-close")
    all_ids = sorted(p.stem for p in d.glob("*.yaml") if p.stem.isdigit())
    records = []
    for tid in all_ids:
        with open(d / f"{tid}.yaml") as f:
            records.append(yaml.safe_load(f))

    matched = resolve_spec(spec, records, lambda r: r["id"], lambda r: r.get("description"))

    missing = []
    if is_id_range_spec(spec):
        requested = {tid.zfill(4) for tid in parse_id_range(spec)}
        missing = sorted(tid for tid in requested if tid not in {r["id"] for r in records})
    elif not matched:
        print(f"hee-ticket -close: no tickets matched '{spec}'", file=sys.stderr)
        sys.exit(1)

    ok, already = [], []
    for rec in matched:
        tid = rec["id"]
        if rec.get("status") == "closed":
            already.append(tid)
            continue
        rec["status"] = "closed"
        rec["closed_at"] = now_iso()
        if why:
            rec["closed_reason"] = why
        with open(d / f"{tid}.yaml", "w") as f:
            yaml.safe_dump(rec, f, sort_keys=False)
        ok.append(tid)
    for tid in ok:
        print(f"hee-ticket {tid}: closed")
    for tid in already:
        print(f"hee-ticket {tid}: already closed, no-op")
    for tid in missing:
        print(f"hee-ticket {tid}: no such ticket", file=sys.stderr)
    if missing:
        sys.exit(1)


def cmd_list(only=None, workspace=None):
    root = repo_root()
    if workspace is not None or root is None:
        # Outside a repo (or asked for): every repo under the workspace, one
        # line per ticket, the repo first so the id is not ambiguous.
        sets = _workspace_ticket_sets(workspace or WORKSPACE_ROOT)
        if not sets:
            print(f"No tickets under {workspace or WORKSPACE_ROOT}.")
            return
        for repo, d in sets:
            for rec in _load_tickets(d):
                if only and rec.get("status") != only:
                    continue
                print(f"{repo}  {rec.get('id', '?')}  [{rec.get('status', '?')}]  ({rec.get('stage', '?')})  "
                      f"{rec.get('description', '')}  ({rec.get('created_at', '?')})")
        return
    d = root / ".hee" / "tickets"
    tickets = sorted(d.glob("*.yaml")) if d.is_dir() else []
    if not tickets:
        print("No tickets yet.")
        return
    for p in tickets:
        with open(p) as f:
            rec = yaml.safe_load(f)
        if only and rec.get("status") != only:
            continue
        stage = rec.get("stage", "?")
        print(f"{rec['id']}  [{rec['status']}]  ({stage})  {rec['description']}  ({rec['created_at']})")


# ---- -html: the todo page body -------------------------------------------
# Emits markup the shared browser components already understand (library/js:
# collapse, arrange, table), so the page needs no script of its own. A
# closed ticket is struck through and carries its reason, which is what
# "cross off the done ones" means when the crossing-off must be checkable.

def _load_tickets(d):
    out = []
    for p in sorted(d.glob("*.yaml")):
        try:
            with open(p) as f:
                rec = yaml.safe_load(f) or {}
        except Exception as e:  # a broken record is shown, not hidden
            rec = {"id": p.stem, "description": f"UNREADABLE: {e}", "status": "open", "stage": "?"}
        if isinstance(rec, dict):
            out.append(rec)
    return out


def _origin(repo):
    r = subprocess.run(["git", "-C", str(repo), "config", "--get", "remote.origin.url"],
                       capture_output=True, text=True)
    url = r.stdout.strip() if r.returncode == 0 else ""
    return url.rstrip("/").removesuffix(".git").lower()


def _workspace_ticket_sets(root):
    """(repo name, path) for every repo under ROOT with .hee/tickets -- ONE per
    origin. A workspace holds sibling clones and worktrees of the same repo
    (fleet-ops-viewjs, fleet-ops-braindump, ...); each carries the same
    tickets, and counting them again would triple the todo. The clone whose
    directory name matches the origin's repo name wins; otherwise the first."""
    root = Path(os.path.expanduser(root))
    sets = {}
    if not root.is_dir():
        return []
    for repo in sorted(root.iterdir()):
        d = repo / ".hee" / "tickets"
        if not (repo.is_dir() and d.is_dir()) or repo.name.endswith(".worktrees"):
            continue
        origin = _origin(repo) or f"local:{repo.name}"
        canonical = origin.rsplit("/", 1)[-1] == repo.name
        if origin not in sets or (canonical and not sets[origin][2]):
            sets[origin] = (repo.name, d, canonical)
    return [(name, d) for name, d, _ in sorted(sets.values(), key=lambda t: t[0])]


def _pill(kind, text):
    return f'<span class="chip {kind}">{_html.escape(text)}</span>'


def _age(created):
    try:
        t = datetime.fromisoformat(str(created).replace("Z", "+00:00"))
        days = (datetime.now(timezone.utc) - t).days
        return f"{days}d"
    except Exception:
        return "?"


def _row(rec, repo):
    st = rec.get("status", "open")
    stage = str(rec.get("stage", "?"))
    desc = _html.escape(str(rec.get("description", "")))
    if st == "closed":
        desc = f"<s>{desc}</s>"
    ref = rec.get("ref") or rec.get("github_issue")
    refcell = ""
    if isinstance(ref, str) and ref.startswith("http"):
        label = ref.rsplit("/", 2)
        label = f"{label[-3].split('/')[-1]}#{label[-1]}" if len(label) == 3 else ref
        refcell = f'<a href="{_html.escape(ref)}" target="_blank" rel="noopener">{_html.escape(label)}</a>'
    src = _html.escape(str(rec.get("source", "")))
    why = _html.escape(str(rec.get("closed_reason", ""))) if st == "closed" else ""
    tags = " ".join(_pill("neutral", t) for t in (rec.get("tags") or []) if isinstance(t, str))
    stage_kind = {"idea": "neutral", "footgun": "warning", "dogfood": "good"}.get(stage, "neutral")
    state = _pill("good", "✓ done") if st == "closed" else _pill("warning", "▲ open")
    return ("<tr>"
            f'<td class="mono">{_html.escape(repo)}</td>'
            f'<td class="mono">{_html.escape(str(rec.get("id", "?")))}</td>'
            f"<td>{state}</td>"
            f"<td>{_pill(stage_kind, stage)}</td>"
            f"<td>{desc}{(' ' + tags) if tags else ''}"
            f"{('<div class=\"why\">' + why + '</div>') if why else ''}</td>"
            f'<td class="mono">{src}</td>'
            f"<td>{refcell}</td>"
            f'<td class="mono">{_age(rec.get("created_at"))}</td>'
            "</tr>")


def render_html(ticket_sets):
    rows_open, rows_done = [], []
    stages = {"idea": 0, "footgun": 0, "dogfood": 0}
    for repo, d in ticket_sets:
        for rec in _load_tickets(d):
            (rows_done if rec.get("status") == "closed" else rows_open).append(_row(rec, repo))
            if rec.get("status") != "closed":
                stages[rec.get("stage", "idea")] = stages.get(rec.get("stage", "idea"), 0) + 1
    n_open, n_done = len(rows_open), len(rows_done)
    head = ("<thead><tr><th>repo</th><th data-tc-sort=\"number\">id</th><th>state</th><th>stage</th>"
            "<th>ticket</th><th>source</th><th>ref</th><th data-tc-sort=\"number\">age</th></tr></thead>")
    def table(tid, rows, empty):
        body = "\n".join(rows) if rows else f'<tr><td colspan="8" class="why">{empty}</td></tr>'
        return (f'<div class="card-tools"><input type="search" data-tc-table-filter="#{tid}" '
                f'placeholder="Search repo, stage, text, source, ref&hellip;" aria-label="Search tickets">'
                f'<span class="count" data-tc-table-count="#{tid}"></span>'
                f'<span class="hint">Words are ANDed.</span></div>'
                f'<div class="body tbl"><table id="{tid}" data-tc-table>{head}<tbody>\n{body}\n</tbody></table></div>')
    repos = ", ".join(r for r, _ in ticket_sets) or "none"
    return f"""  <section class="stats" aria-label="Tickets at a glance">
    <div class="stat is-critical"><b>{n_open}</b><span>open</span></div>
    <div class="stat is-good"><b>{n_done}</b><span>done</span></div>
    <div class="stat"><b>{stages.get('idea', 0)}</b><span>idea</span></div>
    <div class="stat"><b>{stages.get('footgun', 0)}</b><span>footgun</span></div>
    <div class="stat"><b>{stages.get('dogfood', 0)}</b><span>dogfood</span></div>
  </section>
  <section class="card is-critical" data-tc-arrange-item="tickets-open" data-tc-collapse="tickets-open">
    <header><span class="grip" data-tc-arrange-handle title="Drag to reorder">&#10303;</span><h2 data-tc-collapse-toggle>Open</h2><span class="chip critical">&#10007; {n_open}</span><span class="count">from .hee/tickets in {_html.escape(repos)}</span></header>
    <div data-tc-collapse-body>
{table("t-tickets-open", rows_open, "Nothing open.")}
    </div>
  </section>
  <section class="card is-good" data-tc-arrange-item="tickets-done" data-tc-collapse="tickets-done" data-tc-collapse-default="collapsed">
    <header><span class="grip" data-tc-arrange-handle title="Drag to reorder">&#10303;</span><h2 data-tc-collapse-toggle>Done</h2><span class="chip good">&#9679; {n_done}</span><span class="count">struck through, with the reason each was closed</span></header>
    <div data-tc-collapse-body>
{table("t-tickets-done", rows_done, "Nothing closed yet.")}
    </div>
  </section>
"""


def cmd_html(workspace=None, out=None):
    root = repo_root()
    if workspace is not None or root is None:
        workspace = workspace or WORKSPACE_ROOT
        sets = _workspace_ticket_sets(workspace)
        if not sets:
            sys.exit(f"hee-ticket -html: no repo under {workspace} has .hee/tickets")
    else:
        sets = [(root.name, root / ".hee" / "tickets")]
    page = render_html(sets)
    if out:
        Path(out).write_text(page, encoding="utf-8")
        print(f"hee-ticket -html: wrote {out}")
    else:
        sys.stdout.write(page)


def main():
    ap = argparse.ArgumentParser(add_help=False)
    ap.add_argument("-new", dest="new_desc", metavar="DESCRIPTION")
    ap.add_argument("-list", action="store_true")
    ap.add_argument("-advance", dest="advance_id", metavar="ID")
    ap.add_argument("-close", dest="close_ids", metavar="ID[,ID...]")
    ap.add_argument("-html", action="store_true")
    ap.add_argument("--source", metavar="WHERE")
    ap.add_argument("--ref", metavar="URL")
    ap.add_argument("--tag", metavar="T[,T...]")
    ap.add_argument("--why", metavar="TEXT")
    ap.add_argument("--open", action="store_true")
    ap.add_argument("--closed", action="store_true")
    ap.add_argument("--workspace", nargs="?", const=WORKSPACE_ROOT, metavar="DIR")
    ap.add_argument("--out", metavar="FILE")
    ap.add_argument("--repo", metavar="NAME", help="a repo under ~/git whose tickets to read or write, from any directory")
    args = ap.parse_args()
    global _REPO_OVERRIDE
    _REPO_OVERRIDE = args.repo

    if args.new_desc:
        cmd_new(args.new_desc, source=args.source, ref=args.ref, tags=args.tag)
    elif args.list:
        cmd_list("open" if args.open else "closed" if args.closed else None, workspace=args.workspace)
    elif args.advance_id:
        cmd_advance(args.advance_id)
    elif args.close_ids:
        cmd_close(args.close_ids, why=args.why)
    elif args.html:
        cmd_html(workspace=args.workspace, out=args.out)
    else:
        print(HELP, end="")
        sys.exit(1)


if __name__ == "__main__":
    main()
