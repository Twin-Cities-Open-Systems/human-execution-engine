#!/usr/bin/env python3
# section: 1
"""hee-view: one command, the whole real picture -- pve node, every
container, HAProxy backend health, DNS. Same "only view to see them
all" intent as view.lab.tcos.us, as a real CLI, no do-this-do-that.

Real trigger (2026-08-24, Spencer): "not going to all this do this do
that. slick hee view for all." Reuses hee-pve-health's real data
(shells out to it --json, doesn't reimplement pvesh calls) and adds
HAProxy + DNS checks in one terse report.

Real trigger for --sites (2026-08-28, Spencer): "first thing may be to
build a complete site map, setup monitor (simple) with hee view -sites
(or similar) to make sure we get 200's everywhere, condense view
(adding -nerd to that will be verbose as fuck)" -- reuses the real,
already-established --nerd split (condensed by default, full per-URL
detail only with --nerd) rather than inventing new verbosity flags.
Default source is the real, live profile/SITEMAP.yaml on .github's
main branch -- pass --sitemap to check a local copy instead.

Usage:
  hee-view [--pve-host IP] [--haproxy-host IP] [--dns-host IP]
  hee-view --sites [--sitemap URL_OR_PATH] [--network lab|public|all] [--nerd]
"""
import argparse
import json
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

# library/py lives in this tool's own repo -- derive it from this script's
# own location, resolved through symlinks, never from the repo the tool
# happens to be invoked against.
from pathlib import Path as _Path  # noqa: E402
sys.path.insert(0, str(_Path(__file__).resolve().parent.parent.parent / "library" / "py"))
try:
    from hee_cli import help_wanted, note_ignored  # noqa: E402
except ImportError:
    # --via ships this file over ssh and runs it with `python3 -` on a host
    # that has no HEE checkout; the two helpers are trivial to stand in for.
    def help_wanted(argv):
        return any(a in ("help", "-h", "--help") for a in argv)

    def note_ignored(argv):
        pass

try:
    import yaml
except ImportError:
    yaml = None

DEFAULT_SITEMAP_URL = (
    "https://raw.githubusercontent.com/Twin-Cities-Open-Systems/"
    ".github/main/profile/SITEMAP.yaml"
)


def sh(cmd):
    proc = subprocess.run(cmd, capture_output=True, text=True)
    return proc.returncode, proc.stdout, proc.stderr


def pve_health(pve_host):
    """Return (data, reason). reason is None on success.

    It used to return None for every failure, and the caller printed
    "pve: unreachable" for all of them, discarding stderr. Measured
    2026-09-03: a second operator on the same LAN saw "pve: unreachable"
    while every haproxy backend and DNS answered fine. pve was reachable;
    something else failed, and the tool had thrown away the one line that
    would have said what.

    hee-pve-health tries SSH to root@<host> first and a sealed API token
    second, so a failure here is usually credentials, not the network --
    reporting it as unreachable sends the reader to the wrong problem.
    A confidently wrong status is worse than an honest unknown.
    """
    tool = __file__.rsplit("/", 1)[0] + "/hee-pve-health"
    code, out, err = sh([sys.executable, tool, "status", "--host", pve_host, "--json"])
    if code != 0:
        reason = (err or out or "").strip().splitlines()
        return None, (reason[-1] if reason else
                      f"hee-pve-health exited {code} with no output")
    try:
        return json.loads(out), None
    except ValueError as e:
        return None, f"hee-pve-health returned unparseable JSON: {e}"


def print_nerd_stats(health):
    for c in health["lxc"]:
        h, rem = divmod(c["uptime_s"], 3600)
        m = rem // 60
        print(f"   {c['name']:20} cpu {c['cpu_pct']:5.1f}%  mem {c['mem_mb']:5}/{c['maxmem_mb']:5}MB  "
              f"disk r/w {c['diskread_mb']:6}/{c['diskwrite_mb']:6}MB  "
              f"net in/out {c['netin_mb']:6}/{c['netout_mb']:6}MB  elapsed {h}h{m}m")
    t = health["totals"]
    print(f"🔹 totals across {len(health['lxc'])} container(s): mem {t['mem_mb']}MB  "
          f"disk r/w {t['diskread_mb']}/{t['diskwrite_mb']}MB  net in/out {t['netin_mb']}/{t['netout_mb']}MB")


def haproxy_backends(haproxy_host):
    try:
        with urllib.request.urlopen(f"http://{haproxy_host}:8404/;csv", timeout=3) as r:
            body = r.read().decode()
    except Exception:
        return None
    rows = {}
    for line in body.strip().splitlines():
        if line.startswith("#") or not line.strip():
            continue
        f = line.split(",")
        if len(f) > 17 and f[1] not in ("FRONTEND", "BACKEND"):
            rows[f"{f[0]}/{f[1]}"] = f[17]  # pxname/svname -> status
    return rows


def dns_check(dns_host, name="ns1.lab.tcos.us"):
    code, out, err = sh(["dig", f"@{dns_host}", name, "+short", "+time=2"])
    return out.strip() if code == 0 and out.strip() else None


def load_sitemap(source):
    # Real trigger (2026-08-28, Spencer): "the sitemap and url tracking
    # in ci and then hee view can pull from that" -- default source is
    # the real, live profile/SITEMAP.yaml on .github's main branch, not
    # a local copy that can silently drift from what's actually committed.
    if yaml is None:
        return None, "PyYAML not installed (pip install pyyaml)"
    try:
        if source.startswith("http://") or source.startswith("https://"):
            with urllib.request.urlopen(source, timeout=5) as r:
                text = r.read().decode()
        else:
            with open(source, encoding="utf-8") as f:
                text = f.read()
    except (urllib.error.URLError, OSError) as e:
        return None, str(e)
    try:
        data = yaml.safe_load(text)
    except yaml.YAMLError as e:
        return None, f"invalid YAML: {e}"
    sites = data.get("sites") if isinstance(data, dict) else None
    if not sites:
        return None, "sitemap has no 'sites' list"
    return sites, None


LAB_DOMAIN = "lab.tcos.us"


# Which network a site lives on decides WHO CAN CHECK IT, which is a real
# property of the site and not a preference.
#
# Real incident, fleet-ops#350: .github's scheduled site-health workflow was
# permanently red on 14/14 *.lab.tcos.us hosts because a GitHub-hosted
# runner has no route into the private lab network. Every 30 minutes, for
# weeks. A genuine outage would have been invisible in that noise.
#
# So a site declares its network and each checker runs the scope it can
# actually reach: public CI checks `public`, an on-host timer inside the lab
# checks `lab`. Neither pretends to see the other.
#
# An entry with no explicit `network:` is inferred from its hostname, so the
# sitemap did not have to be fully annotated before this could work.
#
# The inference is on the parsed HOSTNAME, not a substring of the whole URL.
# Measured 2026-09-02: the old substring test looked for ".lab.tcos.us",
# which the apex `https://lab.tcos.us/` does not contain -- there is no dot
# before "lab" -- so the one lab host that is not a subdomain was inferred
# "public". A GitHub runner cannot resolve it (8.8.8.8 and 1.1.1.1 both
# return nothing), the site check failed, and Real Site Health went red
# every 30 minutes. Exactly the failure fleet-ops#350 was closed for,
# reintroduced through the apex.
#
# A substring test also matches a host it should not, e.g. a query string
# carrying ".lab.tcos.us" on an unrelated public URL.
def site_network(entry):
    declared = (entry.get("network") or "").strip().lower()
    if declared in ("lab", "public"):
        return declared
    host = (urllib.parse.urlparse(entry.get("url", "")).hostname or "").lower()
    return "lab" if host == LAB_DOMAIN or host.endswith("." + LAB_DOMAIN) else "public"


NOTE_MAX = 160


def lint_sitemap(sites):
    """The one tool that reads SITEMAP.yaml owns its schema. Operator,
    2026-09-06: a note carried unmatched single quotes for a week and
    nothing caught it -- YAML takes an unbalanced apostrophe in a plain
    scalar. Rules: url/repo/note present; note is one short sentence
    (<= NOTE_MAX chars); url unique. WARNING each."""
    warnings, seen = [], set()
    for e in sites:
        u = e.get("url", "?")
        for k in ("url", "repo", "note"):
            if not e.get(k):
                warnings.append(f"{u}: missing {k}")
        note = str(e.get("note", ""))
        if len(note) > NOTE_MAX:
            warnings.append(f"{u}: note is {len(note)} chars (max {NOTE_MAX}) -- history belongs in git, not the status line")
        # Apostrophes in prose are fine once the note is a double-quoted YAML
        # string (operator: "can just wrap in doubles"); only an unbalanced
        # double quote is a real problem, and YAML would have refused it.
        if note.count('"') % 2 == 1:
            warnings.append(f"{u}: note has an unbalanced double quote")
        if u in seen:
            warnings.append(f"{u}: listed twice")
        seen.add(u)
    return warnings


def filter_sites(sites, network):
    if network in (None, "", "all"):
        return sites
    return [e for e in sites if site_network(e) == network]


def gopher_get(url, timeout=8):
    """RFC 1436 over a plain socket: gopher://host[:port]/<type><selector>.
    Returns (item_type, body_text). Menus (type 1) come back as their raw
    lines; text (type 0) as text. Raises on connect/transport errors.
    Operator, 2026-09-06: "it should support crawling our gopher man pages"."""
    import socket
    sp = urllib.parse.urlsplit(url)
    host, port = sp.hostname, sp.port or 70
    path = sp.path or "/"
    itype, selector = (path[1], path[2:]) if len(path) > 1 else ("1", "")
    with socket.create_connection((host, port), timeout=timeout) as s:
        s.sendall((selector + "\r\n").encode())
        chunks = []
        while True:
            b = s.recv(65536)
            if not b:
                break
            chunks.append(b)
            if sum(len(c) for c in chunks) > 2_000_000:
                break
    body = b"".join(chunks).decode("utf-8", "replace")
    if itype == "1" and body.lstrip().startswith("3"):
        raise ValueError("gopher error item: " + body.splitlines()[0][1:80])
    return itype, body


def gopher_menu_links(url, body):
    """Menu items of type 0 (text) and 1 (menu) on the same host, as URLs."""
    sp = urllib.parse.urlsplit(url)
    out = []
    for line in body.splitlines():
        if not line or line[0] not in "01":
            continue
        parts = line.rstrip("\r").split("\t")
        if len(parts) < 4:
            continue
        itype, selector, host, port = line[0], parts[1], parts[2], parts[3]
        if host != sp.hostname:
            continue
        out.append(f"gopher://{host}{'' if port == '70' else ':' + port}/{itype}{selector}")
    return out


_RESOLVE_CACHE = {}


def resolves_absolutely(url):
    """Does the hostname exist as written -- not after the resolver's search
    list appended a domain? Measured 2026-09-06 on kiosk: touchy.media.tcos.us
    had no DNS anywhere, yet the checker reported an SSL error, because
    systemd-resolved tried touchy.media.tcos.us.crooked.tcos.us, a wildcard
    on the operator's home domain answered, and Traefik's default cert came
    back. A trailing dot makes the name absolute and skips the search list."""
    import socket
    host = urllib.parse.urlsplit(url).hostname or ""
    if host in _RESOLVE_CACHE:
        return _RESOLVE_CACHE[host]
    try:
        socket.getaddrinfo(host + ".", None)
        ok = True
    except socket.gaierror:
        ok = False
    _RESOLVE_CACHE[host] = ok
    return ok


def _fetch(url, method):
    req = urllib.request.Request(url, method=method, headers={"User-Agent": "hee-view/1.0"})
    with urllib.request.urlopen(req, timeout=5) as r:
        return r.status


def sites_check(sites):
    # Real gotcha, found dogfooding this against the real sitemap
    # (2026-08-28): Cloudflare-fronted sites here return a real 403 to a
    # bare HEAD request (WAF/bot-protection rule), even though a real
    # browser -- or `curl` with its default GET -- gets a real 200. Try
    # HEAD first (cheaper), fall back to a real GET on any non-2xx/3xx
    # before calling it a failure, so this doesn't cry wolf about sites
    # that are actually fine.
    results = []
    for entry in sites:
        if not entry.get("check", True):
            continue
        url = entry["url"]
        start = time.monotonic()
        code = None
        error = None
        if url.startswith("gopher://"):
            try:
                gopher_get(url); code, error = 200, None
            except Exception as e:
                code, error = None, str(e)[:80]
            elapsed_ms = round((time.monotonic() - start) * 1000)
            results.append({"url": url, "code": code, "elapsed_ms": elapsed_ms, "note": entry.get("note", ""), "error": error})
            continue
        if url.startswith("http") and not resolves_absolutely(url):
            elapsed_ms = round((time.monotonic() - start) * 1000)
            results.append({"url": url, "code": None, "elapsed_ms": elapsed_ms, "note": entry.get("note", ""),
                            "error": "does not resolve (no DNS record; the resolver's search list is not consulted)"})
            continue
        for method in ("HEAD", "GET"):
            try:
                code = _fetch(url, method)
            except urllib.error.HTTPError as e:
                code = e.code  # a real HTTP error status (404, etc) is still a real answer
            except Exception as e:
                code = None
                error = str(e)
            if code and 200 <= code < 400:
                error = None
                break
        elapsed_ms = round((time.monotonic() - start) * 1000)
        results.append({"url": url, "code": code, "elapsed_ms": elapsed_ms,
                         "note": entry.get("note", ""), "error": error})
    return results


def crawl_sites(sites, depth=2, listed=None):
    """Follow same-host links from each listed root, check every page found,
    and say which reachable pages the site map does not know. Operator,
    2026-09-06: "make sure all of redirects are correct from blog to media
    and there are no 404s and our audit tool is smart enough to notice when
    a page is not indexed somewhere." Redirects are followed across hosts
    (blog -> media) and must end 2xx. Returns (pages, broken, unlisted):
    pages = every URL reached; broken = (from_page, url, code_or_error,
    final_url); unlisted = reachable page URLs absent from the site map."""
    import html.parser
    listed = {e["url"].rstrip("/") for e in (listed or sites)} | {e["url"] for e in (listed or sites) if e["url"].endswith("/")}

    class Links(html.parser.HTMLParser):
        def __init__(self):
            super().__init__(); self.hrefs = []
        def handle_starttag(self, tag, attrs):
            if tag == "a":
                for k, v in attrs:
                    if k == "href" and v:
                        self.hrefs.append(v)

    def get(url):
        req = urllib.request.Request(url, headers={"User-Agent": "hee-view/1.0 crawl"})
        with urllib.request.urlopen(req, timeout=8) as r:
            body = r.read(400000) if "html" in (r.headers.get("Content-Type") or "") else b""
            return r.status, r.geturl(), body.decode("utf-8", "replace")

    seen, broken, queue = {}, [], []
    for e in sites:
        if e.get("check", True):  # check: false = a tree that only covers pages under it
            queue.append((e["url"], 0, "(site map)"))
    while queue:
        url, d, src = queue.pop(0)
        key = url.rstrip("/")
        if key in seen:
            continue
        if url.startswith("gopher://"):
            try:
                itype, gbody = gopher_get(url)
                seen[key] = (200, url)
                if itype == "1" and d < depth:
                    for nxt in gopher_menu_links(url, gbody):
                        if nxt.rstrip("/") not in seen:
                            queue.append((nxt, d + 1, url))
            except Exception as ex:
                seen[key] = (None, url); broken.append((src, url, str(ex)[:60], url))
            continue
        if url.startswith("http") and not resolves_absolutely(url):
            seen[key] = (None, url); broken.append((src, url, "does not resolve (no DNS record)", url)); continue
        try:
            code, final, body = get(url)
        except urllib.error.HTTPError as ex:
            seen[key] = (ex.code, url); broken.append((src, url, ex.code, url)); continue
        except Exception as ex:
            seen[key] = (None, url); broken.append((src, url, str(ex)[:60], url)); continue
        seen[key] = (code, final)
        if not (200 <= code < 300):
            broken.append((src, url, code, final)); continue
        # A 200 that serves git conflict markers is broken too. Incident
        # tcos-www#59 (2026-09-06): tcos.us served <<<<<<< / >>>>>>> lines on
        # every page for 16 minutes while every status check stayed green.
        if body and any(l.startswith(("<<<<<<< ", ">>>>>>> ")) or l == "=======" for l in body.splitlines()):
            seen[key] = (599, final)
            broken.append((src, url, "200 but the body contains git conflict markers", final)); continue
        if d >= depth or not body:
            continue
        host = urllib.parse.urlsplit(final).netloc
        lp = Links(); lp.feed(body)
        for h in lp.hrefs:
            if h.startswith(("#", "mailto:", "javascript:", "tel:")):
                continue
            nxt = urllib.parse.urljoin(final, h).split("#")[0].split("?")[0]
            if urllib.parse.urlsplit(nxt).netloc != host:
                continue  # stay on this host; cross-host redirects are followed by get()
            if nxt.rstrip("/") not in seen:
                queue.append((nxt, d + 1, final))
    pages = sorted(seen)

    def covered(u):
        """Listed outright, or a page under a listed directory (an item page
        under a listed gallery, a gopher path under the listed gateway root).
        A host root covers nothing below it, or the check would be empty.
        Operator, 2026-09-06: 24 'unlisted' on public were query-string
        variants of one page and pages under listed directories."""
        u = u.split("?", 1)[0].rstrip("/")
        if u.endswith(".html"):
            u = u[:-5]  # /careers.html is the same page as /careers
        cands = [u]
        # A lab mirror page is covered when its prod twin is: the site map
        # lists tcos.us/careers once, not again for lab.tcos.us.
        sp = urllib.parse.urlsplit(u)
        if sp.netloc == "lab.tcos.us" or sp.netloc.endswith(".lab.tcos.us"):
            cands.append(u.replace("://lab.tcos.us", "://tcos.us", 1).replace(".lab.tcos.us", ".tcos.us", 1))
        for c in cands:
            if c in listed or c + ".html" in listed or c + "/" in listed:
                return True
            for l in listed:
                lp = urllib.parse.urlsplit(l).path
                if lp in ("", "/"):
                    continue  # a host root covers nothing below it
                if c.startswith(l if l.endswith("/") else l + "/"):
                    return True
        return False
    unlisted = sorted({u.split("?", 1)[0] for u, (c, f) in seen.items() if c and 200 <= c < 300 and not covered(u)
                       and not u.split("?", 1)[0].rsplit("/", 1)[-1].endswith((".css", ".js", ".png", ".jpg", ".gif", ".ico", ".json", ".xml", ".txt", ".webp", ".svg", ".asc", ".jpeg"))})
    return pages, broken, unlisted


def print_crawl(pages, broken, unlisted, nerd=False):
    for src, url, code, final in broken:
        where = f" (from {src})" if src != "(site map)" else ""
        print(f"🔴 CRITICAL crawl: {url} -> {code}{where}" + (f" -> {final}" if final != url else ""))
    if nerd:
        for u in unlisted:
            print(f"🟡 WARNING crawl: reachable but not in the site map: {u}")
    # One line per network, so "lab is red, public is green" is visible
    # without reading every finding. Operator, 2026-09-06: "it only checked
    # the lab" -- it had crawled both; the summary did not say so.
    def net(u):
        h = urllib.parse.urlsplit(u).netloc
        return "lab" if h.endswith(".lab.tcos.us") or h == "lab.tcos.us" else "public"
    for which in ("public", "lab"):
        pg = [u for u in pages if net(u) == which]
        if not pg:
            continue
        br = [b for b in broken if net(b[1]) == which]
        un = [u for u in unlisted if net(u) == which]
        flag = "🔴" if br else ("🟡" if un else "🟢")
        print(f"{flag} crawl {which}: {len(pg)} page(s) reached, {len(br)} broken, {len(un)} not in the site map"
              + ("" if nerd or not un else " (--nerd lists them)"))
    return 2 if broken else (1 if unlisted else 0)


def print_sites_condensed(results):
    def is_ok(r):
        return bool(r["code"]) and 200 <= r["code"] < 400
    ok = [r for r in results if is_ok(r)]
    bad = [r for r in results if not is_ok(r)]
    for r in bad:
        why = r["error"] or f"HTTP {r['code']}"
        print(f"🔴 site {r['url']}: {why}")
    flag = "🟢" if not bad else "🔴"
    print(f"{flag} sites: {len(ok)}/{len(results)} real URLs answering 200-399")


def print_sites_nerd(results):
    for r in results:
        flag = "🟢" if r["code"] and 200 <= r["code"] < 400 else "🔴"
        status = r["error"] or r["code"] or "no answer"
        print(f"{flag} {r['url']:55} {status!s:10} {r['elapsed_ms']:5}ms  {r['note']}")


def inbound_status():
    import shutil
    if not shutil.which("gh"):
        return "no-gh"
    # Real trigger (2026-08-26): tcos.us/api/contact + /api/apply write
    # real applicant/investor/press submissions straight into the private
    # Twin-Cities-Open-Systems/inbound repo as issues -- confirmed live,
    # 8 open (unanswered, some 5+ days old) the day this was added, zero
    # prior monitoring. Spencer: "looks like some new stuff there and I
    # am expecting more soon, need to monitor." Deliberately just an open
    # count + oldest-open age here, not a spam/real-applicant judgment
    # call -- that's inbound#12's real, still-open design question.
    code, out, err = sh(["gh", "issue", "list", "--repo", "Twin-Cities-Open-Systems/inbound",
                         "--state", "open", "--json", "number,title,createdAt", "--limit", "100"])
    if code != 0:
        return None
    # Real submissions from the worker are titled "Contact (...): ..." or
    # "Application: ... — ...". Anything else (e.g. inbound#12, "Design a
    # real spam-handling workflow policy...") is a meta/tracking issue in
    # the same repo, not an unprocessed submission -- exclude it, or the
    # oldest-open figure below is misleading (confirmed live, 2026-08-26:
    # #12 itself was being counted as the "oldest open submission").
    return [i for i in json.loads(out) if i["title"].startswith(("Contact (", "Application:"))]


def print_inbound(issues):
    if issues == "no-gh":
        # UNKNOWN, not CRITICAL: a --via host has no gh; nothing was checked.
        print("⚪ inbound: cannot check from this host (no gh)")
        return
    if issues is None:
        print("🔴 inbound: unreachable (gh issue list failed)")
        return
    n = len(issues)
    if n == 0:
        print("🟢 inbound: 0 open submissions")
        return
    oldest = min(issues, key=lambda i: i["createdAt"])
    from datetime import datetime, timezone
    age_days = (datetime.now(timezone.utc) - datetime.fromisoformat(oldest["createdAt"].replace("Z", "+00:00"))).days
    flag = "🔴" if age_days >= 3 else "🟡"
    print(f"{flag} inbound: {n} open submission(s), oldest {age_days}d old (#{oldest['number']}) -- https://github.com/Twin-Cities-Open-Systems/inbound/issues")


def lab_section(args):
    """The pve / haproxy / dns part -- lab-only; --sites-only and --via skip it."""
    print("=== tcos lab -- hee view ===")
    health, pve_why = pve_health(args.pve_host)
    if health is None:
        # Unknown, not critical. This tool could not check; that is a
        # different fact from the node being down, and the Nagios
        # vocabulary this org uses has a state for exactly that.
        print(f"⚪ pve: cannot check -- {pve_why}")
        print("   hee-pve-health tries ssh root@<host> first, then a sealed API token.")
        print(f"   Check with: ssh -o BatchMode=yes root@{args.pve_host} 'pvesh get /nodes'")
    else:
        n = health["node"]
        print(f"🟢 pve node: cpu {n['cpu_pct']}%  mem {n['mem_used_mb']}/{n['mem_total_mb']}MB")
        for sname, s in health["storage"].items():
            flag = "🔴" if s["overcommit_ratio"] > 3 else ("🟡" if s["overcommit_ratio"] > 1 else "🟢")
            print(f"{flag} storage {sname}: {s['overcommit_ratio']}x overcommit "
                  f"({s['allocated_gb']}GB / {s['pool_total_gb']}GB pool)")
        for c in health["lxc"]:
            flag = "🟢" if c["status"] == "running" else "🔴"
            print(f"{flag} lxc {c['name']}: {c['status']}")
        if args.nerd:
            print_nerd_stats(health)

    backends = haproxy_backends(args.haproxy_host)
    if backends is None:
        print("🔴 haproxy: unreachable")
    else:
        for name, status in backends.items():
            flag = "🟢" if status == "UP" else "🔴"
            print(f"{flag} haproxy backend {name}: {status}")

    dns = dns_check(args.dns_host)
    flag = "🟢" if dns else "🔴"
    print(f"{flag} dns (ns1): {dns or 'no answer'}")


def main():
    ap = argparse.ArgumentParser(prog="hee-view")
    ap.add_argument("--pve-host", default="10.0.0.153")
    ap.add_argument("--haproxy-host", default="10.0.0.160")
    ap.add_argument("--dns-host", default="10.0.0.194")
    ap.add_argument("--nerd", action="store_true",
                     help="per-container cpu/mem/disk-io/net-io/elapsed + totals; also full per-URL --sites detail")
    ap.add_argument("--sites", action="store_true",
                     help="check every real URL in the site map answers 200-399")
    ap.add_argument("--sitemap", default=DEFAULT_SITEMAP_URL,
                     help="sitemap source -- URL or local path (default: real .github/profile/SITEMAP.yaml on main)")
    ap.add_argument("--via", metavar="[USER@]HOST",
                    help="an ssh target or alias, never a URL: run the --sites checks FROM that host (this file is "
                         "sent with `python3 -`; the host needs only python3). The point "
                         "is a vantage that is not the operator's own IP: the DigitalOcean "
                         "droplet (man.tcos.us) sees tcos.us the way the public does -- "
                         "Cloudflare edge, no LAN split-DNS, no home-IP exemptions. "
                         "Implies --sites-only and --network public unless given.")
    ap.add_argument("--crawl", action="store_true",
                    help="with --sites: follow same-host links from each listed site (depth 2), "
                         "check every page found, follow blog->media redirects to a 2xx, and "
                         "report reachable pages the site map does not list")
    ap.add_argument("--sites-only", action="store_true",
                    help="skip the pve/haproxy/dns section; just the site checks")
    ap.add_argument("--network", default="all",
                    choices=["lab", "public", "all"],
                    help="only check sites on this network. A GitHub-hosted "
                         "runner can only reach 'public'; an on-host checker "
                         "inside the lab can reach 'lab'. Default all.")
    # Contextual help BEFORE argparse parses anything. argparse owns -h and
    # --help but not the bare `help` verb, and resolves either only after
    # parsing -- so an unrelated argument errors first and the help never
    # prints. Measured: 8 tools exited non-zero for --help for exactly this
    # reason. See library/py/hee_cli.
    if help_wanted(sys.argv[1:]):
        note_ignored(sys.argv[1:])
        ap.print_help()
        return 0

    args = ap.parse_args()

    if args.via:
        if "://" in args.via or "/" in args.via:
            print(f"⚪ UNKNOWN hee-view: --via takes an ssh target ([user@]host or an ssh alias), not a URL: {args.via!r}. "
                  "For the droplet: --via man-tcos-us", file=sys.stderr)
            return 3
        if not args.sites:
            print("⚪ UNKNOWN hee-view: --via only makes sense with --sites", file=sys.stderr)
            return 3
        remote_argv = ["--sites", "--sites-only", "--network", args.network if args.network != "all" else "public",
                       "--sitemap", args.sitemap]
        if args.crawl:
            remote_argv.append("--crawl")
        if args.nerd:
            remote_argv.append("--nerd")
        where = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new", "-o", "ConnectTimeout=8", args.via,
                                "hostname; curl -4 -s -m 5 https://ifconfig.me || true"],
                               capture_output=True, text=True)
        if where.returncode != 0:
            err = where.stderr.strip()[:160]
            hint = ""
            if "Permission denied" in err and "@" not in args.via:
                hint = " -- no user given, so ssh used your local username; the droplet answers root@ (kiosk-spencer key) or claude@"
            print(f"🔴 CRITICAL hee-view: cannot reach {args.via} over ssh: {err}{hint}")
            return 2
        host, _, ip = where.stdout.strip().partition("\n")
        print(f"=== hee view --sites, from {host} ({ip or 'ip unknown'}) via {args.via} ===", flush=True)
        with open(__file__, "rb") as me:
            proc = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "StrictHostKeyChecking=accept-new", args.via, "python3", "-", *remote_argv],
                                  stdin=me)
        return proc.returncode

    if args.sites_only and not args.sites:
        print("⚪ UNKNOWN hee-view: --sites-only without --sites checks nothing", file=sys.stderr)
        return 3

    if not args.sites_only:
        lab_section(args)

    sites_ok = True
    if args.sites:
        sites, err = load_sitemap(args.sitemap)
        all_sites = list(sites) if not err else []
        if not err:
            for w in lint_sitemap(sites):
                print(f"🟡 WARNING sitemap: {w}")
            total = len(sites)
            sites = filter_sites(sites, args.network)
            if args.network != "all":
                print(f"# scope: {args.network} ({len(sites)} of {total} sites)")
        if err:
            print(f"🔴 sites: sitemap unavailable ({err})")
            sites_ok = False
        else:
            results = sites_check(sites)
            if args.nerd:
                print_sites_nerd(results)
            else:
                print_sites_condensed(results)
            sites_ok = all(r["code"] and 200 <= r["code"] < 400 for r in results)
            if args.crawl:
                # crawl the scoped sites; judge coverage against the whole map,
                # so a lab page is covered by its prod twin's entry
                pages, broken, unlisted = crawl_sites(sites, listed=all_sites)
                if print_crawl(pages, broken, unlisted, nerd=args.nerd) == 2:
                    sites_ok = False

    print_inbound(inbound_status())

    # Real exit code, --sites only: a scheduled CI run needs an actual
    # pass/fail signal, not just a report nobody's watching. The other
    # checks stay report-only (matches this tool's existing, deliberate
    # "informational, not a gate" behavior) -- only --sites changes this,
    # since it's the one being wired into real CI (fleet-ops#295).
    if args.sites and not sites_ok:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
