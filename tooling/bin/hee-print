#!/bin/sh
# section: 1
# hee-print: render files nicely for terminal surfaces (tmux-ui, shellboss, humans)
# POSIX sh, no prompts.

# Resolve through symlinks before deriving TOOL_ROOT -- tools are symlinked
# onto PATH from ~/.local/bin, and a bare `dirname "$0"` points at the
# symlink's directory, where library/ does not exist. Same realpath idiom the
# `hee` dispatcher already uses, per the GNU Tools Preference Policy.
SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  SELF="$(realpath -- "$SELF" 2>/dev/null || echo "$SELF")"
elif command -v readlink >/dev/null 2>&1; then
  SELF="$(readlink -f -- "$SELF" 2>/dev/null || echo "$SELF")"
fi
SELF_DIR="$(cd "$(dirname "$SELF")" && pwd)"
TOOL_ROOT="$(cd "$SELF_DIR/../.." && pwd)"

# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"

usage() {
  cat <<'USAGE'
hee-print -- render files nicely for terminal surfaces

SYNOPSIS
  hee-print [--no-header] [--animate] [--image-format FMT] [--] FILE...
  hee-print [--no-header] --stdin [--hint md|yaml|json|text]
  hee-print help

DESCRIPTION
  Picks a renderer from the file extension, falling back to cat whenever the
  nicer tool is not installed. Never prompts, never writes.

    .md/.markdown -> glow -p
    .yml/.yaml    -> yq -P
    .json         -> jq .
    .png/.jpg/.jpeg/.gif/.webp
                  -> chafa (a still; --animate plays a GIF for 10 s), else
                     `file` plus a WARNING naming the missing renderer --
                     never a raw byte dump to the terminal
    other         -> bat/batcat -p --paging=never, else cat

  Images: the format that is known to work is the default, measured from
  where the tool is running, not guessed (operator, 2026-09-06: "when you
  find what works in tmux and not, make it the default and add a switch
  to try something else"):

    inside tmux, allow-passthrough on     -> sixels, passed through to the
                                             outer terminal (which must draw
                                             them; tmux 3.4 cannot itself)
    inside tmux, allow-passthrough off    -> symbols (pixels cannot leave tmux)
    kitty (KITTY_WINDOW_ID) / WezTerm     -> kitty
    iTerm2                                -> iterm
    Windows Terminal (WT_SESSION)         -> sixels
    anything else                         -> chafa's own guess

  --image-format FMT  try something else: symbols, sixels, kitty, iterm,
                      or auto. HEE_PRINT_IMAGE_FORMAT (heerc or environment)
                      is the same override, persistent. `--image-format
                      show` prints the format that would be used and why.

  --no-header  suppress the per-file header printed when given several files
  --animate    let an animated image play (10 s) instead of showing a still
  --stdin      read the document from stdin instead of a path
  --hint       tell --stdin which renderer to use; ignored otherwise

EXIT STATUS
  0 rendered   2 usage error or no file given
USAGE
}

# Contextual help, via the shared contract -- never a positional check.
# `hee-print help --stdin` must print help and read nothing.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  usage
  exit 0
fi

ANIMATE=0
have() { command -v "$1" >/dev/null 2>&1; }

pick_bat() {
  if have bat; then echo bat; return; fi
  if have batcat; then echo batcat; return; fi
  echo ""
}

render_md() {
  if have glow; then glow -p "$1"; else cat "$1"; fi
}

render_yaml() {
  if have yq; then yq -P "$1"; else cat "$1"; fi
}

render_json() {
  if have jq; then jq . < "$1"; else cat "$1"; fi
}

# The image format that works here, and why -- prints "FORMAT<TAB>reason".
# Precedence: --image-format, HEE_PRINT_IMAGE_FORMAT, then what is measured.
image_format() {
  if [ -n "${IMAGE_FORMAT:-}" ]; then printf '%s\t%s\n' "$IMAGE_FORMAT" "--image-format"; return; fi
  if [ -n "${HEE_PRINT_IMAGE_FORMAT:-}" ]; then printf '%s\t%s\n' "$HEE_PRINT_IMAGE_FORMAT" "HEE_PRINT_IMAGE_FORMAT"; return; fi
  if [ -n "${TMUX:-}" ] && have tmux; then
    # tmux cannot draw sixels itself here; it can pass them through to the
    # outer terminal, which then must draw them. allow-passthrough is the
    # switch that decides whether anything gets out at all.
    pt="$(tmux show -gv allow-passthrough 2>/dev/null)"
    case "$pt" in
      on|all) printf 'sixels\ttmux allow-passthrough=%s -- sixels pass through to the outer terminal\n' "$pt" ;;
      *) printf 'symbols\ttmux allow-passthrough is off -- pixels cannot leave tmux (set -g allow-passthrough on)\n' ;;
    esac
    return
  fi
  if [ -n "${KITTY_WINDOW_ID:-}" ]; then printf 'kitty\tKITTY_WINDOW_ID set\n'; return; fi
  case "${TERM_PROGRAM:-}" in
    WezTerm) printf 'kitty\tTERM_PROGRAM=WezTerm\n'; return ;;
    iTerm.app) printf 'iterm\tTERM_PROGRAM=iTerm.app\n'; return ;;
  esac
  if [ -n "${WT_SESSION:-}" ]; then printf 'sixels\tWT_SESSION set (Windows Terminal)\n'; return; fi
  printf 'auto\tno terminal signal -- chafa guesses\n'
}

render_image() {
  if have chafa; then
    fmt="$(image_format | cut -f1)"
    set -- "$1"
    [ "$fmt" != "auto" ] && set -- --format="$fmt" "$1"
    # Inside tmux the ONLY working sixel path on this org's tmux (3.4,
    # Ubuntu build) is chafa's passthrough envelope with allow-passthrough
    # on: measured 2026-09-06 with a scripted client, tmux then forwards one
    # clean sixel; raw sixels are stored and never re-emitted (placeholder
    # text only), with or without the `sixel` terminal feature declared.
    if [ -n "${TMUX:-}" ] && [ "$fmt" = "sixels" ]; then
      set -- --passthrough=tmux "$@"
    fi
    if [ "${ANIMATE:-0}" -eq 1 ]; then
      chafa "$@" --animate=on --duration=10
    else
      chafa "$@" --animate=off
    fi
  else
    echo "⚠️ WARNING hee-print: no image renderer -- install chafa. Not dumping bytes." >&2
    file "$1"
  fi
}

render_other() {
  B="$(pick_bat)"
  if [ -n "$B" ]; then
    "$B" -p --paging=never "$1"
  else
    cat "$1"
  fi
}

render_by_ext() {
  f="$1"
  case "$f" in
    *.md|*.markdown) render_md "$f" ;;
    *.yml|*.yaml)    render_yaml "$f" ;;
    *.json)          render_json "$f" ;;
    *.png|*.jpg|*.jpeg|*.gif|*.webp|*.PNG|*.JPG|*.JPEG|*.GIF|*.WEBP) render_image "$f" ;;
    *)               render_other "$f" ;;
  esac
}

no_header=0
stdin_mode=0
hint=""

# arg parse
while [ $# -gt 0 ]; do
  case "$1" in
    --no-header) no_header=1; shift ;;
    --animate) ANIMATE=1; shift ;;
    --image-format)
      [ $# -ge 2 ] || { echo "hee-print: --image-format needs a value (symbols|sixels|kitty|iterm|auto|show)" >&2; exit 2; }
      if [ "$2" = "show" ]; then image_format | awk -F'\t' '{print "🟢 OK hee-print: image format " $1 " -- " $2}'; exit 0; fi
      IMAGE_FORMAT="$2"; shift 2 ;;
    --stdin) stdin_mode=1; shift ;;
    --hint) hint="${2:-}"; shift 2 ;;
    --) shift; break ;;
    -*) echo "unknown flag: $1" >&2; usage; exit 2 ;;
    *) break ;;
  esac
done

if [ "$stdin_mode" -eq 1 ]; then
  tmp="${TMPDIR:-/tmp}/hee-print.$$"
  cat > "$tmp"
  # best-effort hint routing
  case "$hint" in
    md)   render_md "$tmp" ;;
    yaml) render_yaml "$tmp" ;;
    json) render_json "$tmp" ;;
    *)    render_other "$tmp" ;;
  esac
  rm -f "$tmp"
  exit 0
fi

if [ $# -lt 1 ]; then
  usage
  exit 2
fi

for f in "$@"; do
  if [ ! -f "$f" ]; then
    echo "missing file: $f" >&2
    continue
  fi
  if [ "$no_header" -eq 0 ] && [ $# -gt 1 ]; then
    echo ""
    echo "### $f"
    echo ""
  fi
  render_by_ext "$f"
done
