#!/bin/sh
# section: 8
# Flippy Claude <flippy@tcosagent.com>
# hee-mail -- mailboxes, aliases and master access on the fleet's mail exchanger.
#
# Changes a live mail host (accounts, Maildirs, dovecot and smtpd tables), so
# section 8, not 1. The operational half was proven as
# fleet-ops hosts/mx1-tcosagent-com/bin/mail-account.sh during the
# mx1.tcosagent.com build (2026-09-19); this is that logic on the `hee`
# surface, where `hee list` finds it, plus the record inv.lab reads.
set -eu

# Resolve through symlinks before deriving TOOL_ROOT -- tools are symlinked
# onto PATH from ~/.local/bin, where a bare `dirname "$0"` finds no library/.
HEE_SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  HEE_SELF="$(realpath "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
elif command -v readlink >/dev/null 2>&1; then
  HEE_SELF="$(readlink -f -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
fi
TOOL_ROOT="$(cd "$(dirname "$HEE_SELF")/../.." && pwd)"
# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"

DEFAULT_PKG="$HOME/git/fleet-ops/hosts/mx1-tcosagent-com"
PKG=${HEE_MAIL_PKG:-$DEFAULT_PKG}
DOMAIN=${HEE_MAIL_DOMAIN:-tcosagent.com}
TARGET=""
RECIPIENTS=""
DRYRUN=0

say()  { printf '%s\n' "$*"; }
ok()   { printf '✅ OK %s\n' "$*"; }
crit() { printf '❌ CRITICAL %s\n' "$*" >&2; }
die()  { crit "$*"; exit 2; }
usage_exit() { usage; exit "${1:-0}"; }
RC=0

usage() {
cat <<'USAGE'
hee-mail -- mailboxes, aliases and master access on the fleet's mail exchanger

SYNOPSIS
  hee mail list
  hee mail add     NAME[@DOMAIN] -recipients KEYID[,KEYID...]
  hee mail passwd  NAME[@DOMAIN] -recipients KEYID[,KEYID...]
  hee mail alias   ADDR TARGET
  hee mail unalias ADDR
  hee mail master  NAME[@DOMAIN]
  hee mail unmaster NAME[@DOMAIN]
  hee mail record  [-write]
  hee mail check   [DOMAIN]
  hee mail help

DESCRIPTION
  One mailbox is three things that must agree: a row in the mail host's
  virtual table (where the address goes), a credential in two files on that
  host (smtpd for submission, dovecot for IMAP), and a sealed password
  someone can actually open. This tool keeps them in step; doing it by hand
  is how a password works on 587 and not on 993.

  The mail host is named by a package directory -- the fleet-ops
  hosts/<mx>/ tree that carries droplet.conf (its address), known_hosts
  (its pinned key) and tables/ (its domains and virtuals). Default:
  ~/git/fleet-ops/hosts/mx1-tcosagent-com, or $HEE_MAIL_PKG.

  add generates a password with hee-pwgen, seals it to -recipients as
  mail-<name> in the package repo's .hee/secrets, hashes it ON the mail
  host with `smtpctl encrypt`, writes that hash to both credential files,
  and creates the Maildir owned by vmail. The plaintext is held in one
  shell variable, handed to gpg and to ssh on stdin, and never printed,
  never in argv, never in a file. passwd is the same thing for an address
  that already exists -- a rotation.

  Seal to every key that has a real reason to open it: the mailbox owner's
  personal key AND the per-host key of each machine they read mail from
  (HEE_POLICY §24). A password sealed only to a key that lives on another
  machine is a password nobody can use where they are.

  master makes an account a dovecot master user: it then opens any mailbox
  as "<mailbox>*<master>" with its own password, and dovecot logs every
  such login. No password is generated or changed, and nothing is copied.
  This is how an operator reads the fleet's mail without holding anyone
  else's credential.

  record renders the mailbox list as YAML under the package's repo
  (mail/accounts.<domain>.yaml). It holds addresses, kinds and recipients
  -- never a password or a hash. inv.lab already syncs fleet-ops, so the
  record is how mail identities reach the inventory rather than a second
  API to keep alive.

OPTIONS
  -recipients IDS   with add/passwd: GPG key ids or emails, comma separated
  -pkg DIR          the mail host package (default: $HEE_MAIL_PKG, else
                    ~/git/fleet-ops/hosts/mx1-tcosagent-com)
  -target root@HOST override the address in the package's droplet.conf
  -domain DOMAIN    default domain for a bare NAME (default: tcosagent.com)
  -write            with record: write the file (default prints it)
  -dry-run          with add/passwd: run every check, change nothing

EXAMPLES
  $ hee mail help                                          # ci
  $ hee mail list
  $ hee mail add spencer -recipients 18602F28834DBB05,01C9F82A7582A4DC
  $ hee mail alias postmaster@tcosagent.com spencer@tcosagent.com
  $ hee mail master spencer
  $ hee mail record -write

EXIT STATUS
  Nagios plugin convention.
  0 OK   1 WARNING   2 CRITICAL   3 UNKNOWN (usage)
USAGE
}

# ---------------------------------------------------------------- plumbing
resolve_pkg() {
  [ -d "$PKG" ] || die "no mail host package at $PKG (-pkg DIR, or \$HEE_MAIL_PKG)"
  [ -f "$PKG/tables/virtuals" ] || die "$PKG has no tables/virtuals -- is it a mail host package?"
  REPO=$(cd "$PKG/../.." && pwd)
  STORE=${HEE_CRED_DIR:-$REPO/.hee/secrets}
  KNOWN="$PKG/known_hosts"
  if [ -z "$TARGET" ]; then
    # shellcheck disable=SC1091
    [ -f "$PKG/droplet.conf" ] && . "$PKG/droplet.conf"
    TARGET="root@${DROPLET_IPV4:-}"
  fi
  [ "$TARGET" != "root@" ] || die "no mail host address: $PKG/droplet.conf has no DROPLET_IPV4, and -target was not given"
  [ -s "$KNOWN" ] || die "$KNOWN is empty -- the mail host's key is not pinned; ssh-keyscan -t ed25519 <ip> >> $KNOWN"
  SSH="ssh -o UserKnownHostsFile=$KNOWN -o StrictHostKeyChecking=yes"
}

# full address from a bare name
addr_of() { case $1 in *@*) printf '%s' "$1" ;; *) printf '%s@%s' "$1" "$DOMAIN" ;; esac; }
name_of() { printf '%s' "${1%%@*}"; }

# ---------------------------------------------------------------- actions
do_list() {
  resolve_pkg
  say "mail host: $TARGET   package: $PKG"
  $SSH "$TARGET" 'printf "submission (smtpd):\n"; sed "s/^/  /; s/\t.*//" /etc/smtpd/credentials 2>/dev/null;
    printf "imap (dovecot):\n"; cut -d: -f1 /etc/dovecot/users 2>/dev/null | sed "s/^/  /";
    printf "master users:\n"; cut -d: -f1 /etc/dovecot/master-users 2>/dev/null | sed "s/^/  /"' \
    || die "cannot read the mail host"
  say "virtual table ($PKG/tables/virtuals):"
  grep -v -E '^\s*(#|$)' "$PKG/tables/virtuals" | sed 's/^/  /'
}

do_add() {
  ADDR=$(addr_of "$1"); NAME=$(name_of "$ADDR")
  resolve_pkg
  [ -n "$RECIPIENTS" ] || die "-recipients KEYID[,KEYID...] is required -- whose keys may open mail-$NAME.gpg"
  command -v hee-pwgen >/dev/null 2>&1 || command -v hee >/dev/null || die "hee-pwgen is not on PATH"
  grep -q "^${ADDR}[[:space:]]" "$PKG/tables/virtuals" \
    || die "$ADDR has no row in $PKG/tables/virtuals -- add '$ADDR      vmail' there first, and deploy it"
  for r in $(printf '%s' "$RECIPIENTS" | tr ',' ' '); do
    gpg --list-keys "$r" >/dev/null 2>&1 || die "-recipients $r: no public key in this keyring"
  done
  $SSH "$TARGET" 'command -v smtpctl >/dev/null' || die "smtpctl not on $TARGET -- is it provisioned?"
  if [ "$DRYRUN" = 1 ]; then
    ok "dry run: would seal $STORE/mail-$NAME.gpg to $RECIPIENTS and set $ADDR on $TARGET"
    return 0
  fi

  pw=$(hee pwgen 32) || die "hee pwgen failed"
  [ ${#pw} -ge 32 ] || die "hee pwgen returned something short"

  mkdir -p "$STORE"
  rargs=""; for r in $(printf '%s' "$RECIPIENTS" | tr ',' ' '); do rargs="$rargs -r $r"; done
  # The generated-secret exemption of HEE_POLICY §24: straight into gpg on
  # stdin, the same call hee-cred makes, never through a terminal or a file.
  # shellcheck disable=SC2086
  printf '%s' "$pw" | gpg --batch --yes --trust-model always --encrypt --armor $rargs -o "$STORE/mail-$NAME.gpg" \
    || die "gpg seal failed"
  ok "sealed $STORE/mail-$NAME.gpg to $RECIPIENTS"

  printf '%s' "$pw" | $SSH "$TARGET" "set -e; h=\$(smtpctl encrypt); \
    grep -v '^${ADDR}[[:space:]]' /etc/smtpd/credentials > /etc/smtpd/credentials.new || true; \
    printf '%s\t%s\n' '$ADDR' \"\$h\" >> /etc/smtpd/credentials.new; \
    chmod 0640 /etc/smtpd/credentials.new; chown root:opensmtpd /etc/smtpd/credentials.new; \
    mv /etc/smtpd/credentials.new /etc/smtpd/credentials; \
    grep -v '^${ADDR}:' /etc/dovecot/users > /etc/dovecot/users.new || true; \
    printf '%s:{CRYPT}%s\n' '$ADDR' \"\$h\" >> /etc/dovecot/users.new; \
    chmod 0640 /etc/dovecot/users.new; chown root:dovecot /etc/dovecot/users.new; \
    mv /etc/dovecot/users.new /etc/dovecot/users; \
    if grep -q '^${ADDR}:' /etc/dovecot/master-users 2>/dev/null; then \
      grep -v '^${ADDR}:' /etc/dovecot/master-users > /etc/dovecot/master-users.new || true; \
      grep '^${ADDR}:' /etc/dovecot/users >> /etc/dovecot/master-users.new; \
      chmod 0640 /etc/dovecot/master-users.new; chown root:dovecot /etc/dovecot/master-users.new; \
      mv /etc/dovecot/master-users.new /etc/dovecot/master-users; fi; \
    smtpctl update table credentials >/dev/null; \
    d=\$(printf '%s' '$ADDR' | cut -d@ -f2); u=\$(printf '%s' '$ADDR' | cut -d@ -f1); \
    for p in /var/mail/vhosts/\$d /var/mail/vhosts/\$d/\$u /var/mail/vhosts/\$d/\$u/Maildir \
             /var/mail/vhosts/\$d/\$u/Maildir/new /var/mail/vhosts/\$d/\$u/Maildir/cur /var/mail/vhosts/\$d/\$u/Maildir/tmp; do \
      install -d -o vmail -g vmail -m 0700 \"\$p\"; chown vmail:vmail \"\$p\"; done; \
    echo ok" | grep -qx ok || die "setting $ADDR on $TARGET failed"
  unset pw
  ok "$ADDR: submission + imap credentials set, Maildir present (a master-user entry, if any, was refreshed)"
  say "open it:  hee cred -pass mail-$NAME -dir $STORE -exec ..."
}

do_alias() {
  A=$(addr_of "$1"); B=$(addr_of "$2")
  resolve_pkg
  V="$PKG/tables/virtuals"
  if grep -q "^${A}[[:space:]]" "$V"; then
    die "$A already has a row in $V -- edit or remove it first (this tool never rewrites a row it did not make)"
  fi
  printf '%s      %s\n' "$A" "$B" >> "$V"
  ok "$A -> $B appended to $V"
  say "deploy it:  $PKG/bin/push.sh   (the table is read from the repo, not edited on the box)"
}

do_unalias() {
  A=$(addr_of "$1")
  resolve_pkg
  V="$PKG/tables/virtuals"
  grep -q "^${A}[[:space:]]" "$V" || die "$A has no row in $V"
  grep -v "^${A}[[:space:]]" "$V" > "$V.new" && mv "$V.new" "$V"
  ok "$A removed from $V"
  say "deploy it:  $PKG/bin/push.sh"
}

do_master() {
  ADDR=$(addr_of "$2"); ACT=$1
  resolve_pkg
  $SSH "$TARGET" "set -e; \
    grep -v '^${ADDR}:' /etc/dovecot/master-users > /etc/dovecot/master-users.new 2>/dev/null || true; \
    if [ '$ACT' = master ]; then grep '^${ADDR}:' /etc/dovecot/users >> /etc/dovecot/master-users.new || { echo nosuch; exit 0; }; fi; \
    chmod 0640 /etc/dovecot/master-users.new; chown root:dovecot /etc/dovecot/master-users.new; \
    mv /etc/dovecot/master-users.new /etc/dovecot/master-users; echo ok" > /tmp/.heemail.$$ 2>&1 || { rm -f /tmp/.heemail.$$; die "$ACT $ADDR failed"; }
  if grep -qx nosuch /tmp/.heemail.$$; then rm -f /tmp/.heemail.$$; die "$ADDR is not a mailbox account on $TARGET"; fi
  rm -f /tmp/.heemail.$$
  ok "$ACT $ADDR -- master users now: $($SSH "$TARGET" 'cut -d: -f1 /etc/dovecot/master-users 2>/dev/null | paste -sd,')"
  [ "$ACT" = master ] && say "read any mailbox as:  <mailbox>@$DOMAIN*$ADDR  with $ADDR's own password"
  return 0
}

do_record() {
  WRITE=${1:-0}
  resolve_pkg
  OUT="$REPO/mail/accounts.$DOMAIN.yaml"
  masters=$($SSH "$TARGET" 'cut -d: -f1 /etc/dovecot/master-users 2>/dev/null | paste -sd,' 2>/dev/null || true)
  {
    printf '# %s -- mailboxes on %s, rendered by "hee mail record". Do not hand-edit.\n' "mail/accounts.$DOMAIN.yaml" "$DOMAIN"
    printf '# Addresses, kinds and the keys each password is sealed to. Never a password,\n'
    printf '# never a hash. inv.lab syncs this repo, so this file is how mail identities\n'
    printf '# reach the inventory.\n'
    printf 'apiVersion: hee/v1\nkind: Registry\nmetadata:\n  name: mail-accounts-%s\n' "$DOMAIN"
    printf '  labels:\n    mail.domain: %s\n    mail.host: %s\n' "$DOMAIN" "$(basename "$PKG")"
    printf 'spec:\n  generated: %s\n  mailboxes:\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    grep -v -E '^\s*(#|$)' "$PKG/tables/virtuals" | sed 's/[[:space:]]*#.*$//' | while read -r a t; do
      [ -n "${t:-}" ] || continue
      n=$(name_of "$a")
      case $t in
        vmail)
          seal="none"
          [ -f "$STORE/mail-$n.gpg" ] && seal=$(gpg --list-packets --list-only "$STORE/mail-$n.gpg" 2>/dev/null | sed -n 's/.*keyid \([0-9A-F]*\).*/\1/p' | paste -sd,)
          m=false
          case ",$masters," in *",$a,"*) m=true ;; esac
          printf '    - address: %s\n      kind: mailbox\n      sealed_to: [%s]\n      master: %s\n' "$a" "$seal" "$m"
          ;;
        *)
          case $a in
            @*) printf '    - address: "%s"\n      kind: catch-all\n      delivers_to: %s\n' "$a" "$t" ;;
            *)  printf '    - address: %s\n      kind: alias\n      delivers_to: %s\n' "$a" "$t" ;;
          esac
          ;;
      esac
    done
  } > "/tmp/.heemail-rec.$$"
  if [ "$WRITE" = 1 ]; then
    mkdir -p "$(dirname "$OUT")"
    mv "/tmp/.heemail-rec.$$" "$OUT"
    ok "wrote $OUT ($(grep -c '^    - address:' "$OUT") entries) -- commit it; inv.lab picks it up on its next sync"
  else
    cat "/tmp/.heemail-rec.$$"; rm -f "/tmp/.heemail-rec.$$"
    say "# (nothing written -- add -write)"
  fi
}

do_check() {
  D=${1:-$DOMAIN}
  resolve_pkg
  [ -x "$PKG/bin/check.sh" ] || die "$PKG/bin/check.sh is missing -- it is the external check this wraps"
  "$PKG/bin/check.sh" "$D"
}

# ---------------------------------------------------------------- dispatch
[ $# -gt 0 ] || usage_exit 3
# The help token wins wherever it appears, and what it discarded is named on
# stderr -- silence there is how someone types `hee mail help -dry-run` and
# cannot tell whether anything ran (cli.help.shfn.bash).
for _a in "$@"; do
  case $_a in
    -h|--help|help)
      command -v hee_help_note_ignored >/dev/null 2>&1 && hee_help_note_ignored "$@"
      usage_exit 0 ;;
  esac
done
ACTION=$1; shift

A1=""; A2=""
while [ $# -gt 0 ]; do
  case $1 in
    -recipients) RECIPIENTS=${2:-}; shift ;;
    -pkg)        PKG=${2:-}; shift ;;
    -target)     TARGET=${2:-}; shift ;;
    -domain)     DOMAIN=${2:-}; shift ;;
    -write)      WRITEFLAG=1 ;;
    -dry-run)    DRYRUN=1 ;;
    -*)          die "unknown option $1" ;;
    *)           if [ -z "$A1" ]; then A1=$1; else A2=$1; fi ;;
  esac
  shift
done
WRITEFLAG=${WRITEFLAG:-0}

case $ACTION in
  list)     do_list ;;
  add|passwd) [ -n "$A1" ] || die "$ACTION needs NAME"; do_add "$A1" ;;
  alias)    [ -n "$A2" ] || die "alias needs ADDR and TARGET"; do_alias "$A1" "$A2" ;;
  unalias)  [ -n "$A1" ] || die "unalias needs ADDR"; do_unalias "$A1" ;;
  master)   [ -n "$A1" ] || die "master needs NAME"; do_master master "$A1" ;;
  unmaster) [ -n "$A1" ] || die "unmaster needs NAME"; do_master unmaster "$A1" ;;
  record)   do_record "$WRITEFLAG" ;;
  check)    do_check "${A1:-}" ;;
  *)        crit "unknown action $ACTION"; usage_exit 3 ;;
esac
exit $RC
