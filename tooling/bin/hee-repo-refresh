#!/bin/bash
# section: 1
# hee-repo-refresh -- real per-repo health-check/pull worker for
# bootstrap.mk's health-all-repos and pull-all-repos targets. Extracted
# into its own script, rather than embedded inline in the Makefile
# recipe twice, so the GNU-parallel path and the sequential fallback
# path call the exact same real logic instead of two copies that can
# silently drift -- HEE#415, Spencer direct 2026-08-28: "add gnu
# parallel to this tool." Real trigger for parallelizing at all: with
# ~19-24 real repos each doing a real git fetch/pull over the network,
# the old one-at-a-time loop was a real, avoidable wall-clock cost,
# confirmed live refreshing both claude@kiosk and spencer@kiosk.
#
# Deliberately its own script (not a Makefile-only trick) so it can be
# invoked identically two ways: `parallel hee-repo-refresh health ::: $repos`
# (concurrent) or a plain `for d in $repos; do hee-repo-refresh health "$d"; done`
# (sequential fallback when GNU parallel isn't installed) -- bootstrap.mk
# picks whichever via `command -v parallel`.
#
# Usage:
#   hee-repo-refresh <health|pull|hygiene|prune|refresh|regen> <repo-dir>
#   hee-repo-refresh <health|pull|hygiene|prune|refresh|regen> [all|-all]
#   hee-repo-refresh <health|pull|hygiene|prune|refresh|regen> -repo <name>[,<name>...]
#
# The bare <repo-dir> positional form (a real filesystem path) is what
# bootstrap.mk's own health-all-repos/pull-all-repos targets pass
# internally -- kept exactly as-is, never break that. `all`/`-all` (both
# accepted) and `-repo <name-csv>` are the real, human-facing entry
# points added 2026-08-29, Spencer direct: "needs switches., ./hee repo
# refresh -all or -repo dotfiles, etc" then "csv of repos" -- -repo
# takes real repo *names* (dotfiles, not /home/x/git/dotfiles),
# resolved under ${HEE_GIT_ROOT:-$HOME/git}, comma-separated for more
# than one.
#
# health/pull print one real 🟢/🟡/🟠/🔴-prefixed line to stdout -- same
# format the old inline Makefile loop produced, byte-for-byte, so
# parallel output (each job's single line prints atomically, GNU
# parallel's own default --group behavior) reads exactly the way the
# sequential output always did. hygiene (added for
# fleet-ops/hosts/spencer/bin/hee-git-hygiene-report.sh's real,
# distinct check -- dirty-file-count + no-upstream-branch-count across
# ALL local branches, not just the current one) prints nothing at all
# for a clean repo, matching that script's original silent-unless-a-
# problem behavior exactly. refresh (added 2026-08-29, Spencer direct:
# "hee repo refresh I think for now" -- a single real command instead
# of two-plus-a-Makefile-target) runs the exact same real sequence as
# bootstrap.mk's refresh-all-repos: a full health pass, then a full
# pull pass, then the governance reminder -- printed once per real
# invocation of a scope (all/-all/-repo), not once per repo inside it.
# Only the bare <repo-dir> positional form (a real filesystem path --
# what bootstrap.mk's own targets pass internally) skips the reminder
# entirely, since that form is always one worker among many others
# already fanned out by something else, never the whole real scope.

set -u

# Resolve through symlinks before deriving TOOL_ROOT -- tools are symlinked
# onto PATH from ~/.local/bin, where a bare `dirname "$0"` finds no library/.
HEE_SELF="$0"
if command -v realpath >/dev/null 2>&1; then
  HEE_SELF="$(realpath -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
elif command -v readlink >/dev/null 2>&1; then
  HEE_SELF="$(readlink -f -- "$HEE_SELF" 2>/dev/null || echo "$HEE_SELF")"
fi
TOOL_ROOT="$(cd "$(dirname "$HEE_SELF")/../.." && pwd)"

# shellcheck source=/dev/null
[ -r "$TOOL_ROOT/library/bash/cli.help.shfn.bash" ] && . "$TOOL_ROOT/library/bash/cli.help.shfn.bash"

usage() {
  cat <<'USAGE'
hee-repo-refresh -- per-repo health, pull, hygiene, prune and artifact regeneration

SYNOPSIS
  hee-repo-refresh MODE REPO_DIR
  hee-repo-refresh MODE [all|-all]
  hee-repo-refresh MODE -repo NAME[,NAME...]
  hee-repo-refresh regen [SCOPE] [--write]
  hee-repo-refresh help

DESCRIPTION
  The worker behind bootstrap.mk's health-all-repos and pull-all-repos
  targets. It lives in its own script, not inline in the Makefile, so the
  GNU parallel path and the sequential fallback call the same logic rather
  than two copies that can drift.

MODES
  health    report each repo's state in one line
  pull      fast-forward each repo
  hygiene   dirty-file and no-upstream-branch counts across ALL local
            branches; prints nothing at all for a clean repo
  prune     delete local branches GitHub confirms are merged
  refresh   health, then pull, then the governance reminder -- the same
            sequence as bootstrap.mk's refresh-all-repos
  regen     regenerate the generated artifacts these repos commit or
            publish. DRY RUN unless --write
  gate      does this repo still pass hee-check as its own CI runs it,
            against the human-execution-engine checkout beside it? The same
            question .github/workflows/stable.yaml asks in CI before letting
            `stable` advance -- asked locally, before pushing a tightening
            that would turn other repos red with no commit to them

SCOPE
  A bare REPO_DIR is a filesystem path and is what bootstrap.mk passes
  internally; it skips the governance reminder, since that form is always
  one worker among many. `all`/`-all` and `-repo NAME,NAME` are the
  human-facing forms, and take repo NAMES (dotfiles, not a full path),
  resolved under ${HEE_GIT_ROOT:-$HOME/git}.

GATE
  Runs `hee-check all .` from INSIDE each repo, with human-execution-engine
  as a sibling checkout. Both details are load-bearing and were each measured
  wrong first: hee-check resolves cross-repo references by walking sibling
  checkouts with git, so an absolute-path invocation from elsewhere reports
  CRITICAL that the repo's own CI never sees.

  A repo's own HEE_*_SKIP exemptions are read out of its workflows and
  replayed, because "the repo declares the exemption, the checker never
  guesses". Reading them from the repo beats copying them: a copy drifts.

  A result is annotated when the tree is not a clean main at origin --
  [on BRANCH, not main], [N behind origin], [N uncommitted]. An unannotated
  line is the only one that is an answer about main.

  It judges the WORKING TREE, not origin. That is the point locally -- you
  want to know before you push -- but it means a result here can differ from
  CI. Measured 2026-09-07: dotfiles read 2 findings locally and 0 from a
  clean clone, purely from uncommitted work. When the two disagree, CI is
  right about main and this is right about your desk.

  Exit is 0 even when repos fail -- this reports, it does not gate. Read the
  per-repo lines.

REGEN
  `pull` brings in what other people wrote. `regen` brings in what the
  MACHINES say -- the artifacts in these repos that are generated and were
  being regenerated only when somebody remembered. Measured 2026-09-08: five
  generated artifacts, no crontab entry, no workflow, no timer touching any
  of them, and pve/network-map.md carrying a written admission that
  "regeneration is a habit, not a gate".

  DRY RUN IS THE DEFAULT, the same rule and the same reason as
  hee-gen-manpages and hee-release: a bare run reports what WOULD change and
  writes nothing (issue:464@human-execution-engine, where a documentation
  generator installed a pre-commit hook as a side effect of being run).

  IT NEVER COMMITS, and it never deploys. Regenerating is not landing.
  --write updates files in your working tree; opening the PR is yours. An
  artifact that is published rather than committed (view.lab's
  old-commits.html) is rendered and compared against what the host is really
  serving, and the deploy is named, never run.

  FAILS CLOSED. Each generator already answers "could you reach your source?"
  in its own exit code -- 3 is UNKNOWN in every hee tool -- so an artifact
  whose source is unreachable is reported UNKNOWN, counted, and named in a
  closing "source(s) not reached" line. It is never folded into the
  unchanged list, and the pass never returns a quietly shorter report. The
  cost of the alternative is measured: namespace-audit reported OK across 17
  repos for days while reading none of them (issue:423@fleet-ops).

  --write will not overwrite a destination that already has uncommitted
  changes; it says so and leaves it alone. Dirtiness is snapshotted once, at
  the start of the pass, because network-map.md holds two generated blocks
  and a per-write check would refuse the second one on dirtiness the pass
  itself had just created.

  The artifact registry is library/py/hee_regen -- a table, not a code path.

  `hee pve-health drift` already asked this question for the two pve
  artifacts and could only answer it. regen asks it for every declared
  artifact and, with --write, does something about the answer. The pve
  generators are reused, not reimplemented, so the two cannot disagree.

OPTIONS
  --write     apply the regeneration. Without it nothing is written.
  --json      hygiene only: one JSON object per repo.

ENVIRONMENT
  HEE_GIT_ROOT     where repos live. Default: $HOME/git
  HEE_GIT_TIMEOUT  seconds any single network git call may take before it is
                   reported as unanswered rather than waited on. Default: 45
  HEE_REGEN_TIMEOUT
                   seconds any single generator in `regen` may take before it
                   is reported as unanswered. Default: 300

SEE ALSO
  hee-pve-health(1)   drift, which detects what regen acts on
  hee-gen-manpages(1), hee-gen-changelog(1)   two of the generators regen runs
  tooling/systemd/hee-regen.{service,timer}   the units that would schedule it;
                                              installing them is an operator action

EXIT STATUS
  0 completed   2 usage error

  regen reports in the Nagios vocabulary instead, because it has a real
  verdict to give:
    0 OK        every artifact current, or every stale one regenerated
    1 WARNING   something is stale (dry run), or was not written
    2 CRITICAL  a generator failed with its source reachable, or a write failed
    3 UNKNOWN   a source could not be reached -- NOT a pass
USAGE
}

# Contextual help, via the shared contract. Answered before any real work --
# a tool must be able to explain itself on a machine where its dependencies
# are missing or it is run outside a repo. That is exactly when help is read.
if hee_help_wanted "$@"; then
  hee_help_note_ignored "$@"
  usage
  exit 0
fi

SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
GIT_ROOT="${HEE_GIT_ROOT:-$HOME/git}"

# --json anywhere in argv: hygiene emits one JSON line per repo (ndjson),
# the input .github/bin/render-old-commits.py --local reads. Stripped
# here so the positional parsing below is untouched.
JSON=0
WRITE=0
_args=""
for _a in "$@"; do
  case "$_a" in
    --json) JSON=1 ;;
    # regen's apply switch. Stripped here for the same reason --json is:
    # the positional parsing below predates both and must not learn flags.
    --write) WRITE=1 ;;
    *) _args="$_args${_args:+ }$_a" ;;
  esac
done
# shellcheck disable=SC2086
set -- $_args
export JSON

# regen_run ARGS... -- the pass, from library/py/hee_regen.
#
# Thin on purpose (rule 15): the registry and every comparison live in the
# library where they are testable, and this script contributes only the
# scope resolution it already owns for every other mode. The heredoc-python
# precedent in `hygiene --json` below is the same shape, one rung less
# reusable.
regen_run() {
  [ "$WRITE" = "1" ] && set -- --write "$@"
  PYTHONPATH="$TOOL_ROOT/library/py${PYTHONPATH:+:$PYTHONPATH}" \
    python3 -m hee_regen --git-root "$GIT_ROOT" "$@"
}

MODE="${1:?usage: hee-repo-refresh <health|pull|hygiene|prune|refresh|regen> [<repo-dir>|all|-all|-repo <name-csv>] [--json]}"
shift

SCOPE_ARG="${1:-all}"

case "$SCOPE_ARG" in
  all|-all)
    repos="$(find "$GIT_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)"
    ;;
  -repo)
    names="${2:?usage: hee-repo-refresh <mode> -repo <name>[,<name>...]}"
    repos=""
    IFS=,
    for name in $names; do
      repos="$repos $GIT_ROOT/$name"
    done
    unset IFS
    ;;
  *)
    # A real filesystem path -- the single-repo case bootstrap.mk's own
    # health-all-repos/pull-all-repos targets pass internally. Never
    # change this branch's behavior; other tooling depends on it.
    DIR="$SCOPE_ARG"
    R=$(basename "$DIR")

    # -e, not -d. In a git WORKTREE, .git is a FILE holding a gitdir: pointer,
    # so the -d form silently exited 0 for every worktree -- a real repo
    # reported as no repo at all, with no line printed. Harmless for the
    # bootstrap.mk callers, which only ever pass top-level checkouts, and a
    # fail-OPEN for `regen`, whose whole contract is that nothing it could not
    # read is ever reported as fine. Found running `regen` against this
    # branch's own worktree, 2026-09-08.
    [ -e "$DIR/.git" ] || exit 0

    case "$MODE" in
      health)
        git -C "$DIR" fetch --quiet 2>/dev/null
        branch=$(git -C "$DIR" branch --show-current 2>/dev/null)
        status=$(git -C "$DIR" status --porcelain 2>/dev/null)
        tracked_dirty=$(printf '%s\n' "$status" | rg -v '^\?\?' | rg -c . || echo 0)
        untracked=$(printf '%s\n' "$status" | rg -c '^\?\?' || echo 0)
        upstream=$(git -C "$DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)
        if [ -n "$upstream" ]; then
          # shellcheck disable=SC2046
          # Splitting is the point: rev-list --count prints "AHEAD BEHIND" on
          # one line, and `set --` turns those two fields into $1 and $2.
          set -- $(git -C "$DIR" rev-list --left-right --count "HEAD...$upstream" 2>/dev/null)
          ahead=${1:-0}; behind=${2:-0}
        else
          ahead=0; behind=0
        fi
        untracked_note=""
        [ "$untracked" != "0" ] && untracked_note=" ($untracked untracked, fine to pull through)"
        if [ "$tracked_dirty" != "0" ] && [ "$behind" != "0" ]; then
          echo "🔴 $R: dirty ($tracked_dirty uncommitted) AND $behind behind $branch -- resolve by hand first"
        elif [ "$tracked_dirty" != "0" ]; then
          echo "🟠 $R: dirty ($tracked_dirty uncommitted) on $branch"
        elif [ "$ahead" != "0" ] && [ "$behind" != "0" ]; then
          echo "🟠 $R: diverged ($ahead ahead / $behind behind $branch)"
        elif [ -z "$upstream" ]; then
          echo "🟡 $R: no upstream tracking branch ($branch)$untracked_note"
        elif [ "$behind" != "0" ]; then
          echo "🟡 $R: $behind behind $branch -- pull-all-repos will fast-forward$untracked_note"
        elif [ -n "$branch" ] && [ "$branch" != "main" ]; then
          # Clean and level with its twin, but not on main: the tools this
          # checkout provides are whatever that branch had. Operator,
          # 2026-09-05: a checkout reported "clean, up to date" while parked
          # on a squash-merged fix branch two days old -- and `hee print`
          # was missing image support merged since.
          echo "🟡 $R: clean, but on $branch, not main -- tools here are that branch's$untracked_note"
        else
          echo "🟢 $R: clean, up to date ($branch)$untracked_note"
        fi
        ;;
      pull)
        tracked_dirty=$(git -C "$DIR" status --porcelain 2>/dev/null | rg -v '^\?\?' | rg -c . || echo 0)
        if [ "$tracked_dirty" != "0" ]; then
          echo "🟠 $R: skipped -- $tracked_dirty uncommitted change(s) to tracked files, not touching"
          exit 0
        fi
        # An EMPTY remote has nothing to pull, ever. Reporting that as a red
        # failure on every run is a permanently-red check, which trains people
        # to skip past red -- the same cost rule 16 names for CI.
        #
        # Detected generically by asking the remote for its branches, not by
        # matching a repo name: any repo created but never pushed to behaves
        # this way. Operator, 2026-08-31, on `inbound`: "inbound is special,
        # no git just inbound ... make exception here" -- so the exception is
        # the CONDITION, not the name.
        # An empty answer and a FAILED question are different facts. This
        # used to be `ls-remote ... 2>/dev/null` tested for emptiness, so
        # any failure -- no credential helper, DNS, a rate limit, a proxy --
        # printed "remote is empty (no branches)". That is PROMPTING_RULES
        # rule 2 exactly: discarding stderr and reading the silence as a
        # real negative result.
        #
        # Measured 2026-09-03: a second operator saw "remote is empty" for
        # 18 of 19 repos, including public ones with many branches. Nothing
        # was empty; ls-remote had failed and the tool said otherwise.
        # ONE call, both streams. This was two ls-remote invocations -- one to
        # capture stderr, one to capture stdout -- which doubled the network
        # round trips for the sake of reading both. Measured 2026-09-08:
        # `pull all` over 20 repos made 40 ls-remote calls before it made a
        # single pull, and the operator reasonably read the silence as a hang.
        _ls_err_f="$(mktemp)"
        ls_out=$(timeout "${HEE_GIT_TIMEOUT:-45}" git -C "$DIR" ls-remote --heads origin 2>"$_ls_err_f")
        ls_rc=$?
        ls_err=$(cat "$_ls_err_f")
        rm -f "$_ls_err_f"
        # A remote that never answers is not a remote with no branches. Without
        # a timeout one unreachable host blocks the whole run indefinitely and
        # says nothing about why.
        if [ "$ls_rc" -eq 124 ]; then
          echo "⚪ $R: remote did not answer within ${HEE_GIT_TIMEOUT:-45}s -- skipped, not empty"
          exit 0
        fi
        if [ "$ls_rc" -ne 0 ]; then
          echo "⚪ $R: cannot reach remote -- $(printf '%s\n' "$ls_err" | grep -v '^remote:' | tail -1)"
          exit 0
        fi
        if [ -z "$ls_out" ]; then
          echo "⚪ $R: remote is empty (no branches) -- nothing to pull"
          exit 0
        fi
        out=$(timeout "${HEE_GIT_TIMEOUT:-45}" git -C "$DIR" pull --ff-only 2>&1)
        rc=$?
        if [ "$rc" -eq 124 ]; then
          echo "🔴 $R: pull did not finish within ${HEE_GIT_TIMEOUT:-45}s -- still running or wedged, not failed"
          exit 0
        fi
        if [ "$rc" -eq 0 ]; then
          echo "🟢 $R: $(printf '%s\n' "$out" | tail -1)"
        else
          # Report the line that NAMES the failure, not the last line.
          #
          # `tail -1` gave fragments that hid the cause, repeatedly. Two real
          # examples from one session:
          #
          #   "pull failed -- Updating fbc2470..ff02d19"
          #       reads like success; the real error (untracked files would be
          #       overwritten) was several lines above.
          #
          #   "pull failed -- from the remote, but no such ref was fetched."
          #       the sentence starts on the PREVIOUS line, which is the half
          #       that names the missing ref.
          #
          # git puts the useful text on error:/fatal: lines, so prefer those.
          # rg, not grep -- org rule, and this is an operator-local tool so
          # rg is reliably present (unlike CI runners, where hee#450 was caused
          # by a runner without it).
          why="$(printf '%s\n' "$out" | rg '^(error|fatal):' | head -2 | tr '\n' ' ')"
          [ -z "$why" ] && why="$(printf '%s\n' "$out" | rg -v '^$' | tail -2 | tr '\n' ' ')"
          echo "🔴 $R: pull failed -- $why"

          # Two causes account for nearly every failure seen in practice, and
          # neither is obvious from git's wording. Name the fix.
          case "$out" in
            *"no such ref was fetched"*|*"couldn't find remote ref"*)
              _def="$(git -C "$DIR" remote show origin 2>/dev/null | awk '/HEAD branch/{print $NF}')"
              _cur="$(git -C "$DIR" branch --show-current 2>/dev/null)"
              echo "     ↳ '$_cur' tracks a remote branch that no longer exists"
              echo "       (deleted on merge, or a stale origin/HEAD)."
              echo "       fix: git -C $DIR remote set-head origin -a"
              echo "            git -C $DIR switch ${_def:-main}"
              ;;
            *"Not possible to fast-forward"*)
              _up="$(git -C "$DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
              _local="$(git -C "$DIR" rev-list --count "${_up:-origin/main}..HEAD" 2>/dev/null || echo ?)"
              echo "     ↳ local and remote histories diverged (a rewritten remote, or local commits)."
              if [ "$_local" = "0" ]; then
                echo "       no local commits beyond the remote -- safe to take the remote as-is:"
                echo "         git -C $DIR reset --hard ${_up:-origin/main}"
              else
                echo "       $_local local commit(s) not on the remote -- push them to a branch first:"
                echo "         git -C $DIR switch -c keep/$(date +%Y%m%d)-local && git -C $DIR push -u origin HEAD"
                echo "       then: git -C $DIR switch main && git -C $DIR reset --hard ${_up:-origin/main}"
              fi
              ;;
            *"untracked working tree files would be overwritten"*)
              # Name the real files and say whether each local copy is byte-
              # identical to what is incoming -- a placeholder like <dir> is
              # not a command anyone can paste (operator, 2026-09-06, after
              # pasting it: "syntax error near unexpected token").
              echo "     ↳ incoming tracked files collide with untracked local copies:"
              _up="$(git -C "$DIR" rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null)"
              printf '%s\n' "$out" | sed -n '/would be overwritten by merge:/,/Please move or remove/p' | sed -n 's/^\t//p' | while IFS= read -r _f; do
                [ -n "$_f" ] || continue
                if [ -n "$_up" ] && [ "$(sha256sum "$DIR/$_f" 2>/dev/null | cut -c1-64)" = "$(git -C "$DIR" show "$_up:$_f" 2>/dev/null | sha256sum | cut -c1-64)" ]; then
                  echo "       $_f -- identical to the incoming file; safe to remove:"
                  echo "         rm '$DIR/$_f'"
                else
                  echo "       $_f -- DIFFERS from the incoming file; keep yours first:"
                  echo "         mv '$DIR/$_f' '$DIR/$_f.local'"
                fi
              done
              echo "       then: git -C $DIR pull --ff-only"
              ;;
          esac
        fi
        ;;
      prune)
        # Real, deliberate: git branch --merged can't see squash-merged
        # branches (squash creates a new commit, no shared ancestry with
        # the original branch), so it silently misses almost everything
        # under this org's real default merge flow (PROMPTING_RULES.md
        # rule 8, gh pr merge --squash). GitHub's own real PR state is
        # the only correct source of truth for "is this branch's work
        # actually landed" -- checked here directly, not inferred from
        # local git ancestry. Real trigger: 400+ stale local branches
        # found across the fleet the same session this mode was added,
        # 2026-08-30, Spencer direct: "automate that shit... that is how
        # it was supposed to be."
        default=$(git -C "$DIR" remote show origin 2>/dev/null | awk '/HEAD branch/{print $NF}')
        [ -z "$default" ] && default="main"
        origin_url=$(git -C "$DIR" remote get-url origin 2>/dev/null)
        gh_repo=$(printf '%s\n' "$origin_url" | sed -E 's#.*[:/]([^/]+/[^/.]+)(\.git)?$#\1#')
        [ -z "$gh_repo" ] && { echo "🔴 $R: no real origin remote, skipped"; exit 0; }
        local_branches=$(git -C "$DIR" branch --format='%(refname:short)' | rg -v "^${default}\$")
        [ -z "$local_branches" ] && { echo "🟢 $R: no stray local branches"; exit 0; }
        merged=$(gh pr list --repo "$gh_repo" --state merged --limit 1000 --json headRefName -q '.[].headRefName' 2>/dev/null)
        to_delete=$(comm -12 <(printf '%s\n' "$local_branches" | sort -u) <(printf '%s\n' "$merged" | sort -u))
        [ -z "$to_delete" ] && { echo "🟢 $R: 0 real GitHub-confirmed-merged local branches to prune"; exit 0; }
        current=$(git -C "$DIR" branch --show-current 2>/dev/null)
        if printf '%s\n' "$to_delete" | rg -qx "$current"; then
          git -C "$DIR" checkout "$default" --quiet 2>/dev/null
        fi
        deleted=0; skipped=0
        while IFS= read -r b; do
          [ -z "$b" ] && continue
          # Real case found live 2026-08-30: a merged branch still
          # checked out in a separate worktree (e.g. a /tmp scratch
          # worktree from an earlier fix) can't be deleted until that
          # worktree is removed first. Only auto-remove it when
          # confirmed clean -- never discard real uncommitted work.
          wt_path=$(git -C "$DIR" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$b" '/^worktree /{p=$2} /^branch /{if ($2==b) print p}')
          if [ -n "$wt_path" ]; then
            if [ -z "$(git -C "$wt_path" status --porcelain 2>/dev/null)" ]; then
              git worktree remove "$wt_path" 2>/dev/null
            else
              echo "🟠 $R: $b skipped -- checked out in $wt_path with real uncommitted changes"
              skipped=$((skipped + 1))
              continue
            fi
          fi
          if git -C "$DIR" branch -D "$b" >/dev/null 2>&1; then
            deleted=$((deleted + 1))
          else
            echo "🟠 $R: $b real GitHub-confirmed-merged but delete failed, left in place"
            skipped=$((skipped + 1))
          fi
        done <<EOF
$to_delete
EOF
        note=""
        [ "$skipped" -gt 0 ] && note=" ($skipped skipped, see above)"
        echo "🟢 $R: pruned $deleted real GitHub-confirmed-merged local branch(es)$note"
        ;;
      hygiene)
        if [ "${JSON:-0}" = "1" ]; then
          # One JSON object per repo: every local branch, whether it tracks a
          # twin, how far it is from origin/main, and its last commit -- the
          # record a cleanup is made against (view.lab old-commits.html).
          git -C "$DIR" fetch --quiet --prune 2>/dev/null
          python3 - "$DIR" "$R" <<'PYJ'
import json, subprocess, sys
d, r = sys.argv[1], sys.argv[2]
def sh(*a):
    return subprocess.run(["git", "-C", d, *a], capture_output=True, text=True).stdout.strip()
has_main = bool(sh("rev-parse", "--verify", "-q", "origin/main"))
branches = []
for line in sh("for-each-ref", "--format=%(refname:short)%00%(upstream:short)%00%(objectname)%00%(committerdate:short)%00%(subject)", "refs/heads").splitlines():
    b, up, sha, date, subj = (line + "\0\0\0\0").split("\0")[:5]
    ahead = int(sh("rev-list", "--count", f"origin/main..{b}") or 0) if has_main else None
    behind = int(sh("rev-list", "--count", f"{b}..origin/main") or 0) if has_main else None
    on_origin = bool(sh("rev-parse", "--verify", "-q", f"origin/{b}"))
    branches.append(dict(branch=b, upstream=up or None, on_origin=on_origin, ahead=ahead, behind=behind,
                         sha=sha, date=date, subject=subj))
print(json.dumps(dict(repo=r, current=sh("branch", "--show-current"),
                      dirty=len(sh("status", "--porcelain").splitlines()), branches=branches)))
PYJ
          exit 0
        fi
        dirty=$(git -C "$DIR" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        no_upstream=$(git -C "$DIR" for-each-ref --format='%(refname:short) %(upstream)' refs/heads 2>/dev/null | awk '$2==""' | wc -l | tr -d ' ')
        if [ "$dirty" -gt 0 ] || [ "$no_upstream" -gt 0 ]; then
          echo "$R: ${dirty} uncommitted file(s), ${no_upstream} branch(es) with no upstream"
        fi
        ;;
      refresh)
        "$SELF" health "$DIR"
        "$SELF" pull "$DIR"
        ;;
      regen)
        regen_run "$DIR"
        exit $?
        ;;
      gate)
        HEE_DIR="$GIT_ROOT/human-execution-engine"
        if [ ! -d "$HEE_DIR/.git" ]; then
          echo "UNKNOWN  $R: no human-execution-engine checkout at $HEE_DIR"
          exit 0
        fi
        # Replay this repo's own declared exemptions. Not replaying them
        # judges the repo by rules it never agreed to, which produces a
        # CRITICAL its CI would never raise -- measured on fleet-ops, which
        # reported 5 false CRITICAL before its HEE_REFS_SKIP was honored.
        _gate_skip() {
          # Strips the YAML double quotes and NOTHING ELSE. The single
          # quotes inside are load-bearing: hee-check evals these pathspecs
          # (`eval git -C ... $_HP_SKIP`), so ':!hosts/*' must keep its
          # quotes or the pathspec is never applied. Measured 2026-09-07 --
          # stripping them turned fleet-ops from 0 findings into 20.
          #
          # --no-filename matters too: scanning a DIRECTORY makes rg prefix
          # every hit with its path, which corrupts the value and hides the
          # leading quote from the strip. Measured, not guessed.
          rg --no-filename --no-line-number -o -m1 \
             "^[[:space:]]*$1:[[:space:]]*(.*)$" -r '$1' \
             "$DIR/.github/workflows" 2>/dev/null | head -1 \
             | sed -e 's/^"//' -e 's/"$//'
        }
        HEE_HOME_PATH_SKIP="$(_gate_skip HEE_HOME_PATH_SKIP)"
        HEE_LINT_SKIP="$(_gate_skip HEE_LINT_SKIP)"
        HEE_REFS_SKIP="$(_gate_skip HEE_REFS_SKIP)"
        export HEE_HOME_PATH_SKIP HEE_LINT_SKIP HEE_REFS_SKIP
        # A gate result is about a WORKING TREE. If that tree is parked on
        # another branch or sits behind origin, the answer is true about code
        # that is not main -- which is a wrong answer delivered confidently.
        # Measured 2026-09-08: eight checkouts here were one commit behind
        # their own just-merged PRs, so a sweep would have judged the code as
        # it existed before the change it was checking.
        _gb="$(git -C "$DIR" branch --show-current 2>/dev/null)"
        _gs=""
        if [ -n "$_gb" ] && [ "$_gb" != main ]; then
          _gs=" [on $_gb, not main]"
        else
          _gbehind="$(git -C "$DIR" rev-list --count "HEAD..@{u}" 2>/dev/null || echo 0)"
          [ "${_gbehind:-0}" -gt 0 ] && _gs=" [$_gbehind behind origin]"
        fi
        _gdirty="$(git -C "$DIR" status --porcelain 2>/dev/null | rg -vc '^\?\?' || echo 0)"
        [ "${_gdirty:-0}" -gt 0 ] && _gs="$_gs [$_gdirty uncommitted]"

        out="$(cd "$DIR" && "$HEE_DIR/tooling/bin/hee-check" all . 2>&1)"
        rc=$?
        if [ "$rc" -eq 0 ]; then
          printf 'OK        %s%s\n' "$R" "$_gs"
        else
          n=$(printf '%s\n' "$out" | rg -c '^❌' || echo '?')
          printf 'CRITICAL  %s%s -- %s finding(s), hee-check all exit %s\n' "$R" "$_gs" "$n" "$rc"
          printf '%s\n' "$out" | rg '^❌' | head -5 | sed 's/^/            | /'
        fi
        ;;
      *)
        echo "hee-repo-refresh: unknown mode '$MODE' (want health|pull|hygiene|prune|refresh|regen|gate)" >&2
        exit 2
        ;;
    esac
    exit 0
    ;;
esac

# Reached only for the all/-all/-repo scopes above -- $repos is a real,
# space-separated list of repo dirs to fan out over.
case "$MODE" in
  regen)
    # Deliberately NOT fanned out through GNU parallel like the modes below.
    # Two reasons, both real: a regeneration pass is a REPORT and parallel
    # interleaves it into an order nobody can read back, and its exit status
    # is a count of failed jobs, not the Nagios verdict this mode owes its
    # caller. At most a handful of repos declare artifacts, so there is no
    # wall-clock case for it either.
    case "$SCOPE_ARG" in
      all|-all)
        regen_run --all
        ;;
      *)
        # Splitting is the point: $repos is a space-separated list of repo
        # dirs and the pass takes them as separate arguments.
        # shellcheck disable=SC2086
        regen_run $repos
        ;;
    esac
    exit $?
    ;;
  health|pull|hygiene|prune|gate)
    # --json is re-passed explicitly: the worker form must not depend on
    # an inherited environment variable to know what it was asked for.
    JSON_FLAG=""; [ "$JSON" = "1" ] && JSON_FLAG="--json"
    if command -v parallel >/dev/null 2>&1; then
      # --line-buffer, or GNU parallel holds every job's output until that job
      # finishes and the whole run looks frozen. That is the actual reason
      # `pull all` "takes a very long time to return": it is working, silently.
      # shellcheck disable=SC2086
      parallel --line-buffer "$SELF" "$MODE" $JSON_FLAG ::: $repos
    else
      for d in $repos; do "$SELF" "$MODE" $JSON_FLAG "$d"; done
    fi
    ;;
  refresh)
    if command -v parallel >/dev/null 2>&1; then
      parallel --line-buffer "$SELF" health ::: $repos
      parallel --line-buffer "$SELF" pull ::: $repos
    else
      for d in $repos; do "$SELF" health "$d"; done
      for d in $repos; do "$SELF" pull "$d"; done
    fi
    BOOTSTRAP_MK="$(cd "$(dirname "$SELF")/.." && pwd)/bootstrap.mk"
    [ -f "$BOOTSTRAP_MK" ] && make -f "$BOOTSTRAP_MK" print-governance-reminder
    ;;
  *)
    echo "hee-repo-refresh: unknown mode '$MODE' (want health|pull|hygiene|prune|refresh|regen|gate)" >&2
    exit 2
    ;;
esac
